Options -MultiViews
RewriteEngine On
RewriteBase /

# www → non-www (evita contenido duplicado)
RewriteCond %{HTTP_HOST} ^www\.chordsequence\.com$ [NC]
RewriteRule ^ https://chordsequence.com%{REQUEST_URI} [R=301,L]

# /blog/* → /learn/* (canonicals correctos)
RewriteRule ^blog/(.*)$ /learn/$1 [R=301,L]

# /sitemap.xml → /sitemap-index.xml (convención que usan GSC y herramientas SEO)
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

# Rewrite /editor/<songId> → serve /editor/index.html (SPA routing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^editor/(.+)$ /editor/index.html [L]

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Cache inmutable para bundles JS con hash en el nombre
  <FilesMatch "\/_astro\/.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Cache para assets con hash en el nombre (JS/CSS de Astro)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
