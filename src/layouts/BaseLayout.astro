---
import '../index.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  author?: string;
  noIndex?: boolean;
  showNav?: boolean;
}

const {
  title = 'Free Chord Progression Generator — Build, Play & Export | Chord Sequence',
  description = 'Free chord progression generator — build and play any progression with real instrument sounds. 37 chord types, 13+ styles (pop, jazz, worship, lo-fi). Transpose, export WAV. No account needed.',
  canonicalUrl = 'https://chordsequence.com/',
  ogImage: ogImageProp,
  ogImageAlt = 'Chord Sequence — free online chord progression builder',
  ogType = 'website',
  author = 'Chord Sequence',
  noIndex = false,
  showNav = true,
} = Astro.props;

// Auto-generate OG image from title+description if not explicitly provided
const cleanTitle = title.replace(/\s*[|—–]\s*Chord Sequence.*$/, '').trim();
const ogImageFallback = `https://chordsequence.com/og/page/auto/?t=${encodeURIComponent(cleanTitle)}&d=${encodeURIComponent(description.slice(0, 200))}`;
const ogImage = ogImageProp ?? ogImageFallback;

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://chordsequence.com/#app',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com',
  image: 'https://chordsequence.com/og-image.jpg',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online chord progression builder: drag-and-drop sections, live rhythm playback, transposition, and one-click WAV export.',
  featureList: [
    'Drag-and-drop chord sections',
    'Live rhythm playback',
    'Chord transposition',
    'One-click WAV export',
    '37 chord qualities',
    '13 rhythm styles',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Chord Sequence', url: 'https://chordsequence.com' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://chordsequence.com/#website',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com/',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://chordsequence.com/#organization',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com',
  foundingDate: '2024',
  areaServed: 'Worldwide',
  description: 'Free online chord progression builder for songwriters, producers, and music students. 37 chord types, 13+ rhythm styles, WAV export. No account required.',
  logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png', width: 696, height: 696 },
  parentOrganization: {
    '@type': 'Organization',
    '@id': 'https://codiflash.com/#organization',
    name: 'CodiFlash',
    url: 'https://codiflash.com',
  },
  founder: {
    '@type': 'Person',
    '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    name: 'Elías Corsino Saldaña',
    url: 'https://chordsequence.com/about/elias-corsino/',
    jobTitle: 'Musician & Software Developer',
    nationality: { '@type': 'Country', name: 'Dominican Republic' },
  },
  sameAs: [
    'https://www.linkedin.com/in/elias-corsino-salda%C3%B1a-945138182/',
    'https://www.instagram.com/corsinoeliaas/',
    'https://github.com/codiflash',
    'https://www.youtube.com/@eliascorsino',
    'https://www.fiverr.com/eliascorsino',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="license" href="https://chordsequence.com/llms.txt" type="text/plain" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: non-blocking load to avoid render-blocking LCP penalty -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiA.woff2" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Chord Sequence" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />

    <!-- Google Identity Services — the inline "Sign in with Google" button rendered by
         AuthModal (see src/lib/googleIdentity.ts). Loaded on every page, not just where
         the modal can open, since it's small and async so it doesn't block anything. -->
    <script async defer src="https://accounts.google.com/gsi/client"></script>

    <!-- Google Analytics 4 -->
    {import.meta.env.PROD && (
      <>
        <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-K25BHMSXF1"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-K25BHMSXF1');
        </script>
      </>
    )}
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Top progress bar — this is a traditional multi-page Astro site (no client
         router/View Transitions), so every internal link is a full browser navigation
         with no native loading indicator on mobile. Shows instantly on click; there's
         no "finish" call because the real navigation destroys the page (and this bar
         with it) once the next one loads. -->
    <div id="nav-progress" class="fixed top-0 left-0 h-[3px] bg-primary z-[9999] opacity-0 pointer-events-none" style="width:0%"></div>
    <script is:inline>
      (function () {
        var bar = document.getElementById('nav-progress');
        if (!bar) return;

        function start() {
          bar.style.transition = 'none';
          bar.style.width = '0%';
          bar.style.opacity = '1';
          // Force a reflow so the width change below animates from 0% instead of
          // jumping straight to the target (transition + rAF wouldn't reliably catch
          // a same-tick style change otherwise).
          void bar.offsetWidth;
          bar.style.transition = 'width 4s cubic-bezier(0.1, 0.7, 0.1, 0.9), opacity 0.2s';
          bar.style.width = '90%';
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var target = e.target;
          var link = target instanceof Element ? target.closest('a[href]') : null;
          if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
          var url;
          try { url = new URL(link.href, window.location.href); } catch (err) { return; }
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.hash) return; // same-page anchor
          start();
        });

        // A back/forward navigation can restore this exact page from bfcache mid-bar —
        // snap it back to hidden instantly (no transition) rather than leave it stuck.
        window.addEventListener('pageshow', function () {
          bar.style.transition = 'none';
          bar.style.opacity = '0';
          bar.style.width = '0%';
        });
      })();
    </script>

    {showNav && <Navbar />}
    <div class="flex-1">
      <slot />
    </div>
    {showNav && <Footer />}
  </body>
</html>
