---
import '../index.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  author?: string;
  noIndex?: boolean;
  showNav?: boolean;
}

const {
  title = 'Chord Player (Chord Sequence) — Build & Export Chord Progressions',
  description = 'Free online chord progression builder on chordsequence.com: drag-and-drop sections, live rhythm playback, transposition, and one-click WAV export for songwriters.',
  canonicalUrl = 'https://chordsequence.com/',
  ogImage = 'https://chordsequence.com/og-image.png',
  ogImageAlt = 'Chord Sequence — free online chord progression builder',
  ogType = 'website',
  author = 'Chord Sequence',
  noIndex = false,
  showNav = true,
} = Astro.props;

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://chordsequence.com/#app',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com',
  image: 'https://chordsequence.com/og-image.png',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online chord progression builder: drag-and-drop sections, live rhythm playback, transposition, and one-click WAV export.',
  featureList: [
    'Drag-and-drop chord sections',
    'Live rhythm playback',
    'Chord transposition',
    'One-click WAV export',
    '37 chord qualities',
    '13 rhythm styles',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Chord Sequence', url: 'https://chordsequence.com' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://chordsequence.com/#website',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com/',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://chordsequence.com/#organization',
  name: 'Chord Sequence',
  alternateName: 'Chord Player',
  url: 'https://chordsequence.com',
  foundingDate: '2024',
  areaServed: 'Worldwide',
  description: 'Free online chord progression builder for songwriters, producers, and music students. 37 chord types, 13+ rhythm styles, WAV export. No account required.',
  logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png', width: 696, height: 696 },
  parentOrganization: {
    '@type': 'Organization',
    '@id': 'https://codiflash.com/#organization',
    name: 'CodiFlash',
    url: 'https://codiflash.com',
  },
  founder: {
    '@type': 'Person',
    '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    name: 'Elías Corsino Saldaña',
    url: 'https://chordsequence.com/about/elias-corsino/',
    jobTitle: 'Musician & Software Developer',
    nationality: { '@type': 'Country', name: 'Dominican Republic' },
  },
  sameAs: [
    'https://www.linkedin.com/in/elias-corsino-salda%C3%B1a-945138182/',
    'https://www.instagram.com/corsinoeliaas/',
    'https://github.com/codiflash',
    'https://www.youtube.com/@eliascorsino',
    'https://www.fiverr.com/eliascorsino',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="license" href="https://chordsequence.com/llms.txt" type="text/plain" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: non-blocking load to avoid render-blocking LCP penalty -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      />
    </noscript>

    <!-- Open Graph -->
    <meta property="og:site_name" content="Chord Sequence" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen">
    {showNav && <Navbar />}
    <div class="flex-1">
      <slot />
    </div>
    {showNav && <Footer />}
  </body>
</html>
