---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  tags?: string[];
}

const { title, description, pubDate, image, tags = [] } = Astro.props;

const canonicalUrl = `https://chordsequence.com/blog/${Astro.url.pathname.split('/').pop()}`;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  image: image ?? 'https://chordsequence.com/og-image.png',
  author: { '@type': 'Organization', name: 'Chord Sequence' },
  publisher: {
    '@type': 'Organization',
    name: 'Chord Sequence',
    logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/favicon.ico' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://chordsequence.com/blog' },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---

<BaseLayout {title} {description} {canonicalUrl} ogImage={image}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border bg-card">
      <div class="container max-w-4xl mx-auto px-4 py-4 flex items-center gap-4">
        <a href="/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← Chord Player</a>
        <span class="text-muted-foreground">/</span>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Blog</a>
      </div>
    </header>

    <main class="container max-w-4xl mx-auto px-4 py-10">
      <article>
        <header class="mb-8">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-3">
              {tags.map((tag) => (
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-accent text-accent-foreground">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <h1 class="text-3xl sm:text-4xl font-bold text-foreground mb-3 font-serif">{title}</h1>
          <p class="text-muted-foreground text-sm">{formattedDate}</p>
        </header>

        {image && (
          <img
            src={image}
            alt={title}
            class="w-full rounded-xl mb-8 object-cover aspect-video"
          />
        )}

        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <slot />
        </div>
      </article>

      <footer class="mt-12 pt-8 border-t border-border">
        <a
          href="/blog"
          class="text-primary font-medium hover:text-primary/80 transition-colors"
        >
          ← Back to Blog
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>
