---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHORS } from '../data/authors';
import AppCta from '../components/AppCta.astro';

const author = AUTHORS['elias-corsino'];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/about/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://chordsequence.com/about/' },
  ],
};

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://chordsequence.com/about/#webpage',
  url: 'https://chordsequence.com/about/',
  name: 'About Chord Sequence — Free Music Tools for Every Musician',
  description: 'Chord Sequence is a suite of free browser-based music tools built by Elías Corsino Saldaña — a musician and developer from the Dominican Republic.',
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://chordsequence.com/#website',
    url: 'https://chordsequence.com/',
  },
  about: {
    '@type': 'Person',
    '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    name: 'Elías Corsino Saldaña',
    url: 'https://chordsequence.com/about/elias-corsino/',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    '@id': 'https://chordsequence.com/about/#breadcrumb',
  },
};

const tools = [
  {
    label: 'Chord Player',
    href: '/chord-player/',
    desc: 'Build, play, and export chord progressions with 37 chord types and 13 rhythm styles.',
    icon: 'M9 18V5l12-2v13M6 18a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm12-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  },
  {
    label: 'Bass Guitar Tab Player',
    href: '/tools/bass-guitar-tab/',
    desc: '4-string bass tab editor with real instrument samples, recording mode, and WAV export.',
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z',
  },
  {
    label: 'Song Charts',
    href: '/songs/',
    desc: 'Synchronized chord-over-lyrics playback — every chord lights up in time with the song.',
    icon: 'M9 19V6l12-3v13M9 19a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm12-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
  },
  {
    label: 'Chromatic Tuner',
    href: '/tuner/',
    desc: 'Tune any instrument in your browser using your microphone. No app download needed.',
    icon: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z',
  },
  {
    label: 'Metronome',
    href: '/metronome/',
    desc: 'BPM tool with tap tempo, accent beat, and subdivisions for any time signature.',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    label: 'Circle of Fifths',
    href: '/tools/circle-of-fifths/',
    desc: 'Interactive visualization of key signatures, relative majors/minors, and chord relationships.',
    icon: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 4a6 6 0 1 1 0 12A6 6 0 0 1 12 6zm0 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  },
  {
    label: 'Chord Transposer',
    href: '/tools/chord-transposer/',
    desc: 'Shift an entire chord chart up or down by key or by semitone in one click.',
    icon: 'M7 16V4m0 0L3 8m4-4 4 4M17 8v12m0 0 4-4m-4 4-4-4',
  },
  {
    label: 'Key Detector',
    href: '/tools/key-detector/',
    desc: 'Enter a chord progression and find the most likely key — including modal possibilities.',
    icon: 'M15 7a2 2 0 0 1 2 2m4 0a6 6 0 0 1-7.743 5.743L11 17H9v2H7v2H4a1 1 0 0 1-1-1v-2.586a1 1 0 0 1 .293-.707l5.964-5.964A6 6 0 1 1 21 9z',
  },
  {
    label: 'Guitar Tab Player',
    href: '/tools/guitar-tab/',
    desc: '6-string guitar tab editor with a one-click chord helper, capo support, and real-time playback.',
    icon: 'M9 18V5l12-2v13M6 18a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm12-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  },
  {
    label: 'Drum Machine',
    href: '/tools/drum-machine/',
    desc: '16-step beat programming with 3 kits and 12 genre presets — house, trap, hip-hop, and more.',
    icon: 'M4 4h4v16h-4zM10 4h4v16h-4zM16 4h4v16h-4z',
  },
  {
    label: 'Guitar Scale Chart',
    href: '/tools/scales/',
    desc: 'Visualize any of 277 scales and modes on a guitar fretboard, with BPM playback.',
    icon: 'M2 6h20M2 12h20M2 18h20',
  },
];

const values = [
  {
    title: 'Free forever',
    desc: 'No paywalls, no freemium tiers, no feature locks. Every tool is fully accessible to everyone.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
  {
    title: 'Privacy-first',
    desc: 'No accounts, no tracking. Your progressions live in your browser — never on a server.',
    icon: 'M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04.054-.09A13.916 13.916 0 0 0 8 11a4 4 0 1 1 8 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0 0 15.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 0 0 8 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4',
  },
  {
    title: 'Musician-built',
    desc: 'Every feature is designed by a working musician. If it doesn\'t help you make music, it doesn\'t ship.',
    icon: 'M9 19V6l12-3v13M9 19a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm12-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
  },
  {
    title: 'Accessible to all',
    desc: 'No installs, no subscriptions, no experience required. Open a browser and start playing.',
    icon: 'M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 0 1 9-9',
  },
];
---

<BaseLayout
  title="About Chord Sequence — Free Music Tools for Every Musician"
  description="Chord Sequence is a suite of free browser-based music tools built by Elías Corsino Saldaña — a musician and developer from the Dominican Republic."
  canonicalUrl="https://chordsequence.com/about/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 pt-4 pb-16 sm:pt-8 sm:pb-24">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-3 sm:mb-4">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">About</span>
    </nav>

    <!-- Hero -->
    <header class="mb-16">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center shadow-sm shrink-0">
          <svg class="w-5 h-5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <span class="font-bold text-foreground tracking-tight text-lg">ChordSequence</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-5">
        Music tools that get out of your way
      </h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl">
        Chord Sequence is a growing suite of free, browser-based tools for songwriters, producers, and students.
        No account. No download. No cost. Just open it and make music.
      </p>
    </header>

    <!-- Story -->
    <section class="mb-16 space-y-5 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl font-bold text-foreground mb-4">Our story</h2>
      <p>
        Elías Corsino Saldaña started learning music at 12 — piano first, then bass, guitar, and drums. Years later,
        working as a software developer, he kept running into the same problem: the music theory tools online were either
        too basic to be useful, locked behind a paywall, or buried under so many features they got in the way of
        actually writing a song.
      </p>
      <p>
        So in 2024 he built the first version of Chord Sequence: a simple chord progression editor that ran in the
        browser, played back chords with real guitar samples, and let you export to WAV. No account, no ads, no cost.
      </p>
      <p>
        It kept growing. Song charts with synchronized chord playback. A bass guitar tab editor with realistic
        instrument samples, a fretboard, and a recording mode. A chromatic tuner. A metronome. An interactive
        Circle of Fifths. A key detector. A chord transposer.
      </p>
      <p>
        Each tool came from a real need — something missing from a practice session or a songwriting session.
        That's still how it works today.
      </p>
    </section>

    <!-- Vision -->
    <section class="mb-16 space-y-5 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl font-bold text-foreground mb-4">Vision</h2>
      <p>
        The goal is to build the most useful free music toolkit on the web — a place where a beginner can learn
        their first chord shapes and a working musician can practice a bass line, tune their instrument, and
        chart out a song, all without paying for a subscription or installing anything.
      </p>
      <p>
        Music theory should be something you experience, not something you read about. Every tool here
        is designed to give you immediate feedback — play a chord and hear it, see the notes light up,
        feel the rhythm. The learning happens in the doing.
      </p>
    </section>

    <!-- Values -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-foreground mb-6">Values</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {values.map((v) => (
          <div class="rounded-xl border border-border bg-card p-5 flex gap-4">
            <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4.5 h-4.5 text-primary" style="width:18px;height:18px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={v.icon} />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-foreground text-sm mb-1">{v.title}</p>
              <p class="text-xs text-muted-foreground leading-relaxed">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- What we've built -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-foreground mb-2">What we've built</h2>
      <p class="text-muted-foreground mb-6 leading-relaxed">
        Eleven tools, all free, all running in your browser with no plugins required.
      </p>
      <div class="grid sm:grid-cols-2 gap-3">
        {tools.map((t) => (
          <a
            href={t.href}
            class="rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-accent/30 transition-colors group"
          >
            <p class="font-semibold text-foreground text-sm mb-1 group-hover:text-primary transition-colors">{t.label}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{t.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Who built it -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-foreground mb-6">Who built it</h2>
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-center gap-4 mb-4">
          <img
            src={author.avatar}
            alt={`${author.name}, musician and creator of Chord Sequence`}
            class="w-14 h-14 rounded-full object-cover shrink-0"
            width="56"
            height="56"
            loading="lazy"
          />
          <div>
            <a href="/about/elias-corsino/" class="font-semibold text-foreground hover:text-primary transition-colors">
              {author.name}
            </a>
            <p class="text-sm text-muted-foreground">{author.role}</p>
          </div>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">{author.bio}</p>
        <div class="flex items-center gap-4">
          <a
            href={author.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors"
          >
            LinkedIn ↗
          </a>
          <a
            href={author.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors"
          >
            Instagram ↗
          </a>
          <a
            href={author.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors"
          >
            YouTube ↗
          </a>
          <a href="/about/elias-corsino/" class="text-xs font-medium text-muted-foreground hover:text-foreground transition-colors">
            Full bio →
          </a>
        </div>
      </div>
    </section>

    <!-- Get in touch -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-foreground mb-2">Get in touch</h2>
      <p class="text-muted-foreground mb-6 leading-relaxed">
        Found a bug? Have a feature idea? Just want to say hi? We'd love to hear from you.
      </p>
      <div class="space-y-4">

        <a
          href="mailto:corsinoelias@gmail.com"
          class="flex items-center gap-4 rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:bg-accent/30 transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Email</p>
            <p class="text-xs text-muted-foreground">corsinoelias@gmail.com</p>
          </div>
        </a>

        <a
          href={author.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:bg-accent/30 transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Instagram</p>
            <p class="text-xs text-muted-foreground">@corsinoeliaas — music tips and app updates</p>
          </div>
        </a>

        <a
          href={author.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:bg-accent/30 transition-colors group"
        >
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">LinkedIn</p>
            <p class="text-xs text-muted-foreground">{author.name}</p>
          </div>
        </a>

      </div>
    </section>

    <!-- Legal links -->
    <div class="flex items-center gap-4 text-xs text-muted-foreground border-t border-border pt-8 mb-10">
      <a href="/privacy/" class="hover:text-foreground transition-colors">Privacy Policy</a>
      <span>·</span>
      <a href="/terms/" class="hover:text-foreground transition-colors">Terms of Service</a>
    </div>

    <AppCta
      heading="Try it now"
      description="No signup. No download. Works in any browser."
    />
  </main>
</BaseLayout>
