---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BassTabPlayer } from '../components/BassTabPlayer/BassTabPlayer';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bass Guitar Tab Player',
  url: 'https://chordsequence.com/bass-tab/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online 4-string bass tablature editor. Draw notes on any string, drag to move, resize to change duration, and hear playback in real time.',
  featureList: [
    'Draw notes on any string and fret',
    'Drag to reposition, resize to change duration',
    'Real-time audio playback',
    'Multiple bass sounds: Fender Pick, Finger, Slap, Muted',
    'ASCII tab export',
    'MIDI export',
    'URL sharing — no account required',
    '10+ preset bass lines',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://chordsequence.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Bass Tab Player', item: 'https://chordsequence.com/bass-tab/' },
  ],
};
---

<BaseLayout
  title="Bass Tab Player — 4-String Bass Tablature Editor"
  description="Free online 4-string bass tablature editor. Draw notes on any string, drag to move, resize to change duration, and hear playback in real time."
  canonicalUrl="https://chordsequence.com/bass-tab/"
  ogImage="/og/page/bass-tab/"
  ogImageAlt="Bass Tab Player — 4-String Bass Tablature Editor | Chord Sequence"
  showNav={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <BassTabPlayer client:only="react" />

  <!--
    Exportar a PDF = imprimir. El editor no tiene una vista de impresión aparte: se
    oculta todo con `visibility` (no con `display`, que colapsaría la maquetación y
    desplazaría la partitura) y se deja visible sólo `.bt-print-area`, que envuelve la
    vista activa — Tab, Score o Grid, la que esté puesta. Se saca del flujo para que
    empiece arriba del papel en vez de donde cayera en pantalla, y se le quitan altura
    máxima y scroll para que los compases que quedaban fuera del viewport entren en las
    páginas siguientes en vez de cortarse.
  -->
  <style is:global>
    @media print {
      body * { visibility: hidden !important; }
      .bt-print-area, .bt-print-area * { visibility: visible !important; }
      .bt-print-area {
        position: absolute !important;
        left: 0; top: 0; width: 100%;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        background: #fff !important;
        max-height: none !important;
        overflow: visible !important;
      }
      .bt-print-area * { overflow: visible !important; max-height: none !important; }
      @page { margin: 12mm; }
    }
  </style>
</BaseLayout>
