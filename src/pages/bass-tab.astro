---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BassTabPlayer } from '../components/BassTabPlayer/BassTabPlayer';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bass Guitar Tab Player',
  url: 'https://chordsequence.com/bass-tab/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online 4-string bass tablature editor. Draw notes on any string, drag to move, resize to change duration, and hear playback in real time.',
  featureList: [
    'Draw notes on any string and fret',
    'Drag to reposition, resize to change duration',
    'Real-time audio playback',
    'Multiple bass sounds: Fender Pick, Finger, Slap, Muted',
    'ASCII tab export',
    'MIDI export',
    'URL sharing — no account required',
    '10+ preset bass lines',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://chordsequence.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Bass Tab Player', item: 'https://chordsequence.com/bass-tab/' },
  ],
};
---

<BaseLayout
  title="Bass Tab Player — 4-String Bass Tablature Editor"
  description="Free online 4-string bass tablature editor. Draw notes on any string, drag to move, resize to change duration, and hear playback in real time."
  canonicalUrl="https://chordsequence.com/bass-tab/"
  ogImage="/og/page/bass-tab/"
  ogImageAlt="Bass Tab Player — 4-String Bass Tablature Editor | Chord Sequence"
  showNav={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <BassTabPlayer client:only="react" />
</BaseLayout>
