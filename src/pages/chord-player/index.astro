---
export const prerender = true;
// The player's own design tokens and primitives, all scoped under `.cp` — see
// src/styles/chord-player.css. Imported here so they ship with this page only.
import '../../styles/chord-player.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorApp from '../../components/EditorApp';
import { WEB, instrumentList } from '../../data/facts';
import {
  Plus,
  Sparkles,
  Repeat,
  Settings2,
  Sliders,
  Grid3X3,
  Music2,
  ArrowUpDown,
  Save,
  Download,
} from 'lucide-react';

// NOTE: URLs like /chord-player/SONG_ID are handled by this same page via SPA routing.
// Netlify redirect: /chord-player/*  →  /chord-player/  (200 rewrite), plus a 301 from the
// old /editor/* path (see netlify.toml) for links/bookmarks made before the rename.
// The EditorApp reads the songId from window.location.pathname at runtime.

const faqs = [
  {
    q: 'Do I need an account to use it?',
    a: 'No — you can build, play and export a song without signing up. An account is only needed to keep songs in your library and share them by link.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. Every feature is free, including downloading your song as a WAV or MIDI file. No paywall, no limit on how much you can make.',
  },
  {
    q: 'Can I change the instruments and sounds?',
    a: 'Yes — Edit Rhythm picks the sound of each instrument (the drum kit, piano, guitar, bass and synth) for every part of the rhythm, and the Mixer mutes, solos and levels any of them.',
  },
  {
    q: 'Can I export what I make?',
    a: 'Yes — Export WAV turns your song into a real sound file, at whatever speed and rhythm you last had it set to, and Export MIDI gives you the notes to open in any DAW.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/chord-player/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Player', item: 'https://chordsequence.com/chord-player/' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Chord Player',
  alternateName: 'Chord Sequence Player',
  url: 'https://chordsequence.com/chord-player/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online chord player with drag-and-drop sections, live playback by a full band, transposition, and WAV or MIDI export.',
  featureList: [
    'Drag-and-drop chord sections',
    `Live playback by ${instrumentList(WEB.instruments)}`,
    `${WEB.rhythms} rhythms across genres, with intros, A and B variations and endings`,
    `${WEB.chordTypes} chord types`,
    'Chord progression suggestions by genre',
    'Step-by-step rhythm editor for every instrument',
    'Transpose without re-entering chords',
    'WAV and MIDI export',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title="Chord Player Online – Play, Listen & Practice Chords for Free"
  description={`Free online chord player — hear any progression played by a real band in ${WEB.rhythms} rhythms. Loop a section, edit the groove, and export to WAV or MIDI.`}
  canonicalUrl="https://chordsequence.com/chord-player/"
  ogImage="https://chordsequence.com/images/blog/chord-sequence-editor.webp"
  ogImageAlt="Chord Player"
  showNav={false}
  appBanner="banner_player"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Not a <main> here: EditorApp renders its own <main> once hydrated (Index.tsx), and
       wrapping this in a second one produces a nested/duplicate main landmark. -->
  <div>
    <!--
      EditorApp uses client:only (it touches window/localStorage/AudioContext at mount),
      so nothing paints until the full React bundle loads and hydrates — this was the
      LCP culprit (Lighthouse: 5.0s "Poor"). The static skeleton below renders immediately
      server-side and sits in the same CSS grid cell as the island.

      Relying on DOM order alone to cover it was NOT reliable: Chromium can promote the
      animate-pulse element to its own compositing layer and paint it above the later
      sibling despite source order, so the skeleton showed through on top of the loaded
      app. Explicit z-index fixes the stacking, and removeSkeletonOnHydrate() below tears
      the skeleton down once THIS island has painted — not when any island on the page
      hydrates, which is what used to blank the screen for seconds (see that module).
    -->
    <!-- grid-template-columns: minmax(0, 1fr) — without it the single implicit column is
         sized to its items' min-content, and the editor (a full-bleed two-column layout
         now) drags the whole page ~45px wider than the viewport on a phone. -->
    <div style="display: grid; grid-template-columns: minmax(0, 1fr);">
      <div id="editor-skeleton" style="grid-area: 1 / 1; z-index: 0; transition: opacity 180ms ease-out;" class="min-h-screen">
        <!--
          The logo + breadcrumb row below is real, permanent content (not aria-hidden). A
          crawler never has a saved song in its (nonexistent) localStorage, so it always sees
          this exact text; a real visitor sees it too until they save something, at which
          point the hydrated app swaps it for the actual song title (Index.tsx mirrors this
          same condition). Everything else below is decorative loading shimmer only.

          This crumb used to be the page's H1, which was a bad fit for the one page that has
          to rank for "chord player": 12px, inline, truncated at 160px, and inside
          "hidden sm:flex" — so on mobile it was display:none and the page had no rendered
          heading at all. The H1 now lives in the "About the chord player" section below the
          editor, which is outside #editor-skeleton and therefore survives hydration.
        -->
        <div class="cp flex min-h-screen flex-col lg:h-[100dvh] lg:min-h-0" style="background: var(--cp-bg);">
          <!-- The same shape as the hydrated header (Index.tsx: the centred 1440 row, the title
               row, the transport, the capsules — their own row on a phone — and the song map),
               down to the paddings, so nothing moves when React takes over: measured header
               162px wide screen / 186px phone, matching the app's own. -->
          <div class="cp-hd shrink-0">
            <div class="mx-auto w-full max-w-[1440px]">
              <div class="flex h-12 items-center gap-1 px-3 lg:h-14 lg:gap-2 lg:px-8">
                <div class="mr-1 hidden h-[30px] w-[30px] shrink-0 rounded-[9px] lg:block" style="background: color-mix(in srgb, var(--cp-ac) 25%, transparent);"></div>
                <div class="flex items-center gap-2.5 text-[13px]">
                  <span class="hidden shrink-0 font-medium sm:inline" style="color: var(--cp-mu);">My library</span>
                  <span class="hidden sm:inline" style="color: var(--cp-ln2);">/</span>
                  <span class="m-0 inline max-w-[200px] truncate text-base font-extrabold">Chord Player</span>
                </div>
                <div class="ml-auto flex items-center gap-2" aria-hidden="true">
                  <div class="h-8 w-20 rounded-lg animate-pulse" style="background: var(--cp-s2);"></div>
                  <div class="h-10 w-10 rounded-[10px] animate-pulse" style="background: var(--cp-s2);"></div>
                  <div class="hidden h-10 w-10 rounded-[10px] animate-pulse lg:block" style="background: var(--cp-s2);"></div>
                </div>
              </div>
              <div class="px-3 pt-1 lg:px-8 lg:pt-2" aria-hidden="true">
                <div class="flex items-center gap-3">
                  <div class="h-14 w-14 shrink-0 rounded-full" style="background: color-mix(in srgb, var(--cp-ac) 30%, transparent);"></div>
                  <!-- Tempo: label line, the number, the slider — 58px like the real one. -->
                  <div class="flex min-w-0 flex-1 flex-col gap-1 lg:w-64 lg:flex-none">
                    <div class="h-4 w-32 rounded animate-pulse" style="background: var(--cp-s2);"></div>
                    <div class="h-6 w-16 rounded animate-pulse" style="background: var(--cp-s2);"></div>
                    <div class="h-[10px] w-full rounded animate-pulse" style="background: var(--cp-s2);"></div>
                  </div>
                  <div class="hidden min-w-0 flex-1 items-center gap-2 lg:flex">
                    <div class="h-9 w-28 shrink-0 rounded-full animate-pulse" style="background: var(--cp-s2);"></div>
                    <div class="h-9 w-24 shrink-0 rounded-full animate-pulse" style="background: var(--cp-s2);"></div>
                    <div class="h-9 min-w-0 flex-1 rounded-full animate-pulse lg:max-w-[300px]" style="background: var(--cp-s2);"></div>
                  </div>
                  <div class="flex items-center gap-1">
                    <div class="h-10 w-10 rounded-[10px] animate-pulse" style="background: var(--cp-s2);"></div>
                    <div class="hidden h-10 w-10 rounded-[10px] animate-pulse lg:block" style="background: var(--cp-s2);"></div>
                  </div>
                </div>
                <div class="mt-2 flex items-center gap-2 lg:hidden">
                  <div class="h-9 w-28 shrink-0 rounded-full animate-pulse" style="background: var(--cp-s2);"></div>
                  <div class="h-9 w-24 shrink-0 rounded-full animate-pulse" style="background: var(--cp-s2);"></div>
                  <div class="h-9 min-w-0 flex-1 rounded-full animate-pulse" style="background: var(--cp-s2);"></div>
                </div>
                <div class="pb-3 pt-3 lg:pb-4 lg:pt-4">
                  <div class="cp-map animate-pulse" style="background: var(--cp-s2);"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- The body, with the same paddings as the hydrated grid: one section card with its
               header, a row of chords and the "add chord" row, and the two side cards. -->
          <div class="mx-auto grid w-full max-w-[1440px] items-start gap-3 px-3 pb-10 pt-3 lg:min-h-0 lg:flex-1 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-stretch lg:gap-7 lg:px-8 lg:py-0" aria-hidden="true">
            <div class="flex min-w-0 flex-col gap-3 lg:pt-5">
              <div class="cp-sec">
                <div class="cp-sh">
                  <div class="h-10 w-32 rounded animate-pulse" style="background: var(--cp-s3);"></div>
                  <div class="ml-auto h-10 w-10 rounded animate-pulse" style="background: var(--cp-s3);"></div>
                </div>
                <div class="cp-grid">
                  <div class="h-16 rounded-xl animate-pulse lg:h-[76px]" style="background: var(--cp-s2);"></div>
                  <div class="h-16 rounded-xl animate-pulse lg:h-[76px]" style="background: var(--cp-s2);"></div>
                  <div class="h-16 rounded-xl animate-pulse lg:h-[76px]" style="background: var(--cp-s2);"></div>
                  <div class="h-16 rounded-xl animate-pulse lg:h-[76px]" style="background: var(--cp-s2);"></div>
                  <div class="h-10 rounded-xl animate-pulse" style="grid-column: span 2; background: var(--cp-s2);"></div>
                  <div class="hidden h-10 rounded-xl animate-pulse sm:block" style="grid-column: span 2; background: var(--cp-s2);"></div>
                </div>
              </div>
              <div class="h-12 rounded-xl animate-pulse" style="background: var(--cp-s2);"></div>
            </div>
            <div class="hidden flex-col gap-4 lg:flex lg:pt-5">
              <div class="cp-card h-[291px]"></div>
              <div class="cp-card h-[142px]"></div>
            </div>
          </div>
        </div>
      </div>
      <div id="editor-app" style="grid-area: 1 / 1; z-index: 1;">
        <EditorApp client:only="react" />
      </div>
    </div>
    <script>
      import { removeSkeletonOnHydrate } from '@/lib/hydrationSkeleton';

      removeSkeletonOnHydrate('editor-skeleton', 'editor-app');
    </script>

    <!--
      Fully visible on scroll, not gated behind a click — real content beats a closed
      accordion for both SEO (no reliance on Google expanding anything) and honesty with
      real visitors. It only shows up once someone scrolls past "Add Section" though, so
      it never competes with the tool itself for attention on load.

      Laid out as the redesign canvas draws it: no cards, an editorial column — eyebrow,
      heading, then the content — with a hairline rule between groups. Same copy as before.
    -->
    <div class="cp">
    <section aria-labelledby="chord-player-heading" class="cp-content mx-auto flex max-w-[1440px] flex-col gap-14 px-4 pb-16 pt-16 sm:px-8 lg:gap-[72px] lg:px-[120px] lg:pt-24">
      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-[72px]">
        <div class="flex flex-col gap-4">
          <span class="cp-eyebrow">The chord player</span>
          <!--
            The page's only H1. It lives here rather than above the editor on purpose: this page
            is the tool, and a hero band would push the app down for every returning visitor. Here
            it is server-rendered, visible at every breakpoint, and outside #editor-skeleton, so
            it is present both before and after hydration.
          -->
          <h1 id="chord-player-heading" class="text-[40px] font-extrabold leading-[1.02] tracking-[-0.03em] lg:text-[56px]">
            Online Chord Player
          </h1>
        </div>
        <div class="flex flex-col gap-3.5 lg:pt-2">
          <h2 class="text-[22px] font-extrabold tracking-[-0.01em]">What is a chord player?</h2>
          <p class="cp-lead">
            A chord is a group of notes played at the same time — like pressing a few piano keys
            together so they ring out as one sound. A chord player lets you pick a sequence of
            chords, choose a speed and a style, and hear them played back by drums, bass, piano,
            guitar and synth — like a full band playing your idea out loud. No sheet music
            and no instrument needed — just click and listen.
          </p>
        </div>
      </div>

      <!-- BUILDING YOUR PROGRESSION — a real sequence, so numbering earns its keep -->
      <div class="cp-rule flex flex-col gap-8 pt-10">
        <div class="flex flex-col gap-2.5">
          <span class="cp-eyebrow">Step by step</span>
          <h2 class="cp-h2">Building your progression</h2>
        </div>
        <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <li class="flex flex-col gap-3.5">
            <span class="cp-num">01</span>
            <p class="cp-body"><b>Pick a speed and a rhythm.</b> There are {WEB.rhythms}, from pop and rock to salsa and reggae — each with its own drums, bass and chords, so the same progression feels completely different.</p>
          </li>
          <li class="flex flex-col gap-3.5">
            <span class="cp-num">02</span>
            <p class="cp-body"><b>Add your chords.</b> <span class="cp-uc"><Plus className="cp-uc-i" />Add Chord</span> one at a time, <span class="cp-uc"><Sparkles className="cp-uc-i" />Suggest</span> for progressions real songs use — or a random one, and let the tool surprise you.</p>
          </li>
          <li class="flex flex-col gap-3.5">
            <span class="cp-num">03</span>
            <p class="cp-body"><b>Arrange them.</b> Drag any chord to reorder or remove it. Group them into parts with <span class="cp-uc"><Plus className="cp-uc-i" />Add Section</span> — like a verse and a chorus.</p>
          </li>
          <li class="flex flex-col gap-3.5">
            <span class="cp-num">04</span>
            <p class="cp-body"><b>Loop a section.</b> Hit <span class="cp-uc"><Repeat className="cp-uc-i" />Loop</span> on any section to keep just that part playing while you work on it.</p>
          </li>
        </ol>
      </div>

      <!-- SHAPING THE SOUND — independent tools, not a sequence, so a plain grid -->
      <div class="cp-rule flex flex-col gap-8 pt-10">
        <div class="flex flex-col gap-2.5">
          <span class="cp-eyebrow">Sound tools</span>
          <h2 class="cp-h2">Shaping the sound</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
          <div class="flex flex-col gap-3">
            <span class="cp-tl"><Music2 className="h-[18px] w-[18px]" /></span>
            <h3 class="text-base font-bold">Parts of the rhythm</h3>
            <p class="cp-body text-[13.5px]">Each section plays the rhythm's Intro, A, B or Ending. Tap the letter on a section to choose.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="cp-tl"><Grid3X3 className="h-[18px] w-[18px]" /></span>
            <h3 class="text-base font-bold">Edit Rhythm</h3>
            <p class="cp-body text-[13.5px]">Every part step by step for drums, piano, guitar, bass and synth, each with its own sound, plus a Fill. <span class="cp-uc"><Plus className="cp-uc-i" />New</span> builds one from scratch.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="cp-tl"><Sliders className="h-[18px] w-[18px]" /></span>
            <h3 class="text-base font-bold">Mixer</h3>
            <p class="cp-body text-[13.5px]">Volume, pan, mute and solo for each instrument, with its own EQ and compressor, and reverb for the whole mix.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="cp-tl"><Settings2 className="h-[18px] w-[18px]" /></span>
            <h3 class="text-base font-bold">Section options</h3>
            <p class="cp-body text-[13.5px]">Give a section a rhythm of its own, or switch any instrument off for it.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="cp-tl"><ArrowUpDown className="h-[18px] w-[18px]" /></span>
            <h3 class="text-base font-bold">Transpose</h3>
            <p class="cp-body text-[13.5px]">Shift every chord up or down at once, no retyping.</p>
          </div>
        </div>
      </div>

      <!-- SAVING & SHARING + USE CASES -->
      <div class="cp-rule grid gap-14 pt-10 lg:grid-cols-2 lg:gap-[72px]">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2.5">
            <span class="cp-eyebrow">Wrap up</span>
            <h2 class="cp-h2">Saving &amp; sharing</h2>
          </div>
          <div class="flex flex-col gap-[18px]">
            <div class="flex items-start gap-4">
              <span class="cp-tl"><Save className="h-[18px] w-[18px]" /></span>
              <div class="flex flex-col gap-1"><h3 class="text-base font-bold">Save</h3><p class="cp-body">Keeps your song in your library, ready to share by link. Free account required.</p></div>
            </div>
            <div class="flex items-start gap-4">
              <span class="cp-tl"><Download className="h-[18px] w-[18px]" /></span>
              <div class="flex flex-col gap-1"><h3 class="text-base font-bold">WAV and MIDI export</h3><p class="cp-body">A real audio file of your song, or its notes for your DAW.</p></div>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2.5">
            <span class="cp-eyebrow">Use cases</span>
            <h2 class="cp-h2">What it's for</h2>
          </div>
          <p class="cp-lead">
            Use it to find a new chord pattern for a song you're writing, make a backing track to
            sing or play along with, or just try the same chords in a different style — like turning
            a slow pop song into a fast rock one — before deciding which version you like best.
          </p>
        </div>
      </div>

      <!-- FAQ — individual accordions, closed by default: a reader scans 4 questions in
           seconds instead of 4 paragraphs sitting open whether they're relevant or not.
           Content stays in the DOM either way, so nothing is lost for crawlers. -->
      <div class="cp-rule grid items-start gap-6 pt-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-[72px]">
        <div class="flex flex-col gap-2.5">
          <span class="cp-eyebrow">Questions</span>
          <h2 class="cp-h2">FAQ</h2>
        </div>
        <div style="border-top: 1px solid var(--cp-ln);">
          {faqs.map((f) => (
            <details class="cp-faq group">
              <summary>
                {f.q}
                <svg class="h-[18px] w-[18px] shrink-0 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </summary>
              <p class="cp-body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <p class="cp-body text-[15px]">
        Need inspiration? <a href="/progressions/" class="font-bold no-underline hover:underline" style="color: var(--cp-act);">Browse chord progressions by genre →</a>
      </p>
    </section>
    </div>
  </div>
</BaseLayout>
