---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ChordFinderTool } from '../../components/ChordLookup/ChordFinderTool'
import { ChordIdentifier } from '../../components/ChordLookup/ChordIdentifier'

const faqs = [
  { q: 'How do I find out what chord I&rsquo;m playing?', a: 'Tap the shape you&rsquo;re holding on the fretboard at the top of this page &mdash; one fret per string, and leave the strings you&rsquo;re not playing muted. The chord name appears underneath. You don&rsquo;t need to know the root or the type first; that&rsquo;s what the tool works out for you.' },
  { q: 'Why does it sometimes show more than one chord name?', a: 'Because some chords genuinely share the same notes. C&ndash;E&ndash;G&ndash;A is both C6 and Am7 &mdash; which one it is depends on the musical context, not on the notes alone. The tool shows the most likely reading first and lists the alternatives underneath, using the lowest sounding string as a tie-breaker.' },
  { q: 'Does it handle inversions?', a: 'Yes. An inversion is the same chord with a different note at the bottom, so it keeps the same name — a C shape with E as its lowest note is still C, and the tool says which inversion it is. The lowest note is also used to decide between readings when a set of notes has more than one name.' },
  { q: 'What if I&rsquo;m not fretting every note of the chord?', a: 'That still works for the fifth and for upper extensions &mdash; a C7 without its fifth is still identified as C7, and it says &ldquo;no 5&rdquo; so you know what was left out. The third and the seventh are what define a chord, so those are never assumed. This comes up constantly on guitar, where there simply aren&rsquo;t enough fingers for every note.' },
  { q: 'What do the numbers on the dots mean?', a: 'They tell you which finger of your fretting hand to use: 1 = index, 2 = middle, 3 = ring, 4 = pinky. A long pill across several strings is a barre — one finger pressing them all at once.' },
  { q: 'What do the &#215; and &#9675; symbols above the strings mean?', a: 'A cross (&#215;) means that string should not be played. A circle (&#9675;) means the string is played open, without pressing any fret.' },
  { q: 'What does a label like "3fr" next to the diagram mean?', a: 'By default the second horizontal line from the top is the first fret. When you see "3fr", the diagram starts at the third fret instead — the chord is played higher up the neck.' },
  { q: 'Why are there several positions for the same chord?', a: 'Most chords can be played in different places on the neck. The most common shape is shown first; click any thumbnail under "Positions" to see an alternative voicing with its own fingering.' },
  { q: "Can I use it if I'm left-handed?", a: 'Yes — click the "Left-handed" button above the diagram and every chord is mirrored for a left-handed guitar.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/guitar-chord-lookup/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Finder', item: 'https://chordsequence.com/chord-lookup/' },
    { '@type': 'ListItem', position: 3, name: 'Guitar Chord Identifier & Finder', item: 'https://chordsequence.com/guitar-chord-lookup/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Guitar Chord Identifier & Finder',
  url: 'https://chordsequence.com/guitar-chord-lookup/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Tap the shape you are fretting and get the chord name, inversions included — or look up any guitar chord in standard tuning with real fingerings, barre chords and alternative positions along the neck.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Guitar Chord Identifier & Finder — Name Any Chord You Play"
  description="Tap the shape you're holding and get the chord name — inversions included. Or go the other way: pick a chord and see the fingering."
  canonicalUrl="https://chordsequence.com/guitar-chord-lookup/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#f7f5fb;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#241d33">
    <div style="min-height:100vh;padding:24px 20px 64px;box-sizing:border-box">
      <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;gap:18px">
        <header style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/chord-lookup/" style="font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#7C3AED">&larr; Chord Finder</a>
            <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.6px">Guitar Chord Identifier</h1>
            <p style="margin:0;font-size:15.5px;color:#6f6788;max-width:620px">Tap the shape you&rsquo;re holding and we&rsquo;ll name the chord &mdash; or look up any chord to see its fingering.</p>
          </div>
          <div style="display:inline-flex;background:#ece6f7;border-radius:12px;padding:4px;gap:2px">
            <span style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;background:#ffffff;color:#241d33;box-shadow:0 1px 3px rgba(30,20,60,0.18)">Guitar</span>
            <a href="/piano-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Piano</a>
            <a href="/ukulele-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Ukulele</a>
          </div>
        </header>

        <!--
          Identificador arriba y buscador debajo, los dos siempre renderizados. No son
          pestanas a proposito: React no montaria la inactiva y ese contenido desapareceria
          del HTML servido.
        -->

        <ChordIdentifier instrument="guitar" client:load />

        <div style="display:flex;flex-direction:column;gap:6px;margin-top:6px">

          <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Find any guitar chord</h2>

          <p style="margin:0;font-size:14.5px;color:#6f6788;max-width:620px">Know the chord name already? Pick a root and a type to see the fingering, barre chords and positions along the neck.</p>

        </div>

        <ChordFinderTool instrument="guitar" client:load />

        <section style="background:#ffffff;border:1px solid #e7e0f2;border-radius:18px;padding:26px 28px;display:flex;flex-direction:column;gap:20px;box-shadow:0 1px 4px rgba(40,25,80,0.05)">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">About the guitar chord finder</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">A visual dictionary of guitar chords in standard EADGBE tuning. Pick any of the 12 root notes and 30 chord types — from an open C major to a Cmaj13 — and see the chord on a fretboard diagram: numbered dots for each finger, barres drawn as pills, &#215; for muted strings and &#9675; for open ones, plus the note each string sounds.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">Most chords include several voicings: the common open or low shape first, then alternatives higher up the neck. Press Play to hear the chord string by string and then strummed together. A left-handed mode mirrors every diagram.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Guitar chord FAQs</h2>
            <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
              {faqs.map((f) => (
                <details style="border:1px solid #e7e0f2;border-radius:12px;padding:13px 18px">
                  <summary style="font-size:14.5px;font-weight:600;cursor:pointer" set:html={f.q} />
                  <p style="margin:10px 0 2px;font-size:14px;line-height:1.6;color:#4c4462" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        </section>

        <footer style="font-size:13px;color:#8a819e;display:flex;gap:8px;flex-wrap:wrap">
          <span>Also available:</span>
          <a href="/piano-chord-lookup/" style="color:#7C3AED">Piano chord finder</a> &middot;
          <a href="/ukulele-chord-lookup/" style="color:#7C3AED">Ukulele chord finder</a> &middot;
          <a href="/chord-lookup/" style="color:#7C3AED">All instruments</a>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>
