---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ChordFinderTool } from '../../components/ChordLookup/ChordFinderTool'

// Sin JSON-LD de FAQPage a proposito: Google restringio los resultados enriquecidos de FAQ
// a sitios de administracion publica y salud en agosto de 2023 y este sitio no cualifica.
// El contenido visible de las FAQ si se queda; lo que no puede volver es el schema.
const faqs = [
  { q: 'How do I find out what chord I&rsquo;m playing on the guitar?', a: 'Switch to &ldquo;Notes &rarr; name&rdquo; and click the fret you&rsquo;re holding on each string of the fretboard; the circle by the nut plays that string open and the &times; clears it. With three or more notes we name the chord, and tell you whether it matches a standard shape.' },
  { q: 'Can I just type the chord name?', a: 'Yes. The search box takes almost any spelling &mdash; <strong>Cmaj7</strong>, <strong>CM7</strong>, <strong>C-7</strong>, <strong>F#m7b5</strong>, <strong>Bb sus4</strong>, even solf&egrave;ge like <strong>sol7</strong> or <strong>do menor</strong>. Press <strong>/</strong> to jump straight to it, use &uarr;&darr; to pick a suggestion and &crarr; to load it.' },
  { q: 'What do the numbers on the dots mean?', a: 'They tell you which finger of your fretting hand to use: 1 = index, 2 = middle, 3 = ring, 4 = pinky. A long pill across several strings is a barre &mdash; one finger pressing them all at once.' },
  { q: 'What do the &#215; and &#9675; symbols above the strings mean?', a: 'A cross (&#215;) means that string should not be played. A circle (&#9675;) means the string is played open, without pressing any fret.' },
  { q: 'How does the capo work?', a: 'Pick a capo position and everything is recalculated: the chord you asked for is shown as the shape you actually play (capo 2 + a G shape sounds as A), and the fret numbers are counted <strong>from the capo</strong>, the way tab with a capo is written. <strong>Lower</strong> and <strong>Higher</strong> slide capo and shape together, so the shape stays the same while the chord transposes.' },
  { q: 'Why are there fewer positions when I add a capo?', a: 'Because with a capo you are playing a different shape. With a capo on the 1st fret a C is played with B shapes, and there are fewer stored B shapes than C shapes &mdash; the &ldquo;Positions&rdquo; heading tells you which shapes you are looking at.' },
  { q: 'What does a label like &ldquo;3fr&rdquo; next to the diagram mean?', a: 'By default the second horizontal line from the top is the first fret. When you see &ldquo;3fr&rdquo;, the diagram starts at the third fret instead &mdash; the chord is played higher up the neck. With a capo on, that count starts at the capo.' },
  { q: 'Why are there several positions for the same chord?', a: 'Most chords can be played in different places on the neck. The most common shape is shown first; click any thumbnail under &ldquo;Positions&rdquo; to see an alternative voicing with its own fingering.' },
  { q: 'Can I use it if I&rsquo;m left-handed?', a: 'Yes &mdash; click the &ldquo;Left-handed&rdquo; button and every diagram and the fretboard are mirrored. Your choice is remembered when you move between instruments.' },
  { q: 'Can I hear the chord?', a: 'Press &ldquo;Play chord&rdquo; or hit the spacebar: each note sounds string by string, lighting up as it plays, then the whole chord together. With a capo on, you hear the real pitches, not the shape.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/guitar-chord-lookup/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Lookup', item: 'https://chordsequence.com/chord-lookup/' },
    { '@type': 'ListItem', position: 3, name: 'Guitar Chord Lookup', item: 'https://chordsequence.com/guitar-chord-lookup/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Guitar Chord Lookup',
  url: 'https://chordsequence.com/guitar-chord-lookup/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Find any guitar chord with real fingerings, capo support and positions along the neck — or click the frets you are playing and we name the chord.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Guitar Chord Lookup — Find Any Guitar Chord on the Fretboard"
  description="Guitar chord lookup, both ways: find any guitar chord with real fingerings, capo support and positions along the neck — or click the frets you are playing and we name the chord."
  canonicalUrl="https://chordsequence.com/guitar-chord-lookup/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#f7f5fb;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#241d33">
    <div class="cl-page" style="min-height:100vh;box-sizing:border-box">
      <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;gap:18px">
        <header style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/chord-lookup/" style="font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#7C3AED">&larr; Chord Lookup</a>
            <h1 class="cl-h1" style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;letter-spacing:-0.6px">Guitar Chord Lookup</h1>
            <p style="margin:0;font-size:15.5px;color:#6f6788;max-width:620px;text-wrap:pretty">Find any guitar chord from the fretboard &mdash; or go the other way: click the frets you&rsquo;re playing and we name the chord.</p>
          </div>
          <div class="cl-switch" style="background:#ece6f7;border-radius:12px;padding:4px;gap:2px">
            <span style="border-radius:9px;font-size:14px;font-weight:600;background:#ffffff;color:#241d33;box-shadow:0 1px 3px rgba(30,20,60,0.18)">Guitar</span>
            <a href="/piano-chord-lookup/" style="border-radius:9px;font-size:14px;font-weight:600;color:#6f6788">Piano</a>
            <a href="/ukulele-chord-lookup/" style="border-radius:9px;font-size:14px;font-weight:600;color:#6f6788">Ukulele</a>
          </div>
        </header>

        <ChordFinderTool instrument="guitar" client:load />

        <section class="cl-card" style="background:#ffffff;border:1px solid #e7e0f2;border-radius:18px;display:flex;flex-direction:column;gap:20px;box-shadow:0 1px 4px rgba(40,25,80,0.05)">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h2 class="cl-h2" style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;letter-spacing:-0.3px">About the guitar chord lookup</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">A visual dictionary of guitar chords in standard EADGBE tuning. Search a chord by name, or pick any of the 12 root notes and 30 chord types &mdash; from an open C major to a Cmaj13 &mdash; and see the chord on a fretboard diagram: numbered dots for each finger, barres drawn as pills, &#215; for muted strings and &#9675; for open ones, plus the note each string sounds.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">Most chords include several voicings: the common open or low shape first, then alternatives higher up the neck. Press Play to hear the chord string by string and then strummed together. A left-handed mode mirrors every diagram, and a capo setting recalculates everything: the shape you actually play, the fret numbers counted from the capo, and the pitches you hear.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">It also works in reverse. Switch to <strong style="font-weight:700">Notes &rarr; name</strong> and click the fret you&rsquo;re holding on each string of a full 15-fret fretboard; the circle by the nut plays a string open and the &times; clears it. On a phone the neck is shown a few frets at a time, with arrows to move up and down it &mdash; and it follows the frets you press on its own. With three or more notes we name the chord and tell you if it matches a standard shape &mdash; order and octave are irrelevant, so any voicing of Do, Mi and Sol is simply C major. <strong style="font-weight:700">Lower</strong> and <strong style="font-weight:700">Higher</strong> slide the whole thing, capo included, up or down the neck.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <h2 class="cl-h2" style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;letter-spacing:-0.3px">Guitar chord FAQs</h2>
            <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
              {faqs.map((f) => (
                <details style="border:1px solid #e7e0f2;border-radius:12px;padding:13px 18px">
                  <summary style="font-size:14.5px;font-weight:600;cursor:pointer" set:html={f.q} />
                  <p style="margin:10px 0 2px;font-size:14px;line-height:1.6;color:#4c4462" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        </section>

        <footer style="font-size:13px;color:#8a819e;display:flex;gap:8px;flex-wrap:wrap">
          <span>Also available:</span>
          <a href="/piano-chord-lookup/" style="color:#7C3AED">Piano chord lookup</a> &middot;
          <a href="/ukulele-chord-lookup/" style="color:#7C3AED">Ukulele chord lookup</a> &middot;
          <a href="/chord-lookup/" style="color:#7C3AED">All instruments</a>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* El resto de la pagina va con estilos en linea, pero los margenes y la tipografia si
     necesitan puntos de ruptura, y un atributo `style` no admite media queries. */
  .cl-page { padding: clamp(14px, 4vw, 24px) clamp(12px, 4vw, 20px) 48px; }
  .cl-h1 { font-size: clamp(23px, 6.2vw, 32px); }
  .cl-h2 { font-size: clamp(18px, 4.6vw, 21px); }
  .cl-card { padding: clamp(18px, 5vw, 28px); }

  .cl-switch { display: inline-flex; }
  .cl-switch > * { padding: 10px 22px; text-align: center; }
  /* Los tres instrumentos ocupaban ~300px fijos y empujaban la cabecera a dos filas; en
     pantalla estrecha pasan a repartirse el ancho entero. */
  @media (max-width: 560px) {
    .cl-switch { display: flex; width: 100%; }
    .cl-switch > * { flex: 1; padding: 11px 8px; }
  }
</style>
