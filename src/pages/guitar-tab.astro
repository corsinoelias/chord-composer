---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GuitarTabPlayer } from '../components/GuitarTabPlayer/GuitarTabPlayer';

// Same pairing as /bass-tab/ — see that file for the full rationale. This route is the
// `client:only` editor shell (no H1, no headings, no internal links in the served HTML);
// /tools/guitar-tab/ is the landing page that links here and is the one meant to rank.
// Kept out of the sitemap via SITEMAP_EXCLUDED_PATHS in astro.config.mjs.
const CANONICAL_URL = 'https://chordsequence.com/tools/guitar-tab/';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Guitar Tab Player',
  url: CANONICAL_URL,
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online 6-string guitar tablature editor. Draw notes on any string and fret, drag to move, resize to change duration, and hear playback in real time.',
  featureList: [
    'Draw notes on any string and fret (6 strings)',
    'Drag to reposition, resize to change duration',
    'Real-time audio playback',
    'Multiple guitar sounds: Acoustic, Nylon, Clean, Synth',
    'Capo support (frets 0–7)',
    'Chord Helper — insert full chords in one click',
    'ASCII tab export',
    'MIDI export',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://chordsequence.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Guitar Tab Player', item: CANONICAL_URL },
  ],
};
---

<BaseLayout
  title="Guitar Tab Player — 6-String Guitar Tablature Editor"
  description="Free online 6-string guitar tablature editor. Draw notes, insert chords with one click, capo support, multiple sounds. No signup required."
  canonicalUrl={CANONICAL_URL}
  showNav={false}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <GuitarTabPlayer client:only="react" />
</BaseLayout>
