---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHORS } from '../../data/authors';
import AppCta from '../../components/AppCta.astro';

const author = AUTHORS['elias-corsino'];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://chordsequence.com/about/elias-corsino/#person',
  name: author.name,
  url: author.url,
  jobTitle: author.role,
  description: author.bio,
  image: {
    '@type': 'ImageObject',
    '@id': 'https://chordsequence.com/images/elias-corsino.jpg',
    url: 'https://chordsequence.com/images/elias-corsino.jpg',
    width: 400,
    height: 400,
  },
  nationality: { '@type': 'Country', name: 'Dominican Republic' },
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://codiflash.com/#organization',
    name: 'CodiFlash',
    url: 'https://codiflash.com',
  },
  founder: {
    '@type': 'Organization',
    '@id': 'https://chordsequence.com/#organization',
    name: 'Chord Sequence',
    url: 'https://chordsequence.com',
  },
  sameAs: [
    author.linkedin,
    author.instagram,
    author.youtube,
    'https://github.com/codiflash',
    'https://www.fiverr.com/eliascorsino',
    'https://codiflash.com/en/about/',
  ],
  knowsAbout: [
    'Music Theory', 'Chord Progressions', 'Piano', 'Bass Guitar',
    'Guitar', 'Drums', 'Software Development', 'Web Development',
    'SharePoint', 'Microsoft 365',
  ],
};

const videoSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Elías Corsino Playing Bass Guitar',
    description: 'Elías Corsino playing bass guitar — musician and creator of Chord Sequence.',
    thumbnailUrl: 'https://img.youtube.com/vi/lblASojOL-w/maxresdefault.jpg',
    embedUrl: 'https://www.youtube-nocookie.com/embed/lblASojOL-w',
    contentUrl: 'https://www.youtube.com/watch?v=lblASojOL-w',
    url: 'https://www.youtube.com/watch?v=lblASojOL-w',
    uploadDate: '2021-02-16T00:00:00+00:00',
    author: {
      '@type': 'Person',
      '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Elías Corsino Bass Performance',
    description: 'Elías Corsino bass performance — musician and creator of Chord Sequence.',
    thumbnailUrl: 'https://img.youtube.com/vi/obW-ymxaBbI/maxresdefault.jpg',
    embedUrl: 'https://www.youtube-nocookie.com/embed/obW-ymxaBbI',
    contentUrl: 'https://www.youtube.com/watch?v=obW-ymxaBbI',
    url: 'https://www.youtube.com/watch?v=obW-ymxaBbI',
    uploadDate: '2022-01-20T00:00:00+00:00',
    author: {
      '@type': 'Person',
      '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    },
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/about/elias-corsino/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://chordsequence.com/about/' },
    { '@type': 'ListItem', position: 3, name: author.name, item: 'https://chordsequence.com/about/elias-corsino/' },
  ],
};

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://chordsequence.com/about/elias-corsino/#webpage',
  url: 'https://chordsequence.com/about/elias-corsino/',
  name: `${author.name} — Musician & Developer | Chord Sequence`,
  description: author.bio,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://chordsequence.com/#website',
    url: 'https://chordsequence.com/',
  },
  about: {
    '@type': 'Person',
    '@id': 'https://chordsequence.com/about/elias-corsino/#person',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    '@id': 'https://chordsequence.com/about/elias-corsino/#breadcrumb',
  },
};
---

<BaseLayout
  title={`${author.name} — Musician & Developer | Chord Sequence`}
  description={`${author.name} is a musician and developer from the Dominican Republic who built Chord Sequence to make music theory accessible to everyone.`}
  canonicalUrl="https://chordsequence.com/about/elias-corsino/"
  ogImage="https://chordsequence.com/images/elias-corsino.jpg"
  ogImageAlt={`${author.name} — Musician & Software Developer`}
  author={author.name}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
    {videoSchemas.map((vs) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(vs)} />
    ))}
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 pt-4 pb-16 sm:pt-8 sm:pb-24">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-3 sm:mb-4">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/about/" class="hover:text-foreground transition-colors">About</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">{author.name}</span>
    </nav>

    <div class="flex items-center gap-6 mb-12">
      <img
        src={author.avatar}
        alt={`${author.name} playing bass guitar`}
        class="w-24 h-24 rounded-full object-cover shrink-0 ring-2 ring-primary/20"
        width="96"
        height="96"
        fetchpriority="high"
      />
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold text-foreground tracking-tight">{author.name}</h1>
        <p class="text-muted-foreground mt-1">{author.role}</p>
        <div class="flex items-center gap-3 mt-3">
          <a
            href={author.linkedin}
            target="_blank"
            rel="noopener noreferrer me"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1"
          >
            LinkedIn ↗
          </a>
          <a
            href={author.instagram}
            target="_blank"
            rel="noopener noreferrer me"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1"
          >
            Instagram ↗
          </a>
          <a
            href={author.youtube}
            target="_blank"
            rel="noopener noreferrer me"
            class="text-xs font-medium text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1"
          >
            YouTube ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
      {[
        { value: '12', label: 'age he started' },
        { value: '4', label: 'instruments' },
        { value: '4', label: 'genres played' },
        { value: '1', label: 'app built' },
      ].map(({ value, label }) => (
        <div class="rounded-xl border border-border bg-card/40 px-4 py-5 text-center">
          <p class="text-3xl font-bold text-foreground">{value}</p>
          <p class="text-xs text-muted-foreground mt-1">{label}</p>
        </div>
      ))}
    </div>

    <div class="prose prose-invert max-w-none space-y-6 text-muted-foreground leading-relaxed">
      <p>
        At 12, Elías heard someone play a chord on piano. Not a song — just the chord, hanging
        in the air. Something clicked that didn't unclick. He's been chasing that feeling across
        four instruments ever since.
      </p>

      <p>
        Piano came first, then bass, guitar, and drums — each one because he wanted to understand
        harmony from a different angle. Not collect instruments, just hear things differently.
      </p>

      <p>
        Bass became the main one. Partly by accident — bands always need a bassist — but it
        turned out to be the best music theory class he never paid for. The bass player can't
        hide. You have to know <em>exactly</em> which chord is happening, where the root sits,
        and what's coming next. Get that wrong, and the whole band notices.
      </p>

      <p>
        Years of playing pop, R&amp;B, worship, and jazz in real bands made chord progressions
        feel less like theory and more like a language. The kind you stop translating in your
        head and just start speaking.
      </p>

      <blockquote class="not-prose border-l-4 border-primary/40 pl-5 py-1 my-8">
        <p class="text-lg text-foreground/80 italic leading-relaxed">
          "Every article on this site was written with a bass in my hands at some point."
        </p>
      </blockquote>

      <p>
        The frustrating part was that every tool for learning chord progressions was built for
        people who already knew a lot. Too academic, or too shallow. He wanted something you
        could open in a browser, drop in a ii–V–I, and <em>hear</em> what the theory actually
        sounds like — in thirty seconds, no account, no tutorial. So he built{' '}
        <strong class="text-foreground">Chord Sequence</strong>.
      </p>

      <h2 class="text-2xl font-bold text-foreground mt-10 mb-6">The Instruments</h2>

      <div class="not-prose grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          {
            name: 'Piano',
            icon: '🎹',
            desc: 'Where it started. All voices at once — harmony as a whole picture, nothing hidden.',
          },
          {
            name: 'Bass',
            icon: '🎸',
            desc: 'Main instrument. Forces you to understand roots, movement, and intention — or the whole band falls apart.',
          },
          {
            name: 'Guitar',
            icon: '🎵',
            desc: 'The humbling one. Same chord, twelve different voicings, each with its own personality.',
          },
          {
            name: 'Drums',
            icon: '🥁',
            desc: 'The reason progressions feel alive instead of academic. Rhythm is where theory becomes music.',
          },
        ].map(({ name, icon, desc }) => (
          <div class="rounded-xl border border-border bg-card/40 p-5">
            <p class="text-2xl mb-2">{icon}</p>
            <p class="font-semibold text-foreground mb-1">{name}</p>
            <p class="text-sm text-muted-foreground leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-foreground mt-10 mb-6">Watch Me Play</h2>
      <div class="not-prose grid gap-6">
        <div>
          <div class="relative aspect-video w-full rounded-xl overflow-hidden bg-black/30">
            <iframe
              src="https://www.youtube-nocookie.com/embed/lblASojOL-w"
              title="Elías Corsino playing bass guitar"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>
        </div>
        <div>
          <div class="relative aspect-video w-full rounded-xl overflow-hidden bg-black/30">
            <iframe
              src="https://www.youtube-nocookie.com/embed/obW-ymxaBbI"
              title="Elías Corsino bass performance"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-foreground mt-10 mb-4">About Chord Sequence</h2>
      <p>
        Chord Sequence is a free, browser-based chord progression builder — no account, no
        install, no credit card. Open it, add chords, hit play. It supports 37 chord types,
        13+ rhythm styles with real audio samples, real-time transposition, and WAV export
        ready to drop into any DAW.
      </p>
      <p>
        Everything runs in your browser. Your progressions stay in local storage until you
        export them — nothing is sent anywhere. It works offline after the first load.
      </p>
    </div>

    <AppCta
      class="mt-12"
      heading="Try the app Elías built"
      description="Free, no account needed. Build chord progressions and hear them instantly."
    />
  </main>
</BaseLayout>
