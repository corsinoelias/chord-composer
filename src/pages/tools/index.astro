---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCta from '../../components/AppCta.astro';

const SITE = 'https://chordsequence.com'

const tools = [
  {
    title: 'Guitar Scale Chart',
    desc: 'Visualize any scale on a guitar fretboard. Choose from 277 scales and modes — Major, Pentatonic, Blues, Church Modes, Melodic Minor, and more. Hear the scale with BPM playback and navigate multiple neck positions.',
    href: '/tools/scales/',
    keywords: 'guitar scale chart, fretboard, scale positions, pentatonic, major scale',
  },
  {
    title: 'Circle of Fifths',
    desc: 'Interactive Circle of Fifths. Click any key to instantly see its diatonic chords, relative minor, and neighbouring key relationships.',
    href: '/tools/circle-of-fifths/',
    keywords: 'circle of fifths, key relationships, diatonic chords',
  },
  {
    title: 'Chord Transposer',
    desc: 'Shift any chord progression to any key in one click. Perfect for finding the right key for your voice or instrument.',
    href: '/tools/chord-transposer/',
    keywords: 'transpose chords, change key, chord transposition',
  },
  {
    title: 'Key Detector',
    desc: 'Enter a progression and detect the musical key it belongs to. Understand the tonal center of any chord sequence.',
    href: '/tools/key-detector/',
    keywords: 'key detector, find key, musical key',
  },
  {
    title: 'Bass Guitar Tab Player',
    desc: 'Play, learn and create 4-string bass tabs in your browser. Real-time playback, drag & resize notes, Tab/Grid/Bass views, and 10+ preset songs including Billie Jean and Beat It.',
    href: '/tools/bass-guitar-tab/',
    keywords: 'bass tab, bass guitar tablature, bass tab player',
  },
  {
    title: 'Guitar Tab Player',
    desc: 'Play, learn and create 6-string guitar tabs in your browser. Draw notes on any string and fret, chord helper for one-click chords, capo support, and real-time playback.',
    href: '/tools/guitar-tab/',
    keywords: 'guitar tab, guitar tablature, guitar tab editor',
  },
  {
    title: 'Online Tuner',
    desc: 'Free chromatic tuner — use your device microphone to tune guitar, bass, ukulele, violin and more. Real-time needle display with note name and cents deviation.',
    href: '/tuner/',
    keywords: 'online tuner, chromatic tuner, guitar tuner, bass tuner',
  },
  {
    title: 'Online Metronome',
    desc: 'Free online metronome with tap tempo, beats per measure (1–8), and keyboard shortcuts. Web Audio precision — no drift, no install.',
    href: '/metronome/',
    keywords: 'online metronome, free metronome, tap tempo, BPM tool',
  },
  {
    title: 'Online Drum Machine',
    desc: 'Free 16-step drum machine with 3 kits and 12 genre presets — house, trap, hip-hop, afrobeat and more. No signup required.',
    href: '/tools/drum-machine/',
    keywords: 'online drum machine, drum machine, beat maker, 16-step sequencer',
  },
];

const toolsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free Music Theory Tools',
  description: 'Free online music tools for songwriters and musicians.',
  url: `${SITE}/tools/`,
  numberOfItems: tools.length,
  itemListElement: tools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.title,
      description: t.desc,
      url: `${SITE}${t.href}`,
      applicationCategory: 'MusicApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  })),
}
---

<BaseLayout
  title="Free Music Theory Tools — Chord Transposer, Key Detector & More | Chord Sequence"
  description="Free online music tools for songwriters and musicians. Chord transposer, chord finder, key detector, chord generator, and Roman numeral analyzer."
  canonicalUrl="https://chordsequence.com/tools/"
  ogImage="/og/page/tools/"
  ogImageAlt="Free Music Tools | Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(toolsSchema)} />
  </Fragment>
  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="mb-14 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Free music theory tools
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">
        Online tools for every stage of the songwriting process. Free, instant, and no signup required.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {tools.map((t) => (
        <a
          href={t.href}
          class="group flex flex-col rounded-xl border border-border bg-card p-6 hover:border-primary/50 transition-colors"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h2 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">{t.title}</h2>
            <svg class="h-5 w-5 text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">{t.desc}</p>
          <p class="mt-4 text-xs text-muted-foreground/60">{t.keywords}</p>
        </a>
      ))}
    </div>

    <!-- Related reading -->
    <div class="mt-12 pt-10 border-t border-border">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Related reading</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { href: '/learn/how-to-transpose-chords/', title: 'How to transpose chords', desc: 'The theory behind the Transposer — semitones, keys, and practical tips' },
          { href: '/learn/circle-of-fifths-explained/', title: 'Circle of fifths explained', desc: 'Key signatures, relative minors, and how jazz follows the circle' },
          { href: '/learn/music-theory-basics-for-songwriters/', title: 'Music theory basics', desc: 'Intervals, scales, diatonic chords — everything you need to know' },
          { href: '/best-chord-progression-generators/', title: 'Best chord progression generators', desc: '6 free and paid tools compared — browser apps and DAW plugins for 2026' },
        ].map((a) => (
          <a href={a.href} class="group rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:bg-primary/5 transition-colors">
            <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors mb-1">{a.title}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{a.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <AppCta
      class="mt-12"
      heading="Need the full editor?"
      description="Combine all these tools in the Chord Player — drag chords, pick styles, and export to WAV."
    />
  </main>
</BaseLayout>
