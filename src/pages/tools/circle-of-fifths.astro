---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CircleOfFifths } from '../../components/CircleOfFifths';
import RelatedTools from '../../components/RelatedTools.astro';
import AppCta from '../../components/AppCta.astro';

const faqs = [
  {
    q: 'What is the Circle of Fifths used for?',
    a: 'It maps how the 12 major and minor keys relate to each other, arranged so that each step clockwise or counterclockwise adds one sharp or flat. Musicians use it to find closely related keys for modulation, to build chord progressions that sound natural, and to quickly work out a key signature without memorizing it.',
  },
  {
    q: 'How do I use the Circle of Fifths to transpose a song?',
    a: 'Find your current key on the circle, then find the target key. The number of steps between them tells you how many sharps or flats you are adding or removing — every chord in the progression shifts by the same interval. The Chord Transposer tool does this shift automatically if you would rather not do it by hand.',
  },
  {
    q: 'Why are major and minor keys shown on the same circle?',
    a: 'Every major key has a relative minor that shares the exact same key signature — for example C major and A minor both use no sharps or flats. The outer ring on this chart shows the major keys and the inner ring shows their relative minors directly across from them.',
  },
  {
    q: 'What are the closest related keys to any given key?',
    a: 'The two keys directly next to a key on the circle — one clockwise (its dominant, V) and one counterclockwise (its subdominant, IV) — share six of seven diatonic chords with it. That overlap is why moving between neighboring keys sounds smooth, and why so many songs modulate up a fourth or fifth.',
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Circle of Fifths — Interactive Chart',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: 'https://chordsequence.com/tools/circle-of-fifths/',
  description: 'Free interactive Circle of Fifths. Click any key to see its diatonic chords, relative minor, parallel minor, and chord functions.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/tools/circle-of-fifths/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://chordsequence.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Circle of Fifths', item: 'https://chordsequence.com/tools/circle-of-fifths/' },
  ],
};
---

<BaseLayout
  title="Circle of Fifths — Interactive Chart | Chord Sequence"
  description="Free interactive Circle of Fifths chart. Click any key to instantly see its diatonic chords, relative minor, and parallel minor. No signup required."
  canonicalUrl="https://chordsequence.com/tools/circle-of-fifths/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 sm:px-6 py-12 sm:py-20">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-10">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/tools/" class="hover:text-foreground transition-colors">Tools</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">Circle of Fifths</span>
    </nav>

    <!-- Header -->
    <div class="mb-12 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Circle of Fifths
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">
        Click any key to see its diatonic chords, relative minor, and how it relates to neighbouring keys.
      </p>
    </div>

    <!-- Interactive chart -->
    <div class="flex justify-center">
      <div class="w-full max-w-xl">
        <CircleOfFifths client:load />
      </div>
    </div>

    <!-- Explainer -->
    <section class="mt-20 prose prose-invert max-w-none">
      <h2 class="text-2xl font-bold text-foreground mb-6">What is the Circle of Fifths?</h2>
      <p class="text-sm text-muted-foreground leading-relaxed mb-8 max-w-2xl">
        The Circle of Fifths is a diagram of all 12 major keys (and their relative minors) arranged by how closely
        they're related — each step around the circle adds or removes exactly one sharp or flat. It was originally
        a way to visualize key signatures, but songwriters and producers use it for a lot more: finding a key to
        modulate into that will sound natural, building chord progressions from a key's diatonic chords, and
        understanding at a glance why certain chord changes feel smooth while others feel jarring.
      </p>
      <div class="grid sm:grid-cols-2 gap-8">
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-semibold text-foreground mb-2">How to read it</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Moving <strong class="text-foreground">clockwise</strong> by one step adds a sharp to the key signature —
            C → G → D → A and so on. Moving <strong class="text-foreground">counterclockwise</strong> adds a flat.
            Keys next to each other share six of their seven diatonic chords, making modulation between them sound natural.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-semibold text-foreground mb-2">Outer vs inner ring</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            The <strong class="text-foreground">outer ring</strong> shows major keys.
            The <strong class="text-foreground">inner ring</strong> shows their relative minors — they share the exact same notes
            but with a different tonal centre. For example, C major and A minor both use C D E F G A B.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-semibold text-foreground mb-2">IV and V highlighted</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            When you select a key, the circle highlights its <strong class="text-foreground">dominant (V)</strong> one step clockwise
            and its <strong class="text-foreground">subdominant (IV)</strong> one step counterclockwise.
            These are the three most closely related keys — the foundation of Western harmony.
          </p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="font-semibold text-foreground mb-2">Use it for songwriting</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Pick a key, read off the diatonic chords, and you have a palette of chords that sound great together.
            Click any chord in the table to open it in the editor, or use the <strong class="text-foreground">I–vi–IV–V</strong> button
            to load the most popular pop progression instantly.
          </p>
        </div>
      </div>
    </section>

    <AppCta
      class="mt-16"
      heading="Build a progression from your key"
      description="Pick chords from the table above and arrange them in the Chord Player — add rhythm, transpose, and export to WAV."
    />

    <!-- FAQ -->
    <section class="py-16">
      <div class="mx-auto max-w-3xl px-0 sm:px-0">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-8">Frequently asked questions</h2>
        <div class="space-y-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-card p-6">
              <h3 class="font-semibold text-foreground mb-2">{f.q}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED TOOLS -->
    <RelatedTools tools={[
      { href: '/tools/chord-transposer/', icon: 'transpose', label: 'Chord Transposer', desc: 'Move a chord progression to any key — shift by semitones in real time.' },
      { href: '/tools/key-detector/', icon: 'key', label: 'Key Detector', desc: 'Identify the key of any chord progression using diatonic analysis.' },
      { href: '/app/', icon: 'chords', label: 'Chord Player', desc: 'Load diatonic chords from the circle and hear them played back instantly.' },
    ]} />

    <!-- Related reading -->
    <div class="mt-16 pt-8 border-t border-border">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Related reading</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/learn/circle-of-fifths-explained/" class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-muted-foreground mb-1">Deep dive</p>
            <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Circle of fifths explained</p>
            <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">Key signatures, relative minors, and how jazz progressions follow the circle</p>
          </div>
        </a>
        <a href="/learn/jazz-chord-progressions/" class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-muted-foreground mb-1">Progressions</p>
            <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Jazz chord progressions</p>
            <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">How the circle of fifths directly shapes ii–V–I movement in jazz</p>
          </div>
        </a>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a href="/tools/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← Back to all tools</a>
    </div>

  </main>
</BaseLayout>
