---
// Not prerendered — the "fork someone else's chart" section reads live published charts
// from Supabase via getPublishedChordSheets(), same live-data pattern as
// src/pages/songs/index.astro, but its own table: Chord Sheet Maker is a standalone
// product (own account-backed library, own routes under /chord-sheet-maker/), not part
// of the Songs feature. It shares no data with /songs/ — a chart made here has no tempo
// or arrangement, so it never touches public_songs (see supabase/migrations/
// 20260901_chord_sheets.sql for why that split matters).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedChordSheets } from '@/lib/chordSheets';
import { getPublishedSongs } from '@/lib/publicSongs';
import { songToSheetSeed } from '@/lib/chordSheet/songToSheet';
import { parseSheet, uniqueChords } from '@/lib/chordSheet/chordSheetCore';

const publishedSheets = await getPublishedChordSheets();
const featuredSheets = publishedSheets.slice(0, 4);

// Nobody has published a chart here yet, so this section used to render as nothing at
// all — the one indexed page of the product quietly dropped a whole block. The Songs
// catalogue is the honest stand-in: a real starting chart, converted by the same
// songToSheet.ts the `?from=` links use, so the card shows the chords the visitor
// would actually land on. Reading full rows is fine here and NOT in the library —
// this is SSR, so the lyrics never reach the browser, only the four cards do.
// The moment real charts exist they take the section back over.
const featuredSongs = featuredSheets.length > 0
  ? []
  : (await getPublishedSongs()).slice(0, 4).map((song) => {
      const seed = songToSheetSeed(song);
      return { slug: song.slug, title: song.title, artist: song.artist, baseKey: seed.baseKey, text: seed.text };
    });

// One representative lyric line per card, chords stripped, for the excerpt under the
// chord chips.
function firstLyricLine(sheet: (typeof featuredSheets)[number]): string {
  for (const section of parseSheet(sheet.text)) {
    for (const line of section.lines) {
      if (line.blank) continue;
      const text = line.slots.map((s) => s.lyric).join('').trim();
      if (text) return text;
    }
  }
  return '';
}

const trustBar = [
  'Guitar & ukulele diagrams',
  'One-click transpose',
  'Nashville numbers',
  'Print & PDF ready',
  'Publish to the public library',
];

const features = [
  { icon: '[C]', title: 'ChordPro in, chart out', desc: "Write [G]like this and chords land right over the syllable. Drag any chord on the sheet to nudge it." },
  { icon: '♯♭', title: 'Transpose & capo', desc: 'Move the whole song a semitone at a time, pick a capo position, or switch to Nashville numbers for the band.' },
  { icon: '▦', title: 'Chord diagrams', desc: 'Guitar and ukulele shapes for every chord in the song — placed at the top of the page or in the margin.' },
  { icon: '▤', title: 'Print that fits the page', desc: 'Pick a paper preset, scale the type, go one or two columns — then print or save a PDF with no stray page breaks.' },
  { icon: '☰', title: 'Write once, publish everywhere', desc: "Every sheet autosaves as you write. Publish when it's ready — it's searchable, printable, and shareable with a link." },
  { icon: '↺', title: 'Edit on your phone', desc: 'Tap a line to fix a chord mid-rehearsal. Undo and redo everything, on any screen size.' },
];

const EDITOR_HREF = '/chord-sheet-maker/editor/';

const title = 'Chord Sheet Maker — Write and Publish Your Own Chord Chart | Chord Sequence';
const description = "Write lyrics, drop in chords, transpose to any key, and print a clean chart in seconds. Publish it to your Chord Sheet Maker library when it's ready — no account needed to start.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://chordsequence.com/chord-sheet-maker/"
>
  <section class="relative overflow-hidden pt-8 pb-12 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20 border-b border-border">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-1/2 h-[520px] w-[920px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-[130px]"></div>
    </div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          <span class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1.5 font-mono text-[11px] font-bold uppercase tracking-widest text-primary">
            ChordPro · write &amp; publish
          </span>
          <h1 class="mb-5 font-serif text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-[3.3rem]">
            Write chord sheets your band can actually read.
          </h1>
          <p class="mb-8 max-w-xl text-lg leading-relaxed text-muted-foreground">
            Type lyrics, drop chords where they belong, and get a clean chart in seconds. Transpose to any key, set a capo, print it, and publish it to the public library when it's ready — no formatting fights.
          </p>
          <div class="flex flex-wrap gap-3.5">
            <a
              href={EDITOR_HREF}
              class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-4 text-lg font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90"
            >
              Start a chord sheet →
            </a>
            <a
              href="/songs/"
              class="inline-flex items-center gap-2 rounded-xl border border-primary/30 px-8 py-4 text-lg font-medium text-primary transition-colors hover:bg-primary/5"
            >
              Looking to play a song instead?
            </a>
          </div>
          <p class="mt-4 text-sm text-muted-foreground">Free · works in your browser · nothing to install</p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-7 shadow-xl">
          <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-border pb-3">
            <div>
              <div class="font-serif text-xl font-bold text-foreground">Amazing Grace</div>
              <div class="mt-0.5 text-xs text-muted-foreground">Traditional</div>
            </div>
            <div class="text-right font-mono text-[11px] leading-relaxed text-muted-foreground">
              <div>Key <strong class="text-sm text-primary">G</strong></div>
              <div>Capo 2</div>
            </div>
          </div>
          <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Verse 1</div>
          <div class="mt-2 flex flex-col gap-3 text-sm leading-snug">
            <div>
              <div class="whitespace-pre font-mono text-xs font-bold text-primary">G          G7        C      G</div>
              <div class="whitespace-pre">Amazing grace, how sweet the sound</div>
            </div>
            <div>
              <div class="whitespace-pre font-mono text-xs font-bold text-primary">G                 Em    D</div>
              <div class="whitespace-pre">That saved a wretch like me</div>
            </div>
            <div>
              <div class="whitespace-pre font-mono text-xs font-bold text-primary">G        G7      C        G</div>
              <div class="whitespace-pre">I once was lost, but now am found</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-card/50">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-6">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {trustBar.map((item) => (
          <span class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
            <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Everything a chart needs</h2>
        <p class="mx-auto max-w-xl text-lg text-muted-foreground">Built for worship teams, teachers, and anyone who hands out charts before rehearsal.</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/40">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 font-mono text-sm font-bold text-primary">
              {f.icon}
            </div>
            <h3 class="mb-2 font-semibold text-foreground">{f.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {featuredSongs.length > 0 && (
    <section class="border-t border-border bg-muted/20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Or start from a song we already have</h2>
          <p class="mx-auto max-w-xl text-lg text-muted-foreground">Open one as your own editable copy — change the key to fit your voice, cut the verses you don't play, print it.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {featuredSongs.map((song) => {
            const chords = uniqueChords(parseSheet(song.text));
            const shownChords = chords.slice(0, 4);
            const extraChords = chords.length - shownChords.length;
            return (
              <a
                href={`/chord-sheet-maker/editor/?from=${song.slug}`}
                class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card shadow-sm transition-colors hover:border-primary/50"
              >
                <div class="border-b border-border bg-gradient-to-br from-primary/10 to-primary/0 p-4">
                  <div class="flex flex-wrap gap-1.5">
                    {shownChords.map((c) => (
                      <span class="rounded-md border border-primary/25 bg-card px-2 py-0.5 font-mono text-xs font-bold text-primary">{c}</span>
                    ))}
                    {extraChords > 0 && (
                      <span class="px-1 py-0.5 font-mono text-xs font-bold text-muted-foreground">+{extraChords}</span>
                    )}
                  </div>
                </div>
                <div class="flex flex-1 flex-col gap-1 p-4">
                  <p class="truncate text-sm font-bold text-foreground group-hover:text-primary transition-colors">{song.title}</p>
                  <p class="truncate text-xs text-muted-foreground">{song.artist}</p>
                  <div class="mt-2.5 flex flex-wrap gap-1.5">
                    <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-[10px] font-bold tracking-wide text-muted-foreground">KEY {song.baseKey}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {featuredSheets.length > 0 && (
    <section class="border-t border-border bg-muted/20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Or fork someone else's chart</h2>
          <p class="mx-auto max-w-xl text-lg text-muted-foreground">Start from a chart another player already published, and change the key to fit your voice.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {featuredSheets.map((sheet) => {
            const chords = uniqueChords(parseSheet(sheet.text));
            const shownChords = chords.slice(0, 4);
            const extraChords = chords.length - shownChords.length;
            const snippet = firstLyricLine(sheet);
            return (
              <a
                href={`/chord-sheet-maker/${sheet.slug}/`}
                class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card shadow-sm transition-colors hover:border-primary/50"
              >
                <div class="border-b border-border bg-gradient-to-br from-primary/10 to-primary/0 p-4">
                  <div class="flex flex-wrap gap-1.5">
                    {shownChords.map((c) => (
                      <span class="rounded-md border border-primary/25 bg-card px-2 py-0.5 font-mono text-xs font-bold text-primary">{c}</span>
                    ))}
                    {extraChords > 0 && (
                      <span class="px-1 py-0.5 font-mono text-xs font-bold text-muted-foreground">+{extraChords}</span>
                    )}
                  </div>
                  {snippet && (
                    <p class="mt-3 line-clamp-2 text-[11.5px] leading-snug text-muted-foreground">{snippet}</p>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-1 p-4">
                  <p class="truncate text-sm font-bold text-foreground group-hover:text-primary transition-colors">{sheet.title}</p>
                  <p class="truncate text-xs text-muted-foreground">{sheet.artist}</p>
                  <div class="mt-2.5 flex flex-wrap gap-1.5">
                    <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-[10px] font-bold tracking-wide text-muted-foreground">KEY {sheet.baseKey}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-border py-16 sm:py-20 text-center">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <h2 class="mb-4 font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Your next chart is four lines away</h2>
      <p class="mb-7 text-lg text-muted-foreground">Open the editor, paste your lyrics, and start dropping chords.</p>
      <a
        href={EDITOR_HREF}
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-4 text-lg font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90"
      >
        Open Chord Sheet Maker →
      </a>
    </div>
  </section>
</BaseLayout>
