---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordEmbedIsland from '../../components/ChordEmbedIsland.astro';
import { GENRES, getGenre } from '../../data/progressions';
import AppCta from '../../components/AppCta.astro';

export function getStaticPaths() {
  return GENRES.map((g) => ({
    params: { genre: g.slug },
    props: { genre: g },
  }));
}

const { genre } = Astro.props;

const genreCanonicalUrl = `https://chordsequence.com/progressions/${genre.slug}/`;

const generatorMetaDescription = `${genre.name} chord progression generator — ${genre.progressions.length} progressions with real audio, playable in your browser. Customize key, tempo, and rhythm. Free, no account needed.`;

const firstProgression = genre.progressions[0];
const editorUrl = `/editor/?chords=${firstProgression.chords.replace(/ /g, '-')}&bpm=${firstProgression.bpm}&style=${firstProgression.style}`;

function toAnchorId(title: string): string {
  return title
    .toLowerCase()
    .replace(/[–—]/g, '-')
    .replace(/[♭]/g, 'b')
    .replace(/[#♯]/g, 's')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${genre.name} Chord Progression Generator`,
  description: genre.description,
  url: genreCanonicalUrl,
  numberOfItems: genre.progressions.length,
  itemListElement: genre.progressions.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Thing',
      name: p.title,
      description: p.description,
      '@id': `${genreCanonicalUrl}#${toAnchorId(p.title)}`,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${genreCanonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Progressions', item: 'https://chordsequence.com/progressions/' },
    { '@type': 'ListItem', position: 3, name: `${genre.name} Chord Progression Generator`, item: genreCanonicalUrl },
  ],
};
---

<BaseLayout
  title={`${genre.name} Chord Progression Generator — Play Free | Chord Sequence`}
  description={generatorMetaDescription}
  canonicalUrl={genreCanonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-10">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/progressions" class="hover:text-foreground transition-colors">Progressions</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">{genre.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        {genre.name} Chord Progression Generator
      </h1>
      <p class="text-lg text-muted-foreground mb-4">{genre.description}</p>
      {genre.learnLink && (
        <a href={genre.learnLink.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
          {genre.learnLink.label}
        </a>
      )}
    </header>

    {genre.editorialQA && genre.editorialQA.length > 0 ? (
      <div class="mb-14 space-y-10">
        {genre.editorialQA.map((qa) => (
          <div>
            <h2 class="text-2xl font-bold text-foreground mb-3 tracking-tight">{qa.question}</h2>
            <p class="text-muted-foreground leading-relaxed" set:html={qa.answer} />
          </div>
        ))}
      </div>
    ) : genre.editorialIntro && genre.editorialIntro.length > 0 && (
      <div class="mb-14 space-y-4">
        {genre.editorialIntro.map((para) => (
          <p class="text-muted-foreground leading-relaxed">{para}</p>
        ))}
      </div>
    )}

    <div class="space-y-6">
      {genre.progressions.map((p) => (
        <div id={toAnchorId(p.title)} class="rounded-xl border border-border bg-card p-5">
          <p class="text-xs text-muted-foreground mb-3 leading-relaxed" set:html={p.description} />
          <ChordEmbedIsland chords={p.chords} bpm={p.bpm} style={p.style} title={p.title} />
        </div>
      ))}
    </div>

    {genre.faq && genre.faq.length > 0 && (
      <section class="mt-16 pt-8 border-t border-border" aria-label="Frequently asked questions">
        <h2 class="text-2xl font-bold text-foreground mb-8">Frequently Asked Questions</h2>
        <div class="space-y-6">
          {genre.faq.map((item) => (
            <div class="border border-border rounded-xl p-5">
              <h3 class="text-base font-semibold text-foreground mb-2">{item.question}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed" set:html={item.answer} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Other genres -->
    <div class="mt-16">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Other genres</h2>
      <div class="flex flex-wrap gap-2">
        {GENRES.filter((g) => g.slug !== genre.slug).map((g) => (
          <a
            href={`/progressions/${g.slug}/`}
            class="px-3 py-1.5 text-sm rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors"
          >
            {g.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Learn more section -->
    {genre.relatedArticles && genre.relatedArticles.length > 0 && (
      <div class="mt-16 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
          {genre.learnSectionTitle ?? 'Learn more'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {genre.relatedArticles.map((article) => (
            <a
              href={article.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {article.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                  {article.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <AppCta
      class="mt-12"
      heading={`Generate your own ${genre.name} chord progression`}
      description={`Starts with ${firstProgression.title} — change any chord, adjust the tempo, and export as WAV. Free, no account needed.`}
      buttonText="Open Chord Progression Generator"
      href={editorUrl}
    />
  </main>
</BaseLayout>
