---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordEmbedIsland from '../../components/ChordEmbedIsland.astro';
import { GENRES, getGenre } from '../../data/progressions';

export function getStaticPaths() {
  return GENRES.map((g) => ({
    params: { genre: g.slug },
    props: { genre: g },
  }));
}

const { genre } = Astro.props;

const genreCanonicalUrl = `https://chordsequence.com/progressions/${genre.slug}/`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${genre.name} Chord Progressions`,
  description: genre.description,
  url: genreCanonicalUrl,
  numberOfItems: genre.progressions.length,
  itemListElement: genre.progressions.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    description: p.description,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com' },
    { '@type': 'ListItem', position: 2, name: 'Progressions', item: 'https://chordsequence.com/progressions/' },
    { '@type': 'ListItem', position: 3, name: `${genre.name} Chord Progressions`, item: genreCanonicalUrl },
  ],
};
---

<BaseLayout
  title={`${genre.name} Chord Progressions — Play & Export | Chord Sequence`}
  description={genre.metaDescription}
  canonicalUrl={genreCanonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-10">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/progressions" class="hover:text-foreground transition-colors">Progressions</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">{genre.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        {genre.name} chord progressions
      </h1>
      <p class="text-lg text-muted-foreground mb-4">{genre.description}</p>
      {genre.learnLink && (
        <a href={genre.learnLink.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
          {genre.learnLink.label}
        </a>
      )}
    </header>

    {genre.editorialIntro && genre.editorialIntro.length > 0 && (
      <div class="mb-14 space-y-4">
        {genre.editorialIntro.map((para) => (
          <p class="text-muted-foreground leading-relaxed">{para}</p>
        ))}
      </div>
    )}

    <div class="space-y-6">
      {genre.progressions.map((p) => (
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="text-xs text-muted-foreground mb-3 leading-relaxed">{p.description}</p>
          <ChordEmbedIsland chords={p.chords} bpm={p.bpm} style={p.style} title={p.title} />
        </div>
      ))}
    </div>

    <!-- Other genres -->
    <div class="mt-16">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Other genres</h2>
      <div class="flex flex-wrap gap-2">
        {GENRES.filter((g) => g.slug !== genre.slug).map((g) => (
          <a
            href={`/progressions/${g.slug}/`}
            class="px-3 py-1.5 text-sm rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors"
          >
            {g.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Learn more section -->
    {genre.relatedArticles && genre.relatedArticles.length > 0 && (
      <div class="mt-16 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
          {genre.learnSectionTitle ?? 'Learn more'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {genre.relatedArticles.map((article) => (
            <a
              href={article.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {article.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                  {article.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="mt-12 rounded-xl border border-primary/20 bg-primary/5 p-8 text-center">
      <h2 class="text-xl font-semibold text-foreground mb-2">Build your own {genre.name} progression</h2>
      <p class="text-sm text-muted-foreground mb-5">Open the editor, add any of these chords, and customize the rhythm and tempo.</p>
      <a href="/app" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:bg-primary/90 transition-colors">
        Open Chord Player →
      </a>
    </div>
  </main>
</BaseLayout>
