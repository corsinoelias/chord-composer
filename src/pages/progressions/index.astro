---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GENRES } from '../../data/progressions';
import AppCta from '../../components/AppCta.astro';

const progressionsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Chord Progressions by Genre',
  description: 'Hundreds of chord progressions by genre and mood — pop, jazz, lo-fi, worship, blues, neo soul, EDM. Click any progression to hear it instantly.',
  url: 'https://chordsequence.com/progressions/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: GENRES.length,
    itemListElement: GENRES.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${g.name} Chord Progressions`,
      url: `https://chordsequence.com/progressions/${g.slug}/`,
      description: g.description,
    })),
  },
}
---

<BaseLayout
  title="Chord Progressions by Genre — Play Any in Your Browser | Chord Sequence"
  description="Hundreds of chord progressions by genre and mood — pop, jazz, lo-fi, worship, blues, and more. Click any progression to hear it instantly, free."
  canonicalUrl="https://chordsequence.com/progressions/"
  ogImage="/og/page/progressions/"
  ogImageAlt="Chord Progressions by Genre | Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(progressionsSchema)} />
  </Fragment>
  <main class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="mb-14 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Chord progressions by genre
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">
        Browse progressions by mood and genre. Click any to hear it instantly, or open in the editor to customize.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {GENRES.map((genre) => (
        <a
          href={`/progressions/${genre.slug}/`}
          class="group flex flex-col rounded-xl border border-border bg-card p-6 hover:border-primary/50 transition-colors"
        >
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">
              {genre.name}
            </h2>
            <svg class="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <p class="text-sm text-muted-foreground flex-1 mb-4 leading-relaxed">{genre.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {genre.progressions.slice(0, 3).map((p) => (
              <span class="text-xs px-2 py-0.5 rounded-full border border-border text-muted-foreground font-mono">
                {p.chords.split(' ').slice(0, 4).join(' ')}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <!-- Learn the theory -->
    <div class="mt-16 pt-10 border-t border-border">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-6">Learn the theory behind these progressions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { href: '/learn/what-is-a-chord-progression/', title: 'What is a chord progression?', desc: 'The harmonic foundation every songwriter needs to understand' },
          { href: '/learn/chord-progressions-for-beginners/', title: 'Chord progressions for beginners', desc: 'I–V–vi–IV, 12-bar blues, and the four progressions you need first' },
          { href: '/learn/jazz-chord-progressions/', title: 'Jazz chord progressions', desc: 'ii–V–I, turnarounds, bossa nova, and modal jazz explained' },
        ].map((a) => (
          <a href={a.href} class="group rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:bg-primary/5 transition-colors">
            <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors mb-1">{a.title}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{a.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <AppCta
      class="mt-12"
      heading="Build your own progression"
      description="Use the Chord Player to arrange any of these chords, change the rhythm, and export to WAV."
    />
  </main>
</BaseLayout>
