---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordEmbedIsland from '../../components/ChordEmbedIsland.astro';
import AppCta from '../../components/AppCta.astro';

const canonicalUrl = 'https://chordsequence.com/chord-progression-generator/';

const faqItems = [
  {
    question: 'What is a chord progression generator?',
    answer:
      "A chord progression generator is a tool that lets you build, hear, and experiment with sequences of chords. Instead of working progressions out on paper or in a DAW, you pick your chords, choose a rhythm style, set a tempo, and play — all in your browser. Chord Sequence is a free online chord progression generator with 37 chord types and 13+ rhythm styles including pop, jazz, blues, lo-fi, and worship.",
  },
  {
    question: 'How do I generate a chord progression?',
    answer:
      "Open the generator and add chords to a section — try C, Am, F, G to start. Pick a rhythm style (pop, jazz, folk, blues…), set your BPM, and press Play. You can build multiple sections for verse, chorus, and bridge, then export your progression as a WAV file when you're done. No account required.",
  },
  {
    question: 'Is this chord progression generator free?',
    answer:
      'Yes, completely free. No subscription, no account, and no credit card required. You can build, play, and export chord progressions with no limitations.',
  },
  {
    question: 'What chord types does the generator support?',
    answer:
      'The generator supports 37 chord qualities: major, minor, dominant 7th, major 7th, minor 7th, half-diminished, diminished, augmented, sus2, sus4, and extended chords (9th, 11th, 13th). Slash chords for inversions (C/E, G/B, D/F#) are also supported for smooth bass lines.',
  },
  {
    question: 'Can I export my chord progression as audio?',
    answer:
      'Yes. Every progression you build can be exported as a WAV file with one click. The export includes all instruments — piano, bass, guitar, and drums — at the rhythm style and BPM you set.',
  },
  {
    question: 'What rhythm styles are available?',
    answer:
      'The generator includes 13+ rhythm styles: pop, folk/acoustic, jazz, lo-fi, R&B/soul, hip-hop/trap, shuffle blues, rock, bossa nova, worship, and more. Each style applies a different rhythmic pattern to the same chord sequence, so you can hear how the same progression sounds across different genres without retyping anything.',
  },
  {
    question: 'Can I transpose a chord progression to a different key?',
    answer:
      "Yes. The generator has a built-in transpose feature that shifts your entire progression up or down by any number of semitones instantly. Useful for matching a singer's vocal range or trying the same progression in multiple keys.",
  },
  {
    question: 'What is the difference between a chord progression generator and a chord progression maker?',
    answer:
      "They refer to the same thing — a tool for building chord sequences. 'Generator' implies the tool creates or suggests progressions; 'maker' or 'builder' implies you construct them yourself. Chord Sequence does both: you can start with a blank slate and build your own, or begin from one of the genre examples and customize from there.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: 'Free Chord Progression Generator — Online | Chord Sequence',
  description:
    'Generate chord progressions instantly — pick chords, style, and BPM. 37 chord types, pop, jazz, blues, lo-fi, worship. Play in your browser, export WAV. Free, no account needed.',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', '@id': 'https://chordsequence.com/#website' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Progression Generator', item: canonicalUrl },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Chord Progression Generator — Chord Sequence',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  url: canonicalUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Free online chord progression generator. Build and play chord progressions with real instrument sounds. 37 chord types, 13+ rhythm styles, transpose, WAV export. No account required.',
  featureList: [
    '37 chord types including extensions and inversions',
    '13+ rhythm styles: pop, jazz, folk, blues, lo-fi, worship, R&B, hip-hop',
    'Real instrument audio — piano, guitar, bass, and drums',
    'Transpose to any key',
    'One-click WAV export',
    'Multiple sections: verse, chorus, bridge',
    'Adjustable BPM',
    'No account or download required',
  ],
};

const genres = [
  {
    name: 'Pop',
    examples: [
      { chords: 'C G Am F', bpm: 110, style: 'pop_basic', title: 'I–V–vi–IV — The pop axis (C major)' },
      { chords: 'C Am F G', bpm: 100, style: 'pop_basic', title: 'I–vi–IV–V — Classic pop variation' },
      { chords: 'Am F C G', bpm: 105, style: 'pop_basic', title: 'vi–IV–I–V — Minor-starting pop' },
    ],
  },
  {
    name: 'Jazz',
    examples: [
      { chords: 'Dm7 G7 Cmaj7', bpm: 120, style: 'jazz_light', title: 'ii–V–I — The jazz standard cornerstone' },
      { chords: 'Cmaj7 Am7 Dm7 G7', bpm: 110, style: 'jazz_light', title: 'I–vi–ii–V — Jazz turnaround' },
      { chords: 'Fmaj7 Em7 Dm7 G7', bpm: 100, style: 'jazz_light', title: 'IV–iii–ii–V — Descending movement' },
    ],
  },
  {
    name: 'Blues',
    examples: [
      { chords: 'A7 D7 A7 E7', bpm: 90, style: 'shuffle_blues', title: 'Blues shuffle in A — dominant 7ths' },
      { chords: 'E7 A7 B7 A7', bpm: 95, style: 'shuffle_blues', title: 'Blues turnaround in E' },
    ],
  },
  {
    name: 'Lo-fi',
    examples: [
      { chords: 'Cmaj7 Am7 Fmaj7 G7', bpm: 75, style: 'pop_basic', title: 'Chill lo-fi loop — extended chords in C' },
      { chords: 'Fmaj7 Em7 Am7 Dm7', bpm: 70, style: 'pop_basic', title: 'Dreamy lo-fi — descending sevenths' },
    ],
  },
  {
    name: 'Worship',
    examples: [
      { chords: 'G D Em C', bpm: 72, style: 'folk_strum', title: 'G–D–Em–C — Contemporary worship staple' },
      { chords: 'D A Bm G', bpm: 76, style: 'folk_strum', title: 'D–A–Bm–G — Common worship pattern' },
      { chords: 'C G Am F', bpm: 68, style: 'folk_strum', title: 'Slow worship ballad — I–V–vi–IV' },
    ],
  },
  {
    name: 'R&B / Soul',
    examples: [
      { chords: 'Am7 Dm7 Gmaj7 Cmaj7', bpm: 88, style: 'soul_rnb', title: 'Neo-soul movement — lush seventh chords' },
      { chords: 'Dm7 G7 Em7 Am7', bpm: 92, style: 'soul_rnb', title: 'R&B turnaround — ii–V cycle' },
    ],
  },
];

const features = [
  {
    title: '37 chord types',
    description:
      'Major, minor, dominant 7th, maj7, min7, dim, aug, sus2, sus4, and extended chords — 9ths, 11ths, 13ths. Slash chords (C/E, G/B, D/F#) for smooth bass lines.',
  },
  {
    title: '13+ rhythm styles',
    description:
      'Pop, folk, jazz, blues, lo-fi, R&B, hip-hop, worship, bossa nova, and more. Each style applies a different rhythmic pattern — same chords, completely different feel.',
  },
  {
    title: 'Real instrument audio',
    description:
      'Piano, guitar, bass, and drums — all playing together at the BPM you set. Real audio samples, not MIDI bleeps.',
  },
  {
    title: 'Multiple sections',
    description:
      'Build a full song structure: verse, pre-chorus, chorus, bridge. Each section can have different chords, a different rhythm style, and a different repeat count.',
  },
  {
    title: 'Transpose to any key',
    description:
      "Shift your entire progression up or down by any number of semitones instantly. Useful for matching a singer's range or testing the same progression in multiple keys.",
  },
  {
    title: 'WAV export',
    description:
      'Export your progression as a WAV file with one click. Use it in your DAW, send it to a collaborator, or keep it as a reference track.',
  },
];

const relatedLinks = [
  { href: '/learn/what-is-a-chord-progression/', label: 'What is a chord progression?' },
  { href: '/learn/chord-progressions-for-beginners/', label: 'Chord progressions for beginners' },
  { href: '/learn/jazz-chord-progressions/', label: 'Jazz chord progressions' },
  { href: '/progressions/', label: 'Browse progressions by genre' },
  { href: '/learn/chord-inversions/', label: 'Chord inversions and slash chords' },
  { href: '/best-chord-progression-generators/', label: 'Best chord progression generators' },
];
---

<BaseLayout
  title="Free Chord Progression Generator — Online | Chord Sequence"
  description="Generate chord progressions instantly — pick chords, style, and BPM. 37 chord types, pop, jazz, blues, lo-fi, worship. Play in your browser, export WAV. Free, no account needed."
  canonicalUrl={canonicalUrl}
  ogImage="/og/page/chord-progression-generator/"
  ogImageAlt="Free Chord Progression Generator — Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-4 sm:px-6 pt-4 pb-2">
      <ol class="flex items-center gap-1.5 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-foreground transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-foreground font-medium">Chord Progression Generator</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="py-14 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
          Free · No account required · Works in any browser
        </div>

        <h1 class="mb-5 text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
          Free Chord Progression Generator
        </h1>

        <p class="mx-auto mb-8 max-w-2xl text-lg text-muted-foreground leading-relaxed">
          Build and play any chord progression with real instrument sounds. Pick your chords,
          choose a rhythm style, set your BPM — hear it in seconds. No DAW, no plugins, no account.
        </p>

        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/editor/?chords=C-Am-F-G&bpm=100&style=pop_basic"
            class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-4 text-lg font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Open Generator — it's free
          </a>
          <a
            href="#examples"
            class="inline-flex items-center gap-2 rounded-xl border border-border px-8 py-4 text-lg font-medium text-foreground transition-colors hover:bg-accent/50"
          >
            See examples
          </a>
        </div>

        <p class="mt-4 text-sm text-muted-foreground">
          Opens with C · Am · F · G — change any chord and press play
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-y border-border bg-card/40 py-14">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="mb-10 text-center text-2xl font-bold text-foreground sm:text-3xl">
          How to Generate a Chord Progression
        </h2>
        <div class="grid gap-8 sm:grid-cols-3">
          {[
            {
              step: '1',
              title: 'Add your chords',
              description:
                'Pick any root note and chord quality. Choose from 37 types — major, minor, 7th, maj7, sus4, dim, aug, and more. Add as many chords as you need in any order.',
            },
            {
              step: '2',
              title: 'Pick a rhythm style',
              description:
                'Choose from 13+ styles: pop, jazz, folk, blues, lo-fi, R&B, hip-hop, worship, bossa nova, and more. Each style applies a different rhythmic pattern to your chords.',
            },
            {
              step: '3',
              title: 'Play, tweak, export',
              description:
                'Hit play to hear your progression with real audio. Adjust BPM, transpose to any key, build multiple sections for verse and chorus, then export as WAV.',
            },
          ].map(({ step, title, description }) => (
            <div class="flex gap-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
                {step}
              </div>
              <div>
                <h3 class="mb-1.5 font-semibold text-foreground">{title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Examples by genre -->
    <section id="examples" class="py-14 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="mb-3 text-2xl font-bold text-foreground sm:text-3xl">
          Chord Progression Generator by Genre
        </h2>
        <p class="mb-10 text-muted-foreground">
          Press play on any example below — these run directly in your browser. Click the chord
          names to edit them and generate your own variations.
        </p>

        <div class="space-y-12">
          {genres.map(({ name, examples }) => (
            <div>
              <h3 class="mb-4 text-lg font-semibold text-foreground">{name} Chord Progressions</h3>
              <div class="space-y-3">
                {examples.map((ex) => (
                  <ChordEmbedIsland
                    chords={ex.chords}
                    bpm={ex.bpm}
                    style={ex.style}
                    title={ex.title}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/progressions/"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
          >
            Browse all progressions by genre →
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="border-y border-border bg-card/40 py-14">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="mb-10 text-center text-2xl font-bold text-foreground sm:text-3xl">
          What's Inside the Generator
        </h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {features.map(({ title, description }) => (
            <div class="rounded-lg border border-border bg-card p-5">
              <h3 class="mb-2 font-semibold text-foreground">{title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-14">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <AppCta
          heading="Start generating chord progressions"
          description="Free, no account needed. Opens with C – Am – F – G — change any chord and press play."
          buttonText="Open Chord Progression Generator"
          href="/editor/?chords=C-Am-F-G&bpm=100&style=pop_basic"
        />
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-border py-14 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="mb-8 text-2xl font-bold text-foreground sm:text-3xl">
          Frequently Asked Questions
        </h2>
        <dl class="space-y-6">
          {faqItems.map(({ question, answer }) => (
            <div class="border-b border-border pb-6 last:border-0 last:pb-0">
              <dt class="mb-2 font-semibold text-foreground">{question}</dt>
              <dd class="text-sm text-muted-foreground leading-relaxed">{answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Related links -->
    <section class="border-t border-border bg-card/40 py-10">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="mb-5 text-base font-semibold text-foreground">Related resources</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 text-sm">
          {relatedLinks.map(({ href, label }) => (
            <a
              href={href}
              class="flex items-center gap-1.5 text-muted-foreground hover:text-primary transition-colors"
            >
              <span aria-hidden="true">→</span>
              {label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
