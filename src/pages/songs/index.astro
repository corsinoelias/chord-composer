---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedSongs } from '@/lib/publicSongs';
import AppCta from '../../components/AppCta.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import SongCard from '../../components/SongCard.astro';
import { normalizeForSearch } from '@/lib/searchText';

const songs = await getPublishedSongs();
const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(Astro.url.hostname);

// Real pagination — see src/middleware.ts for why this used to just redirect ?page=
// away entirely (no pagination existed then). Invalid or out-of-range page numbers
// redirect to the clean /songs/ URL (no query string), so this can't loop the way the
// old netlify.toml-level "clear the query" trick did.
const PAGE_SIZE = 24;
const totalPages = Math.max(1, Math.ceil(songs.length / PAGE_SIZE));
const rawPage = Astro.url.searchParams.get('page');
if (rawPage !== null) {
  const requestedPage = Number(rawPage);
  const isValid = Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= totalPages;
  // ?page=1 is folded into the canonical /songs/ URL too — same content, one URL.
  if (!isValid || requestedPage === 1) {
    return Astro.redirect('/songs/', 301);
  }
}
const currentPage = rawPage ? Number(rawPage) : 1;
const pageSongs = songs.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const pageCanonicalUrl = currentPage === 1
  ? 'https://chordsequence.com/songs/'
  : `https://chordsequence.com/songs/?page=${currentPage}`;

// The search grid holds every published song, not just this page's slice — the whole point
// is to reach a song without paginating to it. Key and genre join the haystack so "worship"
// or "key of g" narrow the list too, which is the cheap version of real facet filters.
const searchableSongs = songs.map((song) => ({
  song,
  searchText: normalizeForSearch(`${song.title} ${song.artist} ${song.key} ${song.genre.join(' ')}`),
}));

const KNOWN_BANDS = new Set(['Oasis', 'The Beatles', 'Led Zeppelin', 'Pink Floyd', 'Oasis Ministry', 'Elevation Worship', 'Hillsong', 'Bethel Music', 'Radiohead', 'Coldplay', 'U2', 'Metallica', 'AC/DC']);

function getComposer(artist: string) {
  if (KNOWN_BANDS.has(artist)) return { '@type': 'MusicGroup', name: artist };
  if (artist === 'Jazz Standard') return { '@type': 'Person', name: 'Joseph Kosma' };
  return { '@type': 'Person', name: artist };
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Songs', item: 'https://chordsequence.com/songs/' },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Song Chords — Chord Sequence',
  description: 'Chords and lyrics for popular songs with interactive play-along player.',
  url: 'https://chordsequence.com/songs/',
  numberOfItems: songs.length,
  itemListElement: pageSongs.map((s, i) => ({
    '@type': 'ListItem',
    position: (currentPage - 1) * PAGE_SIZE + i + 1,
    item: {
      '@type': 'MusicComposition',
      '@id': `https://chordsequence.com/songs/${s.slug}/`,
      name: s.title,
      composer: getComposer(s.artist),
      musicalKey: s.key,
      genre: s.genre.join(', '),
      url: `https://chordsequence.com/songs/${s.slug}/`,
    },
  })),
};
---

<BaseLayout
  title={currentPage === 1
    ? "Song Chords — Play Along with Interactive Chord Sheets"
    : `Song Chords — Page ${currentPage} | Chord Sequence`}
  description="Chords and lyrics for popular songs. Press Play and watch each chord highlight above the lyrics in real time. Learn any song by playing along."
  canonicalUrl={pageCanonicalUrl}
  ogImage="/og/page/songs/"
  ogImageAlt="Chord Charts & Songs | Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-16 sm:py-24">

    <div class="mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
        Play along
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Song chords
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl mb-6">
        Every song has an interactive player. Press Play and watch each chord light up above the lyrics
        as it sounds — so you always know where you are in the song.
      </p>

      <!-- What makes these charts different -->
      <div class="grid sm:grid-cols-3 gap-4 mb-8">
        {[
          { icon: 'M8 5v14l11-7z', label: 'Synchronized playback', desc: 'The active chord highlights above the lyrics in real time as the song plays.' },
          { icon: 'M9 19V6l12-3v13M9 19c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm12-3c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z', label: 'Hover for diagrams', desc: 'Hover any chord name to see the guitar fingering diagram and hear the isolated chord.' },
          { icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', label: 'PDF export', desc: 'Download a clean chord sheet PDF for any song — useful for rehearsals.' },
        ].map((f) => (
          <div class="rounded-xl border border-border bg-card p-4">
            <svg class="w-4 h-4 text-primary mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d={f.icon} />
            </svg>
            <p class="text-sm font-semibold text-foreground mb-1">{f.label}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>

      <p class="text-sm text-muted-foreground max-w-2xl leading-relaxed">
        The library covers worship, rock, folk, and jazz — from Wonderwall and Hallelujah to Creo en Ti and Holy Forever.
        Each chart is built by hand: the key, capo position, BPM, and every chord are manually verified against the original recording.
        Missing a song? Use the editor to build it yourself and submit it to the public library.
      </p>
    </div>

    <div class="mb-6">
      <label for="song-search" class="sr-only">Search songs by title or artist</label>
      <div class="relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          id="song-search"
          data-song-search
          type="search"
          autocomplete="off"
          placeholder="Search by title, artist, key or genre…"
          class="w-full rounded-xl border border-border bg-card pl-10 pr-4 py-3 text-base text-foreground placeholder:text-muted-foreground focus:border-primary/50 focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors"
        />
      </div>
    </div>

    <div class="mb-8 flex items-center justify-between">
      <h2
        data-song-count
        data-total-label={`${songs.length} ${songs.length === 1 ? 'song' : 'songs'}`}
        aria-live="polite"
        class="text-sm font-semibold text-muted-foreground uppercase tracking-wider"
      >
        {songs.length} {songs.length === 1 ? 'song' : 'songs'}
      </h2>
      {isLocalhost && (
        <a
          href="/songs/new/"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
          Add a song
        </a>
      )}
    </div>

    {/* One grid holding the whole catalogue, with the songs outside this page's slice
        hidden server-side. Search then reaches any song by revealing its existing card,
        which keeps the card markup in exactly one place (SongCard.astro) rather than
        duplicated as a JS template string that drifts, interpolates no user input into
        HTML, and leaves the ?page= pagination below working exactly as before. */}
    <div data-song-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {searchableSongs.map(({ song, searchText }, i) => {
        const onThisPage = i >= (currentPage - 1) * PAGE_SIZE && i < currentPage * PAGE_SIZE;
        return <SongCard song={song} searchText={searchText} pageVisible={onThisPage} />;
      })}
    </div>

    <div data-search-empty role="status" style="display:none" class="rounded-xl border border-border bg-card p-8 text-center">
      <p class="text-base font-semibold text-foreground mb-2">
        No songs match “<span data-search-empty-term></span>”
      </p>
      <p class="text-sm text-muted-foreground max-w-md mx-auto">
        The library is still growing. You can build this progression yourself in the free
        editor and submit it to the public library.
      </p>
      <a
        href="/chord-player/"
        class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
      >
        Open the editor
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    {totalPages > 1 && (
      <nav data-song-pagination class="mt-10 flex items-center justify-center gap-4" aria-label="Song list pages">
        {currentPage > 1 ? (
          <a
            href={currentPage === 2 ? '/songs/' : `/songs/?page=${currentPage - 1}`}
            class="px-4 py-2 text-sm font-semibold rounded-lg border border-border text-foreground hover:bg-accent/50 transition-colors"
          >
            ← Previous
          </a>
        ) : <span />}
        <span class="text-sm text-muted-foreground">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages ? (
          <a
            href={`/songs/?page=${currentPage + 1}`}
            class="px-4 py-2 text-sm font-semibold rounded-lg border border-border text-foreground hover:bg-accent/50 transition-colors"
          >
            Next →
          </a>
        ) : <span />}
      </nav>
    )}

    <AppCta
      class="mt-12"
      heading="Build your own progression"
      description="Take any chord pattern from a song and continue building in the free editor."
    />

  </main>

  <script>
    import { analytics } from '@/lib/analytics';
    import { matchesSearch, MIN_SEARCH_LENGTH } from '@/lib/searchText';

    const input = document.querySelector<HTMLInputElement>('[data-song-search]');
    const grid = document.querySelector<HTMLElement>('[data-song-grid]');
    const emptyState = document.querySelector<HTMLElement>('[data-search-empty]');
    const emptyTerm = document.querySelector<HTMLElement>('[data-search-empty-term]');
    const countLabel = document.querySelector<HTMLElement>('[data-song-count]');
    const pagination = document.querySelector<HTMLElement>('[data-song-pagination]');

    if (input && grid && emptyState && countLabel) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-search-text]'));
      const totalLabel = countLabel.dataset.totalLabel ?? countLabel.textContent ?? '';

      // Visibility is toggled through inline style, not a `hidden` class: `.hidden` and
      // `.grid` are both Tailwind display utilities in the same layer, so which one wins is
      // decided by their order in the generated stylesheet — an implementation detail that
      // would silently stop hiding things. An inline style outranks both.
      const show = (el: HTMLElement) => { el.style.display = ''; };
      const hide = (el: HTMLElement) => { el.style.display = 'none'; };

      // Two debounces on purpose. The short one is what the page feels like; the long one is
      // what GA4 records, and it must be long enough that a settled word reports once
      // instead of once per prefix.
      let renderTimer: ReturnType<typeof setTimeout>;
      let trackTimer: ReturnType<typeof setTimeout>;
      let lastTracked = '';

      function applyFilter(query: string): number {
        // Short query: back to the plain paginated view — only the cards the server marked
        // as belonging to this ?page= slice come back, so clearing the box restores the
        // page the visitor was actually on rather than dumping the whole catalogue.
        if (query.length < MIN_SEARCH_LENGTH) {
          for (const card of cards) {
            if (card.dataset.pageVisible === undefined) hide(card); else show(card);
          }
          show(grid!);
          if (pagination) show(pagination);
          hide(emptyState!);
          countLabel!.textContent = totalLabel;
          return -1;
        }

        let hits = 0;
        for (const card of cards) {
          const isHit = matchesSearch(card.dataset.searchText ?? '', query);
          if (isHit) { show(card); hits++; } else { hide(card); }
        }

        if (pagination) hide(pagination);
        if (hits > 0) { show(grid!); hide(emptyState!); }
        else { hide(grid!); show(emptyState!); }
        if (emptyTerm) emptyTerm.textContent = query;
        countLabel!.textContent = `${hits} ${hits === 1 ? 'result' : 'results'}`;
        return hits;
      }

      input.addEventListener('input', () => {
        const query = input.value.trim();

        clearTimeout(renderTimer);
        renderTimer = setTimeout(() => applyFilter(query), 180);

        clearTimeout(trackTimer);
        if (query.length < MIN_SEARCH_LENGTH) return;
        trackTimer = setTimeout(() => {
          // Guard against reporting the same settled term twice (blur/refocus, a trailing
          // space, retyping the same thing) — GA4 would count each as a fresh search.
          if (query === lastTracked) return;
          lastTracked = query;
          const hits = applyFilter(query);
          analytics.songSearch(query, hits);
          if (hits === 0) analytics.songSearchNoResults(query);
        }, 800);
      });

      // A native type="search" clear button fires `input`, but Escape does not.
      input.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        input.value = '';
        clearTimeout(renderTimer);
        clearTimeout(trackTimer);
        applyFilter('');
      });
    }
  </script>

  <RelatedTools
    heading="Practice tools"
    tools={[
      { href: '/tools/guitar-tab/', icon: 'guitar', label: 'Guitar Tab Player', desc: 'Draw the notes for any song on a 6-string grid, hear it play back, and export to ASCII or MIDI.' },
      { href: '/tools/bass-guitar-tab/', icon: 'bass-tab', label: 'Bass Tab Player', desc: '4-string bass tablature editor. Record a bass line or tab out the root notes of any chord chart.' },
      { href: '/metronome/', icon: 'metronome', label: 'Metronome', desc: 'Practice each chord change at the song\'s BPM before playing along. Tap tempo supported.' },
    ]}
  />
</BaseLayout>
