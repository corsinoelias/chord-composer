---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedSongs } from '@/lib/publicSongs';

const songs = await getPublishedSongs();

const KNOWN_BANDS = new Set(['Oasis', 'The Beatles', 'Led Zeppelin', 'Pink Floyd', 'Oasis Ministry', 'Elevation Worship', 'Hillsong', 'Bethel Music', 'Radiohead', 'Coldplay', 'U2', 'Metallica', 'AC/DC']);

function getComposer(artist: string) {
  if (KNOWN_BANDS.has(artist)) return { '@type': 'MusicGroup', name: artist };
  if (artist === 'Jazz Standard') return { '@type': 'Person', name: 'Joseph Kosma' };
  return { '@type': 'Person', name: artist };
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com' },
    { '@type': 'ListItem', position: 2, name: 'Songs', item: 'https://chordsequence.com/songs/' },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Song Chords — Chord Sequence',
  description: 'Chords and lyrics for popular songs with interactive play-along player.',
  url: 'https://chordsequence.com/songs/',
  numberOfItems: songs.length,
  itemListElement: songs.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'MusicComposition',
      '@id': `https://chordsequence.com/songs/${s.slug}/`,
      name: s.title,
      composer: getComposer(s.artist),
      musicalKey: s.key,
      genre: s.genre.join(', '),
      url: `https://chordsequence.com/songs/${s.slug}/`,
    },
  })),
};
---

<BaseLayout
  title="Song Chords — Play Along with Interactive Chord Sheets | Chord Sequence"
  description="Chords and lyrics for popular songs. Press Play and watch each chord highlight above the lyrics in real time. Learn any song by playing along."
  canonicalUrl="https://chordsequence.com/songs/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-16 sm:py-24">

    <div class="mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
        Play along
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Song chords
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl">
        Every song has an interactive player. Press Play and watch each chord light up above the lyrics
        as it sounds — so you always know where you are in the song.
      </p>
    </div>

    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">
        {songs.length} {songs.length === 1 ? 'song' : 'songs'}
      </h2>
      <a
        href="/songs/new/"
        class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        Add a song
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {songs.map((song) => (
        <a
          href={`/songs/${song.slug}/`}
          class="group flex flex-col rounded-xl border border-border bg-card p-5 hover:border-primary/50 hover:bg-primary/5 transition-colors"
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="flex-1 min-w-0">
              <h2 class="text-base font-bold text-foreground group-hover:text-primary transition-colors truncate">
                {song.title}
              </h2>
              <p class="text-sm text-muted-foreground truncate">{song.artist}</p>
            </div>
            <svg class="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-border/50">
            <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
              Key: {song.key}
            </span>
            {song.capo && (
              <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground border border-border">
                Capo {song.capo}
              </span>
            )}
            {song.genre.slice(0, 2).map(g => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground border border-border capitalize">
                {g}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-xl border border-primary/20 bg-primary/5 p-8 text-center">
      <h2 class="text-xl font-semibold text-foreground mb-2">Build your own progression</h2>
      <p class="text-sm text-muted-foreground mb-5">
        Take any chord pattern from a song and continue building in the free editor.
      </p>
      <a href="/app/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:bg-primary/90 transition-colors">
        Open Chord Player →
      </a>
    </div>

  </main>
</BaseLayout>
