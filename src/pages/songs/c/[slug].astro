---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import SongChordPlayerIsland from '../../../components/SongChordPlayerIsland.astro';
import CommunityEditButton from '../../../components/CommunityEditButton';
import { getPublicSongBySlug } from '@/lib/publicSongs';
import { extractChordsFromSong } from '@/data/songs';
import type { Song } from '@/data/songs';

const { slug } = Astro.params;

const pub = slug ? await getPublicSongBySlug(slug) : null;

if (!pub) {
  return Astro.redirect('/songs/');
}

const song: Song = {
  slug: pub.slug,
  title: pub.title,
  artist: pub.artist,
  album: pub.album,
  year: pub.year,
  genre: pub.genre,
  key: pub.key,
  capo: pub.capo,
  bpm: pub.bpm,
  style: pub.style,
  description: pub.description,
  tags: pub.tags,
  relatedProgressions: pub.relatedProgressions,
  sections: pub.sections,
};

const canonicalUrl = `https://chordsequence.com/songs/c/${slug}/`;
const allChords = extractChordsFromSong(song);
const uniqueChords = [...new Set(allChords)].join(', ');
const capoNote = song.capo
  ? ` Capo ${song.capo}${song.capo === 1 ? 'st' : song.capo === 2 ? 'nd' : song.capo === 3 ? 'rd' : 'th'} fret.`
  : '';

const musicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: song.title,
  composer: { '@type': 'Person', name: song.artist },
  genre: song.genre.join(', '),
  url: canonicalUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com' },
    { '@type': 'ListItem', position: 2, name: 'Songs', item: 'https://chordsequence.com/songs/' },
    { '@type': 'ListItem', position: 3, name: `${song.title} Chords`, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={`${song.title} Chords — ${song.artist} | Chord Sequence`}
  description={`${song.title} by ${song.artist} — interactive chord chart with lyrics. Key of ${song.key}.${capoNote} Chords: ${uniqueChords}. Press Play to hear every chord as it appears in the song.`}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(musicSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-12 sm:py-20">

    <!-- Edit button (client-side: only shows if current user is the creator) -->
    <div class="flex justify-end mb-4">
      <CommunityEditButton client:load songSlug={slug} createdBy={pub.created_by} />
    </div>

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/songs/" class="hover:text-foreground transition-colors">Songs</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{song.title}</span>
    </nav>

    <!-- How to use hint -->
    <div class="mb-6 rounded-lg border border-primary/20 bg-primary/5 px-4 py-3 flex items-start gap-3">
      <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <p class="text-xs text-muted-foreground">
        Press <strong class="text-foreground">Play song</strong> to hear the chords.
        The active chord highlights above the lyrics so you always know where you are.
      </p>
    </div>

    <!-- Interactive player (server-rendered + hydrated) -->
    <SongChordPlayerIsland song={song} />

    <!-- Chord summary -->
    {allChords.length > 0 && (
      <div class="mt-10 rounded-xl border border-border bg-card p-5">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          Chords used in this song
        </h2>
        <div class="flex flex-wrap gap-2">
          {[...new Set(allChords)].map(chord => (
            <span class="text-sm font-bold font-mono px-3 py-1.5 rounded-lg border border-border bg-background text-foreground">
              {chord}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Back -->
    <div class="mt-8 text-center">
      <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← All song chord charts
      </a>
    </div>

  </main>
</BaseLayout>
