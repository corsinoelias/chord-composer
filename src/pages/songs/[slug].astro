---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SongChordPlayerIsland from '../../components/SongChordPlayerIsland.astro';
import CommunityEditButton from '../../components/CommunityEditButton';
import SongImageButton from '../../components/SongImageButton';
import ChordAside from '../../components/ChordAside';
import { SONGS, extractChordsFromSong } from '../../data/songs';
import type { Song } from '../../data/songs';
import { getPublicSongBySlug } from '@/lib/publicSongs';

const { slug } = Astro.params;

// Supabase is the source of truth — SONGS array is only a fallback
// if Supabase is unavailable (e.g. cold start failure or missing env vars).
let song: Song;
let isCommunity = false;
let communityCreatedBy: string | undefined;

const pub = slug ? await getPublicSongBySlug(slug) : null;

if (pub) {
  isCommunity = !SONGS.some(s => s.slug === pub.slug);
  communityCreatedBy = pub.created_by;
  song = {
    slug: pub.slug,
    title: pub.title,
    artist: pub.artist,
    album: pub.album,
    year: pub.year,
    genre: pub.genre,
    key: pub.key,
    capo: pub.capo,
    bpm: pub.bpm,
    style: pub.style,
    description: pub.description,
    tags: pub.tags,
    relatedProgressions: pub.relatedProgressions,
    sections: pub.sections,
  };
} else {
  // Fallback: static SONGS array (works even without Supabase)
  const staticSong = SONGS.find(s => s.slug === slug);
  if (!staticSong) {
    return Astro.redirect('/songs/');
  }
  song = staticSong;
}

const canonicalUrl = `https://chordsequence.com/songs/${song.slug}/`;
const allChords = extractChordsFromSong(song);
const uniqueChords = [...new Set(allChords)];
// Build a rich SEO description using lyrics, chords and song metadata.
function extractLyricLines(s: Song, maxLines = 3): string[] {
  const lines: string[] = [];
  for (const section of s.sections) {
    for (const line of section.lines) {
      const clean = line.replace(/\[([^\]]+)\]/g, '').trim();
      if (clean.length > 8) {
        lines.push(clean);
        if (lines.length >= maxLines) return lines;
      }
    }
  }
  return lines;
}

function buildSeoDescription(s: Song): string {
  const chordList = [...new Set(extractChordsFromSong(s))].join(', ');
  const capo = s.capo ? `, Capo ${s.capo}` : '';
  const year = s.year ? ` (${s.year})` : '';
  const genre = s.genre.length > 0 ? ` ${s.genre.join(', ')} song.` : '';
  const lyricLines = extractLyricLines(s, 3);
  const lyricPart = lyricLines.length > 0 ? ` "${lyricLines.join(' / ')}."` : '';

  const desc =
    `${s.title} chords by ${s.artist}${year} — Key of ${s.key}${capo}.${genre} ` +
    `Chords: ${chordList}.${lyricPart} ` +
    `Interactive chord chart with synchronized lyrics — press Play and follow each chord in real time.`;

  return desc.length > 320 ? desc.slice(0, 317) + '…' : desc;
}

const seoDescription = buildSeoDescription(song);

const relatedSongs = SONGS
  .filter(s => s.slug !== song.slug && s.genre.some(g => song.genre.includes(g)))
  .slice(0, 3);

const KNOWN_BANDS = new Set(['Oasis', 'The Beatles', 'Led Zeppelin', 'Pink Floyd', 'Oasis Ministry', 'Elevation Worship', 'Hillsong', 'Bethel Music', 'Radiohead', 'Coldplay', 'U2', 'Metallica', 'AC/DC']);
const composerType = KNOWN_BANDS.has(song.artist) ? 'MusicGroup' : 'Person';

const musicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  '@id': canonicalUrl,
  name: song.title,
  composer: { '@type': composerType, name: song.artist },
  inAlbum: song.album ? { '@type': 'MusicAlbum', name: song.album } : undefined,
  datePublished: song.year?.toString(),
  genre: song.genre.join(', '),
  url: canonicalUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Songs', item: 'https://chordsequence.com/songs/' },
    { '@type': 'ListItem', position: 3, name: `${song.title} Chords`, item: canonicalUrl },
  ],
};

// FAQPage schema intentionally removed — Google restricted FAQPage rich results
// to government/healthcare sites (Aug 2023). The FAQ content stays on-page for users.
---

<BaseLayout
  title={`${song.title} Chords — ${song.artist} | Chord Sequence`}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(musicSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-20">

    <!-- Edit + PDF buttons -->
    <div class="flex justify-end gap-2 mb-4">
      <!-- PDF export -->
      <a
        href={`/songs/pdf/${song.slug}/`}
        target="_blank"
        class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-1.5 transition-colors hover:border-primary/40"
        title="Export chord sheet as PDF"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9V2h12v7"/><rect x="6" y="13" width="12" height="9"/>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
        </svg>
        PDF
      </a>

      <!-- Image export -->
      <SongImageButton client:load song={song} />

      <!-- Edit -->
      {isCommunity ? (
        <CommunityEditButton client:only="react" songSlug={slug} createdBy={communityCreatedBy} />
      ) : (
        <a
          href={`/songs/new/?from-static=${song.slug}`}
          class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-1.5 transition-colors hover:border-primary/40"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit song
        </a>
      )}
    </div>

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/songs/" class="hover:text-foreground transition-colors">Songs</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{song.title}</span>
    </nav>

    <!-- How to use hint -->
    <div class="mb-6 rounded-lg border border-primary/20 bg-primary/5 px-4 py-3 flex items-start gap-3">
      <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <p class="text-xs text-muted-foreground">
        Press <strong class="text-foreground">Play song</strong> to hear the chords.
        The active chord highlights above the lyrics so you always know where you are.
        Hover any chord to see its diagram — click to hear it.
        {song.capo && (
          <span> Capo {song.capo}{song.capo === 1 ? 'st' : song.capo === 2 ? 'nd' : song.capo === 3 ? 'rd' : 'th'} fret.</span>
        )}
      </p>
    </div>

    <!-- Two-column layout: player + chord aside -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-6 items-start">

      <!-- Main column -->
      <div class="min-w-0">
        <SongChordPlayerIsland song={song} />

        <!-- Related progressions -->
        {song.relatedProgressions.length > 0 && (
          <div class="mt-8 pt-8 border-t border-border">
            <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
              Explore related progressions
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {song.relatedProgressions.map(slug => (
                <a
                  href={`/progressions/${slug}/`}
                  class="group flex items-center justify-between rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                >
                  <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors capitalize">
                    {slug.replace(/-/g, ' ')} chord progressions
                  </span>
                  <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Related songs -->
        {relatedSongs.length > 0 && (
          <div class="mt-8 pt-8 border-t border-border">
            <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
              More songs
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {relatedSongs.map(s => (
                <a
                  href={`/songs/${s.slug}/`}
                  class="group rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                >
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">{s.title}</p>
                  <p class="text-xs text-muted-foreground mt-0.5">{s.artist}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Back -->
        <div class="mt-8 text-center">
          <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            ← All song chord charts
          </a>
        </div>
      </div>

      <!-- Aside: chord visualizers -->
      {uniqueChords.length > 0 && (
        <aside class="lg:sticky lg:top-6">
          <ChordAside client:load chords={uniqueChords} songKey={song.key} />
        </aside>
      )}

    </div>

  </main>
</BaseLayout>
