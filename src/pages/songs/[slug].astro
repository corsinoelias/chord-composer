---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SongChordPlayerIsland from '../../components/SongChordPlayerIsland.astro';
import CommunityEditButton from '../../components/CommunityEditButton';
import ReportSongButton from '../../components/ReportSongButton';
import SongHeaderActions from '../../components/SongHeaderActions';
import ChordAside from '../../components/ChordAside';
import SongChordPreview from '../../components/SongChordPreview';
import ToolIcon from '../../components/ToolIcon.astro';
import type { ToolIconName } from '../../components/toolIcons';
import { SONGS, extractChordsFromSong } from '../../data/songs';
import type { Song } from '../../data/songs';
import { getPublicSongBySlug, getRelatedPublicSongs } from '@/lib/publicSongs';
import { buildSongEditorUrl } from '@/lib/editorLink';
import { buildKeyVariants } from '@/lib/songKeys';
import { fetchCoverImage } from '@/lib/coverImage';
import JsonLd from '../../components/schema/JsonLd.astro';
import { buildBreadcrumbSchema } from '../../components/schema/builders';

const { slug } = Astro.params;

// Supabase is the source of truth — SONGS array is only a fallback
// if Supabase is unavailable (e.g. cold start failure or missing env vars).
let song: Song;
let isCommunity = false;
let communityCreatedBy: string | undefined;

const pub = slug ? await getPublicSongBySlug(slug) : null;

if (pub) {
  isCommunity = !SONGS.some(s => s.slug === pub.slug);
  communityCreatedBy = pub.created_by;
  song = {
    slug: pub.slug,
    title: pub.title,
    artist: pub.artist,
    composerName: pub.composerName,
    album: pub.album,
    year: pub.year,
    genre: pub.genre,
    key: pub.key,
    capo: pub.capo,
    bpm: pub.bpm,
    style: pub.style,
    description: pub.description,
    tags: pub.tags,
    relatedProgressions: pub.relatedProgressions,
    sections: pub.sections,
    audioTrack: pub.audioTrack,
    audioWholeRange: pub.audioWholeRange,
  };
} else {
  // Fallback: static SONGS array (works even without Supabase)
  const staticSong = SONGS.find(s => s.slug === slug);
  if (!staticSong) {
    return Astro.redirect('/songs/', 301);
  }
  song = staticSong;
}

const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(Astro.url.hostname);
const canonicalUrl = `https://chordsequence.com/songs/${song.slug}/`;
const coverImage = await fetchCoverImage(song.slug, song.artist, song.title);
const allChords = extractChordsFromSong(song);
const uniqueChords = [...new Set(allChords)];
// The same chords written out in the keys people search for. Server-rendered on purpose:
// the transpose control on the chart is React, so until now the only answer to "great are
// you lord chords key of g" (874 impressions, this site's best-converting query shape)
// existed after hydration and Google never saw it. See src/lib/songKeys.ts for why these
// keys and not others.
const keyVariants = buildKeyVariants(song.key, uniqueChords);
// Build a rich SEO description using lyrics, chords and song metadata.
function extractCleanLyrics(s: Song): Array<{ name: string; lines: string[] }> {
  return s.sections.map(section => ({
    name: section.name,
    lines: section.lines.map(line => line.replace(/\[[^\]]+\]/g, '').trim()),
  })).filter(section => section.lines.some(l => l.length > 0));
}
const lyricsData = extractCleanLyrics(song);
const hasLyrics = lyricsData.some(s => s.lines.some(l => l.length > 0));

// Real lyric lines (with chords inlined, e.g. "[C] A thousand generations [F] falling...")
// — mirrors how Ultimate Guitar builds their description. Google discards templated/generic
// descriptions in favor of on-page content (confirmed: Cifra Club's declared meta tag was
// ignored entirely in favor of a raw lyric+chord snippet), so leading with real content
// avoids that override instead of fighting it. Pulls up to 3 lines (not just the first) to
// use more of the 120-320 char budget search engines allow for descriptions.
function buildSeoExcerpt(s: Song, maxLen = 220): string {
  const parts: string[] = [];
  let total = 0;
  for (const section of s.sections) {
    for (const line of section.lines) {
      // Skip instrumental/intro lines that are only chords with no actual lyric words
      // (e.g. "[Bb]   [C]   [F/A]   [Dm:2]  [C:2]") — strip the chords entirely first
      // to check what's left is real lyric text, not just chord-shaped tokens.
      const lyricOnly = line.replace(/\[[^\]]+\]/g, '').trim();
      if (lyricOnly.length <= 15) continue;
      // Chord tags are "[Chord]" or "[Chord:duration]" (e.g. "[Bb:2]") — keep the
      // brackets (just drop the duration suffix) instead of unwrapping to bare text.
      // A bare "A" or "Am" right before a word reads as the English word "a"/"am"
      // ("A Maybe we've made this complicated") — brackets remove that ambiguity
      // for every chord, not just those two.
      const withChords = line.replace(/\[([^:\]]+)(?::[\d.]+)?\]/g, '[$1] ').replace(/\s+/g, ' ').trim();
      if (total + withChords.length > maxLen) {
        if (parts.length === 0) return withChords.slice(0, maxLen - 1) + '…';
        return parts.join(' / ');
      }
      parts.push(withChords);
      total += withChords.length + 3; // + ' / ' separator
      if (parts.length >= 3) return parts.join(' / ');
    }
  }
  return parts.join(' / ');
}

function buildSeoDescription(s: Song): string {
  const artist = s.artist.trim();
  const excerpt = buildSeoExcerpt(s);
  // The tail names the instruments rather than saying "play along", and drops "lyrics"
  // for the same reason the title does (see buildSeoTitle). The fallback branch used to
  // end on "Key of {s.key}" — the RECORDED key, which is the one thing nobody searches
  // for: /songs/great-are-you-lord/ is stored in A and earns its clicks from "key of g",
  // /songs/center-bethel-music/ is stored in A and earns them from "key of c". Promising
  // any key is both truthful and what the query is actually asking.
  const desc = excerpt
    ? `${s.title} by ${artist} — ${excerpt}. Hear it played back in any key — piano, guitar, bass and drums. Free, no signup.`
    : `Play ${s.title} by ${artist} chords free in any key — interactive chart with real-time piano, guitar, bass and drums.`;

  return desc.length > 320 ? desc.slice(0, 317) + '…' : desc;
}

// Google truncates titles past ~65 characters — fall back to shorter variants rather than
// let it cut mid-word. Artist (not brand) is what search queries actually match — Google
// already rewrites our own deployed titles to insert the artist when we don't (confirmed on
// live SERP for /songs/washed-elevation-rhythm/). Brand is dropped: Google shows it separately
// via the breadcrumb line above the title, so repeating it here just costs budget. BPM is
// deliberately excluded — "bpm" queries have 0% CTR sitewide regardless of position.
//
// "& Lyrics" is gone, and "in Any Key" replaces it. Both come from the same 28-day
// Search Console read (Aug 2026):
//
//   - Lyric intent does not convert here. Queries containing "lyrics"/"letra" are 8,171
//     impressions at 1.21% CTR, and by position it is 1.6% at p5, 0.8% at p6, 1.0% at
//     p7-p8 — Genius and AZLyrics own that SERP below rank 4. Advertising lyrics in the
//     title bought impressions this page cannot convert and diluted the CTR Google sees.
//   - Key intent converts about twice as well as anything else at the SAME position:
//     10.5% vs 4.9% at p4, 7.4% vs 3.5% at p5, 4.6% vs 2.0% at p6.
//
// Deliberately NOT "Key of {s.key}": the recorded key is the one key nobody searches for.
// This site's key queries are for the key the singer wants, not the one on the record —
// great-are-you-lord is stored in A and earns 9.6% CTR on "key of g", center-bethel is
// stored in A and earns 13.1% on "key of c". Naming a specific key would put the title in
// direct contradiction with the query it is trying to match; "in Any Key" is what the page
// actually offers and still bolds on the word the query shares.
//
// Under test as of Sep 2026. Judge it on CLICKS, not impressions — dropping lyric intent
// should cost impressions on purpose. Baseline: 6,041 clicks / 190,318 impressions / 3.17%
// sitewide, and the eight song pages were ~490 clicks below their own positions' rate.
// Reassessment needs 2-3 weeks; `node scripts/gsc.mjs compare` and `... page songs/<slug>/`.
function buildSeoTitle(s: Song): string {
  const artist = s.artist.trim();
  const full = `${s.title} Chords in Any Key — ${artist}`;
  if (full.length <= 65) return full;

  const shortArtist = `${s.title} Chords — ${artist}`;
  if (shortArtist.length <= 65) return shortArtist;

  const noArtist = `${s.title} Chords in Any Key`;
  if (noArtist.length <= 65) return noArtist;

  return `${s.title} Chords`;
}

const seoDescription = buildSeoDescription(song);
const seoTitle = buildSeoTitle(song);


// Cross-link both curated (SONGS) and community (Supabase) songs sharing a genre —
// otherwise newly-added community songs never receive internal links from each other.
const communityRelated = await getRelatedPublicSongs(song.slug, song.genre, 3);
const relatedSongs = [
  ...SONGS.filter(s => s.slug !== song.slug && s.genre.some(g => song.genre.includes(g))),
  ...communityRelated,
].filter((s, i, arr) => arr.findIndex(x => x.slug === s.slug) === i)
  .slice(0, 3);

// ── Song analysis helpers ────────────────────────────────────────────────────
const KEY_MOODS: Record<string, string> = {
  C: 'pure and versatile — works across genres',
  G: 'warm and open — one of the most natural guitar keys',
  D: 'bright and triumphant',
  A: 'clear and resonant — rich in open strings',
  E: 'bright and powerful',
  B: 'sharp and intense',
  'F#': 'bright and cutting', Gb: 'bright and cutting',
  'C#': 'clear and full', Db: 'rich and romantic',
  Ab: 'grand and deep', 'G#': 'lush and dark',
  Eb: 'warm and ceremonial — common in worship and brass',
  Bb: 'warm and noble — popular in jazz',
  F: 'calm and contemplative',
  Am: 'melancholic and introspective',
  Em: 'dark and reflective — brooding and natural on guitar',
  Dm: 'somber and moving',
  Bm: 'wistful and bittersweet',
  'F#m': 'melancholic and searching',
  'C#m': 'deep and intense — popular in modern pop and worship',
  Gm: 'melancholic and noble',
  Cm: 'serious and dramatic',
}

function ordinal(n: number): string {
  const v = n % 100
  const s = ['th', 'st', 'nd', 'rd']
  return n + (s[(v - 20) % 10] || s[v] || s[0])
}

const isMinorKey = song.key.endsWith('m')
const fullKeyName = isMinorKey ? `${song.key.replace(/m$/, '')} minor` : `${song.key} major`
const keyMood = KEY_MOODS[song.key] ?? (isMinorKey ? 'expressive and introspective' : 'bright and versatile')

const tempoDesc =
  song.bpm < 70  ? 'slow and contemplative' :
  song.bpm < 90  ? 'slow and emotional' :
  song.bpm < 110 ? 'relaxed mid-tempo' :
  song.bpm < 130 ? 'upbeat' :
  song.bpm < 160 ? 'fast and driving' : 'intense and high-energy'

// Chords ranked by how often they're actually played, not by first appearance. A passing
// chord that shows up twice shouldn't headline a song built on four.
const chordUseCounts = allChords.reduce<Record<string, number>>((acc, c) => {
  acc[c] = (acc[c] ?? 0) + 1
  return acc
}, {})
const chordsByUse = Object.entries(chordUseCounts).sort((a, b) => b[1] - a[1])
const coreChords = chordsByUse.slice(0, 4).map(([c]) => c)

// Difficulty comes from the chords that carry the song — the fewest that cover 85% of all
// chord hits — not from the unique count. Counting decorations rated Wonderwall (four
// chords and two passing ones) "Intermediate", which is the opposite of how it's taught.
const totalChordHits = allChords.length || 1
let coveredHits = 0
let coreChordCount = 0
for (const [, hits] of chordsByUse) {
  coveredHits += hits
  coreChordCount++
  if (coveredHits / totalChordHits >= 0.85) break
}
const difficultyLabel =
  coreChordCount <= 4 ? 'Beginner' :
  coreChordCount <= 6 ? 'Beginner–Intermediate' :
  coreChordCount <= 9 ? 'Intermediate' : 'Advanced'

const yearText = song.year ? ` (${song.year})` : ''
const genreText = song.genre[0] ?? 'popular'

const KNOWN_BANDS = new Set(['Oasis', 'The Beatles', 'Led Zeppelin', 'Pink Floyd', 'Oasis Ministry', 'Elevation Worship', 'Hillsong', 'Bethel Music', 'Radiohead', 'Coldplay', 'U2', 'Metallica', 'AC/DC']);

// Google ignores our meta description on these pages and lifts a fragment of this
// paragraph instead — for a "<song> chords" query it picks whichever sentence contains
// chord names. It used to pick the full enumeration ("15 chords — Gb, Gbsus4, Ebmin7,
// C#, B, Db/F…"), which advertises the hardest possible reading of the song while the
// results above us lead with "Difficulty: Beginner · Key: G · Capo: 2nd fret". So the
// only sentence carrying chord names is now the core four, and the key/BPM/difficulty
// sit alongside them. The mood and tempo prose stays, but with no chord names in it,
// it shouldn't get picked for a chords query.
const capoShort = song.capo ? `, capo ${song.capo}` : ''
const coreChordList = coreChords.length > 1
  ? `${coreChords.slice(0, -1).join(', ')} and ${coreChords[coreChords.length - 1]}`
  : coreChords[0] ?? ''

// The closing sentence used to be built entirely from small fixed vocab buckets
// (tempoDesc: 6 options, keyMood: ~20 keyed by key name, genreText: first genre tag) —
// two songs sharing a key/tempo/genre combo (common across the worship-heavy catalog)
// could end up with a near-identical sentence, which is exactly the templated-paragraph
// pattern the 2026-07-31 audit flagged across 4+ songs. Section structure and total
// chord count are real per-song facts that vary far more, so they anchor the sentence
// instead — the mood/tempo prose stays (it reads better than raw numbers) but isn't
// carrying the whole sentence's uniqueness anymore.
const uniqueSectionNames = [...new Set(song.sections.map(s => s.name.replace(/\s*\d+$/, '')))]
const structureText = uniqueSectionNames.length > 1
  ? `${uniqueSectionNames.slice(0, -1).join(', ')} and ${uniqueSectionNames[uniqueSectionNames.length - 1]}`
  : uniqueSectionNames[0] ?? 'a single section'

const analysisText =
  `${song.title} by ${song.artist}${yearText} — ${fullKeyName}${capoShort}, ${song.bpm} BPM, ${difficultyLabel.toLowerCase()}. ` +
  `Built around ${coreChordList}. Transpose to any key right on the page. ` +
  `The chart moves through ${structureText}, using ${uniqueChords.length} chord${uniqueChords.length !== 1 ? 's' : ''} in total — ` +
  `a ${tempoDesc} ${genreText} song, and ${fullKeyName} is ${keyMood}.`

// Server-rendered deep link into the editor, carrying this song's full section
// structure. The player bar builds its own (with the listener's live transposition
// and BPM); this one is for the plain <a>s below, which is what search engines read
// and what mobile visitors actually get — the player bar's link is desktop-only.
const songEditorUrl = buildSongEditorUrl(song);

// Chord Player leads this list deliberately: it's the flagship tool, and this is the
// one contextual in-content link to the bare /chord-player/ (the nav/footer ones are
// sitewide boilerplate, which carries far less weight).
//
// It points at the bare URL on purpose, NOT at songEditorUrl: robots.txt allows only
// `/chord-player/$` and disallows the rest of `/chord-player/`, so every `?data=` deep
// link is crawl-blocked and can pass nothing on to the canonical page. The CTA above
// keeps the deep link because its whole value is opening *this* song; this card is the
// one that has to be followable.
const practiceTools: { href: string; label: string; desc: string; icon: ToolIconName }[] = [
  { href: '/chord-player/', label: 'Chord Player', desc: 'Build and play chord progressions with real piano, guitar, bass & drums', icon: 'piano' },
  { href: '/chord-lookup/', label: 'Chord Finder', desc: 'Find the fingering for any chord, not just the ones in this song', icon: 'chords' },
  { href: `/metronome/?bpm=${song.bpm}`, label: 'Metronome', desc: `Practice at ${song.bpm} BPM`, icon: 'metronome' },
  { href: '/tools/drum-machine/', label: 'Drum Machine', desc: `Program a beat at ${song.bpm} BPM to play along to`, icon: 'step-grid' },
  { href: '/tuner/', label: 'Guitar Tuner', desc: 'Tune before you play', icon: 'tuner' },
  { href: '/tools/guitar-tab/', label: 'Guitar Tab Player', desc: 'Tab out the melody note by note on a 6-string grid', icon: 'guitar' },
  { href: '/tools/bass-guitar-tab/', label: 'Bass Tab Player', desc: `Build the bass line for ${song.title} on a 4-string grid`, icon: 'bass-tab' },
  { href: '/tools/drum-tab/', label: 'Drum Tab Player', desc: `Write out the drum groove for ${song.title} in notation or tab`, icon: 'step-grid' },
  { href: '/tools/chord-transposer/', label: 'Chord Transposer', desc: 'Move the chords to a friendlier key for your voice', icon: 'transpose' },
]

const composerName = song.composerName || song.artist;
const isCover = !!song.composerName && song.composerName !== song.artist;

const songFaq = [
  {
    q: `Who wrote ${song.title}?`,
    a: isCover
      ? `${song.title} was written by ${composerName}, performed here by ${song.artist}${song.year ? ` (this recording released ${song.year})` : ''}.${song.album ? ` It appears on the album "${song.album}".` : ''}`
      : `${song.title} was written and recorded by ${song.artist}${song.year ? ` and released in ${song.year}` : ''}.${song.album ? ` It appears on the album "${song.album}".` : ''}`,
  },
  {
    q: `What key is ${song.title} in?`,
    a: `${song.title} is in ${fullKeyName}.${song.capo ? ` On guitar, place a capo on the ${ordinal(song.capo)} fret to play in the original recorded key.` : ''}`,
  },
  {
    q: `What are the chords in ${song.title}?`,
    a: `The chord chart uses ${uniqueChords.length} chord${uniqueChords.length !== 1 ? 's' : ''}: ${uniqueChords.join(', ')}.`,
  },
  {
    q: `How fast is ${song.title}?`,
    a: `${song.title} is played at ${song.bpm} BPM (beats per minute) — a ${tempoDesc} feel.`,
  },
  {
    q: `Is ${song.title} easy to play?`,
    a: `${song.title} is built around ${coreChordCount} main chord${coreChordCount !== 1 ? 's' : ''}${song.capo ? ` and a capo on the ${ordinal(song.capo)} fret` : ''} — ${uniqueChords.length} in total once you count the passing chords — so it's rated ${difficultyLabel}. ${coreChordCount <= 4 ? 'Most beginners can learn it in one session.' : 'It takes some practice but is very manageable.'}`,
  },
  ...(song.capo ? [{
    q: `Does ${song.title} use a capo?`,
    a: `Yes — place a capo on the ${ordinal(song.capo)} fret to play ${song.title} in its original key.`,
  }] : []),
  {
    q: `Can I get a printable PDF of ${song.title}?`,
    a: `Yes — click PDF in the toolbar above for a printable, transposable chord chart for ${song.title} by ${song.artist}. Free, no signup needed.`,
  },
]
// ────────────────────────────────────────────────────────────────────────────

const composerType = KNOWN_BANDS.has(composerName) ? 'MusicGroup' : 'Person';

const musicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  '@id': canonicalUrl,
  name: song.title,
  description: song.description,
  composer: { '@type': composerType, name: composerName },
  // schema.org requires lyricist to be a Person — omit it for bands (MusicGroup),
  // since we don't track a distinct lyricist and can't validly attribute lyrics to a group here.
  ...(composerType === 'Person' ? { lyricist: { '@type': 'Person', name: composerName } } : {}),
  musicalKey: song.key,
  datePublished: song.year?.toString(),
  genre: song.genre.join(', '),
  url: canonicalUrl,
  image: {
    '@type': 'ImageObject',
    url: `https://chordsequence.com/og/songs/${song.slug}`,
    width: 1200,
    height: 630,
  },
};

const breadcrumbSchema = buildBreadcrumbSchema(canonicalUrl, [
  { name: 'Home', item: 'https://chordsequence.com/' },
  { name: 'Songs', item: 'https://chordsequence.com/songs/' },
  { name: `${song.title} Chords`, item: canonicalUrl },
]);

// FAQPage schema intentionally removed — Google restricted FAQPage rich results
// to government/healthcare sites (Aug 2023). The FAQ content stays on-page for users.
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  ogImage={isCommunity
    ? `https://chordsequence.com/og/page/auto/?t=${encodeURIComponent(song.title + ' Chords — ' + song.artist)}&d=${encodeURIComponent(seoDescription.slice(0, 200))}`
    : `https://chordsequence.com/og/songs/${song.slug}`}
  ogImageAlt={`${song.title} by ${song.artist} — chords in Key of ${song.key}`}
  author="Elías Corsino Saldaña"
>
  <Fragment slot="head">
    <JsonLd schema={musicSchema} />
    <JsonLd schema={breadcrumbSchema} />
  </Fragment>

  <main class="mx-auto max-w-6xl px-4 sm:px-6 pt-4 pb-10 sm:pt-8 sm:pb-16">

    <!-- Breadcrumb — kept close to the title below it (mb-3/4, not the old mb-8) so the
         two read as one header block. The visual break for the next section happens after
         the title via the sticky bar's own border-b, not here. -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-3 sm:mb-4">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/songs/" class="hover:text-foreground transition-colors">Songs</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{song.title}</span>
    </nav>

    <!-- Song header: title + cover + actions — a normal document heading now, not pinned.
         Scrolls away like any title; Play/Practice live in #song-header-transport below,
         portalled in by SongChordPlayer (see SongHeaderTransport.tsx). -->
    <div class="-mx-4 sm:-mx-6 px-4 sm:px-6 py-3 mb-1 flex items-start sm:items-center gap-4 border-b border-border">
      {coverImage && (
        <img
          src={coverImage}
          alt={`${song.title} by ${song.artist} — album cover`}
          class="w-16 h-16 rounded-xl object-cover shrink-0 shadow-sm border border-border"
          loading="eager"
          width="64"
          height="64"
        />
      )}
      <!-- Title and actions share this column (instead of actions sitting next to the cover
           image at the outer level) so that when actions wrap to their own line on mobile,
           they inherit the title's left edge, not the cover art's — previously they lined up
           flush with the thumbnail, a column to the left of where the title actually starts,
           which read as a stray toolbar rather than something that belonged to the heading. -->
      <div class="flex-1 min-w-0 flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex-1 min-w-0">
          <h1 class="text-xl sm:text-3xl font-bold text-foreground leading-tight truncate">{song.title} Chords</h1>
          <p class="text-sm text-muted-foreground mt-0.5 truncate">
            {song.artist}{song.year ? ` · ${song.year}` : ''}{song.album ? ` · ${song.album}` : ''}
          </p>
        </div>
        <!-- w-full forces this onto its own line on mobile, where the title/album otherwise had
             to compete with 3-4 icon buttons for space in one row and got squeezed unreadable;
             sm:w-auto + sm:ml-auto puts it back inline, pinned to the row's right edge, once
             there's room. -->
        <div class="w-full sm:w-auto sm:ml-auto flex justify-start">
          <SongHeaderActions client:load song={song} isCommunity={isCommunity} isLocalhost={isLocalhost} />
        </div>
      </div>
    </div>

    <!-- Header transport (Play/Practice) + song stats share one row on desktop instead of two
         separate skinny rows, each mostly empty space on a wide viewport — stats sit to the
         right, flush with the transport, and only stack under it once the screen narrows. -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mt-4 mb-6">
      <!-- Portal target for the React island's header transport (Play/Stop + Practice) — see
           SongHeaderTransport.tsx. SongChordPlayer (client:load) is one of the heaviest
           islands on this page — it carries the whole playback engine — so this div sits
           empty in the server-rendered HTML until its bundle downloads, parses and
           hydrates, which is slow enough to notice, especially in dev.
           `grid` + `grid-template-columns: minmax(0,1fr)` here, with both the shimmer AND
           SongHeaderTransport's own root (see its `col-start-1 row-start-1`) placed in the
           SAME cell, is the piano page's skeleton-stacking trick (piano/index.astro):
           the two layers overlap instead of stacking as separate block rows, so fading the
           shimmer out never reserves double height/width for the ~150ms both are mounted —
           a plain block parent did exactly that and was the actual cause of the visible
           jump + blank gap, not the fade timing itself. The script at the bottom of this
           file removes the shimmer once createPortal has appended the real buttons. -->
      <div id="song-header-transport" class="grid" style="grid-template-columns: minmax(0,1fr);">
        <div id="song-header-transport-skeleton" class="col-start-1 row-start-1 flex items-center gap-2.5 transition-opacity duration-150" aria-hidden="true">
          <span class="h-10 w-[136px] rounded-full bg-muted animate-pulse"></span>
          <span class="h-10 w-[108px] rounded-full bg-muted animate-pulse"></span>
        </div>
      </div>

      <!-- Song stats -->
      <div class="flex flex-wrap gap-2 lg:justify-end">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-foreground">
          <svg class="w-3 h-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {song.bpm} BPM
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-foreground">
          <svg class="w-3 h-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          Key of <span id="song-key-value">{song.key}</span>
        </span>
        {song.genre.map(g => (
          <span class="text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-muted-foreground capitalize">{g}</span>
        ))}
        {song.capo && (
          <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-primary/30 bg-primary/5 text-primary">
            Capo {song.capo}
          </span>
        )}
        <span class={`text-xs font-medium px-2.5 py-1 rounded-full border ${difficultyLabel === 'Beginner' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : difficultyLabel === 'Beginner–Intermediate' ? 'border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400' : difficultyLabel === 'Intermediate' ? 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400'}`}>
          {difficultyLabel}
        </span>
      </div>
    </div>

    <!-- Practice panel — Sections/Mixer/Tempo/Metronome/Export, expands in normal document
         flow below the transport+stats row; see SongPracticePanel.tsx. -->
    <div id="song-practice-panel"></div>

    <!-- Tab bar -->
    <div class="flex border-b border-border mb-6 gap-0" role="tablist" aria-label="Song view">
      <button
        id="tab-btn-chords"
        role="tab"
        aria-selected="true"
        aria-controls="tab-panel-chords"
        data-tab="chords"
        class="px-4 py-2.5 text-sm font-semibold text-foreground border-b-2 border-primary -mb-px transition-colors"
      >
        Chords
      </button>
      {hasLyrics && (
        <button
          id="tab-btn-lyrics"
          role="tab"
          aria-selected="false"
          aria-controls="tab-panel-lyrics"
          data-tab="lyrics"
          class="px-4 py-2.5 text-sm font-semibold text-muted-foreground border-b-2 border-transparent -mb-px hover:text-foreground transition-colors"
        >
          Lyrics
        </button>
      )}
    </div>

    <!-- Chords tab panel -->
    <div id="tab-panel-chords" role="tabpanel" aria-labelledby="tab-btn-chords">

      <!-- Chord preview / now playing — pulled up here (was buried below the whole chart as
           part of ChordAside) so it's visible without scrolling past the song first, on both
           mobile and desktop. ChordAside below still owns the "Chords used" list. -->
      {uniqueChords.length > 0 && (
        <div class="mb-6">
          <SongChordPreview client:load chords={uniqueChords} songKey={song.key} />
        </div>
      )}

      <!-- Full-width chart column — no reserved side column. The old two-column split (chart +
           300px aside for the performance rail/chord diagrams) is gone: the rail was replaced
           by the on-demand Practice panel (see [slug].astro's #song-practice-panel above), and
           ChordAside now sits in its own non-sticky section below the chart. -->
      <div class="max-w-none">
        <div class="min-w-0">
          <SongChordPlayerIsland song={song} />

          <!-- Chord diagrams — a plain, non-sticky block right under the chart. Used to live in
               a sticky sidebar; now scrolls with everything else, like the rest of the page. -->
          {uniqueChords.length > 0 && (
            <div class="mt-8">
              <ChordAside client:load chords={uniqueChords} songKey={song.key} songSlug={song.slug} />
            </div>
          )}

          <!--
            The song in the keys people search for. No client directive anywhere in here —
            that is the entire point. The chart's own transpose control is React, so the
            answer to "<song> chords key of g" only existed after hydration; this is the
            same answer in the served HTML. Each row gets an id so a link (or a Google jump
            link) can land on one key.
          -->
          {keyVariants.length > 1 && (
            <section class="mt-8 rounded-xl border border-border bg-card p-5 sm:p-6" aria-labelledby="other-keys-heading">
              <h2 id="other-keys-heading" class="text-base font-semibold text-foreground">
                {song.title} chords in other keys
              </h2>
              <p class="mt-1.5 text-sm text-muted-foreground">
                The same progression moved to whichever key suits your voice. Every chord below is
                the transposed chart, not a different arrangement.
              </p>

              <dl class="mt-5 divide-y divide-border">
                {keyVariants.map((variant) => (
                  <div id={`key-of-${variant.key.toLowerCase().replace('#', '-sharp')}`} class="flex flex-col gap-2 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                    <dt class="flex shrink-0 items-baseline gap-2 sm:w-40">
                      <span class="text-sm font-semibold text-foreground">Key of {variant.label}</span>
                      {variant.isOriginal && (
                        <span class="rounded-full border border-border px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                          Original
                        </span>
                      )}
                    </dt>
                    <dd class="flex min-w-0 flex-wrap gap-1.5">
                      {variant.chords.map((chord) => (
                        <span class="rounded-md border border-border bg-background px-2 py-1 font-mono text-xs text-foreground">
                          {chord}
                        </span>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>

              <p class="mt-4 text-sm text-muted-foreground">
                Need a key that isn't here? The chart above transposes to any of the twelve, and
                plays back in whichever you pick.
              </p>
            </section>
          )}

          <!--
            Song → editor conversion point. Sits right under the chart, where someone has
            just heard the song and the natural next thought is "what if I change it".
            Deliberately a plain <a> with no client directive: it has to be in the served
            HTML (for the anchor text signal to /chord-player/) and it has to work on
            mobile, where the player bar's own Editor link is hidden.
          -->
          <section class="mt-8 rounded-xl border border-border bg-card p-5 sm:p-6">
            <div class="flex items-start gap-4">
              <div class="hidden sm:flex w-11 h-11 rounded-lg bg-primary/10 items-center justify-center shrink-0">
                <ToolIcon name="piano" class="w-6 h-6 text-primary" />
              </div>
              <div class="min-w-0 flex-1">
                <h2 class="text-base font-semibold text-foreground">
                  Open {song.title} in the Chord Player
                </h2>
                <p class="mt-1.5 text-sm text-muted-foreground">
                  Change the chords, try a different rhythm style, transpose to your key, and export to WAV.
                </p>
                <a
                  href={songEditorUrl}
                  data-editor-cta
                  data-entry-point="cta_block"
                  data-song-slug={song.slug}
                  class="mt-4 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
                >
                  Open in the Chord Player
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </section>

          <!-- Related progressions -->
          {song.relatedProgressions.length > 0 && (
            <div class="mt-8 pt-8 border-t border-border">
              <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
                Explore related progressions
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {song.relatedProgressions.map(slug => (
                  <a
                    href={`/progressions/${slug}/`}
                    class="group flex items-center justify-between rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                  >
                    <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors capitalize">
                      {slug.replace(/-/g, ' ')} chord progressions
                    </span>
                    <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Related songs -->
          {relatedSongs.length > 0 && (
            <div class="mt-8 pt-8 border-t border-border">
              <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
                Play next
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {relatedSongs.map(s => (
                  <a
                    href={`/songs/${s.slug}/`}
                    class="group rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                  >
                    <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">{s.title}</p>
                    <p class="text-xs text-muted-foreground mt-0.5">{s.artist}</p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- About this song -->
          <section class="mt-10 pt-8 border-t border-border">
            <h2 class="text-xl font-bold text-foreground mb-3">About {song.title}</h2>
            <p class="text-muted-foreground leading-relaxed text-sm">{analysisText}</p>

            <div class="mt-6 space-y-2">
              <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Frequently asked questions</h3>
              {songFaq.map((f) => (
                <div class="rounded-xl border border-border bg-card overflow-hidden">
                  <details class="group">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-3.5 text-sm font-semibold text-foreground select-none list-none hover:bg-accent/30 transition-colors">
                      {f.q}
                      <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="border-t border-border px-5 py-3.5">
                      <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
                    </div>
                  </details>
                </div>
              ))}
            </div>
            {pub && (
              <div class="mt-4">
                <ReportSongButton client:visible songSlug={song.slug} />
              </div>
            )}
          </section>

          <!-- Practice tools -->
          <section class="mt-10 pt-8 border-t border-border">
            <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Practice tools</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {practiceTools.map((tool) => (
                <a
                  href={tool.href}
                  data-editor-cta={tool.href === '/chord-player/' ? '' : undefined}
                  data-entry-point={tool.href === '/chord-player/' ? 'practice_tools' : undefined}
                  data-song-slug={tool.href === '/chord-player/' ? song.slug : undefined}
                  class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                >
                  <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                    <ToolIcon name={tool.icon} class="w-5 h-5 text-primary" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">{tool.label}</p>
                    <p class="text-xs text-muted-foreground">{tool.desc}</p>
                  </div>
                  <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </section>

          <!-- Back -->
          <div class="mt-8 text-center">
            <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              ← All song chord charts
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Lyrics tab panel -->
    {hasLyrics && (
      <div id="tab-panel-lyrics" role="tabpanel" aria-labelledby="tab-btn-lyrics" class="hidden">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold text-foreground mb-1">{song.title} Lyrics</h2>
          <p class="text-sm text-muted-foreground mb-8">
            {song.artist}{song.year ? ` · ${song.year}` : ''}{song.album ? ` · ${song.album}` : ''}
          </p>

          <div class="space-y-8">
            {lyricsData.map(section => (
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-primary mb-3">[{section.name}]</p>
                <div class="space-y-0.5 font-serif text-[15px] leading-7 text-foreground">
                  {section.lines.map(line =>
                    line
                      ? <p>{line}</p>
                      : <div class="h-2" />
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <button
              data-tab="chords"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-sm font-semibold hover:bg-primary/90 transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Play with chords
            </button>
            <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              ← All song chord charts
            </a>
          </div>
        </div>
      </div>
    )}

  </main>

  <script define:vars={{ songSlug: song.slug }}>
    // Plain JS below, not TS — `define:vars` (needed to get songSlug into this inline
    // script) makes Astro treat the whole tag as `is:inline`, which drops TS processing;
    // see https://docs.astro.build/en/guides/client-side-scripts/#script-processing.
    // Tab nav buttons (in the tab bar, role=tab) handle both styling + switching
    const navBtns = document.querySelectorAll('[role="tab"][data-tab]');
    // All [data-tab] elements (including "Play with chords" CTA) trigger switching
    const allTriggers = document.querySelectorAll('[data-tab]');
    const panels = {
      chords: document.getElementById('tab-panel-chords'),
      lyrics: document.getElementById('tab-panel-lyrics'),
    };

    function switchTab(target) {
      navBtns.forEach(btn => {
        const active = btn.dataset.tab === target;
        btn.setAttribute('aria-selected', String(active));
        btn.classList.toggle('text-foreground', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('font-semibold', active);
        btn.classList.toggle('text-muted-foreground', !active);
        btn.classList.toggle('border-transparent', !active);
      });
      Object.entries(panels).forEach(([key, el]) => {
        el?.classList.toggle('hidden', key !== target);
      });
    }

    // Chords vs Lyrics is the split between "wants to play along" and "wants to read
    // along" traffic — see the song_tab_switched entry in src/lib/analytics.ts. Tracked
    // here (not from React) because the tab bar itself is plain server-rendered markup,
    // same reasoning as the song_editor_opened CTAs below. `role="tab"` distinguishes the
    // actual tab bar from the "Play with chords" CTA button, which also carries
    // `data-tab="chords"` to reuse switchTab but isn't really tab navigation.
    allTriggers.forEach(el => {
      el.addEventListener('click', () => {
        const target = el.dataset.tab;
        switchTab(target);
        const g = window.gtag;
        if (typeof g !== 'function') return;
        g('event', 'song_tab_switched', {
          song_slug: songSlug,
          tab: target,
          entry_point: el.getAttribute('role') === 'tab' ? 'tab_bar' : 'lyrics_cta',
        });
      });
    });

    // Song → editor conversion, from the two server-rendered links on this page. The
    // player bar's own link reports itself from React (entry_point 'player_bar'); these
    // two are plain <a>s, so they report here. gtag only exists in PROD (see BaseLayout),
    // hence the guard. The event fires on a link that navigates away — gtag uses
    // sendBeacon, which survives unload.
    // The parameter must stay `entry_point`, never `source` — GA4 reads `source` as the
    // session's traffic source and overwrites the real one (see src/lib/analytics.ts).
    document.querySelectorAll('[data-editor-cta]').forEach(el => {
      el.addEventListener('click', () => {
        const g = window.gtag;
        if (typeof g !== 'function') return;
        g('event', 'song_editor_opened', { song_slug: el.dataset.songSlug, entry_point: el.dataset.entryPoint });
      });
    });

    // The "Key of …" chip is server-rendered, so it used to keep naming the original key while
    // the whole chart below it played and read in another one. It follows the Pitch control now.
    // No transpose maths here on purpose: SongChordPlayer puts the key it already computed on
    // the event, so the chip can never drift from the chart (and this page doesn't become the
    // eighth copy of the sharps/flats table).
    const songKeyValue = document.getElementById('song-key-value');
    if (songKeyValue) {
      window.addEventListener('song-transpose', (e) => {
        const displayKey = e.detail && e.detail.displayKey;
        if (displayKey) songKeyValue.textContent = displayKey;
      });
    }

    // Removes the Play/Practice shimmer once SongChordPlayer's createPortal appends the
    // real buttons into the same #song-header-transport node (see the comment above it).
    // A MutationObserver, not the astro:hydrate event the piano page's skeleton uses —
    // this page mounts several other client:load islands too (SongHeaderActions,
    // SongChordPreview, ChordAside), so "the first island to hydrate" isn't reliably this
    // one; watching the actual DOM effect we care about is the only precise signal.
    const headerTransport = document.getElementById('song-header-transport');
    if (headerTransport) {
      const removeShimmer = () => {
        const shimmer = document.getElementById('song-header-transport-skeleton');
        if (!shimmer) return;
        shimmer.style.opacity = '0';
        shimmer.addEventListener('transitionend', () => shimmer.remove(), { once: true });
        setTimeout(() => shimmer.remove(), 250); // fallback in case transitionend never fires
      };
      // .children (Element children only), not .childNodes — childNodes also counts the
      // whitespace text nodes between this template's tags, which made the "already
      // hydrated" check below true from the very first paint and removed the shimmer
      // almost immediately, well before SongChordPlayer had actually loaded.
      if (headerTransport.children.length > 1) {
        removeShimmer();
      } else {
        const shimmerObserver = new MutationObserver(() => {
          if (headerTransport.children.length > 1) {
            shimmerObserver.disconnect();
            removeShimmer();
          }
        });
        shimmerObserver.observe(headerTransport, { childList: true });
      }
    }
  </script>
</BaseLayout>
