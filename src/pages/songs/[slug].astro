---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SongChordPlayerIsland from '../../components/SongChordPlayerIsland.astro';
import CommunityEditButton from '../../components/CommunityEditButton';
import SongImageButton from '../../components/SongImageButton';
import ChordAside from '../../components/ChordAside';
import { SONGS, extractChordsFromSong } from '../../data/songs';
import type { Song } from '../../data/songs';
import { getPublicSongBySlug } from '@/lib/publicSongs';
import { fetchCoverImage } from '@/lib/coverImage';

const { slug } = Astro.params;

// Supabase is the source of truth — SONGS array is only a fallback
// if Supabase is unavailable (e.g. cold start failure or missing env vars).
let song: Song;
let isCommunity = false;
let communityCreatedBy: string | undefined;

const pub = slug ? await getPublicSongBySlug(slug) : null;

if (pub) {
  isCommunity = !SONGS.some(s => s.slug === pub.slug);
  communityCreatedBy = pub.created_by;
  song = {
    slug: pub.slug,
    title: pub.title,
    artist: pub.artist,
    album: pub.album,
    year: pub.year,
    genre: pub.genre,
    key: pub.key,
    capo: pub.capo,
    bpm: pub.bpm,
    style: pub.style,
    description: pub.description,
    tags: pub.tags,
    relatedProgressions: pub.relatedProgressions,
    sections: pub.sections,
  };
} else {
  // Fallback: static SONGS array (works even without Supabase)
  const staticSong = SONGS.find(s => s.slug === slug);
  if (!staticSong) {
    return Astro.redirect('/songs/', 301);
  }
  song = staticSong;
}

const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(Astro.url.hostname);
const canonicalUrl = `https://chordsequence.com/songs/${song.slug}/`;
const coverImage = await fetchCoverImage(song.slug, song.artist, song.title);
const allChords = extractChordsFromSong(song);
const uniqueChords = [...new Set(allChords)];
// Build a rich SEO description using lyrics, chords and song metadata.
function extractCleanLyrics(s: Song): Array<{ name: string; lines: string[] }> {
  return s.sections.map(section => ({
    name: section.name,
    lines: section.lines.map(line => line.replace(/\[[^\]]+\]/g, '').trim()),
  })).filter(section => section.lines.some(l => l.length > 0));
}
const lyricsData = extractCleanLyrics(song);
const hasLyrics = lyricsData.some(s => s.lines.some(l => l.length > 0));

function extractLyricLines(s: Song, maxLines = 3): string[] {
  const lines: string[] = [];
  for (const section of s.sections) {
    for (const line of section.lines) {
      const clean = line.replace(/\[([^\]]+)\]/g, '').trim();
      if (clean.length > 8) {
        lines.push(clean);
        if (lines.length >= maxLines) return lines;
      }
    }
  }
  return lines;
}

function buildSeoDescription(s: Song): string {
  const chordList = [...new Set(extractChordsFromSong(s))].join(', ');
  const capo = s.capo ? `, Capo ${s.capo}` : '';
  const year = s.year ? ` (${s.year})` : '';
  const genre = s.genre.length > 0 ? ` ${s.genre.join(', ')} song.` : '';

  const desc =
    `${s.title} chords by ${s.artist}${year} — Key of ${s.key}${capo}.${genre} ` +
    `Chords: ${chordList}. Interactive chord chart — press Play and follow each chord in real time.`;

  return desc.length > 155 ? desc.slice(0, 152) + '…' : desc;
}

const seoDescription = buildSeoDescription(song);


const relatedSongs = SONGS
  .filter(s => s.slug !== song.slug && s.genre.some(g => song.genre.includes(g)))
  .slice(0, 3);

// ── Song analysis helpers ────────────────────────────────────────────────────
const KEY_MOODS: Record<string, string> = {
  C: 'pure and versatile — works across genres',
  G: 'warm and open — one of the most natural guitar keys',
  D: 'bright and triumphant',
  A: 'clear and resonant — rich in open strings',
  E: 'bright and powerful',
  B: 'sharp and intense',
  'F#': 'bright and cutting', Gb: 'bright and cutting',
  'C#': 'clear and full', Db: 'rich and romantic',
  Ab: 'grand and deep', 'G#': 'lush and dark',
  Eb: 'warm and ceremonial — common in worship and brass',
  Bb: 'warm and noble — popular in jazz',
  F: 'calm and contemplative',
  Am: 'melancholic and introspective',
  Em: 'dark and reflective — brooding and natural on guitar',
  Dm: 'somber and moving',
  Bm: 'wistful and bittersweet',
  'F#m': 'melancholic and searching',
  'C#m': 'deep and intense — popular in modern pop and worship',
  Gm: 'melancholic and noble',
  Cm: 'serious and dramatic',
}

function ordinal(n: number): string {
  const v = n % 100
  const s = ['th', 'st', 'nd', 'rd']
  return n + (s[(v - 20) % 10] || s[v] || s[0])
}

const isMinorKey = song.key.endsWith('m')
const fullKeyName = isMinorKey ? `${song.key.replace(/m$/, '')} minor` : `${song.key} major`
const keyMood = KEY_MOODS[song.key] ?? (isMinorKey ? 'expressive and introspective' : 'bright and versatile')

const tempoDesc =
  song.bpm < 70  ? 'slow and contemplative' :
  song.bpm < 90  ? 'slow and emotional' :
  song.bpm < 110 ? 'relaxed mid-tempo' :
  song.bpm < 130 ? 'upbeat' :
  song.bpm < 160 ? 'fast and driving' : 'intense and high-energy'

const difficultyLabel =
  uniqueChords.length <= 3 ? 'Beginner' :
  uniqueChords.length <= 5 ? 'Beginner–Intermediate' :
  uniqueChords.length <= 8 ? 'Intermediate' : 'Advanced'

const capoText = song.capo ? ` with a capo on the ${ordinal(song.capo)} fret` : ''
const yearText = song.year ? ` (${song.year})` : ''
const genreText = song.genre[0] ?? 'popular'

const KNOWN_BANDS = new Set(['Oasis', 'The Beatles', 'Led Zeppelin', 'Pink Floyd', 'Oasis Ministry', 'Elevation Worship', 'Hillsong', 'Bethel Music', 'Radiohead', 'Coldplay', 'U2', 'Metallica', 'AC/DC']);

const analysisText =
  `${song.title} by ${song.artist}${yearText} is a ${tempoDesc} ${genreText} song written in ${fullKeyName}${capoText}. ` +
  `${fullKeyName.charAt(0).toUpperCase() + fullKeyName.slice(1)} is ${keyMood}. ` +
  `The chord chart uses ${uniqueChords.length} chord${uniqueChords.length !== 1 ? 's' : ''} — ${uniqueChords.join(', ')} — at ${song.bpm} BPM.`

const songFaq = [
  {
    q: `Who wrote ${song.title}?`,
    a: `${song.title} was written and recorded by ${song.artist}${song.year ? ` and released in ${song.year}` : ''}.${song.album ? ` It appears on the album "${song.album}".` : ''}`,
  },
  {
    q: `What key is ${song.title} in?`,
    a: `${song.title} is in ${fullKeyName}.${song.capo ? ` On guitar, place a capo on the ${ordinal(song.capo)} fret to play in the original recorded key.` : ''}`,
  },
  {
    q: `What are the chords in ${song.title}?`,
    a: `The chord chart uses ${uniqueChords.length} chord${uniqueChords.length !== 1 ? 's' : ''}: ${uniqueChords.join(', ')}.`,
  },
  {
    q: `How fast is ${song.title}?`,
    a: `${song.title} is played at ${song.bpm} BPM (beats per minute) — a ${tempoDesc} feel.`,
  },
  {
    q: `Is ${song.title} easy to play?`,
    a: `With ${uniqueChords.length} unique chord${uniqueChords.length !== 1 ? 's' : ''}${song.capo ? ` and a capo on the ${ordinal(song.capo)} fret` : ''}, ${song.title} is rated ${difficultyLabel}. ${uniqueChords.length <= 4 ? 'Most beginners can learn it in one session.' : 'It takes some practice but is very manageable.'}`,
  },
  ...(song.capo ? [{
    q: `Does ${song.title} use a capo?`,
    a: `Yes — place a capo on the ${ordinal(song.capo)} fret to play ${song.title} in its original key.`,
  }] : []),
]
// ────────────────────────────────────────────────────────────────────────────

const composerType = KNOWN_BANDS.has(song.artist) ? 'MusicGroup' : 'Person';

const musicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  '@id': canonicalUrl,
  name: song.title,
  description: song.description,
  composer: { '@type': composerType, name: song.artist },
  lyricist: { '@type': composerType, name: song.artist },
  musicalKey: song.key,
  inAlbum: song.album ? { '@type': 'MusicAlbum', name: song.album } : undefined,
  datePublished: song.year?.toString(),
  genre: song.genre.join(', '),
  url: canonicalUrl,
  image: {
    '@type': 'ImageObject',
    url: `https://chordsequence.com/og/songs/${song.slug}`,
    width: 1200,
    height: 630,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Songs', item: 'https://chordsequence.com/songs/' },
    { '@type': 'ListItem', position: 3, name: `${song.title} Chords`, item: canonicalUrl },
  ],
};

// FAQPage schema intentionally removed — Google restricted FAQPage rich results
// to government/healthcare sites (Aug 2023). The FAQ content stays on-page for users.
---

<BaseLayout
  title={`${song.title} Chords & Lyrics — ${song.artist} | Chord Sequence`}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  ogImage={isCommunity
    ? `https://chordsequence.com/og/page/auto/?t=${encodeURIComponent(song.title + ' Chords — ' + song.artist)}&d=${encodeURIComponent(seoDescription.slice(0, 200))}`
    : `https://chordsequence.com/og/songs/${song.slug}`}
  ogImageAlt={`${song.title} by ${song.artist} — chords in Key of ${song.key}`}
  author="Elías Corsino Saldaña"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(musicSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-20">

    <!-- Edit + PDF buttons -->
    <div class="flex justify-end gap-2 mb-4">
      <!-- PDF export -->
      <a
        href={`/songs/pdf/${song.slug}/`}
        target="_blank"
        class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-1.5 transition-colors hover:border-primary/40"
        title="Export chord sheet as PDF"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9V2h12v7"/><rect x="6" y="13" width="12" height="9"/>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
        </svg>
        PDF
      </a>

      <!-- Image export -->
      <SongImageButton client:load song={song} />

      <!-- Edit (localhost only) -->
      {isLocalhost && (
        <a
          href={isCommunity ? `/songs/new/?edit=${song.slug}` : `/songs/new/?from-static=${song.slug}`}
          class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-1.5 transition-colors hover:border-primary/40"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit song
        </a>
      )}
    </div>

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/songs/" class="hover:text-foreground transition-colors">Songs</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{song.title}</span>
    </nav>

    <!-- Song header: title + cover + share -->
    <div class="flex items-start gap-4 mb-5">
      {coverImage && (
        <img
          src={coverImage}
          alt={`${song.title} by ${song.artist} — album cover`}
          class="w-16 h-16 rounded-xl object-cover shrink-0 shadow-sm border border-border"
          loading="eager"
          width="64"
          height="64"
        />
      )}
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground leading-tight">{song.title} Chords</h1>
        <p class="text-sm text-muted-foreground mt-0.5">
          {song.artist}{song.year ? ` · ${song.year}` : ''}{song.album ? ` · ${song.album}` : ''}
        </p>
      </div>
      <button
        id="share-btn"
        class="shrink-0 inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-1.5 transition-colors hover:border-primary/40"
        title="Share this song"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
          <polyline points="16 6 12 2 8 6"/>
          <line x1="12" y1="2" x2="12" y2="15"/>
        </svg>
        <span id="share-label">Share</span>
      </button>
    </div>

    <!-- Song stats -->
    <div class="flex flex-wrap gap-2 mb-6">
      <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-foreground">
        <svg class="w-3 h-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {song.bpm} BPM
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-foreground">
        <svg class="w-3 h-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        Key of {song.key}
      </span>
      {song.genre.map(g => (
        <span class="text-xs font-medium px-2.5 py-1 rounded-full border border-border bg-muted/40 text-muted-foreground capitalize">{g}</span>
      ))}
      {song.capo && (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-primary/30 bg-primary/5 text-primary">
          Capo {song.capo}
        </span>
      )}
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full border ${difficultyLabel === 'Beginner' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : difficultyLabel === 'Beginner–Intermediate' ? 'border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400' : difficultyLabel === 'Intermediate' ? 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400'}`}>
        {difficultyLabel}
      </span>
    </div>

    <!-- Tab bar -->
    <div class="flex border-b border-border mb-6 gap-0" role="tablist" aria-label="Song view">
      <button
        id="tab-btn-chords"
        role="tab"
        aria-selected="true"
        aria-controls="tab-panel-chords"
        data-tab="chords"
        class="px-4 py-2.5 text-sm font-semibold text-foreground border-b-2 border-primary -mb-px transition-colors"
      >
        Chords
      </button>
      {hasLyrics && (
        <button
          id="tab-btn-lyrics"
          role="tab"
          aria-selected="false"
          aria-controls="tab-panel-lyrics"
          data-tab="lyrics"
          class="px-4 py-2.5 text-sm font-semibold text-muted-foreground border-b-2 border-transparent -mb-px hover:text-foreground transition-colors"
        >
          Lyrics
        </button>
      )}
    </div>

    <!-- Chords tab panel -->
    <div id="tab-panel-chords" role="tabpanel" aria-labelledby="tab-btn-chords">

      <!-- How to use hint -->
      <div class="mb-6 rounded-lg border border-primary/20 bg-primary/5 px-4 py-3 flex items-start gap-3">
        <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <p class="text-xs text-muted-foreground">
          Press <strong class="text-foreground">Play song</strong> to hear the chords.
          The active chord highlights above the lyrics so you always know where you are.
          Hover any chord to see its diagram — click to hear it.
          {song.capo && (
            <span> Capo {song.capo}{song.capo === 1 ? 'st' : song.capo === 2 ? 'nd' : song.capo === 3 ? 'rd' : 'th'} fret.</span>
          )}
        </p>
      </div>

      <!-- Two-column layout: player + chord aside -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-6 items-start">

        <!-- Main column -->
        <div class="min-w-0">
          <SongChordPlayerIsland song={song} />

          <!-- Related progressions -->
          {song.relatedProgressions.length > 0 && (
            <div class="mt-8 pt-8 border-t border-border">
              <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
                Explore related progressions
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {song.relatedProgressions.map(slug => (
                  <a
                    href={`/progressions/${slug}/`}
                    class="group flex items-center justify-between rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                  >
                    <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors capitalize">
                      {slug.replace(/-/g, ' ')} chord progressions
                    </span>
                    <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Related songs -->
          {relatedSongs.length > 0 && (
            <div class="mt-8 pt-8 border-t border-border">
              <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
                More songs
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {relatedSongs.map(s => (
                  <a
                    href={`/songs/${s.slug}/`}
                    class="group rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
                  >
                    <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">{s.title}</p>
                    <p class="text-xs text-muted-foreground mt-0.5">{s.artist}</p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- About this song -->
          <section class="mt-10 pt-8 border-t border-border">
            <h2 class="text-xl font-bold text-foreground mb-3">About {song.title}</h2>
            <p class="text-muted-foreground leading-relaxed text-sm">{analysisText}</p>

            <div class="mt-6 space-y-2">
              <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Frequently asked questions</h3>
              {songFaq.map((f) => (
                <div class="rounded-xl border border-border bg-card overflow-hidden">
                  <details class="group">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-3.5 text-sm font-semibold text-foreground select-none list-none hover:bg-accent/30 transition-colors">
                      {f.q}
                      <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="border-t border-border px-5 py-3.5">
                      <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
                    </div>
                  </details>
                </div>
              ))}
            </div>
          </section>

          <!-- Practice tools -->
          <section class="mt-10 pt-8 border-t border-border">
            <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Practice tools</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <a
                href={`/metronome/?bpm=${song.bpm}`}
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V12m0-4V6M9 6h6M12 22l-4-6h8l-4 6z"/><line x1="5" y1="3" x2="19" y2="3"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Metronome</p>
                  <p class="text-xs text-muted-foreground">Practice at {song.bpm} BPM</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a
                href="/tuner/"
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="12" x2="15" y2="15"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Guitar Tuner</p>
                  <p class="text-xs text-muted-foreground">Tune before you play</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a
                href="/tools/guitar-tab/"
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="2" y1="6" x2="22" y2="6"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="15" x2="22" y2="15"/><line x1="2" y1="18" x2="22" y2="18"/><line x1="2" y1="21" x2="22" y2="21"/><circle cx="7" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="13" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="9" cy="18" r="2" fill="currentColor" stroke="none"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Guitar Tab Player</p>
                  <p class="text-xs text-muted-foreground">Tab out the melody note by note on a 6-string grid</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a
                href="/tools/bass-guitar-tab/"
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Bass Tab Player</p>
                  <p class="text-xs text-muted-foreground">Build the bass line for {song.title} on a 4-string grid</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a
                href="/tools/chord-transposer/"
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 7 5-5 5 5"/><path d="M8 2v20"/><path d="m21 17-5 5-5-5"/><path d="M16 22V2"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Chord Transposer</p>
                  <p class="text-xs text-muted-foreground">Move the chords to a friendlier key for your voice</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a
                href="/tools/scales/"
                class="group flex items-center gap-3 rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors"
              >
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="2" y1="6" x2="22" y2="6"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="18" x2="22" y2="18"/><circle cx="6" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="10" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="18" cy="6" r="2" fill="currentColor" stroke="none"/><circle cx="8" cy="18" r="2" fill="currentColor" stroke="none"/><circle cx="14" cy="18" r="2" fill="currentColor" stroke="none"/></svg>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">Scale Explorer</p>
                  <p class="text-xs text-muted-foreground">Find the scales that work over the {song.key} key</p>
                </div>
                <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary ml-auto shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </section>

          <!-- Back -->
          <div class="mt-8 text-center">
            <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              ← All song chord charts
            </a>
          </div>
        </div>

        <!-- Aside: chord visualizers -->
        {uniqueChords.length > 0 && (
          <aside class="lg:sticky lg:top-6">
            <ChordAside client:load chords={uniqueChords} songKey={song.key} />
          </aside>
        )}

      </div>
    </div>

    <!-- Lyrics tab panel -->
    {hasLyrics && (
      <div id="tab-panel-lyrics" role="tabpanel" aria-labelledby="tab-btn-lyrics" class="hidden">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold text-foreground mb-1">{song.title} Lyrics</h2>
          <p class="text-sm text-muted-foreground mb-8">
            {song.artist}{song.year ? ` · ${song.year}` : ''}{song.album ? ` · ${song.album}` : ''}
          </p>

          <div class="space-y-8">
            {lyricsData.map(section => (
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-primary mb-3">[{section.name}]</p>
                <div class="space-y-0.5 font-serif text-[15px] leading-7 text-foreground">
                  {section.lines.map(line =>
                    line
                      ? <p>{line}</p>
                      : <div class="h-2" />
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <button
              data-tab="chords"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-sm font-semibold hover:bg-primary/90 transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Play with chords
            </button>
            <a href="/songs/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              ← All song chord charts
            </a>
          </div>
        </div>
      </div>
    )}

  </main>

  <script>
    // Tab nav buttons (in the tab bar, role=tab) handle both styling + switching
    const navBtns = document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab]');
    // All [data-tab] elements (including "Play with chords" CTA) trigger switching
    const allTriggers = document.querySelectorAll<HTMLElement>('[data-tab]');
    const panels: Record<string, HTMLElement | null> = {
      chords: document.getElementById('tab-panel-chords'),
      lyrics: document.getElementById('tab-panel-lyrics'),
    };

    function switchTab(target: string) {
      navBtns.forEach(btn => {
        const active = btn.dataset.tab === target;
        btn.setAttribute('aria-selected', String(active));
        btn.classList.toggle('text-foreground', active);
        btn.classList.toggle('border-primary', active);
        btn.classList.toggle('font-semibold', active);
        btn.classList.toggle('text-muted-foreground', !active);
        btn.classList.toggle('border-transparent', !active);
      });
      Object.entries(panels).forEach(([key, el]) => {
        el?.classList.toggle('hidden', key !== target);
      });
    }

    allTriggers.forEach(el => {
      el.addEventListener('click', () => switchTab(el.dataset.tab!));
    });

    // Share button
    const shareBtn = document.getElementById('share-btn');
    const shareLabel = document.getElementById('share-label');
    shareBtn?.addEventListener('click', async () => {
      const url = window.location.href;
      const title = document.title;
      try {
        if (navigator.share) {
          await navigator.share({ title, url });
        } else {
          await navigator.clipboard.writeText(url);
          if (shareLabel) {
            shareLabel.textContent = 'Copied!';
            setTimeout(() => { shareLabel.textContent = 'Share'; }, 2000);
          }
        }
      } catch {}
    });
  </script>
</BaseLayout>
