---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ChordFinderTool } from '../../components/ChordLookup/ChordFinderTool'
import { ChordIdentifier } from '../../components/ChordLookup/ChordIdentifier'

const faqs = [
  { q: 'How do I find out what chord I&rsquo;m playing?', a: 'Tap the notes on the keyboard at the top of this page — the same ones your fingers are on — and the chord name appears underneath. You don&rsquo;t need to know the root or the type first; that&rsquo;s what the tool works out for you.' },
  { q: 'Why does it sometimes show more than one chord name?', a: 'Because some chords genuinely share the same notes. C–E–G–A is both C6 and Am7 — which one it is depends on the musical context, not on the notes alone. The tool shows the most likely reading first and lists the alternatives underneath, using the lowest note as a tie-breaker.' },
  { q: 'Can it identify inversions and slash chords?', a: 'Yes. The lowest note you tap is treated as the bass, so C–E–G played with E at the bottom comes out as C/E rather than plain C. Play the same notes with C lowest and it goes back to C.' },
  { q: 'What if I&rsquo;m not playing every note of the chord?', a: 'That still works for the fifth and for upper extensions — a C7 without its fifth is still identified as C7, and it says &ldquo;no 5&rdquo; so you know what was left out. The third and the seventh are what define a chord, so those are never assumed.' },
  { q: 'How do I read the keyboard diagram?', a: 'Every highlighted key is part of the chord, labelled with its note name. The root note — the note the chord is named after — is shown in a solid, darker color; the other chord tones are lighter.' },
  { q: 'Can I play the chord in a different octave?', a: 'Yes — the pattern of keys is identical in every octave. Play the same shape higher for a brighter sound or lower for a fuller one.' },
  { q: 'What&rsquo;s the difference between &quot;C D E&quot; and &quot;Do Re Mi&quot;?', a: 'Two naming systems for the same notes: English notation (C, D, E&#8230;) and Latin solf&#232;ge (Do, Re, Mi&#8230;), common in Spain and Latin America. Use the toggle above the keyboard to switch — every label updates.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/piano-chord-lookup/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Finder', item: 'https://chordsequence.com/chord-lookup/' },
    { '@type': 'ListItem', position: 3, name: 'Piano Chord Finder', item: 'https://chordsequence.com/piano-chord-lookup/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Piano Chord Identifier & Finder',
  url: 'https://chordsequence.com/piano-chord-lookup/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Tap the notes you are playing and get the chord name, inversions and slash chords included — or go the other way and see which keys to press for any chord, from triads to 13ths.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Piano Chord Identifier & Finder — Name Any Chord You Play"
  description="Tap the notes you're playing and get the chord name — inversions and slash chords included. Or go the other way: pick a chord and see which keys to press."
  canonicalUrl="https://chordsequence.com/piano-chord-lookup/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#f7f5fb;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#241d33">
    <div style="min-height:100vh;padding:24px 20px 64px;box-sizing:border-box">
      <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;gap:18px">
        <header style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/chord-lookup/" style="font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#7C3AED">&larr; Chord Finder</a>
            <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.6px">Piano Chord Identifier</h1>
            <p style="margin:0;font-size:15.5px;color:#6f6788;max-width:620px">Tap the notes you&rsquo;re playing and we&rsquo;ll name the chord — or look up any chord to see which keys to press.</p>
          </div>
          <div style="display:inline-flex;background:#ece6f7;border-radius:12px;padding:4px;gap:2px">
            <a href="/guitar-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Guitar</a>
            <span style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;background:#ffffff;color:#241d33;box-shadow:0 1px 3px rgba(30,20,60,0.18)">Piano</span>
            <a href="/ukulele-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Ukulele</a>
          </div>
        </header>

        <!--
          Identificador arriba y buscador debajo, los dos siempre renderizados. No son
          pestanas a proposito: React no montaria la inactiva y ese contenido desapareceria
          del HTML servido. Asi las dos direcciones estan en el HTML y quien busco
          "what piano chord is this" aterriza directamente en lo que pidio.
        -->
        <ChordIdentifier client:load />

        <div style="display:flex;flex-direction:column;gap:6px;margin-top:6px">
          <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Find any piano chord</h2>
          <p style="margin:0;font-size:14.5px;color:#6f6788;max-width:620px">Know the chord name already? Pick a root and a type to see which keys to press.</p>
        </div>

        <ChordFinderTool instrument="piano" client:load />

        <section style="background:#ffffff;border:1px solid #e7e0f2;border-radius:18px;padding:26px 28px;display:flex;flex-direction:column;gap:20px;box-shadow:0 1px 4px rgba(40,25,80,0.05)">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Naming a chord you&rsquo;re already playing</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">If your fingers are on a chord but you don&rsquo;t know what it&rsquo;s called, tap those same notes on the keyboard at the top of the page. The name appears as you go, and it&rsquo;s worked out from the notes themselves — you don&rsquo;t need to know the root or the chord type first.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">The lowest note you pick counts as the bass, so an inversion comes out as a slash chord — C&#8211;E&#8211;G with E at the bottom reads as C/E. And when a set of notes has more than one honest name, you get all of them: C&#8211;E&#8211;G&#8211;A is C6 and Am7 at the same time, so both are shown rather than picking one and hiding the other.</p>

            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Looking up a chord by name</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">The other direction is a visual dictionary of piano chords. Pick any of the 12 root notes and 30 chord types — from a simple C major triad to a Cmaj13 — and the keys you need to press light up on a three-octave keyboard, each labelled with its note name. The root note is shown in a solid color so you always know where the chord is built from.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">Press Play to hear the chord note by note — each key lights up as it sounds — and then all notes together. Switch between English note names (C, D, E) and solf&#232;ge (Do, Re, Mi) with one click.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Piano chord FAQs</h2>
            <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
              {faqs.map((f) => (
                <details style="border:1px solid #e7e0f2;border-radius:12px;padding:13px 18px">
                  <summary style="font-size:14.5px;font-weight:600;cursor:pointer" set:html={f.q} />
                  <p style="margin:10px 0 2px;font-size:14px;line-height:1.6;color:#4c4462" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        </section>

        <footer style="font-size:13px;color:#8a819e;display:flex;gap:8px;flex-wrap:wrap">
          <span>Also available:</span>
          <a href="/guitar-chord-lookup/" style="color:#7C3AED">Guitar chord finder</a> &middot;
          <a href="/ukulele-chord-lookup/" style="color:#7C3AED">Ukulele chord finder</a> &middot;
          <a href="/chord-lookup/" style="color:#7C3AED">All instruments</a>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>
