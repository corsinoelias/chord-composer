---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ChordFinderTool } from '../../components/ChordLookup/ChordFinderTool'

// Sin JSON-LD de FAQPage a proposito — ver la nota en guitar-chord-lookup.
const faqs = [
  { q: 'How do I find out what chord I&rsquo;m playing on the ukulele?', a: 'Switch to &ldquo;Notes &rarr; name&rdquo; and click the fret you&rsquo;re holding on each of the four strings; the circle by the nut plays a string open and the &times; clears it. With three notes we name the chord.' },
  { q: 'Can I just type the chord name?', a: 'Yes. The search box takes almost any spelling &mdash; <strong>Cmaj7</strong>, <strong>CM7</strong>, <strong>C-7</strong>, <strong>F#m7b5</strong>, <strong>Bb sus4</strong>, even solf&egrave;ge like <strong>sol7</strong> or <strong>do menor</strong>. Press <strong>/</strong> to jump straight to it, use &uarr;&darr; to pick a suggestion and &crarr; to load it.' },
  { q: 'What tuning do the diagrams use?', a: 'Standard ukulele tuning, GCEA (soprano, concert, and tenor with high G). The leftmost string in the diagram is the G string, closest to you when you hold the uke.' },
  { q: 'What is the &ldquo;re-entrant&rdquo; high-G string?', a: 'On most ukuleles the fourth string (G) is tuned an octave higher than you&rsquo;d expect, so the strings don&rsquo;t go low-to-high in order. The audio here plays that high G, so what you hear matches a real ukulele.' },
  { q: 'Can I use a capo on the ukulele?', a: 'Yes. Set a capo position and the chord you ask for is shown as the shape you actually play, with fret numbers counted from the capo. <strong>Lower</strong> and <strong>Higher</strong> move capo and shape together so the shape stays put while the chord transposes.' },
  { q: 'What do the numbers on the dots mean?', a: 'Which finger of your fretting hand to use: 1 = index, 2 = middle, 3 = ring, 4 = pinky. A long pill across several strings is a barre &mdash; one finger pressing them all at once.' },
  { q: 'Are guitar chord shapes the same on ukulele?', a: 'No &mdash; the ukulele has four strings and a different tuning, so shapes are their own. (Fun fact: a uke shape matches the guitar&rsquo;s top four strings capoed at the 5th fret.) Use the <a href="/guitar-chord-lookup/">guitar chord lookup</a> for guitar shapes.' },
  { q: 'I play a left-handed ukulele &mdash; can I use the diagrams?', a: 'Yes. Turn on &ldquo;Left-handed&rdquo; and the string order is flipped to match a ukulele strung for a left-handed player, on both the diagrams and the fretboard.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/ukulele-chord-lookup/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Lookup', item: 'https://chordsequence.com/chord-lookup/' },
    { '@type': 'ListItem', position: 3, name: 'Ukulele Chord Lookup', item: 'https://chordsequence.com/ukulele-chord-lookup/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Ukulele Chord Lookup',
  url: 'https://chordsequence.com/ukulele-chord-lookup/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Find any chord in GCEA tuning with finger numbers and positions, or click the frets you are playing and we name the chord.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Ukulele Chord Lookup — Find Any Ukulele Chord (GCEA)"
  description="Ukulele chord lookup, both ways: find any chord in GCEA tuning with finger numbers and positions, or click the frets you are playing and we name the chord."
  canonicalUrl="https://chordsequence.com/ukulele-chord-lookup/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#f7f5fb;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#241d33">
    <div style="min-height:100vh;padding:24px 20px 64px;box-sizing:border-box">
      <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;gap:18px">
        <header style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap">
          <div style="display:flex;flex-direction:column;gap:6px">
            <a href="/chord-lookup/" style="font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#7C3AED">&larr; Chord Lookup</a>
            <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.6px">Ukulele Chord Lookup</h1>
            <p style="margin:0;font-size:15.5px;color:#6f6788;max-width:620px;text-wrap:pretty">Look up any ukulele chord in GCEA tuning &mdash; or go the other way: click the frets you&rsquo;re playing and we name the chord.</p>
          </div>
          <div style="display:inline-flex;background:#ece6f7;border-radius:12px;padding:4px;gap:2px">
            <a href="/guitar-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Guitar</a>
            <a href="/piano-chord-lookup/" style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;color:#6f6788">Piano</a>
            <span style="border-radius:9px;padding:10px 22px;font-size:14px;font-weight:600;background:#ffffff;color:#241d33;box-shadow:0 1px 3px rgba(30,20,60,0.18)">Ukulele</span>
          </div>
        </header>

        <ChordFinderTool instrument="ukulele" client:load />

        <section style="background:#ffffff;border:1px solid #e7e0f2;border-radius:18px;padding:26px 28px;display:flex;flex-direction:column;gap:20px;box-shadow:0 1px 4px rgba(40,25,80,0.05)">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">About the ukulele chord lookup</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">A visual dictionary of ukulele chords in standard GCEA tuning. Search a chord by name, or pick any of the 12 root notes and 30 chord types and see the chord on a four-string diagram: numbered dots for each finger, barres drawn as pills, &#9675; for open strings, and the note each string sounds.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">Many chords include alternative positions higher up the neck. Press Play to hear the chord string by string &mdash; with the re-entrant high-G string voiced correctly &mdash; and then strummed together. A left-handed mode mirrors every diagram, and a capo setting recalculates the shape you play, the fret numbers and the pitches you hear.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px;text-wrap:pretty">It also works in reverse. Switch to <strong style="font-weight:700">Notes &rarr; name</strong> and click the fret you&rsquo;re holding on each of the four strings; the &#215; button clears a string you don&rsquo;t play. With three or more notes we name the chord &mdash; order and octave are irrelevant, so any voicing of Do, Mi and Sol is simply C major. When the same notes have more than one valid name (C&ndash;E&ndash;G&ndash;A reads as C6 or Am7) the most common one comes first.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Ukulele chord FAQs</h2>
            <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
              {faqs.map((f) => (
                <details style="border:1px solid #e7e0f2;border-radius:12px;padding:13px 18px">
                  <summary style="font-size:14.5px;font-weight:600;cursor:pointer" set:html={f.q} />
                  <p style="margin:10px 0 2px;font-size:14px;line-height:1.6;color:#4c4462" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        </section>

        <footer style="font-size:13px;color:#8a819e;display:flex;gap:8px;flex-wrap:wrap">
          <span>Also available:</span>
          <a href="/guitar-chord-lookup/" style="color:#7C3AED">Guitar chord lookup</a> &middot;
          <a href="/piano-chord-lookup/" style="color:#7C3AED">Piano chord lookup</a> &middot;
          <a href="/chord-lookup/" style="color:#7C3AED">All instruments</a>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>
