      <div class="grid w-full grid-cols-1 items-center gap-3 md:grid-cols-2 md:gap-5 lg:grid-cols-[minmax(0,1fr)_340px_minmax(0,1fr)] lg:gap-0">
        <div class="relative flex items-center justify-center md:col-span-2 lg:order-2 lg:col-span-1">
