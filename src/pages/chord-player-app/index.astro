          <div class="relative flex w-full flex-col gap-2 rounded-[24px] bg-primary p-4 max-md:[@media(max-height:760px)]:py-3 text-primary-foreground sm:p-5 shadow-[0_20px_48px_rgba(106,31,234,0.3)] sm:gap-3 lg:w-[300px] lg:rounded-[28px] lg:p-6">
            <h3 class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-white/80">Shared by both</h3>
