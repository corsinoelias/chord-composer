---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import GooglePlayBadge from '../../components/GooglePlayBadge.astro';
import JsonLd from '@/components/schema/JsonLd.astro';
import { buildBreadcrumbSchema, buildMobileApplicationSchema } from '@/components/schema/builders';
import { APP, instrumentList } from '@/data/facts';

// The site's page for the Chord Player mobile app (com.eliascorsino.chord_sequencer). The
// URL names the app rather than the platform because an iOS build is planned; the copy
// says Android only until that build exists. Not /app/: that path is the signed-in library.
//
// Every number on this page is the app's, from APP in src/data/facts.ts, which
// tests/facts/facts.ts checks against the Flutter source. Not the web editor's: the two
// differ, and the Play listing once copied the web's numbers. Every feature it names is in
// the app too (loop: loopingSection; screen off: PlaybackService.kt; count-in and click:
// settings_screen.dart; key: transpose and Apply key) — docs/ficha-play.md in the app's
// repository maps each one to its code.
//
// It sells uses, not features: who the app is for comes first, each with the features that
// make it work. The browser is presented as the same instrument, not as a rival: what the
// two share is true today (one engine, the app's rhythms and sounds, one catalogue); what
// they don't — songs do not sync between them yet — is said once, plainly.
//
// Each Play badge has its own `from`, so Play Console and GA4 can tell which one installs.
// The title leads with "Chord Player App": Search Console (2026-08-31 to 09-27) showed
// "chord player app" as the page's main query, 30 impressions at position 7.6 and no
// clicks, with "chord progression app android" at 10.5 and "chord progression app" at 27.
// It also names what the Keyword Planner (worldwide, 2026-09-29) finds bigger: "backing
// track app" 720 a month, "chord progression app" 320, "worship backing tracks app" 170,
// against 110 for "chord player app". Android stays in the description and the H1, not the
// title, to keep it under 60 characters.
//
// LAYOUT: every block marked data-fit is at most one screen tall — the viewport minus the
// 65px sticky navbar — at every size from a 360x740 phone to a 1920x1080 desktop, and
// data-fit-lg holds the same from 1024px up. Heights that must give are tied to the screen
// with svh (not vh: on a phone vh ignores the address bar), and short desktop screens
// (1280x720, 1024x768) get a compact type scale through `max-height` media queries.
// Nothing is removed to fit: what does not fit is folded (tabs, a carousel, <details>) and
// stays in the HTML. `npm run check:landing-fit` measures all of it against a running
// server and fails when a block outgrows its screen.
const PAGE_URL = 'https://chordsequence.com/chord-player-app/';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.eliascorsino.chord_sequencer';

const description =
  `The Chord Player app for Android turns your chords into a backing track: pick one of ${APP.rhythms} rhythms and a full band plays along. Loop, slow down, change the key.`;

const band = instrumentList(APP.instruments);

// Stroke icons (Lucide shapes), drawn inline.
const ICONS: Record<string, string> = {
  loop: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  gauge: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  key: '<path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>',
  timer: '<line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  drum: '<path d="m2 2 8 8"/><path d="m22 2-8 8"/><ellipse cx="12" cy="9" rx="10" ry="5"/><path d="M7 13.4v7.9"/><path d="M12 14v8"/><path d="M17 13.4v7.9"/><path d="M2 9v8a10 5 0 0 0 20 0V9"/>',
  phone: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  laptop: '<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
};

// The hero's checks. The first three are the ones a phone shows; the rest need the room.
const checks = ['Free', 'No account', 'Works offline', `Android ${APP.minAndroid}+`, APP.languages.join(' and ')];

const practiceTools = [
  { icon: 'loop', title: 'Loop any section', text: 'It starts on the downbeat, round and round' },
  { icon: 'gauge', title: `${APP.tempo.min} to ${APP.tempo.max} BPM`, text: 'Start slow, speed up as you get it' },
  { icon: 'key', title: 'Any key', text: 'A new key, or a semitone at a time' },
  { icon: 'timer', title: 'Click and count-in', text: 'An accent on the one, a bar to get ready' },
  { icon: 'moon', title: 'Screen off, still playing', text: 'Play and stop from the notification' },
  { icon: 'zap', title: 'Fill on demand', text: 'Tap it and the break lands on the next bar' },
];

// The practice panel draws the app's transport rather than showing a screenshot of it.
// Chord colours are the app's: major triads amber, minor blue (chordMajor / chordMinor).
const practiceChords = [
  { name: 'G', degree: 'I', playing: true, minor: false },
  { name: 'D', degree: 'V', playing: false, minor: false },
  { name: 'Em', degree: 'vi', playing: false, minor: true },
  { name: 'C', degree: 'IV', playing: false, minor: false },
];

// The six uses: tabs from 768px up, a swiped carousel below. `tint` is the instrument
// colour of the app's theme (app_theme.dart) the panel borrows; `ink` is that colour darkened
// until text on the tint passes 4.5:1. `short` is what a phone shows; `text` and `bullets`
// are there too, folded away below 768px. The ids are the anchors other pages link to
// (/chord-player-app/#worship): the script opens the tab or card an anchor names.
type Use = {
  id: string; label: string; dot: string; tint: string; ink: string;
  title: string; short: string; text: string; bullets: string[];
  shot?: string; alt?: string;
};
const uses: Use[] = [
  {
    id: 'practice', label: 'Practice', dot: '#1783FF', tint: '#E6F0FF', ink: '#0B5FD6',
    title: 'Practice with a band that never gets tired.',
    short: 'Loop the chorus, slow it down, move it to your key and play along.',
    text: 'Loop the chorus until it’s in your hands. Slow it down, move it to your key and play along. Lock the phone: the band keeps going.',
    bullets: [],
  },
  {
    id: 'worship', label: 'Worship teams', dot: '#E8B93E', tint: '#FBF3DC', ink: '#8A6400',
    title: 'Rehearse Sunday’s set in the singer’s key.',
    short: 'Worship backing tracks for the set, in the key of the voice that sings it.',
    text: 'Make the worship backing tracks for the set yourself: open a song from the chordsequence.com catalogue or write it in, pick Worship, Modern Worship or Gospel, and move the whole song until it sits in the voice that has to sing it.',
    bullets: [
      'Change the key of the whole song, or step it a semitone at a time',
      'Guitar shapes and piano keys for every chord, for whoever is playing',
      'An intro and an ending, so the song starts and stops like a band',
    ],
    shot: 'chord-editor', alt: 'The chord editor, showing the chords of the key, the length of the chord and its bass note',
  },
  {
    id: 'latin', label: 'Latin & keyboard styles', dot: '#FF3849', tint: '#FDE7EA', ink: '#B0102A',
    title: 'An arranger keyboard, in your pocket.',
    short: 'Cumbia, bachata, vallenato, norteño, salsa: intro, verse, chorus, fill and ending.',
    text: 'Cumbia, bachata, vallenato, norteño, bolero, salsa, played the way a keyboard plays them: a way in, a groove for the verse, a fuller one for the chorus, a fill when you call it and a proper ending.',
    bullets: [
      `${APP.percussionRows} rows of hand percussion: congas, bongos, timbales, güiro, claves…`,
      'Intro, A, B and Ending on nearly every rhythm; each section picks its part',
      'Change any step of the groove, and tap the drums with your fingers',
    ],
    shot: 'rhythm-editor', alt: 'The rhythm editor on the drums: a step grid for the kit and the Latin percussion, with Intro, A, B and Ending tabs',
  },
  {
    id: 'songwriters', label: 'Songwriters', dot: '#E0609A', tint: '#FBE7F0', ink: '#A3205C',
    title: 'Catch the idea before it’s gone.',
    short: 'Sections, chords that fit your key, and an M4A for the band. No signal needed.',
    text: 'Write it section by section, let Suggest offer chords that fit your key, give the chorus strings and the verse piano, then send the band an M4A. No signal needed.',
    bullets: [
      'A Suggest button for a progression in your key',
      'A different sound for each part of the song',
      'Export M4A to share, WAV to keep editing',
    ],
    shot: 'progressions', alt: 'Classic progressions to start from, each with its chords and what it sounds like',
  },
  {
    id: 'producers', label: 'Producers', dot: '#8C7AE6', tint: '#ECE9FB', ink: '#5140B8',
    title: 'Sketch it here, finish it in your DAW.',
    short: 'The progression and the groove on the train, then MIDI or WAV for your DAW.',
    text: 'Get the progression and the groove down on the train, note by note per instrument. Export MIDI for the notes or WAV for the audio.',
    bullets: [
      `${band[0].toUpperCase()}${band.slice(1)} on a step grid`,
      'Each instrument’s range set on a keyboard',
      '4/4, 3/4, 6/8 and 5/4, straight or swung',
    ],
    shot: 'rhythm-piano', alt: 'The rhythm editor on the piano, with the notes of each step and a keyboard to set its range',
  },
  {
    id: 'learners', label: 'Learners & teachers', dot: '#34C3B0', tint: '#DDF4F0', ink: '#0F766A',
    title: 'Hear what the theory means.',
    short: 'Every chord with its degree, its guitar shape and its keys, in any rhythm.',
    text: `Every chord shows its degree, its guitar shape and its keys. Play a ii–V–I, then the Andalusian cadence, in any of ${APP.rhythms} rhythms.`,
    bullets: [
      'The degree of every chord in the key',
      'Guitar shapes and piano keys for each chord',
      `${APP.progressions} classic progressions, from the ii–V–I to the Andalusian cadence`,
    ],
    shot: 'chord-diagram', alt: 'A chord shown as a guitar shape and as keys on a piano',
  },
];

// Names as the app lists them (style_presets.dart and assets/rhythm_library.json). The
// first four groups show their first six; the rest of them and the last two groups are
// folded into "More genres", so the section stays one screen tall.
const genres = [
  { name: 'Latin & Caribbean', dot: '#FF3849', items: ['Salsa', 'Bachata', 'Merengue', 'Cumbia', 'Vallenato', 'Norteño', 'Duranguense', 'Banda', 'Bolero', 'Reggaeton', 'Bossa Nova', 'Samba', 'Cha-Cha', 'Punta'] },
  { name: 'Worship & Gospel', dot: '#E8B93E', items: ['Worship', 'Modern Worship', 'Fast Gospel', 'Slow Gospel'] },
  { name: 'Pop, Rock & Soul', dot: '#3B8FFF', items: ['Pop', 'Pop Rock', '16 Beat', 'Shuffle Rock', 'Funk', 'R&B', '60’s Soul', 'Blues Shuffle'] },
  { name: 'Jazz & Swing', dot: '#9C8CF0', items: ['Jazz Swing', 'Swing', 'Big Band', 'Jazz Waltz', 'Fox Trot'] },
  { name: 'Dance & Hip-Hop', dot: '#E0609A', items: ['Trap', 'Hip-Hop', 'House', 'Afrobeat', 'Techno Pop', 'Disco Pop'] },
  { name: 'Ballads, piano & world', dot: '#34C3B0', items: ['Piano Ballad', 'Stride Piano', 'Ragtime', 'Tango', 'Waltz', 'Bhangra', 'Enka'] },
];
const SHOWN_PER_GENRE = 6;
const shownGenres = genres.slice(0, 4).map((g) => ({ ...g, items: g.items.slice(0, SHOWN_PER_GENRE) }));
const moreGenres = [
  ...genres.slice(0, 4)
    .filter((g) => g.items.length > SHOWN_PER_GENRE)
    .map((g) => ({ ...g, name: `More ${g.name}`, items: g.items.slice(SHOWN_PER_GENRE) })),
  ...genres.slice(4),
];

// The song's form as a rhythm plays it: flex weights are roughly how long each part lasts.
const form = [
  { label: 'Intro', note: 'the way in', grow: 'grow-[2]', bar: '#E8B93E', ink: '#E8B93E', fill: false },
  { label: 'A · main', note: 'verse', grow: 'grow-[4]', bar: '#3B8FFF', ink: '#6FAEFF', fill: false },
  { label: 'Fill', note: '', grow: 'grow', bar: '#FF3849', ink: '#FF7A86', fill: true },
  { label: 'B · fuller', note: 'chorus', grow: 'grow-[4]', bar: '#9C8CF0', ink: '#B4A8F5', fill: false },
  { label: 'Fill', note: '', grow: 'grow', bar: '#FF3849', ink: '#FF7A86', fill: true },
  { label: 'Ending', note: 'the way out', grow: 'grow-[2]', bar: '#34C3B0', ink: '#5FD8C7', fill: false },
];

const yours = [
  ['Every note, step by step', `${band[0].toUpperCase()}${band.slice(1)} on a step grid, each with its range on a keyboard.`],
  [`${APP.sounds} sounds to choose from`, 'Pianos, Rhodes, organs, guitars, pads, strings, brass. A different one for each part.'],
  ['A mixer per instrument', 'Level, pan, mute and solo, three-band EQ, compression and reverb.'],
  ['Take it anywhere', `${APP.exports[0]} to send, WAV to keep editing, MIDI to open the notes in your DAW.`],
];

// What the app and Chord Player online share. Each is true of the code today: the web plays
// the app's engine compiled to WebAssembly with its SoundFont (src/lib/appEngine/), its 24
// styles and 177-rhythm library (public/rhythms/), and the app opens the site's public_songs.
const shared = [
  'The same audio engine and sounds',
  `All ${APP.rhythms} of the app’s rhythms`,
  `${APP.chordTypes} chord types, ${APP.instruments.length} instruments`,
  'The chordsequence.com song catalogue',
  'WAV and MIDI files that open anywhere',
];

const questions = [
  ['Is it free?', 'Yes, the whole app. There is nothing to buy inside it and no account to make.'],
  ['Does it work without a connection?', 'Yes. The sounds are on your phone, so writing a song and hearing the band work in a basement or on a plane. Only the song catalogue from chordsequence.com needs a connection.'],
  ['Can I practise one part over and over?', `Loop any section on its own, set the tempo anywhere from ${APP.tempo.min} to ${APP.tempo.max} BPM and turn on a one-bar count-in.`],
  ['Can I change the key?', 'Pick a new key for the whole song, or move it up and down a semitone at a time.'],
  ['Does it keep playing with the screen off?', 'Yes, with play and stop in the notification.'],
  ['Is there an iPhone version?', 'Not yet. On an iPhone or a computer, Chord Player runs in the browser instead.'],
  ['Where do my songs live?', 'On your phone. Nothing is uploaded, and deleting the app deletes them with it.'],
  ['Which languages does it speak?', 'English and Spanish. It follows your phone, and Android lets you set the app to one or the other on its own.'],
];

// A still waveform for the demo player; the script colours it as the song plays.
const wave = [8,14,20,12,24,18,10,22,28,16,12,20,26,14,8,18,24,20,12,16,28,22,14,10,20,26,18,12,24,16,10,22,28,18,14,20,12,24,16,10,18,26,20,14,22,12,8,16];

const appSchema = buildMobileApplicationSchema({
  url: PAGE_URL,
  name: 'Chord Player',
  description,
  installUrl: PLAY_URL,
  operatingSystem: `Android ${APP.minAndroid} or later`,
  featureList: [
    `Song sections with ${APP.chordTypes} chord types`,
    `${band} in ${APP.rhythms} rhythms`,
    'Intro, A and B variations and ending for nearly every rhythm',
    `Loop a section, tempo from ${APP.tempo.min} to ${APP.tempo.max} BPM, transpose, count-in`,
    'Keeps playing with the screen off',
    'Step-by-step rhythm editor with a range keyboard per instrument',
    `${APP.drumKits} drum kits and ${APP.percussionRows} rows of Latin and hand percussion`,
    '4/4, 3/4, 6/8 and 5/4',
    'Per-instrument mixer with EQ, compression and reverb',
    `${APP.exports.join(', ')} export`,
    'Works offline, no account',
    APP.languages.join(' and '),
  ],
});

const breadcrumbSchema = buildBreadcrumbSchema(PAGE_URL, [
  { name: 'Home', item: 'https://chordsequence.com/' },
  { name: 'Chord Player app', item: PAGE_URL },
]);

const kicker = 'font-mono text-xs font-bold uppercase tracking-[0.12em]';
// Section titles shrink on short desktop screens (1280x720, 1024x768), where the full size
// would push the section past one screen.
const h2 = 'font-serif text-[1.75rem] max-md:[@media(max-height:760px)]:text-[1.5rem] font-semibold leading-[1.1] tracking-tight text-foreground sm:text-4xl lg:text-5xl lg:[@media(max-height:800px)]:text-4xl';
// Vertical rhythm of a one-screen section: the padding gives way on short screens first.
// Phones with a short screen (a 360x740 Android, the smallest common one) get a compact
// step of their own, written out in full because Tailwind only sees literal class names.
const screenPad = 'py-6 max-md:[@media(max-height:760px)]:py-4 md:py-[clamp(1.5rem,6svh,4.5rem)]';
// Tighter, for the two sections with the most in them (the uses and the rhythms).
const screenPadTight = 'py-6 max-md:[@media(max-height:760px)]:py-4 md:py-[clamp(1rem,4svh,4rem)]';
---

<BaseLayout
  title="Chord Player App: Free Backing Track & Chord Progression App"
  description={description}
  canonicalUrl={PAGE_URL}
  ogImage="https://chordsequence.com/og/page/chord-player-app/"
  ogImageAlt="Chord Player for Android: your backing band, in your pocket"
>
  <Fragment slot="head">
    <JsonLd schema={appSchema} />
    <JsonLd schema={breadcrumbSchema} />
  </Fragment>

  <main class="overflow-x-clip" data-landing>
    <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
    <!-- From 1024px the words and the phone share one screen. Below that they are two:
         the words, the badge and the demo first — the badge is always on the first screen —
         then the phone. Every size in the column is tied to the screen's height, so a
         1024x768 laptop sees the badge too. -->
    <section class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-4 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,480px)] lg:min-h-[calc(100svh-65px)] lg:py-6" data-fit-lg data-hero>
      <div class="flex min-w-0 flex-col justify-center gap-[clamp(0.9rem,2.6svh,1.75rem)] [@media(max-height:700px)]:gap-3 py-6 [@media(max-height:700px)]:py-4 lg:py-0" data-fit>
        <h1 class="flex flex-col gap-[clamp(0.75rem,2svh,1.25rem)]">
          <span class="flex items-center gap-3">
            <img
              src="/images/chord-player-app-icon.png"
              width="96"
              height="96"
              alt=""
              class="h-11 w-11 rounded-xl border border-border lg:h-[clamp(2.75rem,6svh,3.5rem)] lg:w-[clamp(2.75rem,6svh,3.5rem)]"
            />
            <span class={`${kicker} text-primary`}>The Chord Player app for Android</span>
          </span>
          <span class="font-serif text-[2.1rem] [@media(max-height:700px)]:text-[1.85rem] font-semibold leading-[1.04] tracking-tight text-foreground sm:text-5xl lg:text-[clamp(2.5rem,min(8.5svh,5.2vw),4.5rem)]">
            Your backing band,<br />in your pocket.
          </span>
        </h1>
        <p class="max-w-xl text-base [@media(max-height:700px)]:text-[15px] leading-relaxed [@media(max-height:700px)]:leading-normal text-muted-foreground sm:text-lg lg:[@media(min-height:860px)]:text-xl">
          Turn your chords into a backing track: pick one of {APP.rhythms} rhythms, from cumbia
          and bachata to worship and jazz, and {band} play them with you. Loop a section, slow
          it down, change the key.
        </p>
        <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-7" data-hero-cta>
          <GooglePlayBadge from="landing_hero" eager class="-ml-2" />
          <a href="#phone-and-browser" class="flex items-center gap-1.5 text-sm font-semibold text-muted-foreground transition-colors hover:text-primary sm:text-[15px]">
            <span class="sm:hidden">On iPhone or a computer? Use the browser</span>
            <span class="hidden sm:inline">On iPhone or a computer? Open it in your browser</span>
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.arrow} /></svg>
          </a>
        </div>

        <!-- The demo: "Sunset Drive", the song in the screenshots, exported from the app with
             its own M4A export (1.2.0, 2026-09-29). `preload="none"` keeps its 2.1 MB off
             every page load. A new recording gets a new file name, so no browser keeps
             playing the old one. -->
        <div class="flex max-w-[520px] items-center gap-3.5 rounded-2xl border border-border bg-card p-3 pr-4 shadow-sm sm:gap-4 sm:p-4 sm:pr-5" data-demo>
          <button
            type="button"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground transition-transform hover:scale-105 sm:h-[52px] sm:w-[52px]"
            aria-label="Play the salsa demo"
            data-demo-toggle
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-demo-play><path d="M7 4.5v15l12.5-7.5z" /></svg>
            <svg class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-demo-pause><rect x="5" y="4" width="5" height="16" rx="1" /><rect x="14" y="4" width="5" height="16" rx="1" /></svg>
          </button>
          <div class="flex min-w-0 grow flex-col gap-1.5 sm:gap-2">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-semibold text-foreground sm:text-[15px]">Hear it: “Sunset Drive” in Salsa</span>
              <span class="font-mono text-xs text-muted-foreground" data-demo-time>1:28</span>
            </div>
            <div class="flex h-6 items-center gap-[3px] overflow-hidden sm:h-7" aria-hidden="true">
              {wave.map((h) => (
                <span class="w-1 shrink-0 rounded-sm bg-[#D9DCE3]" style={`height:${h}px`} data-demo-bar></span>
              ))}
            </div>
            <span class="text-xs leading-snug text-muted-foreground [@media(max-height:700px)]:hidden sm:text-[12.5px]">
              Exported straight from the app, nothing added afterwards.
            </span>
          </div>
          <audio preload="none" src="/audio/chord-player-app-demo-salsa.m4a" data-demo-audio></audio>
        </div>

        <ul class="flex flex-wrap gap-x-5 gap-y-1.5" aria-label="At a glance">
          {checks.map((item, i) => (
            <li class:list={['items-center gap-1.5 text-[13px] font-medium text-muted-foreground sm:text-sm', i < 3 ? 'flex' : 'hidden sm:flex']}>
              <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.check} /></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative mx-auto flex h-[min(calc(100svh-65px-2rem),560px)] w-full max-w-[480px] items-center justify-center rounded-[32px] bg-[#EFE8FD] lg:h-[min(calc(100svh-65px-3.5rem),640px)]" data-fit>
        <img
          src="/images/chord-player-app/song.webp"
          width="760"
          height="1600"
          alt="Chord Player playing a salsa: Intro, Verse and Chorus, with the sounding chord lit up"
