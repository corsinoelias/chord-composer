      <div class="flex max-w-[820px] flex-col gap-2.5 md:items-center md:text-center">
        <p class={`${kicker} text-primary`}>Phone and browser</p>
        <h2 class={h2}>One Chord Player, wherever you are.</h2>
        <p class="text-[15px] leading-relaxed text-muted-foreground sm:hidden">
          The same instrument in the app and in the browser. Use the one in front of you.
        </p>
        <p class="hidden leading-relaxed text-muted-foreground sm:block sm:text-base lg:[@media(min-height:860px)]:text-lg">
