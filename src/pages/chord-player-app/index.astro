<script>
  // The demo player: one button over a plain <audio>, the waveform filling as it plays.
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  const audio = demo?.querySelector<HTMLAudioElement>('[data-demo-audio]');
  if (demo && audio) {
    const toggle = demo.querySelector<HTMLButtonElement>('[data-demo-toggle]')!;
    const playIcon = demo.querySelector('[data-demo-play]')!;
    const pauseIcon = demo.querySelector('[data-demo-pause]')!;
    const time = demo.querySelector<HTMLElement>('[data-demo-time]')!;
    const bars = [...demo.querySelectorAll<HTMLElement>('[data-demo-bar]')];
    const total = time.textContent;
    let reported = false;
    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    toggle.addEventListener('click', () => {
      if (audio.paused) void audio.play(); else audio.pause();
    });
    audio.addEventListener('play', () => {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      toggle.setAttribute('aria-label', 'Pause the salsa demo');
      if (!reported) {
        reported = true;
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        w.gtag?.('event', 'app_demo_played', { entry_point: 'landing' });
      }
    });
    audio.addEventListener('pause', () => {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
      toggle.setAttribute('aria-label', 'Play the salsa demo');
    });
    audio.addEventListener('timeupdate', () => {
      const done = audio.duration ? audio.currentTime / audio.duration : 0;
      bars.forEach((bar, i) => { bar.style.backgroundColor = i / bars.length < done ? 'hsl(var(--primary))' : ''; });
      time.textContent = audio.currentTime > 0 ? clock(audio.currentTime) : total;
    });
    audio.addEventListener('ended', () => { audio.currentTime = 0; });
  }

  // The sticky bar shows once the hero's badge is off screen, and not over the closing CTA.
  const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('[data-hero-cta]');
  const end = document.querySelector('[data-end-cta]');
  if (sticky && hero && end && 'IntersectionObserver' in window) {
    const link = sticky.querySelector<HTMLElement>('[data-sticky-link]')!;
    const visible = new Map<Element, boolean>([[hero, true], [end, false]]);
    const update = () => {
      const show = !visible.get(hero) && !visible.get(end);
      sticky.classList.toggle('translate-y-[calc(100%+1rem)]', !show);
      sticky.classList.toggle('opacity-0', !show);
      link.tabIndex = show ? 0 : -1;
      sticky.toggleAttribute('inert', !show);
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => visible.set(entry.target, entry.isIntersecting));
      update();
    });
    observer.observe(hero);
    observer.observe(end);
    update();
  }
</script>
