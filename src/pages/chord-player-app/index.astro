                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="flex items-center justify-between gap-3 rounded-[20px] border border-border bg-card p-3 sm:flex-col sm:items-start sm:justify-start sm:rounded-[24px] sm:p-6 lg:order-1 lg:rounded-[28px] lg:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EFE8FD] text-primary">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.phone} /></svg>
            </span>
            <div class="flex flex-col"><h3 class="text-base font-bold text-foreground sm:text-lg">Android app</h3><span class="text-[13px] text-muted-foreground">Offline, no account, {APP.exports.join(', ')}</span></div>
          </div>
          <ul class="hidden flex-col gap-2 text-[15px] text-foreground/80 lg:flex">
            <li>Works offline, anywhere</li>
            <li>No account; songs stay on your phone</li>
            <li>Android {APP.minAndroid} or later</li>
          </ul>
          <GooglePlayBadge from="landing_both" class="-mr-1.5 shrink-0 sm:-ml-2 sm:mr-0 [&_img]:h-11 sm:[&_img]:h-14" />
        </div>
        <div class="flex items-center justify-between gap-3 rounded-[20px] border border-border bg-card p-3 sm:flex-col sm:items-start sm:justify-start sm:rounded-[24px] sm:p-6 lg:order-3 lg:rounded-[28px] lg:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EFE8FD] text-primary">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.laptop} /></svg>
            </span>
            <div class="flex flex-col"><h3 class="text-base font-bold text-foreground sm:text-lg">Chord Player online</h3><span class="text-[13px] text-muted-foreground"><span class="sm:hidden">iPhone and computers</span><span class="hidden sm:inline">iPhone, iPad, Mac, Windows</span></span></div>
          </div>
          <ul class="hidden flex-col gap-2 text-[15px] text-foreground/80 lg:flex">
            <li>Nothing to install</li>
            <li>A free account saves your songs</li>
            <li>Share a song with a link</li>
          </ul>
          <a href="/chord-player/" class="flex h-11 w-fit shrink-0 items-center gap-2 rounded-full border-[1.5px] border-foreground px-4 text-sm font-semibold text-foreground transition-colors hover:bg-foreground hover:text-background sm:px-5 sm:text-[15px]">
            <span class="sm:hidden">Open</span><span class="hidden sm:inline">Open in your browser</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.arrow} /></svg>
          </a>
        </div>
      </div>
      <p class="text-center text-xs text-muted-foreground sm:text-sm">
        Songs you write stay where you wrote them: on your phone in the app, in your account on the web.
      </p>
    </section>

    <!-- ─── QUESTIONS ────────────────────────────────────────────────────── -->
    <!-- Closed accordions, so eight questions take one screen. Visible questions and answers
         only: this site must never serialize them as FAQPage JSON-LD — see the note in
         CLAUDE.md and scripts/check-schema.mjs. -->
    <section id="questions" class={`mx-auto grid max-w-[1200px] grid-cols-1 gap-5 px-4 sm:px-6 lg:grid-cols-[300px_minmax(0,1fr)] lg:gap-20 ${screenPad}`} data-fit>
      <div class="flex flex-col gap-2">
        <p class={`${kicker} text-primary`}>Questions</p>
        <h2 class={h2}>Before you install</h2>
      </div>
      <div class="border-t border-border">
        {questions.map(([question, answer]) => (
          <details class="group border-b border-border">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-[clamp(0.7rem,2svh,1.1rem)] [&::-webkit-details-marker]:hidden">
              <h3 class="text-[15px] font-semibold text-foreground sm:text-base">{question}</h3>
              <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.chevron} /></svg>
            </summary>
            <p class="pb-4 text-[15px] leading-relaxed text-muted-foreground">{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
    <section class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6 lg:pb-16" data-end-cta data-fit>
      <div class="grid grid-cols-1 overflow-hidden rounded-[28px] bg-primary text-primary-foreground lg:grid-cols-[minmax(0,1fr)_300px] lg:rounded-[32px]">
        <div class="flex flex-col justify-center gap-3.5 p-6 sm:p-12 lg:px-[72px] lg:py-14">
          <h2 class="font-serif text-[1.75rem] font-semibold leading-[1.08] tracking-tight sm:text-5xl">Your band is ready when you are.</h2>
          <p class="text-base text-white/85 sm:text-lg">Free on Google Play. No account, no connection needed.</p>
          <div class="mt-1 flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-6">
            <GooglePlayBadge from="landing_end" class="-ml-2" />
            <a href="/chord-player/" class="text-[15px] font-semibold text-white hover:underline">Or open it in your browser →</a>
          </div>
        </div>
        <div class="relative hidden lg:block" aria-hidden="true">
          <img src="/images/chord-player-app/song.webp" width="760" height="1600" alt="" loading="lazy"
            class="absolute left-5 top-10 w-[240px] rotate-6 drop-shadow-[0_24px_40px_rgba(0,0,0,0.3)]" />
        </div>
      </div>
    </section>
  </main>

  <!-- ─── STICKY INSTALL BAR (phones) ────────────────────────────────────── -->
  <!-- Android only (the script removes it anywhere else). A small bar, not an
       interstitial: it covers nothing until the hero's badge has
       scrolled away, and hides again whenever the closing call to action is on screen. While
       it shows it takes the bottom 68px of the screen (56px tall, 12px up), and every section
       it can cover is sized to fit above it — check:landing-fit counts it. -->
  <div
    class="pointer-events-none fixed inset-x-3 bottom-3 z-40 translate-y-[calc(100%+1rem)] opacity-0 transition-all duration-300 lg:hidden"
    data-sticky-cta
    inert
  >
    <div class="pointer-events-auto flex h-14 items-center gap-2.5 rounded-2xl bg-[#14181F] pl-2.5 pr-1.5 text-white shadow-[0_12px_32px_rgba(20,24,31,0.3)]">
      <img src="/images/chord-player-app-icon.png" width="96" height="96" alt="" loading="lazy" class="h-8 w-8 rounded-lg" />
      <span class="flex grow flex-col"><span class="text-sm font-semibold">Chord Player</span><span class="text-xs text-[#A3AAB8]">Free · Offline · No account</span></span>
      <a
        href="/android/?from=landing_sticky"
        class="flex h-11 items-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground"
        onclick="if(typeof gtag!=='undefined')gtag('event','app_cta_clicked',{entry_point:'landing_sticky'})"
      >Install</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* No scroll snapping. `scroll-snap-type: y proximity` was here until 2026-09-29: small
     wheel and trackpad steps landed "close" to the hero's edge and the browser pulled the
     page back to it, twelve steps in a row, so the page could hardly be scrolled at all.
     `scroll-padding-top` stays: it keeps an anchor (#worship) under the 65px navbar. */
  html:has(main[data-landing]) {
    scroll-padding-top: 65px;
  }
  /* The uses, from 768px: one panel at a time. Without JavaScript the first shows, and an
     anchor from another page (#worship) still opens its own through :target. */
  @media (min-width: 768px) {
    main[data-landing] [data-use-panel]:not([data-active]) {
      display: none;
    }
    main[data-landing] [data-use-panel]:target {
      display: grid;
    }
    main[data-landing] [data-use-track]:has(:target) [data-use-panel][data-active]:not(:target) {
      display: none;
    }
  }
</style>

<script>
  // ── The demo player: one button over a plain <audio>, the waveform filling as it plays.
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  const audio = demo?.querySelector<HTMLAudioElement>('[data-demo-audio]');
  if (demo && audio) {
    const toggle = demo.querySelector<HTMLButtonElement>('[data-demo-toggle]')!;
    const playIcon = demo.querySelector('[data-demo-play]')!;
    const pauseIcon = demo.querySelector('[data-demo-pause]')!;
    const time = demo.querySelector<HTMLElement>('[data-demo-time]')!;
    const bars = [...demo.querySelectorAll<HTMLElement>('[data-demo-bar]')];
    const total = time.textContent;
    let reported = false;
    const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    toggle.addEventListener('click', () => {
      if (audio.paused) void audio.play(); else audio.pause();
    });
    audio.addEventListener('play', () => {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      toggle.setAttribute('aria-label', 'Pause the salsa demo');
      if (!reported) {
        reported = true;
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        w.gtag?.('event', 'app_demo_played', { entry_point: 'landing' });
      }
    });
    audio.addEventListener('pause', () => {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
      toggle.setAttribute('aria-label', 'Play the salsa demo');
    });
    audio.addEventListener('timeupdate', () => {
      const done = audio.duration ? audio.currentTime / audio.duration : 0;
      bars.forEach((bar, i) => { bar.style.backgroundColor = i / bars.length < done ? 'hsl(var(--primary))' : ''; });
      time.textContent = audio.currentTime > 0 ? clock(audio.currentTime) : total;
    });
    audio.addEventListener('ended', () => { audio.currentTime = 0; });
  }

  // ── The uses: tabs from 768px, a carousel below, one list of buttons driving both.
  const uses = document.querySelector<HTMLElement>('[data-uses]');
  if (uses) {
    const track = uses.querySelector<HTMLElement>('[data-use-track]')!;
    const tabs = [...uses.querySelectorAll<HTMLButtonElement>('[data-use-tab]')];
    const panels = [...uses.querySelectorAll<HTMLElement>('[data-use-panel]')];
    const wide = window.matchMedia('(min-width: 768px)');

    const select = (id: string) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.useTab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        // Keep the selected tab in view by scrolling the tab row only: scrollIntoView would
        // scroll the page too, and did, on load, as the first card came into view.
        if (on && !wide.matches) {
          const row = tab.parentElement!;
          const left = tab.offsetLeft - row.offsetLeft;
          if (left < row.scrollLeft || left + tab.offsetWidth > row.scrollLeft + row.clientWidth) {
            row.scrollTo({ left: left - 16, behavior: 'smooth' });
          }
        }
      });
      panels.forEach((panel) => panel.toggleAttribute('data-active', panel.id === id));
    };
    // A tap: on a wide screen, show the panel; on a phone, slide the carousel to its card.
    const open = (id: string, focus = false) => {
      if (!wide.matches) {
        const panel = panels.find((p) => p.id === id);
        if (panel) track.scrollTo({ left: panel.offsetLeft - track.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft), behavior: 'smooth' });
      }
      select(id);
      if (focus) tabs.find((t) => t.dataset.useTab === id)?.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => open(tab.dataset.useTab!));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const edge = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (!step && edge < 0) return;
        e.preventDefault();
        const next = edge >= 0 ? edge : (i + step + tabs.length) % tabs.length;
        open(tabs[next].dataset.useTab!, true);
      });
    });

    // On a phone the swipe is the input: whichever card is mostly on screen is selected.
    const seen = new IntersectionObserver((entries) => {
      if (wide.matches) return;
      const best = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (best) select((best.target as HTMLElement).id);
    }, { root: track, threshold: [0.6] });
    panels.forEach((panel) => seen.observe(panel));

    // An anchor from another page (/chord-player-app/#worship) opens its use, and shows the
    // section from its title, under the navbar. Run again on load: the browser's own jump to
    // the anchor comes after this script and would leave the title behind the navbar.
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!panels.some((p) => p.id === id)) return;
      open(id);
      const nav = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
      window.scrollTo({ top: uses.getBoundingClientRect().top + window.scrollY - nav });
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
    window.addEventListener('load', () => requestAnimationFrame(fromHash), { once: true });
  }

  // ── The sticky bar: Android only, like the site's app banner (AppBanner.astro) — on an
  // iPhone or a computer it would be a Play Store button that leads nowhere. It shows once
  // the hero's badge is off screen, and not over the closing call to action.
  let sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
  if (sticky && !/Android/i.test(navigator.userAgent)) { sticky.remove(); sticky = null; }
  const hero = document.querySelector('[data-hero-cta]');
  const end = document.querySelector('[data-end-cta]');
  if (sticky && hero && end && 'IntersectionObserver' in window) {
    const visible = new Map<Element, boolean>([[hero, true], [end, false]]);
    const update = () => {
      const show = !visible.get(hero) && !visible.get(end);
      sticky.classList.toggle('translate-y-[calc(100%+1rem)]', !show);
      sticky.classList.toggle('opacity-0', !show);
      sticky.toggleAttribute('inert', !show);
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => visible.set(entry.target, entry.isIntersecting));
      update();
    });
    observer.observe(hero);
    observer.observe(end);
  }
</script>
