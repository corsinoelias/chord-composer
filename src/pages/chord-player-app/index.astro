    </section>

    <!-- ─── MADE FOR ─────────────────────────────────────────────────────── -->
    <!-- Six uses in one screen. From 768px: a tab list and one panel. Below: a carousel
         swiped sideways, one card per swipe, the same list above it as its index. Every
         panel is in the HTML either way; only what is shown changes. -->
    <section id="made-for" class={`mx-auto flex max-w-[1200px] flex-col gap-[clamp(0.75rem,2.5svh,1.5rem)] px-4 sm:px-6 ${screenPadTight}`} data-fit data-uses>
      <div class="flex flex-col gap-2">
        <p class={`${kicker} text-primary`}>Made for</p>
        <h2 class={h2}>However you play, there’s a band for it.</h2>
      </div>

      <div
        role="tablist"
        aria-label="Uses"
        class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:-mx-6 sm:px-6 md:mx-0 md:flex-wrap md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden"
      >
        {uses.map((use, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${use.id}`}
            aria-controls={use.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-use-tab={use.id}
            class="flex h-9 shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-border bg-card px-3.5 text-sm font-medium text-foreground transition-colors hover:border-primary/40 aria-selected:border-foreground aria-selected:bg-foreground aria-selected:text-background"
          >
            <span class="h-2 w-2 rounded-full" style={`background:${use.dot}`}></span>{use.label}
          </button>
        ))}
      </div>

      <div
        class="-mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-1 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:block md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden"
        data-use-track
      >
        {uses.map((use, i) => (
          <article
            id={use.id}
            role="tabpanel"
            aria-labelledby={`tab-${use.id}`}
            data-use-panel
            data-active={i === 0 ? '' : undefined}
            class="flex w-[86%] shrink-0 snap-start flex-col gap-3 rounded-[24px] border border-border bg-card p-4 sm:w-[70%] sm:p-5 md:w-auto md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] md:items-center md:gap-8 md:rounded-[28px] md:p-[clamp(1.25rem,4svh,3rem)] lg:gap-14"
          >
            <div class="flex min-w-0 flex-col gap-2.5 md:gap-[clamp(0.6rem,2svh,1.1rem)]">
              <span class="flex h-[26px] w-fit items-center rounded-full px-2.5 font-mono text-[11px] font-bold uppercase tracking-[0.08em] md:h-7 md:px-3 md:text-xs" style={`background:${use.tint};color:${use.ink}`}>{use.label}</span>
              <h3 class="font-serif text-[1.3rem] font-semibold leading-[1.12] text-foreground sm:text-[1.45rem] md:text-[clamp(1.6rem,4.6svh,2.4rem)]">{use.title}</h3>
              <p class="text-[15px] leading-snug text-muted-foreground lg:hidden">{use.short}</p>
              <p class="hidden text-base leading-relaxed text-muted-foreground lg:block lg:[@media(min-height:860px)]:text-[17px] lg:[@media(max-height:800px)]:text-[15px]">{use.text}</p>
              {use.id === 'practice' ? (
                <>
                  <ul class="hidden flex-wrap gap-1.5 sm:flex md:hidden">
                    {practiceTools.slice(0, 3).map((tool) => (
                      <li class="flex h-7 items-center gap-1.5 rounded-full bg-muted px-2.5 text-[13px] font-medium text-foreground">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS[tool.icon]} /></svg>
                        {tool.title}
                      </li>
                    ))}
                  </ul>
                  <ul class="hidden gap-x-6 gap-y-[clamp(0.5rem,1.6svh,0.9rem)] md:grid md:grid-cols-2">
                    {practiceTools.map((tool) => (
                      <li class="flex items-start gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] bg-muted text-foreground">
                          <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS[tool.icon]} /></svg>
                        </span>
                        <span class="flex flex-col">
                          <span class="text-[15px] font-semibold text-foreground">{tool.title}</span>
                          <span class="hidden text-[13.5px] leading-snug text-muted-foreground lg:block lg:[@media(max-height:800px)]:hidden">{tool.text}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <ul class="hidden flex-col gap-[clamp(0.4rem,1.4svh,0.75rem)] md:flex">
                  {use.bullets.map((line) => (
                    <li class="flex gap-2.5 text-[15px] leading-normal text-foreground lg:[@media(max-height:800px)]:text-sm">
                      <svg class="mt-0.5 h-[18px] w-[18px] shrink-0" style={`color:${use.ink}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.check} /></svg>
                      {line}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {use.id === 'practice' ? (
              <!-- The app's transport, drawn: slowed down, in G, the chorus looping. Decoration,
                   so hidden from screen readers; the list beside it says the same in words. -->
              <div class="flex flex-col justify-center gap-3 rounded-2xl p-3 md:h-[min(calc(100svh-21rem),440px)] md:rounded-3xl md:p-5" style={`background:${use.tint}`} aria-hidden="true">
                <div class="flex flex-col gap-3 rounded-[18px] bg-card p-3 shadow-[0_16px_40px_rgba(11,40,90,0.14)] md:p-4">
                  <div class="flex items-center gap-3.5">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary shadow-[0_0_0_6px_#EFE8FD] md:h-14 md:w-14"><span class="h-3.5 w-3.5 rounded-[3px] bg-white md:h-4 md:w-4"></span></span>
                    <div class="flex grow flex-col gap-1">
                      <div class="flex items-baseline gap-1.5"><span class="font-mono text-2xl font-bold leading-none text-foreground md:text-3xl">72</span><span class="text-xs text-muted-foreground md:text-[13px]">BPM<span class="hidden sm:inline"> · slowed from 96</span></span></div>
                      <div class="relative h-1.5 rounded-full bg-muted"><div class="h-1.5 w-1/5 rounded-full bg-primary"></div></div>
                    </div>
                    <span class="flex h-9 shrink-0 items-center gap-2 rounded-full bg-muted px-3 font-mono text-sm font-bold"><span class="text-muted-foreground">−</span><span class="text-primary">G</span><span class="text-muted-foreground">+</span></span>
                  </div>
                  <div class="overflow-hidden rounded-xl border-2 border-[#1783FF]">
                    <div class="flex h-9 items-center justify-between bg-[#E6F0FF] px-3">
                      <span class="flex items-center gap-2 text-sm font-semibold text-foreground"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#1783FF]"></span>Chorus</span>
                      <span class="flex h-6 items-center gap-1.5 rounded-full bg-[#1783FF] px-2.5 text-xs font-semibold text-white">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={ICONS.loop} /></svg>Looping
                      </span>
                    </div>
                    <div class="grid grid-cols-4 gap-1.5 p-2 md:gap-2 md:p-2.5">
                      {practiceChords.map((chord) => (
                        <span class:list={[
                          'flex h-12 flex-col justify-between rounded-lg border px-2 py-1.5 md:h-[52px]',
                          chord.playing ? 'border-[#E5A50A] bg-[#FBBD23]' : chord.minor ? 'border-[#B9CCF3] bg-[#E8EFFC]' : 'border-[#F5DC9A] bg-[#FEF6DE]',
                        ]}>
                          <span class:list={['font-mono text-base font-bold leading-none', chord.minor ? 'text-[#234A99]' : 'text-[#6B4A00]']}>{chord.name}</span>
                          <span class:list={['text-[11px] leading-none', chord.minor ? 'text-[#4A6AA8]' : 'text-[#7A5E1A]']}>{chord.degree}</span>
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="hidden h-10 items-center gap-2.5 self-center whitespace-nowrap rounded-[14px] bg-[#14181F] pl-2.5 pr-4 text-[13px] text-white md:flex">
                  <img src="/images/chord-player-app-icon.png" width="96" height="96" alt="" loading="lazy" class="h-6 w-6 rounded-md" />
                  <span class="font-semibold">Chord Player</span><span class="text-[#A3AAB8]">Playing · Chorus</span>
                  <span class="h-[18px] w-px bg-[#3A414D]"></span>
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="4" width="5" height="16" rx="1" /><rect x="14" y="4" width="5" height="16" rx="1" /></svg>
                </div>
              </div>
            ) : (
              <div class="flex h-[26svh] items-start justify-center overflow-hidden rounded-2xl pt-[5%] md:h-[min(calc(100svh-21rem),440px)] md:rounded-3xl" style={`background:${use.tint}`}>
                <img
                  src={`/images/chord-player-app/${use.shot}.webp`}
                  width="760"
                  height="1600"
                  loading="lazy"
                  alt={use.alt}
                  class="h-[125%] w-auto max-w-none drop-shadow-[0_18px_32px_rgba(20,24,31,0.18)]"
                />
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- ─── RHYTHMS ──────────────────────────────────────────────────────── -->
    <section id="rhythms" class="bg-[#131720] text-[#F3F4F6]">
      <div class={`mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)] lg:gap-16 ${screenPadTight}`} data-fit>
        <div class="flex min-w-0 flex-col gap-3 max-md:[@media(max-height:760px)]:gap-2.5 md:gap-[clamp(0.75rem,2.4svh,1.5rem)]">
          <p class={`${kicker} text-[#B89AF7]`}>{APP.rhythms} rhythms</p>
          <h2 class="font-serif text-[1.75rem] max-md:[@media(max-height:760px)]:text-[1.5rem] font-semibold leading-[1.1] tracking-tight sm:text-4xl lg:text-5xl lg:[@media(max-height:800px)]:text-4xl">Every rhythm has a way in and a way out.</h2>
          <p class="max-w-[640px] text-[15px] leading-relaxed text-[#B7BDC9] sm:hidden">
            Nearly every rhythm brings an intro, an A and a B and an ending; Fill throws in a break.
          </p>
          <p class="hidden max-w-[640px] text-base leading-relaxed text-[#B7BDC9] sm:block lg:[@media(min-height:860px)]:text-lg">
            Nearly every rhythm brings an intro, an A and a B variation and an ending. Each
            section of your song picks its part, and the Fill button throws in a break whenever
            you want one.
          </p>
          <ol class="flex h-14 gap-1 sm:h-[68px] sm:gap-1.5" aria-label="How a rhythm plays a song">
            {form.map((part) => (
              <li class:list={['flex basis-0 flex-col justify-between rounded-lg border-t-4 px-2 py-2 sm:rounded-xl sm:px-3', part.grow, part.fill ? 'bg-[#3A1A22]' : 'bg-[#1D202B]']} style={`border-top-color:${part.bar}`}>
                <span class="font-mono text-[10px] font-bold uppercase sm:text-[11px]" style={`color:${part.ink}`}>{part.label}</span>
                {part.note && <span class="hidden text-[13px] text-[#B7BDC9] sm:block">{part.note}</span>}
              </li>
            ))}
          </ol>
          <!-- Below 640px each genre is one line that scrolls sideways, so the four groups
               cost four lines; from 640px they wrap in two columns. -->
          <div class="grid gap-x-10 gap-y-[clamp(0.6rem,2svh,1.25rem)] sm:grid-cols-2">
            {shownGenres.map((genre) => (
              <div class="flex min-w-0 flex-col gap-1.5 sm:gap-2">
                <h3 class="flex items-center gap-2 text-[13px] font-semibold"><span class="h-2 w-2 rounded-full" style={`background:${genre.dot}`}></span>{genre.name}</h3>
                <ul class="-mx-4 flex gap-1.5 overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 [&::-webkit-scrollbar]:hidden">
                  {genre.items.map((item) => (
                    <li class="flex h-7 shrink-0 items-center whitespace-nowrap rounded-full border border-[#303441] bg-[#1D202B] px-2.5 text-[13px] text-[#DDE1E8]">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <details class="group">
            <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-[#B89AF7] [&::-webkit-details-marker]:hidden">
              More genres
              <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.chevron} /></svg>
            </summary>
            <div class="mt-3 grid gap-x-10 gap-y-4 sm:grid-cols-2">
              {moreGenres.map((genre) => (
                <div class="flex flex-col gap-2">
                  <h3 class="flex items-center gap-2 text-[13px] font-semibold"><span class="h-2 w-2 rounded-full" style={`background:${genre.dot}`}></span>{genre.name}</h3>
                  <ul class="flex flex-wrap gap-1.5">
                    {genre.items.map((item) => (
                      <li class="flex h-7 items-center rounded-full border border-[#303441] bg-[#1D202B] px-2.5 text-[13px] text-[#DDE1E8]">{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
          <p class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-[#B7BDC9] sm:text-sm">
            <span class="font-mono font-bold text-[#F3F4F6]">4/4 · 3/4 · 6/8 · 5/4</span>
            <span><span class="font-mono font-bold text-[#F3F4F6]">Straight · Light · Shuffle</span> swing</span>
          </p>
        </div>
        <figure class="hidden flex-col items-center gap-4 lg:flex">
          <img src="/images/chord-player-app/rhythms.webp" width="760" height="1600" loading="lazy"
            alt={`The rhythm list, with ${APP.rhythms} rhythms, a search box and filters by genre and meter`}
            class="h-[min(calc(100svh-65px-9rem),600px)] w-auto drop-shadow-[0_30px_50px_rgba(0,0,0,0.5)]" />
          <figcaption class="text-center text-[13px] text-[#9AA1AE]">One list, by genre and meter, with a search and favourites.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ─── MAKE IT YOURS ────────────────────────────────────────────────── -->
    <!-- The mixer screenshot is left out below 768px: with it the section is two screens. -->
    <section class={`mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-8 px-4 sm:px-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)] lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] lg:gap-16 ${screenPad}`} data-fit>
      <div class="hidden h-[min(calc(100svh-65px-8rem),600px)] items-start justify-center overflow-hidden rounded-[32px] bg-[#EFE8FD] pt-[6%] md:flex">
        <img src="/images/chord-player-app/mixer.webp" width="760" height="1600" loading="lazy"
          alt="The mixer, with a fader and level meter per instrument, pan knobs and an EQ curve"
