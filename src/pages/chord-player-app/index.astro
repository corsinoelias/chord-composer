---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import GooglePlayBadge from '../../components/GooglePlayBadge.astro';
import JsonLd from '@/components/schema/JsonLd.astro';
import { buildBreadcrumbSchema, buildMobileApplicationSchema } from '@/components/schema/builders';
import { APP, instrumentList } from '@/data/facts';

// The site's page for the Chord Player mobile app (com.eliascorsino.chord_sequencer). The
// URL names the app rather than the platform because an iOS build is planned; the copy
// says Android only until that build exists. Not /app/: that path is the signed-in library.
//
// Every number on this page is the app's, from APP in src/data/facts.ts, which
// tests/facts/facts.ts checks against the Flutter source. Not the web editor's: the two
// differ, and the Play listing once copied the web's numbers. Every feature it names is in
// the app too (loop: loopingSection; screen off: PlaybackService.kt; count-in and click:
// settings_screen.dart; key: transpose and Apply key) — docs/ficha-play.md in the app's
// repository maps each one to its code.
//
// It sells uses, not features: who the app is for comes first, each with the features that
// make it work. The browser is presented as the same instrument, not as a rival: what the
// two share is true today (one engine, the app's rhythms and sounds, one catalogue); what
// they don't — songs do not sync between them yet — is said once, plainly.
//
// Each Play badge has its own `from`, so Play Console and GA4 can tell which one installs.
const PAGE_URL = 'https://chordsequence.com/chord-player-app/';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.eliascorsino.chord_sequencer';

const description =
  `Chord Player for Android: write the chords, pick one of ${APP.rhythms} rhythms and a full band plays along. Loop a section, slow it down, change the key. Free, offline.`;

const band = instrumentList(APP.instruments);

// Stroke icons (Lucide shapes), drawn inline.
const ICONS: Record<string, string> = {
  loop: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  gauge: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  key: '<path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>',
  timer: '<line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  drum: '<path d="m2 2 8 8"/><path d="m22 2-8 8"/><ellipse cx="12" cy="9" rx="10" ry="5"/><path d="M7 13.4v7.9"/><path d="M12 14v8"/><path d="M17 13.4v7.9"/><path d="M2 9v8a10 5 0 0 0 20 0V9"/>',
  phone: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  laptop: '<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>',
};

const checks = ['Free', 'No account needed', 'Works offline', `Android ${APP.minAndroid} or later`, APP.languages.join(' and ')];

// The uses, in the order the jump links and the page show them. `tint` is the instrument
// colour of the app's theme (app_theme.dart) the card borrows; `ink` is that colour
// darkened until text on the tint passes 4.5:1.
const uses = [
  { id: 'practice', label: 'Practice', dot: '#1783FF' },
  { id: 'worship', label: 'Worship teams', dot: '#E8B93E' },
  { id: 'latin', label: 'Latin & keyboard styles', dot: '#FF3849' },
  { id: 'songwriters', label: 'Songwriters', dot: '#E0609A' },
  { id: 'producers', label: 'Producers', dot: '#8C7AE6' },
  { id: 'learners', label: 'Learners & teachers', dot: '#34C3B0' },
];

const practiceTools = [
  { icon: 'loop', title: 'Loop any section', text: 'It starts on the downbeat, round and round' },
  { icon: 'gauge', title: `${APP.tempo.min} to ${APP.tempo.max} BPM`, text: 'Start slow, speed up as you get it' },
  { icon: 'key', title: 'Any key', text: 'A new key, or a semitone at a time' },
  { icon: 'timer', title: 'Click and count-in', text: 'An accent on the one, a bar to get ready' },
  { icon: 'moon', title: 'Screen off, still playing', text: 'Play and stop from the notification' },
  { icon: 'zap', title: 'Fill on demand', text: 'Tap it and the break lands on the next bar' },
];

// The practice card draws the app's transport rather than showing a screenshot of it.
// Chord colours are the app's: major triads amber, minor blue (chordMajor / chordMinor).
const practiceChords = [
  { name: 'G', degree: 'I', playing: true, minor: false },
  { name: 'D', degree: 'V', playing: false, minor: false },
  { name: 'Em', degree: 'vi', playing: false, minor: true },
  { name: 'C', degree: 'IV', playing: false, minor: false },
];

const smallUses = [
  {
    id: 'songwriters', tag: 'Songwriters', tint: '#FBE7F0', ink: '#A3205C', shot: 'progressions',
    alt: 'Classic progressions to start from, each with its chords and what it sounds like',
    title: 'Catch the idea before it’s gone.',
    text: 'Sections, a Suggest button for chords that fit your key, strings in the chorus and piano in the verse. Then an M4A for the band. No signal needed.',
  },
  {
    id: 'producers', tag: 'Producers', tint: '#ECE9FB', ink: '#5140B8', shot: 'rhythm-piano',
    alt: 'The rhythm editor on the piano, with the notes of each step and a keyboard to set its range',
    title: 'Sketch it here, finish it in your DAW.',
    text: 'Get the progression and the groove down on the train, note by note per instrument. Export MIDI for the notes or WAV for the audio.',
  },
  {
    id: 'learners', tag: 'Learners & teachers', tint: '#DDF4F0', ink: '#0F766A', shot: 'chord-diagram',
    alt: 'A chord shown as a guitar shape and as keys on a piano',
    title: 'Hear what the theory means.',
    text: `Every chord shows its degree, its guitar shape and its keys. Play a ii–V–I, then the Andalusian cadence, in any of ${APP.rhythms} rhythms.`,
  },
];

// Names as the app lists them (style_presets.dart and assets/rhythm_library.json).
const genres = [
  { name: 'Latin & Caribbean', dot: '#FF3849', items: ['Salsa', 'Bachata', 'Merengue', 'Cumbia', 'Vallenato', 'Norteño', 'Duranguense', 'Banda', 'Bolero', 'Reggaeton', 'Bossa Nova', 'Samba', 'Cha-Cha', 'Punta'] },
  { name: 'Worship & Gospel', dot: '#E8B93E', items: ['Worship', 'Modern Worship', 'Fast Gospel', 'Slow Gospel'] },
  { name: 'Pop, Rock & Soul', dot: '#3B8FFF', items: ['Pop', 'Pop Rock', '16 Beat', 'Shuffle Rock', 'Funk', 'R&B', '60’s Soul', 'Blues Shuffle'] },
  { name: 'Jazz & Swing', dot: '#9C8CF0', items: ['Jazz Swing', 'Swing', 'Big Band', 'Jazz Waltz', 'Fox Trot'] },
  { name: 'Dance & Hip-Hop', dot: '#E0609A', items: ['Trap', 'Hip-Hop', 'House', 'Afrobeat', 'Techno Pop', 'Disco Pop'] },
  { name: 'Ballads, piano & world', dot: '#34C3B0', items: ['Piano Ballad', 'Stride Piano', 'Ragtime', 'Tango', 'Waltz', 'Bhangra', 'Enka'] },
];

// The song's form as a rhythm plays it: flex weights are roughly how long each part lasts.
const form = [
  { label: 'Intro', note: 'the way in', grow: 'grow-[2]', bar: '#E8B93E', ink: '#E8B93E', fill: false },
  { label: 'A · main', note: 'verse', grow: 'grow-[4]', bar: '#3B8FFF', ink: '#6FAEFF', fill: false },
  { label: 'Fill', note: '', grow: 'grow', bar: '#FF3849', ink: '#FF7A86', fill: true },
  { label: 'B · fuller', note: 'chorus', grow: 'grow-[4]', bar: '#9C8CF0', ink: '#B4A8F5', fill: false },
  { label: 'Fill', note: '', grow: 'grow', bar: '#FF3849', ink: '#FF7A86', fill: true },
  { label: 'Ending', note: 'the way out', grow: 'grow-[2]', bar: '#34C3B0', ink: '#5FD8C7', fill: false },
];

// What the app and Chord Player online share. Each is true of the code today: the web plays
// the app's engine compiled to WebAssembly with its SoundFont (src/lib/appEngine/), its 24
// styles and 177-rhythm library (public/rhythms/), and the app opens the site's public_songs.
const shared = [
  'The same audio engine and sounds',
  `All ${APP.rhythms} of the app’s rhythms`,
  `${APP.chordTypes} chord types, ${APP.instruments.length} instruments`,
  'The chordsequence.com song catalogue',
  'WAV and MIDI files that open anywhere',
];

const questions = [
  ['Is it free?', 'Yes, the whole app. There is nothing to buy inside it and no account to make.'],
  ['Does it work without a connection?', 'Yes. The sounds are on your phone, so writing a song and hearing the band work in a basement or on a plane. Only the song catalogue from chordsequence.com needs a connection.'],
  ['Can I practise one part over and over?', `Loop any section on its own, set the tempo anywhere from ${APP.tempo.min} to ${APP.tempo.max} BPM and turn on a one-bar count-in.`],
  ['Can I change the key?', 'Pick a new key for the whole song, or move it up and down a semitone at a time.'],
  ['Does it keep playing with the screen off?', 'Yes, with play and stop in the notification.'],
  ['Is there an iPhone version?', 'Not yet. On an iPhone or a computer, Chord Player runs in the browser instead.'],
  ['Where do my songs live?', 'On your phone. Nothing is uploaded, and deleting the app deletes them with it.'],
  ['Which languages does it speak?', 'English and Spanish. It follows your phone, and Android lets you set the app to one or the other on its own.'],
];

// A still waveform for the demo player; the script colours it as the song plays.
const wave = [8,14,20,12,24,18,10,22,28,16,12,20,26,14,8,18,24,20,12,16,28,22,14,10,20,26,18,12,24,16,10,22,28,18,14,20,12,24,16,10,18,26,20,14,22,12,8,16];

const appSchema = buildMobileApplicationSchema({
  url: PAGE_URL,
  name: 'Chord Player',
  description,
  installUrl: PLAY_URL,
  operatingSystem: `Android ${APP.minAndroid} or later`,
  featureList: [
    `Song sections with ${APP.chordTypes} chord types`,
    `${band} in ${APP.rhythms} rhythms`,
    'Intro, A and B variations and ending for nearly every rhythm',
    `Loop a section, tempo from ${APP.tempo.min} to ${APP.tempo.max} BPM, transpose, count-in`,
    'Keeps playing with the screen off',
    'Step-by-step rhythm editor with a range keyboard per instrument',
    `${APP.drumKits} drum kits and ${APP.percussionRows} rows of Latin and hand percussion`,
    '4/4, 3/4, 6/8 and 5/4',
    'Per-instrument mixer with EQ, compression and reverb',
    `${APP.exports.join(', ')} export`,
    'Works offline, no account',
    APP.languages.join(' and '),
  ],
});

const breadcrumbSchema = buildBreadcrumbSchema(PAGE_URL, [
  { name: 'Home', item: 'https://chordsequence.com/' },
  { name: 'Chord Player app', item: PAGE_URL },
]);

const kicker = 'font-mono text-xs font-bold uppercase tracking-[0.12em]';
const h2 = 'font-serif text-4xl font-semibold leading-[1.08] tracking-tight text-foreground sm:text-5xl';
---

<BaseLayout
  title="Chord Player for Android — Free Chord Progression App"
  description={description}
  canonicalUrl={PAGE_URL}
  ogImage="https://chordsequence.com/og/page/chord-player-app/"
  ogImageAlt="Chord Player for Android: your backing band, in your pocket"
>
  <Fragment slot="head">
    <JsonLd schema={appSchema} />
    <JsonLd schema={breadcrumbSchema} />
  </Fragment>

  <main class="overflow-x-clip">
    <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
    <!-- The demo sits under the badge: that the band sounds like a band is the one claim
         nobody can check by reading, so it is in reach before any scrolling. On a phone the
         screenshot comes after the words, where it cannot push the badge off the screen. -->
    <section class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 px-4 pb-12 pt-10 sm:px-6 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_500px] lg:gap-16 lg:pb-16">
      <div class="flex min-w-0 flex-col gap-6 sm:gap-7">
        <h1 class="flex flex-col gap-5">
          <span class="flex items-center gap-3.5">
            <img
              src="/images/chord-player-app-icon.png"
              width="96"
              height="96"
              alt=""
              class="h-12 w-12 rounded-xl border border-border sm:h-14 sm:w-14"
            />
            <span class={`${kicker} text-primary`}>Chord Player for Android</span>
          </span>
          <span class="font-serif text-[2.6rem] font-semibold leading-[1.04] tracking-tight text-foreground sm:text-6xl lg:text-7xl">
            Your backing band,<br />in your pocket.
          </span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
          Write the chords, pick one of {APP.rhythms} rhythms, from cumbia and bachata to
          worship and jazz, and {band} play them with you. Loop a section, slow it down,
          change the key.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-7" data-hero-cta>
          <GooglePlayBadge from="landing_hero" eager class="-ml-2" />
          <a href="#phone-and-browser" class="flex items-center gap-1.5 text-[15px] font-semibold text-muted-foreground transition-colors hover:text-primary">
            On iPhone or a computer? Open it in your browser
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.arrow} /></svg>
          </a>
        </div>

        <!-- The demo: "Sunset Drive", the song in the screenshots, exported from the app with
             its own M4A export (1.2.0, 2026-09-29). `preload="none"` keeps its 2.1 MB off
             every page load. A new recording gets a new file name, so no browser keeps
             playing the old one. -->
        <div class="flex max-w-[520px] items-center gap-4 rounded-2xl border border-border bg-card p-4 pr-5 shadow-sm" data-demo>
          <button
            type="button"
            class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground transition-transform hover:scale-105"
            aria-label="Play the salsa demo"
            data-demo-toggle
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-demo-play><path d="M7 4.5v15l12.5-7.5z" /></svg>
            <svg class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-demo-pause><rect x="5" y="4" width="5" height="16" rx="1" /><rect x="14" y="4" width="5" height="16" rx="1" /></svg>
          </button>
          <div class="flex min-w-0 grow flex-col gap-2">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[15px] font-semibold text-foreground">Hear it: “Sunset Drive” in Salsa</span>
              <span class="font-mono text-xs text-muted-foreground" data-demo-time>1:28</span>
            </div>
            <div class="flex h-7 items-center gap-[3px] overflow-hidden" aria-hidden="true">
              {wave.map((h) => (
                <span class="w-1 shrink-0 rounded-sm bg-[#D9DCE3]" style={`height:${h}px`} data-demo-bar></span>
              ))}
            </div>
            <span class="text-[12.5px] leading-snug text-muted-foreground">
              Exported straight from the app. Congas, bongos and güiro included, nothing added afterwards.
            </span>
          </div>
          <audio preload="none" src="/audio/chord-player-app-demo-salsa.m4a" data-demo-audio></audio>
        </div>
      </div>

      <div class="relative mx-auto flex h-[440px] w-full max-w-[500px] items-start justify-center overflow-visible rounded-[32px] bg-[#EFE8FD] pt-8 sm:h-[560px] lg:h-[640px] lg:items-center lg:pt-0">
        <img
          src="/images/chord-player-app/song.webp"
          width="760"
          height="1600"
          alt="Chord Player playing a salsa: Intro, Verse and Chorus, with the sounding chord lit up"
          fetchpriority="high"
          class="w-[220px] drop-shadow-[0_24px_40px_rgba(60,20,140,0.25)] sm:w-[260px] lg:w-[290px]"
        />
        <div class="absolute left-3 top-24 hidden items-center gap-2.5 rounded-2xl bg-card px-4 py-3 shadow-[0_12px_32px_rgba(20,24,31,0.12)] sm:flex lg:-left-7 lg:top-28">
          <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#E6F0FF] text-[#0B5FD6]">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.loop} /></svg>
          </span>
          <span class="flex flex-col"><span class="text-[13px] font-semibold text-foreground">Chorus on loop</span><span class="text-xs text-muted-foreground">until it’s in your hands</span></span>
        </div>
        <div class="absolute bottom-20 right-3 hidden items-center gap-2.5 rounded-2xl bg-card px-4 py-3 shadow-[0_12px_32px_rgba(20,24,31,0.12)] sm:flex lg:-right-6 lg:bottom-28">
          <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#FDE7EA] text-[#C8102E]">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.drum} /></svg>
          </span>
          <span class="flex flex-col"><span class="text-[13px] font-semibold text-foreground">Salsa · 100 BPM</span><span class="text-xs text-muted-foreground">one of {APP.rhythms} rhythms</span></span>
        </div>
      </div>
    </section>

    <!-- ─── CHECKS ───────────────────────────────────────────────────────── -->
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 rounded-2xl border border-border bg-card px-5 py-5 lg:justify-around">
        {checks.map((item) => (
          <li class="flex items-center gap-2 text-sm font-medium text-muted-foreground sm:text-[15px]">
            <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.check} /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- ─── MADE FOR ─────────────────────────────────────────────────────── -->
    <section id="made-for" class="mx-auto flex max-w-[1200px] scroll-mt-20 flex-col gap-6 px-4 pt-20 sm:px-6 sm:pt-28">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
        <div class="flex max-w-[700px] flex-col gap-3.5">
          <p class={`${kicker} text-primary`}>Made for</p>
          <h2 class={h2}>However you play, there’s a band for it.</h2>
        </div>
        <nav aria-label="Uses" class="flex max-w-[480px] flex-wrap gap-2 lg:justify-end">
          {uses.map((use) => (
            <a href={`#${use.id}`} class="flex h-9 items-center gap-2 rounded-full border border-border bg-card px-3.5 text-sm font-medium text-foreground transition-colors hover:border-primary/40">
              <span class="h-2 w-2 rounded-full" style={`background:${use.dot}`}></span>{use.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- 1 · Practice -->
      <article id="practice" class="grid grid-cols-1 scroll-mt-20 items-center gap-10 rounded-[28px] border border-border bg-card p-6 sm:p-10 lg:grid-cols-2 lg:gap-16 lg:p-14">
        <div class="flex flex-col gap-5">
          <span class="flex h-7 w-fit items-center rounded-full bg-[#E6F0FF] px-3 font-mono text-xs font-bold uppercase tracking-[0.08em] text-[#0B5FD6]">Practice</span>
          <h3 class="font-serif text-3xl font-semibold leading-[1.12] text-foreground sm:text-[40px]">Practice with a band that never gets tired.</h3>
          <p class="text-[17px] leading-relaxed text-muted-foreground">
            Loop the chorus until it’s in your hands. Slow it down, move it to your key and
            play along. Lock the phone: the band keeps going.
          </p>
          <ul class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            {practiceTools.map((tool) => (
              <li class="flex items-start gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] bg-muted text-foreground">
                  <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS[tool.icon]} /></svg>
                </span>
                <span class="flex flex-col gap-0.5">
                  <span class="text-[15px] font-semibold text-foreground">{tool.title}</span>
                  <span class="text-[13.5px] leading-snug text-muted-foreground">{tool.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- The app's transport, drawn: slowed down, in G, the chorus looping. Decoration,
             so hidden from screen readers; the list beside it says the same in words. -->
        <div class="flex flex-col justify-center gap-4 rounded-3xl bg-[#E6F0FF] p-5 sm:p-9" aria-hidden="true">
          <div class="flex flex-col gap-4 rounded-[22px] bg-card p-4 shadow-[0_16px_40px_rgba(11,40,90,0.14)] sm:p-5">
            <div class="flex items-center gap-4">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary shadow-[0_0_0_8px_#EFE8FD] sm:h-16 sm:w-16"><span class="h-4 w-4 rounded-[3px] bg-white"></span></span>
              <div class="flex grow flex-col gap-1.5">
                <div class="flex items-center gap-2"><span class="font-mono text-[11px] font-bold tracking-[0.12em] text-muted-foreground">TEMPO</span><span class="rounded-md bg-muted px-2 py-0.5 font-mono text-[11px] font-bold text-muted-foreground">4/4</span></div>
                <div class="flex items-baseline gap-1.5"><span class="font-mono text-3xl font-bold leading-none text-foreground sm:text-4xl">72</span><span class="text-[13px] text-muted-foreground">BPM · slowed from 96</span></div>
                <div class="relative h-1.5 rounded-full bg-muted"><div class="h-1.5 w-1/5 rounded-full bg-primary"></div><span class="absolute left-[20%] top-[-5px] -ml-2 h-4 w-4 rounded-full border border-border bg-white"></span></div>
              </div>
            </div>
            <div class="flex gap-2.5">
              <span class="flex h-10 shrink-0 items-center gap-2.5 rounded-full bg-muted px-4 font-mono font-bold"><span class="text-muted-foreground">−</span><span class="text-primary">G</span><span class="text-muted-foreground">+</span></span>
              <span class="flex h-10 shrink-0 items-center rounded-full border border-primary/30 bg-[#EFE8FD] px-3.5 text-sm font-semibold text-primary">Click</span>
