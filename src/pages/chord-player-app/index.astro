        <div class="absolute left-3 top-[14%] hidden items-center gap-2.5 rounded-2xl bg-card px-4 py-3 shadow-[0_12px_32px_rgba(20,24,31,0.12)] sm:flex xl:-left-7">
          <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#E6F0FF] text-[#0B5FD6]">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.loop} /></svg>
          </span>
          <span class="flex flex-col"><span class="text-[13px] font-semibold text-foreground">Chorus on loop</span><span class="text-xs text-muted-foreground">until it’s in your hands</span></span>
        </div>
        <div class="absolute bottom-[14%] right-3 hidden items-center gap-2.5 rounded-2xl bg-card px-4 py-3 shadow-[0_12px_32px_rgba(20,24,31,0.12)] sm:flex xl:-right-6">
          <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-[#FDE7EA] text-[#C8102E]">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.drum} /></svg>
          </span>
          <span class="flex flex-col"><span class="text-[13px] font-semibold text-foreground">Salsa · 100 BPM</span><span class="text-xs text-muted-foreground">one of {APP.rhythms} rhythms</span></span>
        </div>
