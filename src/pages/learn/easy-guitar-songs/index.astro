---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChordEmbedIsland from '../../../components/ChordEmbedIsland.astro';

const TITLE       = 'Easy Guitar Songs for Beginners — 27 Songs You Can Play Today';
const DESCRIPTION = '27 easy guitar songs for beginners, sorted by difficulty from 2-chord songs to classics. Includes chords, BPM, a practice tip, and a free player.';
const CANONICAL   = 'https://chordsequence.com/learn/easy-guitar-songs/';
const PUB_DATE    = '2026-06-18';
const MOD_DATE    = '2026-06-18';

type Level = 'beginner' | 'easy' | 'intermediate';

interface Song {
  title: string;
  artist: string;
  chords: string[];
  capo: number | null;
  bpm: number;
  level: Level;
  strumHint: string;
  tip: string;
  editorUrl: string;
  chartUrl: string | null;
}

interface SongGroup {
  id: string;
  badge: string;
  title: string;
  subtitle: string;
  intro: string;
  embedChords: string;
  embedBpm: number;
  embedStyle: string;
  embedTitle: string;
  songs: Song[];
}

