    '@id': 'https://chordsequence.com/about/elias-corsino/#person',
    name: 'Elías Corsino Saldaña',
    url: 'https://chordsequence.com/about/elias-corsino/',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://chordsequence.com/#organization',
    name: 'Chord Sequence',
    logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png', width: 696, height: 696 },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': CANONICAL },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Easy Guitar Songs for Beginners',
  description: `${totalSongs} easy guitar songs organized by difficulty — from 2-chord songs to acoustic classics.`,
  numberOfItems: totalSongs,
  itemListElement: allSongs.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${s.title} — ${s.artist}`,
    ...(s.chartUrl ? { url: `https://chordsequence.com${s.chartUrl}` } : {}),
  })),
};

const faqItems = [
  {
    q: 'What is the easiest song to learn on guitar for beginners?',
    a: "Knockin' on Heaven's Door by Bob Dylan is one of the easiest — just G and D, both open chords at a slow 68 BPM. A Horse with No Name by America is another great choice: two chords that share notes, making the transition nearly seamless. Both songs can be played within your first hour of practice.",
  },
  {
    q: 'How many chords do I need to play popular songs?',
    a: 'Just 4 chords — C, G, Am, and F — unlock hundreds of popular songs. Add G, D, and Em and you have access to most of the 3-chord rock and folk catalog. You can play every song on this page with 8 chord shapes total.',
  },
  {
    q: 'What are the best guitar songs for beginners?',
    a: "The best beginner songs have slow chord changes, open chord shapes, and fewer than 5 chords. Knockin' on Heaven's Door (2 chords), Blowin' in the Wind (3 chords), Let It Be (4 chords), and Wish You Were Here (5 chords) represent the ideal difficulty progression — each adds one more chord and one more level of challenge.",
  },
  {
    q: 'Do I need to read music to play guitar songs?',
    a: 'No. Almost all guitarists learn using chord charts and tabs, not music notation. A chord chart shows you which chord shape to hold and when to change it. You can play real songs on your first day without reading a single note.',
  },
  {
    q: 'What guitar should I use to learn these songs?',
    a: 'Any acoustic or electric guitar works. Steel-string acoustics are the most common choice for beginners learning these songs. Classical guitars (nylon string) are gentler on fingertips but slightly harder to form chord shapes on. Electric guitars have the same chord shapes as acoustic — whatever you own is the right guitar to start with.',
  },
  {
    q: 'How long does it take to learn a beginner guitar song?',
    a: 'A 2-chord song like Knockin\' on Heaven\'s Door is playable in one or two practice sessions — sometimes in a single afternoon. A 4-chord song usually takes a week of daily 20-minute sessions to play through comfortably. "Playing it" and "playing it well" are different timelines: the first is achievable in days, the second takes months. Start with the first goal.',
  },
  {
    q: 'Do I need to know music theory to play these songs?',
    a: "Not at all. Chord shapes are the only language you need for every song on this page. Understanding why C–G–Am–F works (it's the I–V–vi–IV progression in C major) is interesting and eventually useful, but it's not required. If you're curious, check our guide to chord progressions after you've played a few songs.",
  },
  {
    q: "What's the difference between strumming and fingerpicking?",
    a: 'Strumming moves a pick or your thumb across multiple strings at once — it\'s the foundation of most guitar playing and what all the songs on this list use by default. Fingerpicking means plucking individual strings with specific fingers, which creates a more delicate, arpeggiated sound. Good Riddance, Nothing Else Matters, and Patience on this list are traditionally played fingerstyle, but all of them can be strummed. Learn strumming first.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${CANONICAL}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',  item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://chordsequence.com/learn/' },
    { '@type': 'ListItem', position: 3, name: 'Easy Guitar Songs for Beginners', item: CANONICAL },
  ],
};
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  canonicalUrl={CANONICAL}
  ogType="article"
  author="Elías Corsino Saldaña"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={PUB_DATE} />
    <meta property="article:modified_time"  content={MOD_DATE} />
    <meta property="article:author"         content="Elías Corsino Saldaña" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-20">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-muted-foreground mb-10">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span class="opacity-40">/</span>
      <a href="/learn/" class="hover:text-foreground transition-colors">Learn</a>
      <span class="opacity-40">/</span>
      <span class="text-foreground">Easy guitar songs</span>
    </nav>

    <!-- Hero -->
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-5">
        🎸 {totalSongs} songs · Updated June 2026
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Easy guitar songs<br class="hidden sm:block" /> for beginners
      </h1>
      <p class="text-sm text-muted-foreground mb-6">
        By <a href="/about/elias-corsino/" class="text-foreground hover:text-primary transition-colors font-medium">Elías Corsino Saldaña</a>
        · Updated June 2026 · ~12 min read
      </p>
      <div class="space-y-4 text-lg text-muted-foreground max-w-2xl">
        <p>
          Whether you picked up a guitar yesterday or a month ago, the hardest question is always the same: <em>what do I actually play?</em> Scales are fine, theory is fine, but what beginners really want is to sit down and play something that sounds like a real song.
        </p>
        <p>
          This list was built around one rule: every song here is playable by someone who has just learned their first chord shapes. <strong class="text-foreground">"Easy" has a real definition.</strong> A beginner-friendly song has at least three of these: a slow or moderate tempo (under 120 BPM), fewer than five chords, open chord shapes only (no barre chords, or a capo to avoid them), and chord changes that happen slowly — at least one beat per change, often two.
        </p>
        <p>
          We start with 2-chord songs because they're the fastest way to feel like you're actually playing music. Then we add a third chord, then a fourth. By the time you reach the acoustic classics section, you'll have built a real vocabulary of chord shapes and changes — and you'll recognize that many of the "hard" songs use the same four chords as the easy ones.
        </p>
        <p>
          Each song includes a free interactive player so you can hear how the chords sound before you pick up your guitar. That's not a substitute for playing — it's a preview that makes learning faster. You don't need to read music or understand theory to use this page. Chord shapes and a sense of rhythm are all you need.
        </p>
      </div>
    </header>

    <!-- Table of contents -->
    <nav aria-label="Page contents" class="rounded-2xl border border-border bg-card p-6 mb-14">
      <p class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-4">On this page</p>
      <ol class="space-y-2 text-sm">
        {[
          { href: '#how-we-pick', label: 'How we pick beginner songs' },
          { href: '#two-chords',   label: '2-chord songs (4 songs)' },
          { href: '#three-chords', label: '3-chord songs (5 songs)' },
          { href: '#four-chords',  label: 'The 4-chord magic (9 songs)' },
          { href: '#acoustic',     label: 'Acoustic classics (5 songs)' },
          { href: '#iconic',       label: 'Iconic first songs (4 songs)' },
          { href: '#reference',    label: 'Quick reference table' },
          { href: '#practice',     label: 'How to practice these songs' },
          { href: '#next-steps',   label: 'What to learn next' },
          { href: '#faq',          label: 'Common questions' },
        ].map(item => (
          <li class="flex items-center gap-2">
            <span class="text-primary/50 font-mono text-xs">{String(item.href.replace('#', '')).padEnd(0)}</span>
            <a href={item.href} class="text-muted-foreground hover:text-foreground transition-colors">{item.label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- How we pick songs -->
    <section id="how-we-pick" class="rounded-2xl border border-border bg-card/40 p-6 sm:p-8 mb-14 scroll-mt-24">
      <h2 class="text-xl font-bold text-foreground mb-4">How we pick beginner songs</h2>
      <p class="text-muted-foreground text-sm mb-5">A song earns a spot on this list by meeting most of these criteria:</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { label: 'Tempo under 120 BPM', desc: 'Or commonly played slower than the original recording.' },
          { label: '2–5 chord shapes', desc: 'Fewer chords means faster progress and more time playing music.' },
          { label: 'Open chord shapes', desc: 'No full barre chords unless a capo makes them avoidable.' },
          { label: 'Slow chord changes', desc: 'At least 2 beats per chord — enough time to move cleanly.' },
        ].map(c => (
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            <div>
              <p class="text-sm font-semibold text-foreground">{c.label}</p>
              <p class="text-xs text-muted-foreground mt-0.5">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Song groups -->
    <div class="space-y-20">
      {songGroups.map((group) => (
        <section id={group.id} class="scroll-mt-24">
          <!-- Group header -->
          <div class="mb-6">
            <span class="text-xs font-semibold uppercase tracking-wide text-primary mb-2 block">{group.badge}</span>
            <h2 class="text-3xl font-bold text-foreground mb-2">{group.title}</h2>
            <p class="text-muted-foreground max-w-2xl">{group.subtitle}</p>
          </div>

          <!-- Group intro -->
          <p class="text-muted-foreground mb-8 max-w-2xl leading-relaxed">{group.intro}</p>

          <!-- ChordEmbed preview -->
          <div class="mb-8">
            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">Hear the foundation:</p>
            <ChordEmbedIsland
              chords={group.embedChords}
              bpm={group.embedBpm}
              style={group.embedStyle}
              title={group.embedTitle}
            />
          </div>

          <!-- Song cards -->
          <div class="space-y-4">
            {group.songs.map((song) => {
              const lvl = levelConfig[song.level];
              return (
                <article class="rounded-xl border border-border bg-card p-5 hover:border-primary/30 transition-colors">
                  <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                    <div class="flex-1 min-w-0">
                      <!-- Title row -->
                      <div class="flex flex-wrap items-start gap-x-3 gap-y-1 mb-2">
                        <div>
                          <h3 class="font-semibold text-foreground">{song.title}</h3>
                          <p class="text-sm text-muted-foreground">
                            {song.artist}{song.capo ? ` · Capo ${song.capo}` : ''}
                            {' · '}{song.bpm} BPM
                          </p>
                        </div>
                        <span class={`text-xs font-medium px-2 py-0.5 rounded-full shrink-0 mt-0.5 ${
                          song.level === 'beginner' ? 'bg-green-500/10 text-green-400' :
                          song.level === 'intermediate' ? 'bg-red-500/10 text-red-400' :
                          'bg-yellow-500/10 text-yellow-400'
                        }`}>
                          {lvl.icon} {lvl.label}
                        </span>
                      </div>

                      <!-- Chords -->
                      <div class="flex flex-wrap gap-1.5 mb-3">
                        {song.chords.map(c => (
                          <span class="text-xs font-bold font-mono px-2 py-0.5 rounded-md bg-primary/10 text-primary border border-primary/20">
                            {c}
                          </span>
                        ))}
                      </div>

                      <!-- Tip -->
                      <p class="text-sm text-muted-foreground leading-relaxed mb-2">{song.tip}</p>

                      <!-- Strum hint -->
                      <p class="text-xs text-muted-foreground/70 italic">Strum: {song.strumHint}</p>
                    </div>

                    <!-- Actions -->
                    <div class="flex sm:flex-col gap-2 shrink-0">
                      <a
                        href={song.editorUrl}
                        class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-primary-foreground transition-all whitespace-nowrap"
                      >
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        Hear it
                      </a>
                      {song.chartUrl && (
                        <a
                          href={song.chartUrl}
                          class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-2 border border-border rounded-lg text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors whitespace-nowrap"
                        >
                          Full chart →
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <!-- Reference table -->
    <section id="reference" class="mt-20 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground mb-2">Quick reference — all {totalSongs} songs</h2>
      <p class="text-muted-foreground mb-6 text-sm">Sort by difficulty, BPM, or chord count to find your next song.</p>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-card">
              <th class="text-left px-4 py-3 text-muted-foreground font-medium">Song</th>
              <th class="text-left px-4 py-3 text-muted-foreground font-medium">Artist</th>
              <th class="text-left px-4 py-3 text-muted-foreground font-medium hidden sm:table-cell">Chords</th>
              <th class="text-left px-4 py-3 text-muted-foreground font-medium hidden md:table-cell">BPM</th>
              <th class="text-left px-4 py-3 text-muted-foreground font-medium hidden md:table-cell">Capo</th>
              <th class="text-left px-4 py-3 text-muted-foreground font-medium">Level</th>
            </tr>
          </thead>
          <tbody>
            {allSongs.map((song, i) => {
              const lvl = levelConfig[song.level];
              return (
                <tr class={`border-b border-border last:border-0 hover:bg-card/50 transition-colors ${i % 2 === 0 ? '' : 'bg-card/20'}`}>
                  <td class="px-4 py-3 font-medium text-foreground">
                    {song.chartUrl
                      ? <a href={song.chartUrl} class="hover:text-primary transition-colors">{song.title}</a>
                      : song.title}
                  </td>
                  <td class="px-4 py-3 text-muted-foreground">{song.artist}</td>
                  <td class="px-4 py-3 hidden sm:table-cell">
                    <span class="font-mono text-xs text-primary/80">{song.chords.join(' · ')}</span>
                  </td>
                  <td class="px-4 py-3 text-muted-foreground hidden md:table-cell">{song.bpm}</td>
                  <td class="px-4 py-3 text-muted-foreground hidden md:table-cell">{song.capo ?? '—'}</td>
                  <td class="px-4 py-3">
                    <span class="text-xs">{lvl.icon} {lvl.label}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Practice tips -->
    <section id="practice" class="mt-20 rounded-2xl border border-border bg-card p-6 sm:p-8 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground mb-8">How to actually learn these songs</h2>
      <div class="space-y-6">
        {[
          {
            n: '1',
            title: 'Pick one song and commit to it',
            desc: "Don't rotate through five songs in one session. Choose the song you most want to play, learn it completely — from first chord to last — then move on. Spending 30 minutes on one song gets you further than 5 minutes on six songs. The psychological reward of playing something all the way through is also what keeps you coming back.",
          },
          {
            n: '2',
            title: 'Practice the hardest chord change in isolation',
            desc: "Identify the trickiest transition in your song — usually a move to F, Bm, or F#m — and practice just that change, back and forth, for several minutes before playing the full song. This targeted practice is five times faster than running through the whole song and hoping the hard part improves on its own.",
          },
          {
            n: '3',
            title: 'Start at half tempo, then build',
            desc: "Speed comes after your fingers know where to go — not before. Start at half the song's BPM and play through the changes cleanly. Once every transition is automatic at half tempo, bring it up to 75%, then full speed. Playing at full speed before your muscle memory is ready just reinforces mistakes.",
          },
          {
            n: '4',
            title: 'Use a metronome or backing track',
            desc: "Timing is the difference between chord shapes and music. Even tapping your foot helps. The free chord player on this page is built for exactly this — set it to your song's chords and BPM and play along. Hearing drums and bass in the background makes your chord changes lock in faster than playing alone.",
          },
          {
            n: '5',
            title: 'Record yourself, then listen back',
            desc: "Your ear hears things when you record that you miss while you're playing. A one-minute phone recording after each practice session reveals if chord changes are clean, if your timing is steady, and whether any chord is buzzing instead of ringing. It takes 30 seconds and removes all the guessing.",
          },
          {
            n: '6',
            title: 'Learn the intro first, then the verse',
            desc: "The intro of most beginner songs uses the same chord shapes as the verse. Learning the intro gives you a quick win in the first 10 minutes of practice — something that sounds complete — which motivates you to keep going. Once the intro is playable, the verse is usually 80% already there.",
          },
        ].map(tip => (
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/15 text-primary text-sm font-bold flex items-center justify-center">{tip.n}</span>
            <div>
              <p class="font-semibold text-foreground mb-1">{tip.title}</p>
              <p class="text-sm text-muted-foreground leading-relaxed">{tip.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- What to learn next -->
    <section id="next-steps" class="mt-16 scroll-mt-24">
      <h2 class="text-xl font-bold text-foreground mb-2">What to learn next</h2>
      <p class="text-muted-foreground text-sm mb-6">Once the songs on this page feel comfortable, these are the most useful next steps.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {[
          {
            title: 'Beginner guitar chords',
            desc: 'Diagrams and fingering for the 8 essential open chord shapes',
            href: '/learn/beginner-guitar-chords/',
          },
          {
            title: 'Chord inversions',
            desc: 'Use slash chords (G/B, C/E) to make any progression sound smoother',
            href: '/learn/chord-inversions/',
          },
          {
            title: 'What is a chord progression?',
            desc: 'Understand why these songs use the same chords and how to write your own',
            href: '/learn/what-is-a-chord-progression/',
          },
        ].map(link => (
          <a
            href={link.href}
            class="rounded-xl border border-border bg-card p-4 hover:border-primary/40 hover:bg-primary/5 transition-colors group"
          >
            <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">{link.title}</p>
            <p class="text-xs text-muted-foreground mt-1 leading-relaxed">{link.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mt-16 scroll-mt-24">
      <h2 class="text-2xl font-bold text-foreground mb-8">Common questions</h2>
      <div class="space-y-6">
        {faqItems.map(faq => (
          <div class="border-b border-border pb-6 last:border-0 last:pb-0">
            <h3 class="font-semibold text-foreground mb-2">{faq.q}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="mt-16 rounded-2xl bg-primary/5 border border-primary/20 p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground mb-3">Hear any progression before you play it</h2>
      <p class="text-muted-foreground mb-6 max-w-md mx-auto text-sm">
        Open the free chord player, type in any chords from the songs above, and hear exactly how they sound —
        with drums and bass. No account needed.
      </p>
      <a
        href="/editor/?chords=C-G-Am-F&bpm=90&style=pop_basic"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-primary-foreground text-base font-semibold rounded-xl hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        Try the free chord player
      </a>
      <p class="mt-3 text-xs text-muted-foreground">Free · No account · Works on phone and desktop</p>
    </section>

    <!-- Author box -->
    <div class="mt-10 pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img
          src="/images/elias-corsino.jpg"
          alt="Elías Corsino Saldaña"
          width="36"
          height="36"
          class="w-9 h-9 rounded-full object-cover shrink-0"
          loading="lazy"
        />
        <div>
          <a href="/about/elias-corsino/" class="text-sm font-medium text-foreground hover:text-primary transition-colors">
            Elías Corsino Saldaña
          </a>
          <p class="text-xs text-muted-foreground">Musician & Software Developer · Bass, Piano, Guitar, Drums</p>
        </div>
      </div>
      <p class="text-xs text-muted-foreground">
        Further reading:
        <a href="https://en.wikipedia.org/wiki/Guitar_chord" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline ml-1">Guitar chord — Wikipedia</a>
        {' · '}
        <a href="https://en.wikipedia.org/wiki/Tablature" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Tablature — Wikipedia</a>
      </p>
    </div>

  </main>
</BaseLayout>
