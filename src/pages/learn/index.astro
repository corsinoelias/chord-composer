---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCta from '../../components/AppCta.astro';

const allPosts = await getCollection('learn', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const learnSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Learn Music Theory — Chord Sequence',
  description: 'Free music theory guides for songwriters and producers. Chord progressions, transposition, circle of fifths, and more.',
  url: 'https://chordsequence.com/learn/',
  publisher: {
    '@type': 'Organization',
    name: 'Chord Sequence',
    url: 'https://chordsequence.com',
    logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png' },
  },
  blogPost: allPosts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `https://chordsequence.com/learn/${post.slug}/`,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: ((post.data as any).updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: 'Elías Corsino Saldaña',
      url: 'https://chordsequence.com/about/elias-corsino/',
    },
  })),
}
---

<BaseLayout
  title="Learn Music Theory & Chord Progressions | Chord Sequence"
  description="Free music theory guides for songwriters and producers. Learn chord progressions, transposition, the circle of fifths, and more — with interactive examples."
  canonicalUrl="https://chordsequence.com/learn/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(learnSchema)} />
  </Fragment>
  <main class="mx-auto max-w-4xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
        Free music theory guides
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">
        Learn music theory
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl">
        Short, practical guides for songwriters and producers. Every article includes interactive chord players so you can hear what you're learning.
      </p>
    </div>

    <!-- Beginner guides (static pages, not in blog collection) -->
    <div class="mb-10">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Beginner guides</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          {
            href: '/learn/how-to-read-bass-tabs/',
            title: 'How to Read Bass Tabs',
            description: 'Complete guide to bass tablature — 4 strings, fret numbers, symbols, and 3 interactive song examples.',
            tags: ['Bass', 'Beginner', 'Tab'],
          },
          {
            href: '/learn/beginner-guitar-chords/',
            title: 'Guitar Chords for Beginners',
            description: 'The 8 chords every beginner needs to know — diagrams, finger positions, and songs to practice.',
            tags: ['Guitar', 'Beginner'],
          },
          {
            href: '/learn/easy-guitar-songs/',
            title: 'Easy Guitar Songs for Beginners',
            description: '16 songs you can play today — from 2-chord classics to acoustic favourites.',
            tags: ['Guitar', 'Songs', 'Beginner'],
          },
          {
            href: '/best-chord-progression-generators/',
            title: 'Best Chord Progression Generators',
            description: 'Free vs paid tools compared — browser apps and DAW plugins for songwriters in 2026.',
            tags: ['Tools', 'Guide'],
          },
        ].map((guide) => (
          <a
            href={guide.href}
            class="group flex flex-col rounded-xl border border-border bg-card p-5 hover:border-primary/40 transition-colors"
          >
            <div class="flex flex-wrap gap-1.5 mb-2">
              {guide.tags.map((tag) => (
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors mb-1">
              {guide.title}
            </h2>
            <p class="text-sm text-muted-foreground flex-1">{guide.description}</p>
          </a>
        ))}
      </div>
    </div>

    {allPosts.length === 0 ? (
      <p class="text-muted-foreground">No articles yet. Check back soon.</p>
    ) : (
      <>
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Music theory articles</h2>
      <ul class="space-y-4">
        {allPosts.map((post) => (
          <li>
            <a
              href={`/learn/${post.slug}`}
              class="group flex flex-col sm:flex-row sm:items-start gap-4 rounded-xl border border-border bg-card p-5 hover:border-primary/40 transition-colors"
            >
              <div class="flex-1 min-w-0">
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    {post.data.tags.map((tag: string) => (
                      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors mb-1">
                  {post.data.title}
                </h2>
                <p class="text-sm text-muted-foreground line-clamp-2 mb-3">{post.data.description}</p>
                <p class="text-xs text-muted-foreground">
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
              </div>
              <div class="hidden sm:flex items-center text-primary/60 group-hover:text-primary transition-colors">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </a>
          </li>
        ))}
      </ul>
      </>
    )}

    <!-- Explore by genre -->
    <div class="mt-12 pt-10 border-t border-border">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Explore progressions by genre</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { href: '/progressions/pop/', label: 'Pop' },
          { href: '/progressions/jazz/', label: 'Jazz' },
          { href: '/progressions/lo-fi/', label: 'Lo-fi' },
          { href: '/progressions/blues/', label: 'Blues' },
          { href: '/progressions/12-bar-blues/', label: '12-Bar Blues' },
          { href: '/progressions/ii-v-i/', label: 'ii–V–I' },
          { href: '/progressions/rock/', label: 'Rock' },
          { href: '/progressions/sad/', label: 'Sad' },
          { href: '/progressions/happy/', label: 'Happy' },
          { href: '/progressions/neo-soul/', label: 'Neo Soul' },
          { href: '/progressions/worship/', label: 'Worship' },
          { href: '/progressions/edm/', label: 'EDM' },
        ].map((g) => (
          <a href={g.href} class="px-3 py-1.5 text-sm rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/40 transition-colors">
            {g.label}
          </a>
        ))}
      </div>
    </div>

    <AppCta
      class="mt-12"
      heading="Ready to try what you've learned?"
      description="Build any progression you read about in the interactive editor."
    />
  </main>
</BaseLayout>
