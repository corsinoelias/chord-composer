---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordEmbedIsland from '../../components/ChordEmbedIsland.astro';
import { AUTHORS } from '../../data/authors';

interface RelatedLink {
  href: string;
  label: string;
  description: string;
}

interface ArticleRelated {
  progressions: RelatedLink[];
  articles: RelatedLink[];
  tool?: { href: string; label: string; cta: string };
}

interface FAQItem {
  question: string;
  answer: string;
}

const ARTICLE_FAQ: Record<string, FAQItem[]> = {
  'what-is-a-chord-progression': [
    { question: 'What is a chord progression?', answer: 'A chord progression is a sequence of two or more chords played in succession that forms the harmonic foundation of a song. Chord progressions give music its emotional direction and are one of the primary building blocks of songwriting.' },
    { question: 'What is the most common chord progression?', answer: 'The most common chord progression is I–V–vi–IV (for example, C–G–Am–F in the key of C major). It is used in thousands of pop songs across every decade and is sometimes called the Axis progression.' },
    { question: 'How many chords do you need for a chord progression?', answer: 'A chord progression needs at least two chords, but most songs use three or four. The I–IV–V uses three chords and is the foundation of the blues, rock and roll, and folk music. The I–V–vi–IV uses four chords and drives the majority of modern pop.' },
  ],
  'jazz-chord-progressions': [
    { question: 'What is the most important jazz chord progression?', answer: 'The ii–V–I is the most important chord progression in jazz. In C major it is Dm7–G7–Cmaj7. The dominant seventh chord (G7) creates strong tension through its tritone interval, which resolves naturally to the tonic major seventh (Cmaj7). This progression appears in virtually every jazz standard ever written.' },
    { question: 'What is a jazz turnaround?', answer: 'A jazz turnaround is a short chord progression — typically two to four chords — used at the end of a section to create tension that leads back to the top of the form. The most common turnaround is I–VI–ii–V (Cmaj7–A7–Dm7–G7 in C major). The VI7 chord creates a secondary dominant that pulls toward the ii chord, which then resolves through V back to I.' },
    { question: 'What is tritone substitution in jazz?', answer: 'Tritone substitution replaces a dominant seventh chord with another dominant seventh whose root is a tritone (six semitones) away. G7 can be replaced by Db7 because they share the same tritone interval (B and F, or Cb and F). The substitution creates a chromatic descending bass line — G, Db, C — which is smoother and more colorful than the standard root movement.' },
  ],
  'circle-of-fifths-explained': [
    { question: 'What is the circle of fifths?', answer: 'The circle of fifths is a diagram that arranges all 12 musical keys in a circle based on their harmonic relationships. Moving clockwise, each key is a perfect fifth above the previous one. The circle shows which keys share the most notes (adjacent keys), which chords belong to each key, and how to modulate from one key to another.' },
    { question: 'How do you use the circle of fifths for songwriting?', answer: 'The circle of fifths helps songwriters choose chords that sound natural together. All the diatonic chords of a key sit adjacent to each other on the circle. To find chords that fit in C major, look at C and its immediate neighbors (G and F) — these are the I, V, and IV chords. Moving two steps in either direction gives you the ii, iii, and vi chords. Modulating to a closely related key means moving one or two steps around the circle.' },
    { question: 'Why do jazz progressions follow the circle of fifths?', answer: 'Jazz progressions follow the circle of fifths because each dominant seventh chord naturally resolves to the key a fifth below. In G7–Cmaj7, G7 resolves to C — one step clockwise on the circle. Jazz composers chain these resolutions together, creating sequences that descend through the circle (iii–VI–ii–V–I in the key of C, for example). This movement generates harmonic momentum that listeners experience as forward motion.' },
  ],
};

const ARTICLE_RELATED: Record<string, ArticleRelated> = {
  'what-is-a-chord-progression': {
    progressions: [
      { href: '/progressions/pop/', label: 'Pop chord progressions', description: 'I–V–vi–IV and the most recorded progressions in modern music' },
      { href: '/progressions/sad/', label: 'Sad chord progressions', description: 'Minor keys and descending lines that evoke emotion' },
    ],
    articles: [
      { href: '/learn/chord-progressions-for-beginners/', label: 'Chord progressions for beginners', description: 'Step-by-step guide to using progressions in your own songs' },
      { href: '/learn/music-theory-basics-for-songwriters/', label: 'Music theory basics for songwriters', description: 'Keys, scales, and the theory behind every chord choice' },
    ],
  },
  'chord-progressions-for-beginners': {
    progressions: [
      { href: '/progressions/pop/', label: 'Pop chord progressions', description: 'Start playing the I–V–vi–IV and other pop staples right now' },
      { href: '/progressions/happy/', label: 'Happy chord progressions', description: 'Bright, major-key progressions full of energy' },
    ],
    articles: [
      { href: '/learn/what-is-a-chord-progression/', label: 'What is a chord progression?', description: 'The theory behind why certain chord combinations work' },
      { href: '/learn/jazz-chord-progressions/', label: 'Jazz chord progressions', description: 'Take your progressions further with jazz harmony' },
    ],
  },
  'jazz-chord-progressions': {
    progressions: [
      { href: '/progressions/jazz/', label: 'Jazz chord progressions', description: 'ii–V–I, turnarounds, bossa nova — play every example in your browser' },
      { href: '/progressions/neo-soul/', label: 'Neo soul chord progressions', description: 'Jazz-influenced extended harmony in a modern R&B context' },
    ],
    articles: [
      { href: '/learn/what-is-a-chord-progression/', label: 'What is a chord progression?', description: 'The fundamentals behind all harmonic movement' },
      { href: '/learn/circle-of-fifths-explained/', label: 'Circle of fifths explained', description: 'Why jazz progressions move through the circle of fifths' },
    ],
  },
  'circle-of-fifths-explained': {
    progressions: [
      { href: '/progressions/jazz/', label: 'Jazz chord progressions', description: 'The circle of fifths in action — ii–V–I and cycle progressions' },
    ],
    articles: [
      { href: '/learn/how-to-transpose-chords/', label: 'How to transpose chords', description: 'The circle of fifths is the foundation of transposition' },
      { href: '/learn/jazz-chord-progressions/', label: 'Jazz chord progressions', description: 'How jazz harmony follows the circle of fifths step by step' },
    ],
    tool: { href: '/tools/circle-of-fifths/', label: 'Explore key relationships visually with the interactive Circle of Fifths tool', cta: 'Open Circle of Fifths →' },
  },
  'how-to-transpose-chords': {
    progressions: [
      { href: '/progressions/pop/', label: 'Pop chord progressions', description: 'Try transposing I–V–vi–IV to different keys to hear the difference' },
    ],
    articles: [
      { href: '/learn/chord-progressions-for-beginners/', label: 'Chord progressions for beginners', description: 'The foundational progressions to practice transposing' },
      { href: '/learn/music-theory-basics-for-songwriters/', label: 'Music theory basics for songwriters', description: 'Keys, intervals, and how transposition fits the bigger picture' },
    ],
    tool: { href: '/tools/chord-transposer/', label: 'Shift any chord progression to any key instantly with the free Chord Transposer', cta: 'Open Chord Transposer →' },
  },
  'music-theory-basics-for-songwriters': {
    progressions: [
      { href: '/progressions/edm/', label: 'EDM chord progressions', description: 'How electronic music applies basic theory at high energy' },
      { href: '/progressions/lo-fi/', label: 'Lo-fi chord progressions', description: 'Extended seventh chords and modal harmony in chill beats' },
    ],
    articles: [
      { href: '/learn/what-is-a-chord-progression/', label: 'What is a chord progression?', description: 'Apply your theory knowledge to real chord writing' },
      { href: '/learn/circle-of-fifths-explained/', label: 'Circle of fifths explained', description: 'The visual tool that maps all key relationships' },
    ],
    tool: { href: '/tools/key-detector/', label: 'Find the key of any chord progression with the free Key Detector tool', cta: 'Open Key Detector →' },
  },
};

export async function getStaticPaths() {
  const posts = await getCollection('learn', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const related = ARTICLE_RELATED[post.slug];
const faqItems = ARTICLE_FAQ[post.slug];
const faqSchema = faqItems
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const canonicalLearnUrl = `https://chordsequence.com/learn/${post.slug}/`;

const authorSlug = post.data.author as keyof typeof AUTHORS | undefined;
const author = authorSlug ? AUTHORS[authorSlug] : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image ?? 'https://chordsequence.com/og-image.png',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString().split('T')[0],
  author: author
    ? {
        '@type': 'Person',
        name: author.name,
        url: author.url,
        sameAs: [author.linkedin, author.instagram],
      }
    : { '@type': 'Organization', name: 'Chord Sequence', url: 'https://chordsequence.com' },
  publisher: {
    '@type': 'Organization',
    name: 'Chord Sequence',
    url: 'https://chordsequence.com',
    logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png', width: 696, height: 696 },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalLearnUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com' },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://chordsequence.com/learn/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalLearnUrl },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | Chord Sequence`}
  description={post.data.description}
  canonicalUrl={canonicalLearnUrl}
  ogType="article"
  author={author?.name ?? 'Elías Corsino Saldaña'}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:author" content={author?.url ?? 'https://chordsequence.com/about/elias-corsino/'} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/learn" class="hover:text-foreground transition-colors">Learn</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{post.data.title}</span>
    </nav>

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
            {tag}
          </span>
        ))}
      </div>
    )}

    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4 font-serif">
        {post.data.title}
      </h1>
      <p class="text-lg text-muted-foreground">{post.data.description}</p>
      <p class="mt-4 text-sm text-muted-foreground">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      {author && (
        <div class="flex items-center gap-3 mt-6 pb-6 border-b border-border">
          <img
            src={author.avatar}
            alt={author.name}
            width="36"
            height="36"
            class="w-9 h-9 rounded-full object-cover shrink-0"
            loading="lazy"
          />
          <div>
            <a href="/about/elias-corsino/" class="text-sm font-medium text-foreground hover:text-primary transition-colors">
              {author.name}
            </a>
            <p class="text-xs text-muted-foreground">{author.role}</p>
          </div>
        </div>
      )}
    </header>

    <!-- Above-fold CTA -->
    <div class="mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">
      <p class="text-sm text-muted-foreground">Build the progressions from this article in the free interactive editor.</p>
      <a
        href="/app/"
        class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
      >
        Try in Chord Player →
      </a>
    </div>

    <article class="
      prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground
      prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-muted-foreground prose-p:leading-relaxed prose-p:my-5
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-strong:text-foreground prose-strong:font-semibold
      prose-li:text-muted-foreground prose-li:my-1
      prose-ul:my-5 prose-ol:my-5
      prose-hr:border-border prose-hr:my-10
      prose-table:text-sm
      prose-thead:border-border
      prose-th:text-foreground prose-th:font-semibold prose-th:py-3
      prose-td:text-muted-foreground prose-td:py-3
      prose-blockquote:border-primary prose-blockquote:text-muted-foreground
    ">
      <Content components={{ ChordEmbed: ChordEmbedIsland }} />
    </article>

    <!-- CTA -->
    <div class="mt-16 rounded-xl border border-primary/20 bg-primary/5 p-8 text-center">
      <h2 class="text-xl font-semibold text-foreground mb-2">Try it in Chord Player</h2>
      <p class="text-sm text-muted-foreground mb-5">Build the progressions from this article in the free interactive editor.</p>
      <a href="/app" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:bg-primary/90 transition-colors">
        Open Chord Player →
      </a>
    </div>

    <!-- Related tool callout -->
    {related?.tool && (
      <div class="mt-8 rounded-xl border border-primary/20 bg-primary/5 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-muted-foreground text-center sm:text-left">{related.tool.label}</p>
        <a
          href={related.tool.href}
          class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          {related.tool.cta}
        </a>
      </div>
    )}

    <!-- Explore progressions -->
    {related?.progressions && related.progressions.length > 0 && (
      <div class="mt-12 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Explore progressions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {related.progressions.map((item) => (
            <a
              href={item.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {item.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">{item.description}</p>
              </div>
              <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Related articles -->
    {related?.articles && related.articles.length > 0 && (
      <div class="mt-8 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Related articles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {related.articles.map((item) => (
            <a
              href={item.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {item.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">{item.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Back -->
    <div class="mt-8 text-center">
      <a href="/learn/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Back to all articles
      </a>
    </div>
  </main>
</BaseLayout>
