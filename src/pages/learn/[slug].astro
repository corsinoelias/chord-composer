export async function getStaticPaths() {
  const posts = await getCollection('learn', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const related = ARTICLE_RELATED[post.slug];
const faqItems = ARTICLE_FAQ[post.slug];

const canonicalLearnUrl = `https://chordsequence.com/learn/${post.slug}/`;

const authorSlug = post.data.author as keyof typeof AUTHORS | undefined;
const author = authorSlug ? AUTHORS[authorSlug] : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalLearnUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image
    ? { '@type': 'ImageObject', url: post.data.image, width: 1200, height: 630 }
    : { '@type': 'ImageObject', url: 'https://chordsequence.com/og-image.jpg', width: 1200, height: 630 },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: author
    ? {
        '@type': 'Person',
        '@id': `${author.url}#person`,
        name: author.name,
        url: author.url,
        image: {
          '@type': 'ImageObject',
          url: `https://chordsequence.com${author.avatar}`,
          width: 400,
          height: 400,
        },
        description: author.bio,
        sameAs: [author.linkedin, author.instagram, author.youtube],
      }
    : { '@type': 'Organization', '@id': 'https://chordsequence.com/#organization', name: 'Chord Sequence', url: 'https://chordsequence.com' },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://chordsequence.com/#organization',
    name: 'Chord Sequence',
    url: 'https://chordsequence.com',
    logo: { '@type': 'ImageObject', url: 'https://chordsequence.com/logo-schema.png', width: 696, height: 696 },
  },
  educationalLevel: 'Beginner',
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalLearnUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalLearnUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://chordsequence.com/learn/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalLearnUrl },
  ],
};

const ARTICLE_EXTRA_SCHEMAS: Record<string, object[]> = {
  'secondary-dominants': [
    {
      '@context': 'https://schema.org',
      '@type': 'DefinedTermSet',
      name: 'Secondary Dominant Glossary',
      url: 'https://chordsequence.com/learn/secondary-dominants/',
      hasDefinedTerm: [
        { '@type': 'DefinedTerm', name: 'Secondary Dominant', termCode: 'secondary-dominant', description: 'A dominant seventh chord that resolves to a chord other than the home tonic, briefly treating that chord as a local tonic. Written as V/X (V of X).' },
        { '@type': 'DefinedTerm', name: 'Tonicization', termCode: 'tonicization', description: 'Briefly emphasizing a non-tonic chord as if it were the tonic by approaching it with its own dominant chord. Shorter than a full modulation — the home key is never abandoned.' },
        { '@type': 'DefinedTerm', name: 'Applied Dominant', termCode: 'applied-dominant', description: 'Another name for a secondary dominant — a dominant chord "applied" to a specific target chord to create a V→I resolution toward it.' },
        { '@type': 'DefinedTerm', name: 'V/V', termCode: 'v-of-v', description: 'The secondary dominant of the dominant chord. In C major, V/V is D7 — the dominant of G. Introduces F# (the leading tone of G major) to make the arrival of G feel stronger.' },
        { '@type': 'DefinedTerm', name: 'Tritone Interval', termCode: 'tritone', description: 'The interval of three whole tones (six semitones) between the third and seventh of any dominant seventh chord. This unstable interval drives the dominant-to-tonic resolution.' },
      ],
    },
  ],
  'chord-inversions': [
    {
      '@context': 'https://schema.org',
      '@type': 'DefinedTermSet',
      name: 'Chord Inversion Glossary',
      url: 'https://chordsequence.com/learn/chord-inversions/',
      hasDefinedTerm: [
        { '@type': 'DefinedTerm', name: 'Root Position', termCode: 'root-position', description: 'The default chord arrangement where the root note is the lowest note. C major root position: C at the bottom, E in the middle, G on top.' },
        { '@type': 'DefinedTerm', name: 'First Inversion', termCode: 'first-inversion', description: 'A chord arrangement where the third is the lowest note. C major first inversion is written C/E — E is in the bass, with C and G above.' },
        { '@type': 'DefinedTerm', name: 'Second Inversion', termCode: 'second-inversion', description: 'A chord arrangement where the fifth is the lowest note. C major second inversion is written C/G — G is in the bass.' },
        { '@type': 'DefinedTerm', name: 'Slash Chord', termCode: 'slash-chord', description: 'Notation specifying the bass note separately from the chord: Chord/BassNote. Examples: C/E, G/B, D/F#, Am/G.' },
        { '@type': 'DefinedTerm', name: 'Voice Leading', termCode: 'voice-leading', description: 'The art of moving from one chord to the next with the smallest possible movement in each individual note. Chord inversions are the primary tool for smooth voice leading.' },
      ],
    },
  ],
};

const extraSchemas = ARTICLE_EXTRA_SCHEMAS[post.slug] ?? [];
---

<BaseLayout
  title={`${post.data.seoTitle ?? post.data.title} | Chord Sequence`}
  description={post.data.description}
  canonicalUrl={canonicalLearnUrl}
  ogImage={`https://chordsequence.com/og/learn/${post.slug}/`}
  ogImageAlt={post.data.title}
  ogType="article"
  author={author?.name ?? 'Elías Corsino Saldaña'}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedDate ?? post.data.pubDate).toISOString()} />
    <meta property="article:author" content={author?.url ?? 'https://chordsequence.com/about/elias-corsino/'} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {extraSchemas.map(schema => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/learn/" class="hover:text-foreground transition-colors">Learn</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground truncate">{post.data.title}</span>
    </nav>

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
            {tag}
          </span>
        ))}
      </div>
    )}

    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4 font-serif">
        {post.data.title}
      </h1>
      <p class="text-lg text-muted-foreground">{post.data.description}</p>
      <p class="mt-4 text-sm text-muted-foreground">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.updatedDate && (
          <span class="ml-3 text-xs text-muted-foreground/70">
            · Updated {post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
        )}
      </p>

      {author && (
        <div class="flex items-center gap-3 mt-6 pb-6 border-b border-border">
          <img
            src={author.avatar}
            alt={author.name}
            width="36"
            height="36"
            class="w-9 h-9 rounded-full object-cover shrink-0"
            loading="lazy"
          />
          <div>
            <a href="/about/elias-corsino/" class="text-sm font-medium text-foreground hover:text-primary transition-colors">
              {author.name}
            </a>
            <p class="text-xs text-muted-foreground">{author.role}</p>
          </div>
        </div>
      )}
    </header>

    <!-- Above-fold CTA -->
    <div class="mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">
      <p class="text-sm text-muted-foreground">Build the progressions from this article in the free interactive editor.</p>
      <a
        href="/chord-player/"
        class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
      >
        Open free Chord Player
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <article class="
      prose prose-invert prose-lg max-w-none
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground
      prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-muted-foreground prose-p:leading-relaxed prose-p:my-5
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-strong:text-foreground prose-strong:font-semibold
      prose-li:text-muted-foreground prose-li:my-1
      prose-ul:my-5 prose-ol:my-5
      prose-hr:border-border prose-hr:my-10
      prose-table:text-sm
      prose-thead:border-border
      prose-th:text-foreground prose-th:font-semibold prose-th:py-3
      prose-td:text-muted-foreground prose-td:py-3
      prose-blockquote:border-primary prose-blockquote:text-muted-foreground
    ">
      <Content components={{ ChordEmbed: ChordEmbedIsland, CircleOfFifths: CircleOfFifthsIsland, InversionDemo: InversionDemoIsland, BassTabPreview: BassTabPreviewIsland }} />
    </article>

    {faqItems && faqItems.length > 0 && (
      <section class="mt-16 pt-8 border-t border-border" aria-label="Frequently asked questions">
        <h2 class="text-2xl font-bold text-foreground mb-8">Frequently Asked Questions</h2>
        <dl class="space-y-6">
          {faqItems.map((item: FAQItem) => (
            <div class="border border-border rounded-xl p-5">
              <dt class="text-base font-semibold text-foreground mb-2">{item.question}</dt>
              <dd class="text-sm text-muted-foreground leading-relaxed">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <AppCta
      class="mt-16"
      heading="Try it in Chord Player"
      description="Build the progressions from this article in the free interactive editor."
    />

    <!-- Related tool callout -->
    {related?.tool && (
      <div class="mt-8 rounded-xl border border-primary/20 bg-primary/5 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-muted-foreground text-center sm:text-left">{related.tool.label}</p>
        <a
          href={related.tool.href}
          class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          {related.tool.cta}
        </a>
      </div>
    )}

    <!-- Explore progressions -->
    {related?.progressions && related.progressions.length > 0 && (
      <div class="mt-12 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Explore progressions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {related.progressions.map((item) => (
            <a
              href={item.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {item.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">{item.description}</p>
              </div>
              <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Related articles -->
    {related?.articles && related.articles.length > 0 && (
      <div class="mt-8 pt-8 border-t border-border">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Related articles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {related.articles.map((item) => (
            <a
              href={item.href}
              class="group flex items-start gap-3 rounded-xl border border-border bg-card hover:border-primary/40 hover:bg-primary/5 p-4 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
                  {item.label}
                </p>
                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">{item.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Author box -->
    {author && (
      <ArticleAuthorBox author={author} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} />
    )}

    <!-- Back -->
    <div class="mt-8 text-center">
      <a href="/learn/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Back to all articles
      </a>
    </div>
  </main>
</BaseLayout>
