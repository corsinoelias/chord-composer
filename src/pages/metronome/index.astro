---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { OnlineMetronome } from '../../components/Metronome/OnlineMetronome'
import RelatedTools from '../../components/RelatedTools.astro'

const howTo = [
  { t: 'Set the tempo', d: 'with the slider, the − / + buttons, the arrow keys, or press TAP a few times along with the song.' },
  { t: 'Pick a time signature', d: '(4/4, 3/4, 6/8…) and, if you like, a subdivision: eighth notes, triplets, sixteenths…' },
  { t: 'Shape the accents', d: 'by tapping the dots: strong accent, normal beat, or dashed for silent. Build patterns like X · X · for odd meters.' },
  { t: 'Press play', d: '(or the space bar) and practice.' },
  { t: 'Want more of a challenge?', d: 'Turn on the Speed trainer to raise the BPM automatically, or Silent bars to alternate sounding and muted bars and strengthen your inner clock.' },
]

const features = [
  { t: 'Tempo 20–400 BPM', d: 'Slider, buttons, keyboard and tap tempo, with the classical tempo name (Andante, Allegro…).' },
  { t: 'Time signatures & accents', d: 'From 2/4 to 12/8. Tap the dots to build your own accent pattern, including silent beats.' },
  { t: 'Subdivisions', d: 'Eighth notes, triplets, sixteenths, quintuplets and sextuplets, with a softer in-between click.' },
  { t: 'Clean click sound', d: 'A clear, distraction-free beep with a higher-pitched accent, synthesized live — nothing to download.' },
  { t: 'Speed trainer', d: 'Raises the BPM automatically every N bars up to your target. Ideal for building speed.' },
  { t: 'Silent bars', d: 'Alternates sounding and muted bars to train your inner clock like a pro.' },
  { t: 'Visual beat indicator', d: 'A beat circle that fills as the bar progresses and highlights every accent.' },
  { t: 'Web Audio precision', d: 'Every click is scheduled ahead in the audio engine: a stable pulse without JavaScript timer jitter.' },
]

const shortcuts = [
  { k: 'Space', d: 'Play / pause' },
  { k: '↑ / ↓', d: 'Tempo +1 / −1 BPM' },
  { k: '← / →', d: 'Tempo −5 / +5 BPM' },
  { k: 'Shift + ↑ / ↓', d: 'Tempo +10 / −10 BPM' },
  { k: 'T', d: 'Tap tempo' },
]

const faqs = [
  { q: 'Is this metronome accurate?', a: 'Yes. Each click is scheduled ahead of time in the browser\'s audio engine (Web Audio API), not with JavaScript timers. The result is a stable pulse with millisecond precision, even when the tab is busy.' },
  { q: 'What BPM should I practice at?', a: 'Start at a tempo where you can play the passage with no mistakes — usually slower than you think. Raise it 2 BPM at a time, only after playing it clean three times in a row. The speed trainer automates exactly that.' },
  { q: 'What are subdivisions?', a: 'The clicks between beats: two eighth notes, three triplet notes or four sixteenths per quarter note. Practicing with subdivisions helps you place every note exactly where it belongs.' },
  { q: 'What are silent bars for?', a: 'The metronome clicks for a few bars, then goes silent while you keep the tempo internally. When the click returns you find out if you rushed or dragged. It\'s one of the most effective timing exercises.' },
  { q: 'Are my settings saved?', a: 'Yes — tempo, time signature and trainers are saved automatically in your browser. No account needed.' },
  { q: 'Does it work on mobile?', a: 'Yes, the layout is responsive with thumb-sized controls. On iOS, tap play once to enable audio (a system requirement).' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/metronome/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Online Metronome', item: 'https://chordsequence.com/metronome/' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Online Metronome',
  url: 'https://chordsequence.com/metronome/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online metronome with tap tempo, time signatures, subdivisions, speed trainer and silent bars. Accurate Web Audio scheduling from 20 to 400 BPM.',
  featureList: [
    'Adjustable BPM from 20 to 400',
    'Tap tempo — click or press T',
    'Time signatures from 2/4 to 12/8',
    'Subdivisions: eighths, triplets, sixteenths, quintuplets, sextuplets',
    'Speed trainer and silent bars practice modes',
    'Keyboard shortcuts: Space, T, arrow keys',
    'No signup, no download',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Online Metronome — Free BPM Tool with Tap Tempo | Chord Sequence"
  description="Free online metronome. Set your BPM with the slider or tap tempo, choose time signatures and subdivisions, and train with the speed trainer and silent bars. No signup required."
  canonicalUrl="https://chordsequence.com/metronome/"
  ogImage="/og/page/metronome/"
  ogImageAlt="Online Metronome — Free BPM Tool | Chord Sequence"
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#fafbfc">

    <!--
      OnlineMetronome is SSR-safe (deterministic initial state — no window/
      document access outside the keyboard-shortcut effect), so it doesn't
      need a hand-built skeleton. client:load renders its real HTML
      immediately server-side (it's the primary, above-the-fold content of
      this page — a full-viewport hero, not a boxed widget) and just
      attaches interactivity on hydrate — no pop-in.
    -->
    <OnlineMetronome client:load />

    <div style="max-width:800px;margin:0 auto;padding:24px 24px 80px;display:flex;flex-direction:column;gap:64px;font-family:'IBM Plex Sans',Helvetica,Arial,sans-serif;color:#15181d">

      <!-- WHAT IS A METRONOME -->
      <section>
        <h2 style="font-size:26px;margin:0 0 14px;letter-spacing:-0.01em">What is an online metronome?</h2>
        <p style="font-size:16px;line-height:1.7;color:#3c434d;margin:0">
          A metronome keeps a steady beat so you can practice playing in time. This one runs right in your browser — free, no account, no install — and is built as a practice companion, not just a timer. It uses the browser's audio engine (Web Audio API) with look-ahead scheduling, so the click stays rock-solid from 20 to 400 BPM, on desktop and mobile. Your settings are remembered automatically.
        </p>
      </section>

      <!-- HOW TO USE -->
      <section>
        <h2 style="font-size:26px;margin:0 0 14px;letter-spacing:-0.01em">How to use it</h2>
        <ol style="font-size:15.5px;line-height:1.8;color:#3c434d;margin:0;padding-left:22px;display:flex;flex-direction:column;gap:10px">
          {howTo.map((step) => (
            <li><strong style="color:#15181d">{step.t}</strong> {step.d}</li>
          ))}
        </ol>
      </section>

      <!-- FEATURES -->
      <section>
        <h2 style="font-size:26px;margin:0 0 18px;letter-spacing:-0.01em">Features</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px">
          {features.map((f) => (
            <div style="border:1.5px solid #e3e7ec;border-radius:12px;background:#fff;padding:16px 18px">
              <div style="font-weight:600;font-size:14.5px;margin-bottom:6px">{f.t}</div>
              <div style="font-size:13.5px;line-height:1.55;color:#5c6470">{f.d}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- KEYBOARD SHORTCUTS -->
      <section>
        <h2 style="font-size:26px;margin:0 0 18px;letter-spacing:-0.01em">Keyboard shortcuts</h2>
        <div style="display:flex;flex-direction:column;border:1.5px solid #e3e7ec;border-radius:12px;background:#fff;overflow:hidden">
          {shortcuts.map((s, i) => (
            <div style={`display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 18px;${i < shortcuts.length - 1 ? 'border-bottom:1px solid #eef1f4' : ''}`}>
              <span style="font-size:14px;color:#3c434d">{s.d}</span>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;background:#eef1f4;border:1px solid #d8dde3;border-radius:6px;padding:3px 9px;white-space:nowrap">{s.k}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section>
        <h2 style="font-size:26px;margin:0 0 18px;letter-spacing:-0.01em">Frequently asked questions</h2>
        <div style="display:flex;flex-direction:column;gap:10px">
          {faqs.map((f) => (
            <details style="border:1.5px solid #e3e7ec;border-radius:12px;background:#fff;padding:14px 18px">
              <summary style="font-size:15px;font-weight:600;cursor:pointer">{f.q}</summary>
              <p style="font-size:14px;line-height:1.65;color:#5c6470;margin:10px 0 2px">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <div style="text-align:center;font-size:12px;color:#8a929c;border-top:1px solid #e3e7ec;padding-top:24px">Online metronome · free, no account, runs in your browser</div>
    </div>

    <!-- RELATED TOOLS -->
    <RelatedTools tools={[
      { href: '/tuner/', icon: 'tuner', label: 'Online Tuner', desc: 'Tune your instrument via microphone before you start practicing.' },
      { href: '/tools/drum-machine/', icon: 'drums', label: 'Drum Machine', desc: '16-step beat programming with 3 kits and 12 genre presets.' },
      { href: '/bass-guitar/', icon: 'bass', label: 'Virtual Bass Guitar', desc: 'Play bass lines with four real sampled sounds on a full fretboard.' },
      { href: '/tools/bass-guitar-tab/', icon: 'bass-tab', label: 'Bass Tab Player', desc: 'Compose bass lines at custom BPM. Export to MIDI or ASCII tab.' },
      { href: '/chord-player/', icon: 'chords', label: 'Chord Player', desc: 'Build chord progressions with drums, bass, and piano — BPM included.' },
    ]} />

  </main>
</BaseLayout>
