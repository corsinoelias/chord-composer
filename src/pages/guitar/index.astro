---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { GuitarInstrument } from '../../components/GuitarTabPlayer/GuitarInstrument'
import RelatedTools from '../../components/RelatedTools.astro'

const sounds = [
  { label: 'Steel ★',      desc: 'Acoustic steel-string — bright, full-bodied, and resonant. The quintessential acoustic guitar sound for folk, pop, and singer-songwriter.' },
  { label: 'Nylon ★',      desc: 'Classical nylon string — warm, mellow, and intimate. Perfect for fingerpicked melodies and flamenco-inspired patterns.' },
  { label: 'Clean ★',      desc: 'Electric clean — crisp, clear, and articulate. Ideal for jazz chords, funk rhythm, and clean blues playing.' },
  { label: 'Jazz ★',       desc: 'Hollow-body electric — dark, mellow, and smooth. The definitive tone for jazz leads and chord melody.' },
  { label: 'Muted ★',      desc: 'Palm-muted electric — percussive and tight. Essential for funk rhythms and downstroked rock riffs.' },
  { label: 'Distorted ★',  desc: 'High-gain distortion — gritty, aggressive, and powerful. The standard tone for rock and metal riffing.' },
  { label: 'Overdrive ★',  desc: 'Driven amp — warm breakup and crunch. Classic blues leads and classic rock rhythm in one tone.' },
  { label: 'Harmonics ★',  desc: 'Natural harmonics — delicate bell-like tones with long sustain. Beautiful for ambient textures and intros.' },
]

// Written in the imperative, second person, subject dropped: every line asks for one
// action and names what you get for it. Keep it that way, and keep it honest — a step
// telling someone to do something the page cannot do yet is worse than no step at all.
const howToSteps = [
  { n: 1, title: 'Tap any fret to hear it',            desc: 'Press a fret on any string. The string vibrates, the note sounds, and its name appears under the neck.' },
  { n: 2, title: 'Drag across the strings to strum',   desc: 'Sweep down the six strings to strum. Sweep back up to strum the other way, or press the Strum button.' },
  { n: 3, title: 'Pick a chord and watch it light up', desc: 'Choose a root and a chord type. Every finger position lights up on the neck, and Strum plays the shape.' },
  { n: 4, title: 'Cycle the shapes until one fits',    desc: 'Hit Shape to move through the other ways to play the same chord — open position, barre at the 5th, and higher up the neck.' },
  { n: 5, title: 'Switch the dots to fret numbers',    desc: 'Read note names while you learn the neck, then flip to fret numbers when you just want to place your fingers.' },
  { n: 6, title: 'Choose your tone',                   desc: 'Start on Steel, then try Nylon, Jazz, Muted or Distorted. Each one loads the first time you pick it — choose Synth for sound with no wait.' },
  { n: 7, title: 'Tune up before you start',           desc: 'Playing along on a real guitar? Open the tuner, get in tune, and come back.' },
]

const faqs = [
  {
    q: 'What is a virtual guitar?',
    a: 'A virtual guitar is a browser-based instrument that simulates a real guitar using recorded audio samples. You can play it with your mouse or touchscreen — no physical instrument required.',
  },
  {
    q: 'Can I play chords on it?',
    a: 'Yes. Pick a root note and a chord type and the shape lights up on the neck, then press Strum or drag across the strings to hear it. Most chords have several shapes — open position, barre at the 5th, and further up the neck — and the Shape button moves through them.',
  },
  {
    q: 'Is this guitar free to use?',
    a: 'Yes, completely free. No account, no download, no install. Open it in any modern browser on desktop or mobile.',
  },
  {
    q: 'What guitar sounds are included?',
    a: 'Eight high-quality sampled sounds: Steel (acoustic), Nylon (classical), Clean (electric), Jazz (hollow-body), Muted (palm-muted), Distorted (high-gain), Overdrive (crunch), and Harmonics. Plus a Synth mode that works instantly without loading.',
  },
  {
    q: 'What is standard guitar tuning?',
    a: 'Standard tuning from the thinnest string to the thickest is: e4, B3, G3, D3, A2, E2. That is E-A-D-G-B-e, the default tuning for most 6-string guitars.',
  },
  {
    q: 'Can I create and export my own guitar tabs?',
    a: 'Yes. Use the full Guitar Tab Editor to draw notes, set fret positions and durations, then export as ASCII tab or MIDI. You can also share via URL with no account needed.',
  },
  {
    q: 'How is this different from the Guitar Tab Editor?',
    a: 'Play here, write there. This page is the instrument: tap frets, strum chords, and try shapes without setting anything up. The Guitar Tab Editor at /guitar-tab/ is where you write music down — draw notes onto a timeline, set capo and rhythm, then export as ASCII tab or MIDI.',
  },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/guitar/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Virtual Guitar', item: 'https://chordsequence.com/guitar/' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Virtual Guitar',
  url: 'https://chordsequence.com/guitar/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free virtual guitar you can play in the browser. Pick a chord and the shape lights up on the neck, then strum it. Eight real-sampled sounds: Steel, Nylon, Clean, Jazz, Muted, Distorted, Overdrive, Harmonics.',
  featureList: [
    'Steel, Nylon, Clean, Jazz, Muted, Distorted, Overdrive and Harmonics sample banks',
    '6-string standard tuning (E2 A2 D3 G3 B3 e4)',
    'Real-time audio playback',
    'Interactive fretboard with every fret playable',
    'Chord shapes shown on the neck, with alternate voicings',
    'Strum by dragging across the strings',
    'Note names or fret numbers on the neck',
    'Guitar Tab Editor with chord helper',
    'Capo support (frets 0–7)',
    'MIDI export',
    'ASCII tab export',
    'URL sharing',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}

---

<BaseLayout
  title="Virtual Guitar with Chords — Play Online Free"
  description="Free virtual guitar in your browser. Pick any chord and see the shape on the neck, then strum it. Eight real-sampled sounds, every fret playable. No signup."
  canonicalUrl="https://chordsequence.com/guitar/"
  ogImage="/og/page/guitar/"
  ogImageAlt="Virtual Guitar — Play Online Free | Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main>

    <!-- BREADCRUMB -->
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pt-6">
      <a href="/instruments/" class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-primary transition-colors">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        All instruments
      </a>
    </div>

    <!--
      HERO — deliberately short on a phone. A 664px screen used to be filled entirely by
      the eyebrow, a four-line paragraph and two buttons, so someone arriving from a
      "virtual guitar" search met a page of copy before they met a guitar. The eyebrow
      and the button row are sm+ only (the buttons reappear under the instrument, where
      they read as "what next" rather than "before you start"), and the paragraph is one
      line on mobile.
    -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-4 sm:pt-8 pb-4 sm:pb-8 text-center">
      <p class="hidden sm:block text-xs font-semibold uppercase tracking-widest text-primary mb-3">Virtual Instrument</p>
      <h1 class="text-3xl sm:text-5xl font-bold text-foreground tracking-tight mb-2 sm:mb-4 leading-tight">
        Virtual Guitar
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto mb-0 sm:mb-8">
        Pick a chord, see the shape, strum it. Eight real sampled tones, every fret playable.
        <span class="hidden sm:inline">Free, no install, no account.</span>
      </p>
      <div class="hidden sm:flex flex-wrap items-center justify-center gap-3">
        <a
          href="/guitar-tab/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          Open Full Tab Editor →
        </a>
        <a
          href="#how-to-use"
          class="inline-flex items-center gap-2 px-6 py-3 border border-border text-foreground font-medium rounded-lg hover:border-primary/50 transition-colors"
        >
          How to use
        </a>
      </div>
    </section>

    <!-- INTERACTIVE FRETBOARD -->
    <!--
      GuitarInstrument uses client:only (it touches window/AudioContext at mount), so
      nothing paints until the React bundle loads and hydrates. The skeleton below
      renders immediately server-side and sits in the same CSS grid cell as the island
      — same technique as src/pages/chord-player, /piano and /drums (see those comments
      for the stacking-context gotcha it works around).

      Keep this in sync with GuitarInstrument.tsx by hand. It mirrors the four bands of
      the real panel: chord row, sound row, neck, readout. The neck's height is the same
      clamp() the component uses, so the swap does not shift the page; the deterministic
      copy ("Chord", "Sound", and the idle readout line) is real text, and only the
      controls and the neck itself are shimmer.
    -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 pb-6" aria-label="Interactive virtual guitar — pick a chord or tap any fret">
      <div style="display: grid; grid-template-columns: minmax(0, 1fr); position: relative;">
        <div id="guitar-skeleton" style="grid-area: 1 / 1; z-index: 0; transition: opacity 180ms ease-out;" class="rounded-2xl border border-border bg-card overflow-hidden">
          <div class="flex items-center gap-2 px-3 sm:px-4 py-2.5 border-b border-border bg-muted/30">
            <span class="hidden sm:inline text-xs font-semibold text-muted-foreground uppercase tracking-wider">Chord</span>
            <span aria-hidden="true" class="h-9 w-[72px] rounded-md bg-muted animate-pulse"></span>
            <span aria-hidden="true" class="h-9 w-[92px] rounded-md bg-muted animate-pulse"></span>
            <span aria-hidden="true" class="h-9 w-[104px] rounded-md bg-muted animate-pulse ml-auto"></span>
            <span aria-hidden="true" class="h-9 w-9 rounded-md bg-muted animate-pulse"></span>
          </div>
          <div class="flex items-center gap-2 px-3 sm:px-4 py-2.5 border-b border-border bg-muted/30 overflow-hidden">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mr-1">Sound</span>
            {/* Widths approximate each real label (Steel/Nylon/Clean ★, Jazz ★ shorter,
                Distorted/Overdrive/Harmonics ★ longer, Synth shortest) so the row ends
                at the same place instead of drifting. */}
            {['w-16', 'w-16', 'w-16', 'w-14', 'w-16', 'w-24', 'w-24', 'w-24', 'w-14'].map((w) => (
              <span aria-hidden="true" class={`h-7 shrink-0 rounded-md bg-muted animate-pulse ${w}`}></span>
            ))}
          </div>
          <div style="height: clamp(230px, 42dvh, 380px); background: hsl(224 26% 11%);" aria-hidden="true"></div>
          <div class="px-4 py-1.5 border-t border-border bg-muted/40 text-center">
            <span class="text-[11px] text-muted-foreground">Drag across the strings to strum · tap a fret for one note</span>
          </div>
          <div class="px-4 py-3 border-t border-border bg-muted/20 min-h-[52px] flex items-center gap-4">
            <p class="text-xs text-muted-foreground">Tap a fret to hear it, or pick a chord above</p>
          </div>
        </div>
        <div id="guitar-app" style="grid-area: 1 / 1; z-index: 1;">
          <GuitarInstrument client:only="react" />
        </div>
      </div>

      <!-- The hero's buttons, for the mobile layout that drops them so the neck can sit
           in the first screen. Below the instrument they answer "what next" instead of
           standing between the visitor and the guitar. -->
      <div class="flex sm:hidden flex-wrap items-center justify-center gap-3 pt-5">
        <a
          href="/guitar-tab/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground font-semibold rounded-lg"
        >
          Open Full Tab Editor →
        </a>
        <a
          href="#how-to-use"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-border text-foreground font-medium rounded-lg"
        >
          How to use
        </a>
      </div>
    </section>
    <script>
      import { removeSkeletonOnHydrate } from '@/lib/hydrationSkeleton'

      removeSkeletonOnHydrate('guitar-skeleton', 'guitar-app')
    </script>

    <!-- 8 SOUNDS -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-2 text-center">Eight authentic guitar sounds</h2>
      <p class="text-muted-foreground text-center mb-10 max-w-xl mx-auto">
        Every sampled sound uses real recorded audio — not synthesis — so you hear the true character of each style and technique.
      </p>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {sounds.map((s) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <h3 class="font-semibold text-foreground mb-1">{s.label}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- HOW TO USE -->
    <section id="how-to-use" class="bg-muted/30 border-y border-border py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-10 text-center">How to use the virtual guitar</h2>
        <div class="space-y-5">
          {howToSteps.map((s) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center mt-0.5">
                {s.n}
              </div>
              <div>
                <p class="font-semibold text-foreground mb-1">{s.title}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-10 text-center">Frequently asked questions</h2>
        <div class="space-y-6">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-card p-6">
              <h3 class="font-semibold text-foreground mb-2">{f.q}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED TOOLS -->
    <RelatedTools tools={[
      { href: '/tools/guitar-strumming-patterns/', icon: 'guitar', label: 'Strumming & Arpeggio Player', desc: 'Edit and play strumming and arpeggio patterns over any chord.' },
      { href: '/tuner/',        icon: 'tuner',    label: 'Online Tuner',        desc: 'Tune your guitar with your microphone before you start playing.' },
      { href: '/metronome/',    icon: 'metronome', label: 'Metronome',           desc: 'Practice with a steady click. Tap tempo and accent control included.' },
      { href: '/bass-guitar/',  icon: 'bass',     label: 'Virtual Bass Guitar',  desc: 'Switch to bass and lay down the low end with four sampled sounds.' },
    ]} />

    <!-- CTA FINAL -->
    <section class="mx-auto max-w-4xl px-4 sm:px-6 py-16 text-center">
      <h2 class="text-2xl font-bold text-foreground mb-3">Ready to go deeper?</h2>
      <p class="text-muted-foreground mb-6 max-w-lg mx-auto">
        The full Guitar Tab Editor adds chord helper, capo support, drag-and-resize notes,
        ASCII export, MIDI export, and URL sharing.
      </p>
      <a
        href="/guitar-tab/"
        class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-primary-foreground font-bold rounded-xl text-lg hover:bg-primary/90 transition-colors"
      >
        Open Guitar Tab Editor →
      </a>
    </section>

  </main>
</BaseLayout>
