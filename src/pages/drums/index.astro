---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { VirtualDrums } from '../../components/VirtualDrums/VirtualDrums'

const shortcutList = [
  { k: 'Z / V', n: 'Bass drum' },
  { k: 'X / C', n: 'Snare drum' },
  { k: 'G / B', n: 'Snare — cross stick' },
  { k: 'S / A', n: 'Hi-hat (closed)' },
  { k: 'D / F', n: 'Hi-hat (open)' },
  { k: 'Alt / Caps', n: 'Hi-hat (foot pedal)' },
  { k: 'Q', n: 'High tom' },
  { k: 'W', n: 'Low tom' },
  { k: 'E', n: 'Floor tom' },
  { k: '1 / R', n: 'Crash' },
  { k: '2 / T', n: 'Ride' },
  { k: '3 / Y', n: 'Bell (ride)' },
]

const whatYouCanDo = [
  { title: 'Hit different zones', desc: "Crash and ride respond to where you strike: the outer edge washes, the body pings, and the center of the cymbal rings the bell. The snare has a cross-stick sound on its rim, and the hi-hat plays open, closed or with the foot pedal." },
  { title: 'Two drum kits', desc: 'Switch between an acoustic kit with real sampled drum and cymbal hits, warm sunburst shells and bronze cymbals — or an electronic kit with punchy synth drums. The look of the kit changes with the sound.' },
  { title: 'Record your grooves', desc: 'Hit Record and you get a 4-3-2-1 count-in, just like in the studio. Everything you play is captured with its exact timing — press Play to hear it back on the kit, animations included.' },
  { title: 'Jam over real beats', desc: "Six built-in grooves — Rock, Funk, Disco, Hip-Hop, Jazz Swing and Reggaetón — loop on the kit so you can study how they're built or play on top of them." },
  { title: 'Plug in MIDI', desc: "Connect an electronic drum kit or pad controller and play the on-screen kit with velocity sensitivity. It's detected automatically — watch the MIDI light in the top bar." },
  { title: 'Change the scenery', desc: 'Cycle between a dark stage with spotlights and a live crowd, a garage rehearsal room, and a daylight studio.' },
]

const faqs = [
  { q: "I don't hear anything — is it broken?", a: 'Browsers block audio until you interact with the page. Click anywhere on the kit once and sound will unlock. Also check your system volume.' },
  { q: 'Why do cymbals sound different depending on where I click?', a: 'Real cymbals have three playing zones. Near the rim (edge) you get a full crash wash; the flat area (body) gives a controlled ping; the raised dome in the center (bell) cuts through with a bright metallic ring. The virtual cymbals measure how far from the center you hit and pick the zone, exactly like the real thing.' },
  { q: 'Are these real drum samples?', a: 'The Acoustic kit uses real sampled drum and cymbal hits. The Electronic kit is synthesized live from oscillators, shaped noise and a touch of room reverb — that’s why it loads instantly and never repeats identically.' },
  { q: 'How does recording work?', a: 'Press Record and count in with the 4-3-2-1 clicks. Everything you play — keyboard, mouse or MIDI — is captured with its timing. Press "Stop rec", then Play to hear it back. Recording again replaces the previous take. Loop beats aren’t recorded, so you can practice over them freely.' },
  { q: 'Can I connect my electronic drum kit?', a: 'Yes. Connect it over USB-MIDI and the status light in the top bar turns green. Pads follow the General MIDI drum map (kick 36, snare 38, hi-hats 42/44/46, toms 41-50, cymbals 49-57), including velocity.' },
  { q: 'Any tips for learning a first beat?', a: 'Start with the classic rock beat: steady eighth notes on the hi-hat (S), bass drum (Z) on beats 1 and 3, snare (X) on 2 and 4. Loop the built-in Rock beat first and listen, then try to copy it. When it flows, put on a song you love and play along.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/drums/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Virtual Drums', item: 'https://chordsequence.com/drums/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Virtual Drums',
  url: 'https://chordsequence.com/drums/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free virtual drum kit you can play in the browser. The Acoustic kit uses real sampled drum and cymbal hits; the Electronic kit is synthesized live. Triggered by mouse, touch, keyboard, or MIDI. Record grooves and jam over 6 built-in beats.',
  featureList: [
    '15-piece playable kit — kick, snare, hi-hat (closed/open/foot), toms, crash and ride (edge/body/bell zones)',
    'Acoustic kit uses real sampled drum and cymbal hits; Electronic kit is synthesized live',
    'Mouse, touch, keyboard, and MIDI control with velocity',
    'Record with 4-3-2-1 count-in and exact-timing playback',
    '6 built-in beat loops: Rock, Funk, Disco, Hip-Hop, Jazz Swing, Reggaeton',
    '3 stage scenes',
    'No signup, no download',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Virtual Drum Kit Online – Play Real Drums for Free"
  description="Free online virtual drum kit with real sampled acoustic sounds — click, tap, keyboard or MIDI. Record grooves, jam over 6 built-in beats."
  canonicalUrl="https://chordsequence.com/drums/"
  ogImage="/og/page/drums/"
  ogImageAlt="Virtual Drum Kit Online – Play Real Drums for Free"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div>
    <!--
      VirtualDrums uses client:only (it touches window/AudioContext/canvas at
      mount), so nothing paints until the full React bundle loads and
      hydrates. The static skeleton below renders immediately server-side and
      sits in the same CSS grid cell as the island — same technique as
      src/pages/chord-player/index.astro's editor-skeleton and
      src/pages/piano/index.astro's piano-skeleton (see those comments for
      the stacking-context gotcha this works around). The real
      "Virtual Drums" H1 is kept as genuine, non-shimmer text (deterministic,
      never changes per visitor); the kit-type toggle, Record/Play/Settings
      buttons, the beat-loop bar below it, and the kit visualization area are
      all interactive/stateful, so they stay as loading shimmer. The
      mobile/desktop shape (aspect-ratio kit box vs. fill-remaining-height) mirrors VirtualDrums's own
      `isNarrow` breakpoint (<=640px) via a plain CSS media query, so there's
      no shift from picking the wrong shape at different viewport widths
      either — this needs no JS, since the real component's own `isNarrow` is
      also just `window.innerWidth <= 640`.
    -->
    <div style="display: grid; grid-template-columns: minmax(0, 1fr); position: relative;">
      <div id="drums-skeleton" class="vd-skeleton-shell" style="grid-area: 1 / 1; z-index: 0; transition: opacity 180ms ease-out; width: 100%; display: flex; flex-direction: column; font-family: Helvetica, Arial, sans-serif; overflow: hidden; background: #f6f4fb;">
        <div style="background: #f8f6fd;">
          <div style="max-width: 1280px; margin: 0 auto; width: 100%; display: flex; align-items: center; gap: 9px; padding: 8px 16px; flex-wrap: wrap;">
            <div style="flex: 1; display: flex; justify-content: flex-start;" aria-hidden="true">
              <span class="h-9 w-40 rounded-full bg-muted animate-pulse"></span>
            </div>
            <h1 style="flex: 0 1 auto; margin: 0; font-size: 15px; font-weight: 700; color: #1d1830; letter-spacing: 0.3px; white-space: nowrap; text-align: center;">Virtual Drums</h1>
            <div style="flex: 1; display: flex; justify-content: flex-end;" aria-hidden="true">
              <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: flex-end;">
                <span class="h-9 w-24 rounded-full bg-muted animate-pulse"></span>
                <span class="h-9 w-20 rounded-full bg-muted animate-pulse"></span>
                <span class="h-9 w-28 rounded-full bg-muted animate-pulse"></span>
              </div>
            </div>
          </div>
        </div>
        <div style="background: #efe8fb; border-top: 1px solid #e0d6f7; border-bottom: 1px solid #e0d6f7;">
          <div style="max-width: 1280px; margin: 0 auto; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; flex-wrap: wrap;" aria-hidden="true">
            <span class="h-5 w-32 rounded-full bg-muted animate-pulse"></span>
            <span class="h-9 w-56 rounded-full bg-muted animate-pulse"></span>
          </div>
        </div>
        <div class="vd-skeleton-kit bg-muted animate-pulse" aria-hidden="true" style="width: 100%;"></div>
      </div>
      <div style="grid-area: 1 / 1; z-index: 1;">
        <VirtualDrums client:only="react" />
      </div>
    </div>
    <script>
      document.addEventListener(
        'astro:hydrate',
        () => {
          const skeleton = document.getElementById('drums-skeleton')
          if (!skeleton) return
          skeleton.style.opacity = '0'
          skeleton.addEventListener('transitionend', () => skeleton.remove(), { once: true })
          setTimeout(() => skeleton.remove(), 250) // fallback in case transitionend never fires
        },
        { capture: true, once: true },
      )
    </script>

    <!-- ============ ABOUT SECTION ============ -->
    <div style="background: #f6f4fb; color: #4b4463; font-family: Helvetica, Arial, sans-serif; padding: 72px 24px 96px;">
      <div style="max-width: 920px; margin: 0 auto; display: flex; flex-direction: column; gap: 64px;">

        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 680px;">
          <div style="font-size: 13px; font-weight: 700; letter-spacing: 2px; color: #7442d6; text-transform: uppercase;">About</div>
          <h2 style="margin: 0; font-size: 34px; font-weight: 700; color: #1d1830; line-height: 1.15;">Play the drums, right in your browser</h2>
          <p style="margin: 0; font-size: 16px; line-height: 1.65;">Virtual Drums is a fully playable drum kit. The Acoustic kit plays real sampled drum and cymbal hits; the Electronic kit is synthesized live. Every piece of the kit reacts with its own animation when you hit it. Play by clicking the drums, with your keyboard, or by plugging in an electronic drum kit over MIDI.</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.65;">A fun way to practice is to put on your favorite songs and play along, or loop one of the built-in beats and jam over it.</p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 18px;">
          <h2 style="margin: 0; font-size: 24px; font-weight: 700; color: #1d1830;">What you can do</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
            {whatYouCanDo.map((f) => (
              <div style="background: #ffffff; border: 1px solid #e6e1f2; border-radius: 14px; padding: 20px;">
                <div style="font-size: 15px; font-weight: 700; color: #1d1830; margin-bottom: 6px;">{f.title}</div>
                <div style="font-size: 14px; line-height: 1.6;">{f.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 18px;">
          <h2 style="margin: 0; font-size: 24px; font-weight: 700; color: #1d1830;">Keyboard layout</h2>
          <p style="margin: 0; font-size: 15px; line-height: 1.6; max-width: 680px;">The layout mirrors a real drummer's hands: the left hand keeps time on bass drum and snare in the bottom row, while the right hand reaches up for toms and cymbals in the number row. Toggle "Key labels" to see the keys on the kit itself.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px;">
            {shortcutList.map((s) => (
              <div style="display: flex; align-items: center; gap: 12px; background: #ffffff; border: 1px solid #e6e1f2; border-radius: 10px; padding: 10px 14px;">
                <span style="display: inline-block; min-width: 78px; text-align: center; padding: 5px 8px; border: 1px solid #d6cdeb; border-bottom-width: 3px; border-radius: 7px; background: #f1edfa; color: #1d1830; font-family: monospace; font-size: 12px; white-space: nowrap;">{s.k}</span>
                <span style="font-size: 14px; color: #4b4463;">{s.n}</span>
              </div>
            ))}
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 18px;">
          <h2 style="margin: 0; font-size: 24px; font-weight: 700; color: #1d1830;">Questions &amp; answers</h2>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {faqs.map((f) => (
              <details style="background: #ffffff; border: 1px solid #e6e1f2; border-radius: 12px; padding: 16px 20px;">
                <summary style="font-size: 15px; font-weight: 600; color: #1d1830; cursor: pointer;">{f.q}</summary>
                <p style="margin: 12px 0 0; font-size: 14px; line-height: 1.6;">{f.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
          <div style="background: #ffffff; border: 1px solid #e6e1f2; border-radius: 14px; padding: 20px;">
            <div style="font-size: 14px; color: #4b4463; margin-bottom: 8px;">Want a repeating beat instead of playing live?</div>
            <a class="vd-cta-link" href="/tools/drum-machine/">Try the Drum Machine →</a>
          </div>
          <div style="background: #ffffff; border: 1px solid #e6e1f2; border-radius: 14px; padding: 20px;">
            <div style="font-size: 14px; color: #4b4463; margin-bottom: 8px;">Learning a groove from a written tab?</div>
            <a class="vd-cta-link" href="/tools/drum-tab/">Open the Drum Tab Player →</a>
          </div>
          <div style="background: #ffffff; border: 1px solid #e6e1f2; border-radius: 14px; padding: 20px;">
            <div style="font-size: 14px; color: #4b4463; margin-bottom: 8px;">Building a full arrangement?</div>
            <a class="vd-cta-link" href="/chord-player/">Open the Chord Player →</a>
            <div style="font-size: 13px; color: #6d6685; margin-top: 6px;">Combines drums, bass, and piano with BPM control.</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <style>
    .vd-cta-link {
      display: inline-block;
      font-size: 15px;
      font-weight: 700;
      color: #7442d6;
      text-decoration: none;
    }
    .vd-cta-link:hover {
      color: #f0be62;
      text-decoration: underline;
    }

    /* Mirrors VirtualDrums's own isNarrow breakpoint (window.innerWidth <= 640) */
    .vd-skeleton-shell { height: auto; }
    .vd-skeleton-kit { flex: none; aspect-ratio: 29 / 20; }
    @media (min-width: 641px) {
      .vd-skeleton-shell { height: calc(100vh - 64px); }
      .vd-skeleton-kit { flex: 1; min-height: 0; aspect-ratio: unset; }
    }
  </style>
</BaseLayout>
