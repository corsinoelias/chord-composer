---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/schema/JsonLd.astro';
import { withBrand } from '../lib/seoTitle';
import ToolIcon from '../components/ToolIcon.astro';
import type { ToolIconName } from '../components/toolIcons';
import HeroDemo from '../components/home/HeroDemo';
import ProgressionExplorer from '../components/home/ProgressionExplorer';
import { GENRES } from '../data/progressions';

// The home has one job: sound in one click, the Chord Player in two.
//
// Sept 2026: the home was rebuilt around a full generator, key explorer and song analysis.
// Time on the page itself tripled, but engaged sessions from the home fell from 77% to 61%
// (Tue–Sat, Sept 1–5 vs 8–12), bounce went from 23% to 38%, and visitors who went on to
// /chord-player/ fell from 184 to 82 — in every channel, so it was the page, not the traffic.
// Half the home's Google clicks are branded ("chord sequence"), and direct visitors lost the
// most: people arriving here want the app. That content now lives on /progressions/, where
// people come to browse progressions, and this page goes back to the hero that worked.
//
// SEO split, so pages stop competing with each other: the home keeps generator / player /
// online (where it already ranks, positions 4–7); "chord progressions" belongs to
// /learn/what-is-a-chord-progression/, and genre modifiers to /progressions/<genre>/.

// Must equal what HeroDemo builds for its first preset (pop-axis): the CTA is static HTML
// until the island hydrates, then the island keeps it in sync through the home:formula event.
// Hardcoded rather than calling editorUrl() so this page's build does not import the audio
// export chain.
const DEFAULT_EDITOR_URL = '/chord-player/?chords=C-G-Am-F&bpm=110&style=pop_1';

// Song pages are the site's biggest landing surface after the home; these are the charts
// with the most landings plus the navbar's own picks. Keys match the navbar and songs.ts.
const songs = [
  { slug: 'center-bethel-music', title: 'Center', artist: 'Bethel Music', key: 'A' },
  { slug: 'washed-elevation-rhythm', title: 'Washed', artist: 'Elevation Rhythm', key: 'B' },
  { slug: 'holy-forever-chris-tomlin', title: 'Holy Forever', artist: 'Chris Tomlin', key: 'C' },
  { slug: 'alleluia-elevation-worship', title: 'Alleluia', artist: 'Elevation Worship', key: 'B' },
  { slug: 'oceans-hillsong-united', title: 'Oceans (Where Feet May Fail)', artist: 'Hillsong United', key: 'D' },
  { slug: 'goodness-of-god-bethel-music', title: 'Goodness of God', artist: 'Bethel Music', key: 'C' },
  { slug: 'great-are-you-lord-all-sons-daughters', title: 'Great Are You Lord', artist: 'All Sons & Daughters', key: 'G' },
  { slug: 'hay-poder-yeshua-averly-morillo', title: 'Hay Poder | Yeshua', artist: 'Averly Morillo', key: 'F#' },
];

// Genre pages rank on their own (6,193 impressions / 181 clicks in 28 days to Sept 12); the
// home hands visitors to them instead of re-hosting their content.
const GENRE_ORDER = ['pop', 'worship', 'gospel', 'jazz', 'neo-soul', 'lo-fi', 'blues', 'rock', 'edm', 'sad', 'happy', '12-bar-blues'];
const genres = GENRE_ORDER.flatMap((slug) => {
  const g = GENRES.find((x) => x.slug === slug);
  return g ? [{ slug, name: g.name, formula: g.progressions[0]?.title.split(' (')[0] ?? '' }] : [];
});

// Chord Player leads on purpose: the anchor text names the destination, which is the fix for
// this page outranking /chord-player/ for its own name.
const tools = [
  { title: 'Chord Player', desc: 'Play, listen, and practice chord progressions with real instrument sounds — piano, guitar, bass & drums.', href: '/chord-player/', icon: 'piano' },
  { title: 'Chord Finder', desc: 'Find any chord on guitar, piano, or ukulele — see the fingering and hear it.', href: '/chord-lookup/', icon: 'chords' },
  { title: 'Chord Transposer', desc: 'Shift any chord or progression to any key instantly.', href: '/tools/chord-transposer/', icon: 'transpose' },
  { title: 'Circle of Fifths', desc: 'Interactive chart — click any key to see its diatonic chords.', href: '/tools/circle-of-fifths/', icon: 'circle' },
  { title: 'Guitar Strumming & Arpeggio', desc: 'Edit and play strumming/arpeggio patterns on a live 6-string fretboard.', href: '/tools/guitar-strumming-patterns/', icon: 'guitar' },
  { title: 'Drum Tab Player', desc: 'Read and write drum tabs — percussion notation, step grid, or pasted ASCII tab.', href: '/tools/drum-tab/', icon: 'step-grid' },
] satisfies { title: string; desc: string; href: string; icon: ToolIconName }[];

// Plain data for the visible accordion — never serialized as FAQPage JSON-LD (see CLAUDE.md).
const faqs = [
  { q: 'Is Chord Sequence free to use?', a: 'Yes. Chord Sequence is completely free. No subscription and no credit card. Building, playing, transposing and exporting all work without an account.' },
  { q: 'Do I need to install anything?', a: 'No installation required. Chord Sequence runs entirely in your browser using the Web Audio API. It works on Chrome, Firefox, Safari, and Edge.' },
  { q: 'Can I export my chord progression as MIDI or WAV?', a: 'Yes. Open any progression in the Chord Player and export it as a MIDI file or a WAV audio file in one click, ready for Ableton, Logic, FL Studio, GarageBand or any other DAW.' },
  { q: 'Are my saved songs private?', a: 'Yes. Saved songs are private to your account — nobody else can open one until you use the Share button, and you can switch that link off again whenever you want. Saving needs a free account so your library follows you between devices.' },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://chordsequence.com/#webpage',
  url: 'https://chordsequence.com/',
  name: 'Chord Progression Generator — Hear It Instantly',
  description: 'Pick a chord progression, press play, change the key, and open it in the free Chord Player.',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', '@id': 'https://chordsequence.com/#website' },
  about: { '@type': 'WebApplication', '@id': 'https://chordsequence.com/#app', name: 'Chord Sequence', url: 'https://chordsequence.com' },
};
---

<BaseLayout
  title={withBrand('Chord Progressions You Can Hear in Any Key')}
  description="Hear popular chord progressions played in any key — pop, jazz, neo-soul, gospel and worship. Transpose instantly, see the voicings, export MIDI and WAV. Free."
  canonicalUrl="https://chordsequence.com/"
  ogImage="https://chordsequence.com/og/page/home/"
  ogImageAlt="Chord Sequence — free chord progression generator and player"
>
  <Fragment slot="head">
    <JsonLd schema={webPageSchema} />
  </Fragment>

  <main>
    <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
    <section data-home-hero class="relative overflow-hidden border-b border-border pt-8 pb-12 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-1/2 h-[520px] w-[920px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-[130px]"></div>
      </div>

      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <!-- minmax(0, …) + min-w-0: without them the demo's chip row sets the column's minimum
             width, and the card pushed itself past the right edge of a 1440px screen. -->
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14">
          <div class="min-w-0 text-center lg:text-left">
            <h1 class="mb-6 font-serif text-5xl font-bold tracking-tight text-foreground sm:text-6xl lg:text-[3.35rem] xl:text-[4rem]">
              The chord progression generator.<br />
              <span class="text-primary">Hear it instantly.</span>
            </h1>

            <p class="mx-auto mb-8 max-w-xl text-lg text-muted-foreground sm:text-xl lg:mx-0">
              Pick a progression, press play, change the key. When you like it, take it into the
              Chord Player — free, no account needed.
            </p>

            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
              <a
                href={DEFAULT_EDITOR_URL}
                data-home-cta
                data-home-event="hero_cta"
                data-home-label="start_playing"
                class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-xl bg-primary px-8 py-4 text-lg font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90"
              >
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                Start playing
              </a>
              <a
                href="/progressions/"
                data-home-event="genre"
                data-home-label="hero_browse"
                class="inline-flex items-center gap-1.5 whitespace-nowrap text-base font-medium text-primary transition-colors hover:text-primary/80"
              >
                Browse progressions by genre →
              </a>
            </div>
          </div>

          <div class="min-w-0">
            <HeroDemo client:idle />
          </div>
        </div>
      </div>
    </section>

    <!-- ─── SOCIAL PROOF ──────────────────────────────────────────────────── -->
    <section class="border-b border-border bg-card/50">
      <div class="mx-auto max-w-5xl px-4 py-6 sm:px-6">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
          {['100% Free', 'No account needed', '37 chord types', '13+ rhythm styles', 'MIDI & WAV export'].map((item) => (
            <span class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
              <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── SONG CHORD CHARTS ──────────────────────────────────────────── -->
    <section class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Play along — songs with chords
          </h2>
          <p class="mx-auto max-w-xl text-lg text-muted-foreground">
            Chords synced to the lyrics. Press play, transpose to your key, print the chart.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
          {songs.map((song) => (
            <a
              href={`/songs/${song.slug}/`}
              data-home-event="song"
              data-home-label={song.slug}
              class="group flex flex-col rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/50 hover:bg-primary/5 sm:p-5"
            >
              <p class="truncate text-sm font-bold text-foreground transition-colors group-hover:text-primary sm:text-base">{song.title}</p>
              <p class="mb-3 truncate text-xs text-muted-foreground sm:text-sm">{song.artist}</p>
              <div class="mt-auto flex flex-wrap gap-1.5">
                <span class="rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-xs text-primary">Key: {song.key}</span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a href="/songs/" data-home-event="song" data-home-label="all_songs" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            All song charts →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── PROGRESSIONS BY GENRE ─────────────────────────────────────────── -->
    <section class="border-y border-border bg-muted/20 py-14 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Chord progressions by genre
          </h2>
          <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
            Every genre page has playable progressions with MIDI and WAV. New to this?
            <a href="/learn/what-is-a-chord-progression/" data-home-event="learn" data-home-label="what_is" class="font-semibold text-primary hover:text-primary/80">Start with what a chord progression is →</a>
          </p>
        </div>

        <div class="mb-10 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
          {genres.map((g) => (
            <a
              href={`/progressions/${g.slug}/`}
              data-home-event="genre"
              data-home-label={g.slug}
              class="group flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-4 py-3.5 transition-colors hover:border-primary/40"
            >
              <span class="min-w-0">
                <span class="block text-sm font-bold text-foreground transition-colors group-hover:text-primary">{g.name}</span>
                <span class="block truncate font-mono text-[11px] text-primary">{g.formula}</span>
              </span>
              <span class="text-muted-foreground transition-colors group-hover:text-primary" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <p class="mb-4 text-center font-mono text-xs uppercase tracking-wider text-muted-foreground">Play one now</p>
        <ProgressionExplorer client:visible onlyIds={['pop-axis', 'worship-elevation', 'gospel-736']} surface="home_cards" />

        <div class="mt-8 text-center">
          <a href="/progressions/" data-home-event="genre" data-home-label="all_progressions" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            Browse all chord progressions →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── TOOLS ────────────────────────────────────────────────────────── -->
    <section class="py-14 sm:py-20" id="tools">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="mb-10 text-center text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          More free music tools
        </h2>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((t) => (
            <a
              href={t.href}
              data-home-event="tool"
              data-home-label={t.href}
              class="group flex items-start gap-4 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
            >
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                <ToolIcon name={t.icon} class="h-5 w-5 text-primary" />
              </div>
              <div class="min-w-0">
                <h3 class="mb-1 font-semibold text-foreground transition-colors group-hover:text-primary">{t.title}</h3>
                <p class="text-sm text-muted-foreground">{t.desc}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href="/tools/" data-home-event="tool" data-home-label="all_tools" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            View all music tools →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── FAQ ──────────────────────────────────────────────────────────── -->
    <section class="border-y border-border bg-muted/20 py-14 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="mb-10 text-center text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Frequently asked questions
        </h2>

        <div class="space-y-3">
          {faqs.map((faq) => (
            <div class="overflow-hidden rounded-xl border border-border bg-card">
              <details class="group">
                <summary class="flex cursor-pointer select-none list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-foreground transition-colors hover:bg-accent/30">
                  {faq.q}
                  <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="border-t border-border px-5 py-4">
                  <p class="text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── FINAL CTA ─────────────────────────────────────────────────────── -->
    <section data-home-final class="relative overflow-hidden py-16 sm:py-24">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-1/2 h-[500px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/[0.08] blur-[100px]"></div>
      </div>
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="mb-6 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
          Your next chord progression<br />is one click away.
        </h2>
        <p class="mx-auto mb-10 max-w-xl text-lg text-muted-foreground">
          Free, instant, and no signup. Open the editor and start building.
        </p>
        <a
          href="/chord-player/"
          data-home-event="final_cta"
          data-home-label="open_chord_player"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-10 py-5 text-xl font-bold text-primary-foreground shadow-xl shadow-primary/25 transition-colors hover:bg-primary/90"
        >
          Open Chord Player
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>

  <!-- Mobile only: once the hero has scrolled away, the way into the editor stays on screen.
       Organic mobile was the worst-hit segment of the Sept 2026 redesign (engaged 79% → 52%). -->
  <div
    data-home-sticky
    inert
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border bg-background/95 px-4 py-3 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] backdrop-blur transition-transform duration-200 sm:hidden"
  >
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Ready to play</p>
        <p data-home-sticky-label class="truncate text-sm font-semibold text-foreground">Pop Axis · C G Am F</p>
      </div>
      <a
        href={DEFAULT_EDITOR_URL}
        data-home-cta
        data-home-event="sticky_cta"
        data-home-label="start_playing"
        class="inline-flex min-h-[44px] shrink-0 items-center gap-1.5 rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        Start playing
      </a>
    </div>
  </div>

  <script>
    import { analytics } from '@/lib/analytics';

    type LinkTarget = Parameters<typeof analytics.homeLinkClicked>[0];

    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLElement>('[data-home-event]');
      if (!link) return;
      analytics.homeLinkClicked(link.dataset.homeEvent as LinkTarget, link.dataset.homeLabel ?? '');
    });

    // HeroDemo dispatches this whenever the formula or key changes ('home:formula' is
    // HOME_FORMULA_EVENT in HeroDemo.tsx), so "Start playing" opens what the visitor just heard.
    window.addEventListener('home:formula', (event) => {
      const { href, label } = (event as CustomEvent<{ href: string; label: string }>).detail;
      document.querySelectorAll<HTMLAnchorElement>('[data-home-cta]').forEach((a) => a.setAttribute('href', href));
      const stickyLabel = document.querySelector('[data-home-sticky-label]');
      if (stickyLabel) stickyLabel.textContent = label;
    });

    // The bar shows between the hero and the final CTA — never over the hero's own button,
    // and never over the footer, where it would hide the last links on the page.
    const hero = document.querySelector('[data-home-hero]');
    const finalCta = document.querySelector('[data-home-final]');
    const bar = document.querySelector<HTMLElement>('[data-home-sticky]');
    if (hero && finalCta && bar) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const show = hero.getBoundingClientRect().bottom < 0 && finalCta.getBoundingClientRect().top > window.innerHeight;
        bar.classList.toggle('translate-y-full', !show);
        bar.toggleAttribute('inert', !show);
      };
      window.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
      update();
    }
  </script>
</BaseLayout>
