---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/schema/JsonLd.astro';
import ToolIcon from '../components/ToolIcon.astro';
import type { ToolIconName } from '../components/toolIcons';
import { SONGS } from '../data/songs';
import { FEATURED_PROGRESSIONS } from '../data/featuredProgressions';
import HomeGenerator from '../components/home/HomeGenerator';
import ProgressionExplorer from '../components/home/ProgressionExplorer';
import KeyHarmonyExplorer from '../components/home/KeyHarmonyExplorer';

// Plain FAQ data for the visible accordion below. Deliberately NOT emitted as FAQPage
// JSON-LD: Google restricted FAQ rich results to gov/health sites in Aug 2023, and that
// schema has already had to be stripped from this codebase twice. Visible FAQ copy is
// fine and useful — it is serializing it into a banned JSON-LD type that check-schema.mjs
// fails the build on (it scans this file's source, so don't even write the pair as an
// example in a comment). The same ban covers HowTo.
const faqs = [
  {
    q: 'What is a chord progression?',
    a: 'A chord progression is a succession of two or more chords played in sequence. It forms the harmonic bedrock under the melody, bassline and rhythm of essentially every genre, creating emotional movement through cycles of tension and resolution.',
  },
  {
    q: 'What are the most famous chord progressions?',
    a: 'The Pop Axis (I–V–VI–IV, e.g. C–G–Am–F), the jazz II–V–I cadence (Dm7–G7–Cmaj7), the 12-bar blues (I7–IV7–V7), the 50s doo-wop turnaround (I–VI–IV–V), and the cinematic minor progression (I–VI–III–VII, e.g. Am–F–C–G). You can play all five above.',
  },
  {
    q: 'How does Roman numeral analysis work?',
    a: 'Roman numerals name the scale degree each chord is built on (I, II, III, IV, V, VI, VII), independently of key. Qualities and extensions (maj7, 7, m9, diminished °) describe the voicing. Because the numerals are key-agnostic, the same progression can be transposed into any of the 12 keys without relearning it.',
  },
  {
    q: 'Can I export chord progressions as MIDI and WAV?',
    a: 'Yes. Every progression on this page exports as a standard MIDI (.mid) file that works with any virtual instrument, and as an uncompressed WAV (.wav) audio stem you can drag straight into Ableton Live, FL Studio, Logic Pro, Cubase, Studio One, GarageBand or Reaper.',
  },
  {
    q: 'Is Chord Sequence free?',
    a: 'Yes — building, playing, transposing and exporting are all free with no account. Signing up is only needed to save progressions to a library that follows you between devices.',
  },
  {
    q: 'Do I need to install anything?',
    a: 'No. Everything runs in the browser on the Web Audio API — Chrome, Firefox, Safari and Edge, on desktop and mobile.',
  },
];

// Chord Player leads this list on purpose — it's the flagship tool and the internal link/anchor
// text here ("Chord Player", not "editor"/"Chord Sequence") is a deliberate signal to search
// engines about which URL is the canonical answer for that phrase (see the cannibalization fix
// this section is part of: /chord-player/ was losing rankings to this homepage for its own name).
const tools = [
  { title: 'Chord Player', desc: 'Play, listen, and practice chord progressions with real instrument sounds — piano, guitar, bass & drums.', href: '/chord-player/', icon: 'piano' },
  { title: 'Chord Finder', desc: 'Find any chord on guitar, piano, or ukulele — see the fingering and hear it.', href: '/chord-lookup/', icon: 'chords' },
  { title: 'Key Detector', desc: 'Detect the key of any chord progression.', href: '/tools/key-detector/', icon: 'key' },
  { title: 'Chord Transposer', desc: 'Shift any chord or progression to any key instantly.', href: '/tools/chord-transposer/', icon: 'transpose' },
  { title: 'Circle of Fifths', desc: 'Interactive chart — click any key to see its diatonic chords.', href: '/tools/circle-of-fifths/', icon: 'circle' },
  { title: 'Guitar Strumming & Arpeggio', desc: 'Edit and play strumming/arpeggio patterns on a live 6-string fretboard.', href: '/tools/guitar-strumming-patterns/', icon: 'guitar' },
  { title: 'Drum Machine', desc: 'Program a 16-step beat with 3 kits and 12 genre presets.', href: '/tools/drum-machine/', icon: 'step-grid' },
  { title: 'Drum Tab Player', desc: 'Read and write drum tabs — percussion notation, step grid, or pasted ASCII tab.', href: '/tools/drum-tab/', icon: 'step-grid' },
  { title: 'Metronome', desc: 'Tap tempo, beats per measure, and keyboard shortcuts — Web Audio precision.', href: '/metronome/', icon: 'metronome' },
  { title: 'Tuner', desc: 'Tune by ear or with your microphone — guitar, bass, ukulele, and more.', href: '/tuner/', icon: 'tuner' },
] satisfies { title: string; desc: string; href: string; icon: ToolIconName }[];

const DAWS = ['Ableton Live', 'FL Studio', 'Logic Pro', 'GarageBand', 'Cubase', 'Studio One', 'Reaper'];

const heroHighlights = [
  { title: 'Instant MIDI & WAV', desc: 'Drag straight into any DAW' },
  { title: '37 chord qualities', desc: 'Major, minor, 7ths, 9ths, sus, dim' },
  { title: 'All 12 keys', desc: 'Transpose without rewriting a thing' },
  { title: 'Zero-latency audio', desc: 'Real sampled piano in the browser' },
];

const theoryPillars = [
  {
    n: '01',
    label: 'Harmonic function',
    title: 'Tension and resolution',
    body: 'Every chord in a key has a role: <strong>tonic</strong> (stability and home), <strong>subdominant</strong> (departure and gentle motion), and <strong>dominant</strong> (peak tension pulling back to the tonic). Progressions are just journeys between those three states.',
  },
  {
    n: '02',
    label: 'Voice leading',
    title: 'Smooth transitions',
    body: 'Good chord progressions minimise leaps between voices. Holding common tones and moving the rest by a semitone or whole tone is what makes a change sound velvety instead of abrupt.',
  },
  {
    n: '03',
    label: 'Modal interchange',
    title: 'Borrowed chords',
    body: 'Borrowing from parallel modes — the famous minor iv in a major key, or ♭VI and ♭VII — injects instant nostalgia and cinematic depth without ever leaving the key.',
  },
];

const CANONICAL = 'https://chordsequence.com/';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://chordsequence.com/#webpage',
  url: CANONICAL,
  name: 'Chord Progressions — Free Generator, Player & MIDI Library',
  description: 'Audition popular chord progressions with real-time audio, transpose across all 12 keys, and download free MIDI and WAV files for your DAW.',
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', '@id': 'https://chordsequence.com/#website' },
  about: {
    '@type': 'WebApplication',
    '@id': 'https://chordsequence.com/#app',
    name: 'Chord Sequence',
    url: 'https://chordsequence.com',
  },
};

const progressionListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://chordsequence.com/#progression-list',
  name: 'Popular chord progressions',
  url: CANONICAL,
  numberOfItems: FEATURED_PROGRESSIONS.length,
  itemListElement: FEATURED_PROGRESSIONS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Thing',
      name: `${p.name} (${p.romanNumerals.join('–')})`,
      description: p.description,
      '@id': `${CANONICAL}#progression-${p.id}`,
    },
  })),
};

const songListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://chordsequence.com/#song-list',
  name: 'Songs with Chord Charts — Chord Sequence',
  url: 'https://chordsequence.com/songs/',
  itemListElement: SONGS.map((song, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${song.title} — ${song.artist}`,
    url: `https://chordsequence.com/songs/${song.slug}/`,
  })),
};
---

<BaseLayout
  title="Chord Progressions — Free Generator, Player & MIDI | Chord Sequence"
  description="Find, audition and download popular chord progressions instantly. Free chord progression generator with real-time playback, MIDI/WAV export, piano voicings and guitar shapes."
  canonicalUrl={CANONICAL}
  ogImage="https://chordsequence.com/og/page/home/"
  ogImageAlt="Chord Sequence — free chord progression generator and player"
>
  <Fragment slot="head">
    <JsonLd schema={[webPageSchema, progressionListSchema, songListSchema]} />
  </Fragment>

  <main>
    <!-- ─── HERO ───────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border pt-8 pb-14 sm:pt-12 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
        <div class="h-[400px] w-[700px] rounded-full bg-primary/10 blur-[130px]"></div>
      </div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-5 flex justify-center">
          <!--
            The trailing "· Free MIDI & WAV" is dropped below sm: at 390px the badge wraps
            onto two lines and strands the separator dot on its own. The claim is not lost —
            it is repeated in the paragraph below and in the highlights row under the card.
          -->
          <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1 text-center text-xs font-semibold text-primary">
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
            <span>Interactive chord progression generator</span>
            <span class="hidden opacity-40 sm:inline">·</span>
            <span class="hidden font-bold sm:inline">Free MIDI &amp; WAV</span>
          </span>
        </div>

        <div class="mx-auto mb-9 max-w-4xl text-center">
          <h1 class="font-serif text-4xl font-bold leading-[1.08] tracking-tight text-foreground sm:text-6xl lg:text-7xl">
            Chord Progressions
            <span class="mt-2 block font-sans text-xl font-normal text-primary sm:text-3xl lg:text-4xl">
              Interactive generator, player &amp; free MIDI library
            </span>
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base lg:text-lg">
            Audition popular <strong class="text-foreground">chord progressions</strong> with real-time audio,
            transpose across all 12 keys, see the piano voicings and guitar shapes, and download
            <strong class="text-foreground">free MIDI &amp; WAV files</strong> for your DAW.
          </p>
        </div>

        <HomeGenerator client:load />

        <!-- DAW trust strip -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-center text-xs">
          <span class="font-mono font-medium text-muted-foreground">Compatible with all major DAWs:</span>
          <div class="flex flex-wrap items-center justify-center gap-1.5 font-mono text-[11px] font-semibold">
            {DAWS.map((daw) => (
              <span class="rounded-md border border-border bg-card px-2 py-0.5 text-muted-foreground">{daw}</span>
            ))}
          </div>
        </div>

        <div class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-3.5 text-center sm:grid-cols-4">
          {heroHighlights.map((h) => (
            <div class="rounded-2xl border border-border bg-card p-3.5">
              <div class="font-mono text-xs font-bold text-primary">{h.title}</div>
              <div class="mt-0.5 text-xs text-muted-foreground">{h.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── PROGRESSION EXPLORER ───────────────────────────────────────── -->
    <section id="progressions" class="border-b border-border py-14 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-primary">
            Browse the library
          </p>
          <h2 class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Popular chord progressions by genre, mood &amp; key
          </h2>
          <p class="mt-2 text-sm text-muted-foreground sm:text-base">
            Filter by what you're writing, press play to hear it, transpose it into your key,
            then take it to the editor or straight into your DAW.
          </p>
        </div>

        <ProgressionExplorer client:visible />

        <div class="mt-10 text-center">
          <a href="/progressions/" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            Browse every genre — hundreds more progressions →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── DIATONIC HARMONY ───────────────────────────────────────────── -->
    <section id="keys" class="border-b border-border bg-muted/20 py-14 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-primary">
            Diatonic harmony &amp; keys
          </p>
          <h2 class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Which chords belong together in each key
          </h2>
          <p class="mt-2 text-sm text-muted-foreground sm:text-base">
            Pick a key to inspect its seven natural chords, its relative minor, and the
            progressions musicians actually build in it — all playable.
          </p>
        </div>

        <KeyHarmonyExplorer client:visible />

        <div class="mt-10 text-center">
          <a href="/tools/circle-of-fifths/" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            Open the interactive circle of fifths →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── SONG CHORD CHARTS ──────────────────────────────────────────── -->
    <section id="songs" class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-primary">
            Real songs, analysed
          </p>
          <h2 class="mb-3 font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Chord progressions from songs you know
          </h2>
          <p class="mx-auto max-w-xl text-base text-muted-foreground">
            Full chords and lyrics, synchronised — press play and the active chord highlights
            above the line in real time.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {SONGS.map((song) => (
            <a
              href={`/songs/${song.slug}/`}
              class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/50 hover:bg-primary/5"
            >
              <p class="mb-1 truncate text-base font-bold text-foreground transition-colors group-hover:text-primary">
                {song.title}
              </p>
              <p class="mb-3 truncate text-sm text-muted-foreground">{song.artist}</p>
              <div class="mt-auto flex flex-wrap gap-1.5 border-t border-border/50 pt-3">
                <span class="rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-xs text-primary">
                  Key: {song.key}
                </span>
                {song.capo && (
                  <span class="rounded-full border border-border bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                    Capo {song.capo}
                  </span>
                )}
                {song.genre.slice(0, 1).map((g) => (
                  <span class="rounded-full border border-border bg-muted px-2 py-0.5 text-xs capitalize text-muted-foreground">
                    {g}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href="/songs/" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            Browse all songs →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── TOOLS ──────────────────────────────────────────────────────── -->
    <section id="tools" class="border-y border-border bg-muted/20 py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-3 font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            The rest of the toolkit
          </h2>
          <p class="text-lg text-muted-foreground">
            Free browser tools for songwriters, producers and students — no installs, no account.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((t) => (
            <a
              href={t.href}
              class="group flex items-start gap-4 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
            >
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                <ToolIcon name={t.icon} class="h-5 w-5 text-primary" />
              </div>
              <div class="min-w-0">
                <h3 class="mb-1 font-semibold text-foreground transition-colors group-hover:text-primary">{t.title}</h3>
                <p class="text-sm text-muted-foreground">{t.desc}</p>
              </div>
              <svg class="ml-auto mt-1 h-4 w-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href="/tools/" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            View all music tools →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── THEORY + FAQ ───────────────────────────────────────────────── -->
    <section id="theory" class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-primary">
            Theory guide
          </p>
          <h2 class="font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            How chord progressions actually work
          </h2>
          <p class="mt-2 text-sm text-muted-foreground sm:text-base">
            Practical harmony for songwriters, producers and beatmakers — why progressions
            create emotion, tension and resolution.
          </p>
        </div>

        <div class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-3">
          {theoryPillars.map((p) => (
            <div class="rounded-3xl border border-border bg-card p-6">
              <div class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-primary">
                {p.n} · {p.label}
              </div>
              <h3 class="mb-2 font-serif text-lg font-bold text-foreground">{p.title}</h3>
              <p class="text-xs leading-relaxed text-muted-foreground" set:html={p.body} />
            </div>
          ))}
        </div>

        <div class="mx-auto max-w-3xl">
          <h3 class="mb-8 text-center font-serif text-2xl font-bold text-foreground">
            Frequently asked questions about chord progressions
          </h3>

          <div class="space-y-3">
            {faqs.map((faq) => (
              <div class="overflow-hidden rounded-2xl border border-border bg-card">
                <details class="group">
                  <summary class="flex cursor-pointer select-none list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-foreground transition-colors hover:bg-accent/30">
                    {faq.q}
                    <svg class="h-4 w-4 shrink-0 text-primary transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="border-t border-border px-5 py-4">
                    <p class="text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
                  </div>
                </details>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ─── LEARN ──────────────────────────────────────────────────────── -->
    <section class="border-y border-border bg-muted/20 py-14 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-3 font-serif text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Learn music theory
          </h2>
          <p class="text-lg text-muted-foreground">
            Free guides for songwriters and producers. Every article includes interactive examples.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            { href: '/learn/what-is-a-chord-progression/', title: 'What is a chord progression?', desc: 'The complete beginner guide to harmonic movement and why progressions work.' },
            { href: '/learn/chord-progressions-for-beginners/', title: 'Chord progressions for beginners', desc: 'I–V–vi–IV, the 12-bar blues, and the four progressions to learn first.' },
            { href: '/learn/jazz-chord-progressions/', title: 'Jazz chord progressions', desc: 'ii–V–I, turnarounds, bossa nova, and modal jazz — with interactive players.' },
            { href: '/learn/circle-of-fifths-explained/', title: 'Circle of fifths explained', desc: 'How key relationships work and how to use them in your songwriting.' },
            { href: '/best-chord-progression-generators/', title: 'Best chord progression generators', desc: 'Free vs paid tools compared — browser apps and DAW plugins for 2026.' },
            { href: '/best-guitar-tab-software/', title: 'Best guitar tab software', desc: 'Free vs paid tab editors compared — browser tools, desktop apps, and notation software for 2026.' },
          ].map((a) => (
            <a href={a.href} class="group rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/40">
              <h3 class="mb-2 text-sm font-semibold text-foreground transition-colors group-hover:text-primary">{a.title}</h3>
              <p class="text-xs leading-relaxed text-muted-foreground">{a.desc}</p>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center">
          <a href="/learn/" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary/80">
            View all music theory guides →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── FINAL CTA ──────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-t border-border py-16 sm:py-24">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute left-1/2 top-1/2 h-[500px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/[0.08] blur-[100px]"></div>
      </div>
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="mb-6 font-serif text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
          Your next chord progression<br />is one click away.
        </h2>
        <p class="mx-auto mb-10 max-w-xl text-lg text-muted-foreground">
          Free, instant, and no signup. Open the editor and start building.
        </p>
        <a
          href="/chord-player/"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-10 py-5 text-xl font-bold text-primary-foreground shadow-xl shadow-primary/25 transition-colors hover:bg-primary/90"
        >
          Open Chord Player
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
