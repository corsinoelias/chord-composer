---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ChordFinderTool } from '../../components/ChordLookup/ChordFinderTool'

const cards = [
  { href: '/guitar-chord-lookup/', title: 'Guitar chord lookup', desc: 'Find any guitar chord from the fretboard, with fingerings and positions along the neck.' },
  { href: '/piano-chord-lookup/', title: 'Piano chord lookup', desc: 'Identify piano chords from pressed keys — every note highlighted on the keyboard.' },
  { href: '/ukulele-chord-lookup/', title: 'Ukulele chord lookup', desc: 'Look up any ukulele chord in standard GCEA tuning, with real finger patterns.' },
]

const steps = [
  { t: '1 · Pick your instrument', d: 'Each instrument has its own page: <a href="/guitar-chord-lookup/">guitar</a>, <a href="/piano-chord-lookup/">piano</a> or <a href="/ukulele-chord-lookup/">ukulele</a>.' },
  { t: '2 · Build the chord', d: 'Choose a root note, then a chord type from the Basic, 6th &amp; 7th, or Extended tabs. The chord name and its notes appear instantly.' },
  { t: '3 · Play &amp; listen', d: 'Press "Play chord" (or the spacebar) to hear each note one by one — each dot or key lights up as it sounds — followed by the full chord.' },
]

const faqs = [
  { q: 'Which instruments are supported?', a: 'Guitar (standard EADGBE tuning), piano, and ukulele (standard GCEA tuning). Each has a dedicated lookup page with diagrams built for that instrument.' },
  { q: 'How many chords can I look up?', a: '12 root notes × 30 chord types — around 360 chords per instrument, from basic triads (major, minor, sus, dim, aug) to 6ths, 7ths and extended chords up to 13ths. Guitar and ukulele chords include several positions along the neck.' },
  { q: 'Can I hear the chord?', a: 'Yes. Press "Play chord" (or the spacebar): each note sounds one at a time — its dot or key lights up as it plays — and then you hear the full chord together.' },
  { q: 'Can I use Do Re Mi (solfège) note names?', a: 'Yes. A toggle switches every label between English notation (C, D, E…) and Latin solfège (Do, Re, Mi…). Your choice applies to root notes, chord names and every diagram.' },
  { q: 'Do I need to read music?', a: 'No. Everything is shown visually — highlighted keys on a keyboard, or dots on a fretboard diagram with finger numbers. Note names are shown too, so you learn them as you go.' },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/chord-lookup/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Chord Lookup', item: 'https://chordsequence.com/chord-lookup/' },
  ],
}

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Chord Lookup',
  url: 'https://chordsequence.com/chord-lookup/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free chord lookup tool: identify any chord for guitar, piano or ukulele. See the fingering, hear every note, and switch between C-D-E and Do-Re-Mi note names.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<BaseLayout
  title="Chord Lookup — Identify Any Chord | Guitar, Piano & Ukulele"
  description="Free chord lookup tool: identify any chord for guitar, piano or ukulele. See the fingering, hear every note, and switch between C-D-E and Do-Re-Mi note names."
  canonicalUrl="https://chordsequence.com/chord-lookup/"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main style="background:#f7f5fb;font-family:'Hanken Grotesk',system-ui,sans-serif;color:#241d33">
    <div style="min-height:100vh;padding:24px 20px 64px;box-sizing:border-box">
      <div style="max-width:1100px;margin:0 auto;display:flex;flex-direction:column;gap:18px">
        <header style="display:flex;flex-direction:column;gap:6px">
          <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:32px;font-weight:700;letter-spacing:-0.6px">Chord Lookup</h1>
          <p style="margin:0;font-size:15.5px;color:#6f6788;max-width:640px">Identify any chord for guitar, piano or ukulele — see exactly where your fingers go and hear how the chord sounds, note by note.</p>
        </header>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px">
          {cards.map((c) => (
            <a href={c.href} style="background:#ffffff;border:1.5px solid #e7e0f2;border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px;transition:border-color 0.1s ease">
              <div style="font-family:'Bricolage Grotesque',sans-serif;font-size:17px;font-weight:700;color:#241d33">{c.title} &rarr;</div>
              <div style="font-size:13.5px;line-height:1.55;color:#6f6788">{c.desc}</div>
            </a>
          ))}
        </div>

        <ChordFinderTool instrument="guitar" client:load />

        <section style="background:#ffffff;border:1px solid #e7e0f2;border-radius:18px;padding:26px 28px;display:flex;flex-direction:column;gap:20px;box-shadow:0 1px 4px rgba(40,25,80,0.05)">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">What is Chord Lookup?</h2>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">A visual chord dictionary for three instruments. Choose any of the 12 root notes and 30 chord types — from a simple C major to a Cmaj13 — and it shows you exactly how to play that chord: which keys to press on a piano, or which frets and fingers to use on guitar and ukulele, with real fingerings and several positions along the neck.</p>
            <p style="margin:0;font-size:14.5px;line-height:1.65;color:#4c4462;max-width:760px">You can also hear every chord: press Play and each note sounds one at a time — lighting up its dot or key so you can follow along — then the full chord together. Made for music teachers and students, but useful to anyone learning songs, writing music, or checking a fingering on the spot.</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px">
            {steps.map((s) => (
              <div style="background:#f7f4fc;border-radius:14px;padding:16px 18px;display:flex;flex-direction:column;gap:6px">
                <div style="font-size:13px;font-weight:700;color:#7C3AED">{s.t}</div>
                <div style="font-size:13.5px;line-height:1.6;color:#4c4462" set:html={s.d} />
              </div>
            ))}
          </div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:21px;font-weight:700;letter-spacing:-0.3px">Frequently asked questions</h2>
            <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
              {faqs.map((f) => (
                <details style="border:1px solid #e7e0f2;border-radius:12px;padding:13px 18px">
                  <summary style="font-size:14.5px;font-weight:600;cursor:pointer">{f.q}</summary>
                  <p style="margin:10px 0 2px;font-size:14px;line-height:1.6;color:#4c4462" set:html={f.a} />
                </details>
              ))}
            </div>
          </div>
        </section>

        <footer style="font-size:13px;color:#8a819e;display:flex;gap:8px;flex-wrap:wrap">
          <span>Chord lookup by instrument:</span>
          <a href="/guitar-chord-lookup/" style="color:#7C3AED">Guitar</a> &middot;
          <a href="/piano-chord-lookup/" style="color:#7C3AED">Piano</a> &middot;
          <a href="/ukulele-chord-lookup/" style="color:#7C3AED">Ukulele</a>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>
