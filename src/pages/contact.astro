---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHORS } from '../data/authors';

const author = AUTHORS['elias-corsino'];
---

<BaseLayout
  title="Contact | Chord Sequence"
  description="Get in touch with the Chord Sequence team. Reach us by email or find us on social media."
  canonicalUrl="https://chordsequence.com/contact/"
>
  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-10">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-foreground">Contact</span>
    </nav>

    <header class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4">Get in touch</h1>
      <p class="text-lg text-muted-foreground">
        Have a question, found a bug, or want to suggest a feature? We'd love to hear from you.
      </p>
    </header>

    <div class="space-y-6">

      <!-- Email -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <h2 class="font-semibold text-foreground mb-1">Email</h2>
            <p class="text-sm text-muted-foreground mb-2">For general questions, bug reports, or feature requests.</p>
            <a
              href="mailto:corsinoelias@gmail.com"
              class="text-sm font-medium text-primary hover:text-primary/80 transition-colors"
            >
              corsinoelias@gmail.com
            </a>
          </div>
        </div>
      </div>

      <!-- Instagram -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </div>
          <div>
            <h2 class="font-semibold text-foreground mb-1">Instagram</h2>
            <p class="text-sm text-muted-foreground mb-2">Follow for music theory tips and app updates.</p>
            <a
              href={author.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-primary hover:text-primary/80 transition-colors"
            >
              @corsinoeliaas ↗
            </a>
          </div>
        </div>
      </div>

      <!-- LinkedIn -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <div>
            <h2 class="font-semibold text-foreground mb-1">LinkedIn</h2>
            <p class="text-sm text-muted-foreground mb-2">Connect with Elías on LinkedIn.</p>
            <a
              href={author.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-primary hover:text-primary/80 transition-colors"
            >
              {author.name} ↗
            </a>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-12 rounded-xl border border-primary/20 bg-primary/5 p-8 text-center">
      <h2 class="text-xl font-semibold text-foreground mb-2">Try Chord Sequence</h2>
      <p class="text-sm text-muted-foreground mb-5">Free, no account needed. Build chord progressions in your browser.</p>
      <a href="/app" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-lg hover:bg-primary/90 transition-colors">
        Open Chord Player →
      </a>
    </div>
  </main>
</BaseLayout>
