---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { OnlineTuner } from '../../components/Tuner/OnlineTuner'
import RelatedTools from '../../components/RelatedTools.astro'

const instruments = [
  { name: 'Guitar',       notes: ['E2', 'A2', 'D3', 'G3', 'B3', 'E4'] },
  { name: 'Bass guitar',  notes: ['E1', 'A1', 'D2', 'G2'] },
  { name: 'Ukulele',      notes: ['G4', 'C4', 'E4', 'A4'] },
  { name: 'Banjo',        notes: ['G4', 'D3', 'G3', 'B3', 'D4'] },
  { name: 'Mandolin',     notes: ['G3', 'G3', 'D4', 'D4', 'A4', 'A4', 'E5', 'E5'] },
  { name: 'Violin',       notes: ['G3', 'D4', 'A4', 'E5'] },
  { name: 'Viola',        notes: ['C3', 'G3', 'D4', 'A4'] },
  { name: 'Cello',        notes: ['C2', 'G2', 'D3', 'A3'] },
  { name: 'Double bass',  notes: ['E1', 'A1', 'D2', 'G2'] },
]

// Precompute note sets (letter only, no octave) for the matrix
const instrumentMatrix = instruments.map(inst => ({
  ...inst,
  noteSet: new Set(inst.notes.map(n => n.replace(/\d+/, ''))),
}))

// Columns sorted by how many instruments share that note
const NOTE_COLS = [
  { note: 'G', count: 9, labelClass: 'text-primary',           dotClass: 'bg-primary',            emptyClass: 'border-primary/25' },
  { note: 'D', count: 8, labelClass: 'text-primary/80',        dotClass: 'bg-primary/80',         emptyClass: 'border-primary/20' },
  { note: 'A', count: 8, labelClass: 'text-primary/80',        dotClass: 'bg-primary/80',         emptyClass: 'border-primary/20' },
  { note: 'E', count: 6, labelClass: 'text-primary/55',        dotClass: 'bg-primary/55',         emptyClass: 'border-border' },
  { note: 'C', count: 3, labelClass: 'text-muted-foreground',  dotClass: 'bg-muted-foreground/60',emptyClass: 'border-border' },
  { note: 'B', count: 2, labelClass: 'text-muted-foreground/50', dotClass: 'bg-muted-foreground/35', emptyClass: 'border-border' },
]

const faqs = [
  {
    q: 'What does "chromatic" mean in a tuner?',
    a: 'A chromatic tuner listens for any of the 12 notes in Western music — C, C#, D, D#, E, F, F#, G, G#, A, A#, B — and their octaves. This is different from tuner apps that only know about the standard open strings of one specific instrument. Because it covers every note, it works for any instrument in any tuning.',
  },
  {
    q: 'How accurate is this tuner?',
    a: 'The tuner uses an autocorrelation algorithm that resolves pitch to within about 1–2 cents (there are 100 cents per semitone, so that is well below what the human ear can hear as out of tune). The main variable is your microphone — a built-in laptop mic is usually sufficient, but a noisy room or a very quiet room can occasionally cause the needle to waver.',
  },
  {
    q: 'The tuner is showing the right note but the wrong octave — is something broken?',
    a: 'No, the string is still in tune. Very low strings (like the open E on a bass or guitar) sit near the edge of the detection range, and sometimes the algorithm latches onto a harmonic overtone rather than the fundamental frequency. The note name is what matters for tuning — if it says E and you\'re playing E, you\'re good.',
  },
  {
    q: 'Does it work on a phone or tablet?',
    a: 'Yes. The tuner runs on the Web Audio API, which works in Chrome on Android and Safari on iPhone and iPad. When you tap Start Tuning, your browser will ask for microphone permission — allow it and you\'re ready to go.',
  },
  {
    q: 'Is my audio sent anywhere?',
    a: 'No. Everything runs locally in your browser. The microphone signal goes directly into the Web Audio API, the pitch is calculated on your own device, and nothing is uploaded or stored anywhere.',
  },
]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://chordsequence.com/tuner/#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://chordsequence.com/' },
    { '@type': 'ListItem', position: 2, name: 'Online Tuner', item: 'https://chordsequence.com/tuner/' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Online Chromatic Tuner',
  url: 'https://chordsequence.com/tuner/',
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Any',
  description: 'Free online chromatic tuner. Detects pitch via your device microphone and shows whether your note is flat, in tune, or sharp. Works for guitar, bass, ukulele, violin, and more.',
  featureList: [
    'Chromatic pitch detection — all 12 notes',
    'Visual needle gauge with cents deviation',
    'Real-time display — no latency',
    'Works for guitar, bass, ukulele, violin, and more',
    'No signup, no download',
  ],
  browserRequirements: 'Requires a modern browser with Web Audio API and microphone access',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}

---

<BaseLayout
  title="Online Tuner — Free Chromatic Tuner for Guitar, Bass & More | Chord Sequence"
  description="Free online chromatic tuner. Use your microphone to tune guitar, bass, ukulele, or violin in real time — note name, frequency, and cents deviation."
  canonicalUrl="https://chordsequence.com/tuner/"
  ogImage="/og/page/tuner/"
  ogImageAlt="Online Guitar Tuner — Free | Chord Sequence"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main>

    <!-- HERO -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-14 pb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Free Online Tool</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-tight mb-4 leading-tight">
        Online Tuner
      </h1>
      <p class="text-lg text-muted-foreground max-w-xl mx-auto">
        Tune any instrument in your browser using your device microphone. Free, instant, no signup.
      </p>
    </section>

    <!-- TUNER COMPONENT -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6 pb-16">
      <OnlineTuner client:only="react" />
    </section>

    <!-- HOW TO USE -->
    <section class="bg-muted/30 border-t border-border py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-4">How to tune your instrument</h2>
        <div class="text-muted-foreground space-y-4 leading-relaxed">
          <p>
            Hit <strong class="text-foreground">Start Tuning</strong> and allow microphone access when your browser asks.
            Then play any string on your instrument and hold the note steady.
          </p>
          <p>
            The needle tells you everything: if it swings left your string is <strong class="text-foreground">flat</strong> (too low) — tighten the tuning peg.
            If it swings right, the string is <strong class="text-foreground">sharp</strong> (too high) — loosen it slightly.
            When the needle centers and turns green, you're in tune.
          </p>
          <p>
            Make small adjustments and let the note ring out fully after each turn of the peg.
            Strings can take a moment to settle, especially if they're new.
          </p>
        </div>
      </div>
    </section>

    <!-- WHAT IS A TUNER -->
    <section class="py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-4">What is a tuner?</h2>
        <div class="text-muted-foreground space-y-4 leading-relaxed">
          <p>
            Every musical note has a specific frequency — a precise number of vibrations per second measured in Hz.
            When a string is in tune, it vibrates at exactly the right frequency for its note.
            A tuner listens to your instrument, measures that frequency, and tells you how close you are to the target.
          </p>
          <p>
            String instruments go out of tune constantly: temperature changes, humidity, stretching strings, and just playing
            all affect the tension. Tuning before every session is a basic habit every musician needs.
          </p>
          <p>
            This tuner is <strong class="text-foreground">chromatic</strong>, meaning it recognizes all 12 notes —
            not just the open strings of one specific instrument. It works for any instrument in any tuning.
            Everything runs in your browser; no audio leaves your device.
          </p>
        </div>
      </div>
    </section>

    <!-- STANDARD TUNINGS: dot matrix -->
    <section class="bg-muted/30 border-t border-border py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-2">Standard tunings</h2>
        <p class="text-muted-foreground mb-8">
          Each dot marks a note in that instrument's standard tuning. Brighter columns are shared by more instruments.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left pb-3 pr-6" style="min-width: 8rem"></th>
                {NOTE_COLS.map(col => (
                  <th class="pb-3 px-3 text-center w-12">
                    <span class={`block text-sm font-bold font-mono ${col.labelClass}`}>{col.note}</span>
                    <span class="block text-xs text-muted-foreground/40 mt-0.5">{col.count}/9</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {instrumentMatrix.map(inst => (
                <tr class="border-b border-border/40 last:border-0 hover:bg-muted/40 transition-colors">
                  <td class="py-3 pr-6 text-sm font-medium text-foreground whitespace-nowrap">{inst.name}</td>
                  {NOTE_COLS.map(col => (
                    <td class="py-3 px-3 text-center">
                      {inst.noteSet.has(col.note) ? (
                        <span class={`inline-block w-3.5 h-3.5 rounded-full ${col.dotClass}`} />
                      ) : (
                        <span class={`inline-block w-3.5 h-3.5 rounded-full border-2 ${col.emptyClass}`} />
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-xs text-muted-foreground mt-6 pt-4 border-t border-border">
          <strong class="text-foreground">G, D and A</strong> are the most universal —
          they appear in guitar, bass, mandolin, and the entire violin family (violin, viola, cello).
          Standard tuning only; drop, open, and alternate tunings vary.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-8">Frequently asked questions</h2>
        <div class="space-y-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-card p-6">
              <h3 class="font-semibold text-foreground mb-2">{f.q}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED TOOLS -->
    <RelatedTools tools={[
      { href: '/bass-guitar/', icon: 'bass', label: 'Virtual Bass Guitar', desc: 'Once tuned, play the bass with real Fender, Finger, Slap, and Muted samples.' },
      { href: '/metronome/', icon: 'metronome', label: 'Metronome', desc: 'Keep steady time while you practice. Tap tempo and accent on beat 1.' },
      { href: '/tools/bass-guitar-tab/', icon: 'bass-tab', label: 'Bass Tab Player', desc: 'Compose and play bass lines. Load Beat It, Billie Jean, and more.' },
      { href: '/chord-player/', icon: 'chords', label: 'Chord Player', desc: 'Build chord progressions with drums, bass, and piano playback.' },
    ]} />

  </main>
</BaseLayout>
