---
const nav = [
  {
    id: 'features',
    label: 'Features',
    items: [
      { label: 'Chord Progression Builder', href: '/app/', desc: 'Drag-and-drop chord sequencer' },
      { label: 'Live Rhythm Playback', href: '/app/', desc: '13+ rhythm styles with real audio' },
      { label: 'Chord Transposer', href: '/tools/chord-transposer/', desc: 'Shift any progression by semitones' },
      { label: 'WAV Export', href: '/app/', desc: 'Download your progression as audio' },
      { label: 'Song Library', href: '/app/', desc: 'Save and organize your songs' },
    ],
  },
  {
    id: 'tools',
    label: 'Tools',
    items: [
      { label: 'Circle of Fifths', href: '/tools/circle-of-fifths/', desc: 'Interactive key & chord relationships' },
      { label: 'Chord Transposer', href: '/tools/chord-transposer/', desc: 'Shift chords by key or semitone' },
      { label: 'Key Detector', href: '/tools/key-detector/', desc: 'Detect the key of a progression' },
    ],
  },
  {
    id: 'progressions',
    label: 'Progressions',
    items: [
      { label: 'Pop Progressions', href: '/progressions/pop/', desc: null },
      { label: 'Jazz Progressions', href: '/progressions/jazz/', desc: null },
      { label: 'Lo-fi Progressions', href: '/progressions/lo-fi/', desc: null },
      { label: 'Sad Progressions', href: '/progressions/sad/', desc: null },
      { label: 'Happy Progressions', href: '/progressions/happy/', desc: null },
      { label: 'Neo Soul Progressions', href: '/progressions/neo-soul/', desc: null },
      { label: 'Worship Progressions', href: '/progressions/worship/', desc: null },
      { label: 'EDM Progressions', href: '/progressions/edm/', desc: null },
      { label: 'Rock Progressions', href: '/progressions/rock/', desc: null },
      { label: 'Blues Progressions', href: '/progressions/blues/', desc: null },
      { label: '12-Bar Blues', href: '/progressions/12-bar-blues/', desc: null },
      { label: 'ii–V–I (Jazz)', href: '/progressions/ii-v-i/', desc: null },
    ],
  },
  {
    id: 'learn',
    label: 'Learn',
    items: [
      { label: 'What is a Chord Progression?', href: '/learn/what-is-a-chord-progression/', desc: null },
      { label: 'How to Transpose Chords', href: '/learn/how-to-transpose-chords/', desc: null },
      { label: 'Circle of Fifths Explained', href: '/learn/circle-of-fifths-explained/', desc: null },
      { label: 'Common Pop Progressions', href: '/learn/chord-progressions-for-beginners/', desc: null },
      { label: 'Music Theory Basics', href: '/learn/music-theory-basics-for-songwriters/', desc: null },
      { label: 'All Articles →', href: '/learn/', desc: null },
    ],
  },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center shadow-sm">
          <svg class="w-4 h-4 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <span class="font-bold text-foreground tracking-tight text-sm sm:text-base">ChordSequence</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5">
        {nav.map((section) => (
          <div class="relative" data-nav-item>
            <button
              class="flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors"
              aria-haspopup="true"
            >
              {section.label}
              <svg class="w-3 h-3 transition-transform duration-200" data-nav-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>

            <!-- Dropdown panel -->
            <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 transition-all duration-150 z-50" data-nav-panel>
              <div class="bg-card border border-border rounded-xl shadow-2xl overflow-hidden min-w-[220px]">
                <div class="p-1.5">
                  {section.items.map((item) => (
                    <a
                      href={item.href}
                      class="flex flex-col px-3 py-2.5 rounded-lg hover:bg-accent/60 transition-colors group/item"
                    >
                      <span class="text-sm font-medium text-foreground group-hover/item:text-primary transition-colors">{item.label}</span>
                      {item.desc && (
                        <span class="text-xs text-muted-foreground mt-0.5">{item.desc}</span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </nav>

      <!-- Right: CTA + mobile button -->
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/app/"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors shadow-sm"
        >
          Open App
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-nav-btn"
          class="lg:hidden p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="hidden lg:hidden border-t border-border bg-background max-h-[80vh] overflow-y-auto">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">

      {nav.map((section) => (
        <div class="mobile-section">
          <button
            class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold text-foreground hover:bg-accent/50 transition-colors"
            data-target={`mobile-${section.id}`}
          >
            {section.label}
            <svg class="w-4 h-4 text-muted-foreground transition-transform duration-200" data-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
          <div id={`mobile-${section.id}`} class="hidden pl-3 pb-2 space-y-0.5">
            {section.items.map((item) => (
              <a
                href={item.href}
                class="block px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-accent/40 transition-colors"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="pt-3 pb-2 border-t border-border mt-3">
        <a
          href="/app/"
          class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-primary text-primary-foreground text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
        >
          Open App
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Mobile nav ────────────────────────────────────────────────
  const btn = document.getElementById('mobile-nav-btn');
  const panel = document.getElementById('mobile-nav');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    hamburger?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });

  document.querySelectorAll<HTMLButtonElement>('.mobile-accordion-btn').forEach((accBtn) => {
    accBtn.addEventListener('click', () => {
      const targetId = accBtn.dataset.target;
      if (!targetId) return;
      const content = document.getElementById(targetId);
      const chevron = accBtn.querySelector<SVGElement>('[data-chevron]');
      content?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });

  // ── Desktop dropdowns (JS-driven so only one opens at a time) ─
  const navItems = document.querySelectorAll<HTMLElement>('[data-nav-item]');

  function closeAll() {
    navItems.forEach(item => {
      item.querySelector<HTMLElement>('[data-nav-panel]')?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      item.querySelector<HTMLElement>('[data-nav-panel]')?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      item.querySelector<SVGElement>('[data-nav-chevron]')?.classList.remove('rotate-180');
    });
  }

  navItems.forEach(item => {
    const dropPanel = item.querySelector<HTMLElement>('[data-nav-panel]');
    const chevron = item.querySelector<SVGElement>('[data-nav-chevron]');

    item.addEventListener('mouseenter', () => {
      closeAll();
      dropPanel?.classList.remove('opacity-0', 'invisible', 'translate-y-1');
      dropPanel?.classList.add('opacity-100', 'visible', 'translate-y-0');
      chevron?.classList.add('rotate-180');
    });

    item.addEventListener('mouseleave', () => {
      dropPanel?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      dropPanel?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      chevron?.classList.remove('rotate-180');
    });
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-nav-item]')) closeAll();
  });
</script>
