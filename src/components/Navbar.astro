---
import { AccountSlot } from './AccountSlot';

// The site's navigation: ONE menu in the HTML, laid out two ways. From 1024px it is a row of
// four sections whose panels open full width under the header; below, the same markup is a
// full-screen sheet where each section is an accordion. It used to be two menus (a desktop
// row and a separate mobile list), so every link was in the page twice.
//
// SEO rules this file keeps (2026-09-29):
// - Every panel is server-rendered HTML, hidden with CSS until opened. Its ~55 links are on
//   every page for crawlers; never build a panel's content in JavaScript.
// - Anchor text is the page's real name, the same on every screen: Google indexes the
//   phone layout, so a short phone label would be the anchor text that counts.
// - Nothing here links /app/ (the signed-in library, out of the sitemap): AccountSlot shows
//   "My library" to signed-in visitors only, on the client.
// - The songs get a link from every page, the strongest internal link a song page can have:
//   pick them with Search Console (pages at positions ~5-15 with the most impressions) and
//   change them monthly at most, not daily. The current six were picked 2026-09-29 from
//   the 28 days to 09-27: Center (15.3k impressions, position 6.0) and Washed (17.0k, 6.7)
//   stayed; Oceans (25.0k, 6.5), Goodness of God (15.6k, 8.3), Jesus Be the Name (13.8k,
//   7.2) and Great Are You Lord (13.7k, 7.3) came in for Alleluia (4.5k), Hay Poder (1.2k)
//   and Holy Forever (not in the top 25). The song title A/B test (songTitleTest.ts) was
//   running: this moved three sitewide links from its arm B to arm A, noted there.
//
// Accessibility: sections open with a click, Enter or Space (hover also opens them on a
// mouse), Escape closes and returns focus, arrow keys move along the row, and every trigger
// carries aria-expanded / aria-controls. The page you are on is marked aria-current="page",
// and its section is underlined.

interface NavLink {
  label: string;
  href: string;
  desc?: string;
}

interface LinkGroup {
  name: string;
  dot: string;
  links: NavLink[];
}

const path = Astro.url.pathname;

// `key` only where it is known here (src/data/songs.ts or the chart itself); a song kept only
// in Supabase shows no key rather than a guessed one.
const songs: (NavLink & { artist: string; key?: string })[] = [
  { label: 'Oceans (Where Feet May Fail)', artist: 'Hillsong United', key: 'D', href: '/songs/oceans-hillsong-united/' },
  { label: 'Washed', artist: 'Elevation Rhythm', key: 'B', href: '/songs/washed-elevation-rhythm/' },
  { label: 'Goodness of God', artist: 'Bethel Music', key: 'C', href: '/songs/goodness-of-god-bethel-music/' },
  { label: 'Center', artist: 'Bethel Music', key: 'A', href: '/songs/center-bethel-music/' },
  { label: 'Jesus Be the Name', artist: 'Elevation Worship', key: 'Db', href: '/songs/jesus-be-the-name-elevation-worship/' },
  { label: 'Great Are You Lord', artist: 'All Sons & Daughters', key: 'G', href: '/songs/great-are-you-lord-all-sons-daughters/' },
];
const songLinks: NavLink[] = [
  { label: 'All song charts', href: '/songs/' },
  { label: 'Easy guitar songs', href: '/learn/easy-guitar-songs/' },
];

const toolGroups: LinkGroup[] = [
  {
    name: 'Write & tab', dot: '#E0609A',
    links: [
      { label: 'Chord Sheet Maker', href: '/chord-sheet-maker/', desc: 'Lyrics and chords, print or publish' },
      { label: 'Guitar Tab', href: '/tools/guitar-tab/', desc: 'Play and write 6-string tabs' },
      { label: 'Bass Guitar Tab', href: '/tools/bass-guitar-tab/', desc: 'Play and write 4-string tabs' },
      { label: 'Drum Tab', href: '/tools/drum-tab/', desc: 'Notation, grid or ASCII' },
    ],
  },
  {
    name: 'Theory', dot: '#3B8FFF',
    links: [
      { label: 'Chord Finder', href: '/chord-lookup/', desc: 'Any chord on guitar, piano or ukulele' },
      { label: 'Chord Transposer', href: '/tools/chord-transposer/', desc: 'Move chords to any key' },
      { label: 'Key Detector', href: '/tools/key-detector/', desc: 'Find the key of a progression' },
      { label: 'Circle of Fifths', href: '/tools/circle-of-fifths/', desc: 'Keys and their chords' },
      { label: 'Guitar Scale Chart', href: '/tools/scales/', desc: '277 scales on the fretboard' },
    ],
  },
  {
    name: 'Practice', dot: '#E8B93E',
    links: [
      { label: 'Metronome', href: '/metronome/', desc: 'Tap tempo and accents' },
      { label: 'Tuner', href: '/tuner/', desc: 'Chromatic, any instrument' },
      { label: 'Guitar Strumming', href: '/tools/guitar-strumming-patterns/', desc: 'Strum and arpeggio patterns' },
      { label: 'Drum Machine', href: '/tools/drum-machine/', desc: '16 steps, 3 kits' },
    ],
  },
  {
    name: 'Instruments', dot: '#34C3B0',
    links: [
      { label: 'Piano', href: '/piano/', desc: 'Real samples, MIDI and songs' },
      { label: 'Guitar', href: '/guitar/', desc: '8 sampled sounds' },
      { label: 'Bass Guitar', href: '/bass-guitar/', desc: '4 strings, real tones' },
      { label: 'Drums', href: '/drums/', desc: '15-piece kit, touch or MIDI' },
    ],
  },
];

const genres: NavLink[] = [
  { label: 'Pop', href: '/progressions/pop/' },
  { label: 'Rock', href: '/progressions/rock/' },
  { label: 'Blues', href: '/progressions/blues/' },
  { label: '12-Bar Blues', href: '/progressions/12-bar-blues/' },
  { label: 'Jazz', href: '/progressions/jazz/' },
  { label: 'II–V–I (Jazz)', href: '/progressions/ii-v-i/' },
  { label: 'Neo Soul', href: '/progressions/neo-soul/' },
  { label: 'Gospel', href: '/progressions/gospel/' },
  { label: 'Worship', href: '/progressions/worship/' },
  { label: 'Lo-fi', href: '/progressions/lo-fi/' },
  { label: 'EDM', href: '/progressions/edm/' },
  { label: 'Happy', href: '/progressions/happy/' },
  { label: 'Sad', href: '/progressions/sad/' },
];
const guides: NavLink[] = [
  { label: 'What is a Chord Progression?', href: '/learn/what-is-a-chord-progression/' },
  { label: 'Common Pop Progressions', href: '/learn/chord-progressions-for-beginners/' },
  { label: 'C Major Chord Progressions', href: '/learn/c-major-chord-progressions/' },
  { label: 'Chord Inversions', href: '/learn/chord-inversions/' },
  { label: 'Jazz Chord Progressions', href: '/learn/jazz-chord-progressions/' },
  { label: 'How to Transpose Chords', href: '/learn/how-to-transpose-chords/' },
  { label: 'How to Read Bass Tabs', href: '/tools/bass-guitar-tab/#what-is-a-bass-tab' },
];

// Which section the page belongs to, for the underline. A page counts as the section of any
// link that points at it, and of the hub its path sits under.
const here = (href: string) => href.split('#')[0] === path;
const within = (prefixes: string[]) => prefixes.some((p) => path.startsWith(p));
const currentSection =
  within(['/chord-player/', '/chord-player-app/']) ? 'player'
  : within(['/songs/']) || songLinks.some((l) => here(l.href)) ? 'songs'
  : within(['/tools/', '/instruments/']) || toolGroups.some((g) => g.links.some((l) => here(l.href))) ? 'tools'
  : within(['/learn/', '/progressions/']) ? 'learn'
  : null;

const sections = [
  { id: 'player', label: 'Chord Player' },
  { id: 'songs', label: 'Songs' },
  { id: 'tools', label: 'Tools' },
  { id: 'learn', label: 'Learn' },
];

const current = (href: string) => (here(href) ? { 'aria-current': 'page' as const } : {});
const groupLabel = 'font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-muted-foreground';
---

<!-- No backdrop-filter on the header: it would make the header the containing block of the
     fixed phone sheet and scrim below, squeezing both into the header's 64px. -->
<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background" data-site-header>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:gap-6 xl:px-8">

    <!-- Logo -->
    <a href="/" class="group flex shrink-0 items-center gap-2.5 py-1.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary shadow-sm">
        <svg class="h-4 w-4 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <span class="text-sm font-bold tracking-tight text-foreground sm:text-base">ChordSequence</span>
    </a>

    <!-- The menu. Below 1024px it is the sheet the hamburger opens (hidden until then); from
         1024px its four triggers sit in the row and each panel drops full width. -->
    <nav
      id="site-nav"
      aria-label="Main"
      class="fixed inset-x-0 bottom-0 top-16 z-50 hidden overflow-y-auto overscroll-contain bg-background lg:static lg:z-auto lg:flex lg:h-16 lg:flex-1 lg:overflow-visible lg:bg-transparent"
      data-site-nav
    >
      <div class="flex min-h-full flex-col gap-3 px-4 pb-6 pt-4 sm:px-6 lg:min-h-0 lg:w-full lg:flex-row lg:items-stretch lg:gap-0 lg:p-0">

        <ul class="flex flex-col lg:flex-row lg:items-stretch lg:gap-0.5">
          {sections.map((section) => (
            <li class:list={['lg:flex lg:items-stretch', section.id === 'player' ? 'order-first border-b border-border lg:border-0' : 'border-b border-border lg:border-0']}>
              <button
                type="button"
                id={`nav-trigger-${section.id}`}
                aria-expanded="false"
                aria-controls={`nav-panel-${section.id}`}
                data-nav-trigger={section.id}
                class:list={[
                  'group relative h-[52px] w-full items-center justify-between px-1 text-base font-semibold text-foreground',
                  section.id === 'player' ? 'hidden lg:flex' : 'flex',
                  'lg:h-16 lg:w-auto lg:gap-1.5 lg:px-3 lg:text-sm lg:font-medium lg:text-muted-foreground lg:hover:text-foreground lg:aria-expanded:text-foreground',
                  currentSection === section.id && 'lg:text-foreground',
                ]}
              >
                <span class="lg:rounded-md lg:px-0.5">{section.label}</span>
                <svg class="h-4 w-4 text-muted-foreground transition-transform duration-200 group-aria-expanded:rotate-180 lg:h-3 lg:w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                {currentSection === section.id && (
                  <span class="absolute inset-x-3 bottom-0 hidden h-0.5 rounded-full bg-primary lg:block" aria-hidden="true"></span>
                )}
              </button>

              <!-- The panel: an accordion body on a phone, a full-width sheet under the header
                   from 1024px (the header is the positioned box it hangs from). -->
              <div
                id={`nav-panel-${section.id}`}
                role="region"
                aria-labelledby={`nav-trigger-${section.id}`}
                class:list={[
                  'hidden pb-4 lg:absolute lg:inset-x-0 lg:top-full lg:border-b lg:border-border lg:bg-card lg:pb-0 lg:shadow-[0_24px_48px_rgba(20,24,31,0.12)]',
                  // On a phone the player is not an accordion: its two cards head the sheet.
                  section.id === 'player' && 'max-lg:!block',
                ]}
                data-nav-panel={section.id}
              >
                <div class="lg:mx-auto lg:max-w-7xl lg:px-6 lg:py-7 xl:px-8">

                  {section.id === 'player' && (
                    <div class="flex flex-col gap-2.5 lg:grid lg:grid-cols-3 lg:gap-5">
                      <a href="/chord-player/" class="flex items-center gap-3.5 rounded-2xl bg-primary/10 p-4 transition-colors hover:bg-primary/15 lg:col-span-2 lg:gap-5 lg:p-6" {...current('/chord-player/')}>
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground lg:h-14 lg:w-14 lg:rounded-2xl">
                          <svg class="h-[18px] w-[18px] lg:h-[22px] lg:w-[22px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z"/></svg>
                        </span>
                        <span class="flex flex-col gap-0.5 lg:gap-1">
                          <span class="text-base font-bold text-foreground lg:text-lg">Chord Player</span>
                          <span class="text-[13px] leading-snug text-muted-foreground lg:text-[14.5px]">Write the chords, pick a rhythm, and a full band plays them. In your browser, free.</span>
                          <span class="mt-1 hidden text-sm font-semibold text-primary lg:block">Open the chord player →</span>
                        </span>
                      </a>
                      <a href="/chord-player-app/" class="flex items-center gap-3.5 rounded-2xl border border-border px-4 py-3 transition-colors hover:border-primary/40 lg:gap-4 lg:p-6" {...current('/chord-player-app/')}>
                        <img src="/images/chord-player-app-icon.png" width="96" height="96" alt="" loading="lazy" class="h-9 w-9 rounded-lg border border-border lg:h-14 lg:w-14 lg:rounded-xl" />
                        <span class="flex flex-col gap-0.5 lg:gap-1">
                          <span class="text-[15px] font-semibold text-foreground lg:text-base lg:font-bold">Chord Player for Android</span>
                          <span class="text-[13px] leading-snug text-muted-foreground lg:text-[13.5px]">The backing band in your pocket. Offline, no account.</span>
                        </span>
                      </a>
                    </div>
                  )}

                  {section.id === 'songs' && (
                    <div class="flex flex-col gap-4 lg:grid lg:grid-cols-[2fr_1fr] lg:gap-12">
                      <div class="flex flex-col gap-2">
                        <p class={groupLabel}>Popular charts</p>
                        <ul class="grid gap-0.5 lg:grid-cols-2 lg:gap-x-6">
                          {songs.map((song) => (
                            <li>
                              <a href={song.href} class="flex items-center justify-between gap-3 rounded-lg px-2 py-2 hover:bg-accent/60 lg:px-3" {...current(song.href)}>
                                <span class="flex flex-col">
                                  <span class="text-[15px] font-semibold text-foreground lg:text-[14.5px]">{song.label} — {song.artist}</span>
                                </span>
                                {song.key && (
                                  <span class="flex h-6 shrink-0 items-center rounded-md bg-muted px-2 font-mono text-[11px] font-bold text-muted-foreground" aria-label={`Key of ${song.key}`}>{song.key}</span>
                                )}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="flex flex-col gap-2">
                        <p class={groupLabel}>Browse</p>
                        <ul class="flex flex-col gap-0.5">
                          {songLinks.map((link) => (
                            <li><a href={link.href} class="block rounded-lg px-2 py-2 text-[15px] font-semibold text-foreground hover:bg-accent/60 lg:px-3 lg:text-[14.5px]" {...current(link.href)}>{link.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  )}

                  {section.id === 'tools' && (
                    <div class="flex flex-col gap-4">
                      <div class="flex flex-col gap-4 lg:grid lg:grid-cols-4 lg:gap-8">
                        {toolGroups.map((group) => (
                          <div class="flex flex-col gap-1.5">
                            <p class:list={[groupLabel, 'flex items-center gap-2 lg:px-2.5 lg:pb-1']}><span class="h-2 w-2 rounded-full" style={`background:${group.dot}`}></span>{group.name}</p>
                            <ul class="flex flex-wrap gap-1.5 lg:flex-col lg:gap-0.5">
                              {group.links.map((link) => (
                                <li>
                                  <a
                                    href={link.href}
                                    class:list={[
                                      'flex min-h-9 items-center rounded-full border border-border px-3 text-sm font-medium text-foreground',
                                      'lg:min-h-0 lg:flex-col lg:items-start lg:gap-0.5 lg:rounded-lg lg:border-0 lg:px-2.5 lg:py-2 lg:hover:bg-accent/60',
                                      here(link.href) && 'border-primary/40 bg-primary/10 lg:bg-primary/10',
                                    ]}
                                    {...current(link.href)}
                                  >
                                    <span class="lg:text-[14.5px] lg:font-semibold">{link.label}</span>
                                    <span class="hidden text-[13px] leading-snug text-muted-foreground lg:block">{link.desc}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <div class="flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-border pt-3.5 text-sm font-semibold lg:px-2.5">
                        <a href="/tools/" class="text-foreground hover:text-primary" {...current('/tools/')}>All tools →</a>
                        <a href="/instruments/" class="text-foreground hover:text-primary" {...current('/instruments/')}>All instruments →</a>
                      </div>
                    </div>
                  )}

                  {section.id === 'learn' && (
                    <div class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:gap-14">
                      <div class="flex flex-col gap-2.5">
                        <p class={groupLabel}>Chord progressions by genre</p>
                        <ul class="flex flex-wrap gap-1.5 lg:gap-2">
                          {genres.map((genre) => (
                            <li><a href={genre.href} class:list={['flex min-h-9 items-center rounded-full border border-border px-3.5 text-sm font-medium text-foreground hover:border-primary/40', here(genre.href) && 'border-primary/40 bg-primary/10']} {...current(genre.href)}>{genre.label}</a></li>
                          ))}
                        </ul>
                        <a href="/progressions/" class="text-sm font-semibold text-foreground hover:text-primary" {...current('/progressions/')}>All chord progressions →</a>
                      </div>
                      <div class="flex flex-col gap-2">
                        <p class={groupLabel}>Guides</p>
                        <ul class="grid gap-0.5 lg:grid-cols-2 lg:gap-x-5">
                          {guides.map((guide) => (
                            <li><a href={guide.href} class="block rounded-lg px-2 py-2 text-[15px] font-semibold text-foreground hover:bg-accent/60 lg:px-2.5 lg:text-[14.5px]" {...current(guide.href)}>{guide.label}</a></li>
                          ))}
                        </ul>
                        <a href="/learn/" class="px-2 text-sm font-semibold text-foreground hover:text-primary lg:px-2.5" {...current('/learn/')}>All articles →</a>
                      </div>
                    </div>
                  )}

                </div>
              </div>
            </li>
          ))}
        </ul>

        <!-- About, contact and feedback, once: the sheet's foot on a phone, the end of the row
             from 1024px (where Contact stays one click away on the About page). -->
        <div class="mt-auto flex flex-col gap-3 lg:ml-auto lg:mt-0 lg:flex-row lg:items-center lg:gap-1">
          <div class="flex items-center gap-5 px-1 text-sm font-medium text-muted-foreground lg:gap-1 lg:px-0">
            <a href="/about/" class="lg:flex lg:h-10 lg:items-center lg:rounded-md lg:px-2.5 lg:hover:text-foreground" {...current('/about/')}>About</a>
            <a href="/contact/" class="lg:hidden" {...current('/contact/')}>Contact</a>
            <a
              href="/contact/"
              data-feedback-open
              data-feedback-entry-point="navbar"
              title="Send feedback"
              class="lg:flex lg:h-10 lg:w-10 lg:items-center lg:justify-center lg:rounded-md lg:hover:bg-accent/50 lg:hover:text-foreground"
            >
              <span class="lg:sr-only">Send feedback</span>
              <svg class="hidden h-[18px] w-[18px] lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </a>
          </div>
          <div class="lg:hidden"><AccountSlot client:load variant="mobile" /></div>
        </div>
      </div>
    </nav>

    <!-- Right side -->
    <div class="ml-auto flex shrink-0 items-center gap-1.5 lg:ml-0">
      <span class="mx-1 hidden h-6 w-px bg-border lg:block" aria-hidden="true"></span>
      <!--
        Signed-out visitors get the bare /chord-player/ CTA — the strongest internal link on
        the site (it renders on every page), pointing at the canonical URL. Once there's a
        session, AccountSlot swaps this same slot to "My library" — client:load, so the CTA
        is what SSR/crawlers see. On a phone it is the compact "Player" beside the menu button.
      -->
      <AccountSlot client:load variant="desktop" />
      <button
        type="button"
        id="mobile-nav-btn"
        class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-muted-foreground hover:bg-accent/50 hover:text-foreground lg:hidden"
        aria-label="Open menu"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="close-icon" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Desktop only: dims the page under an open panel; a click on it closes the panel. -->
  <div class="fixed inset-x-0 bottom-0 top-16 -z-10 hidden bg-foreground/20 lg:block lg:opacity-0 lg:pointer-events-none lg:transition-opacity" data-nav-scrim aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  const nav = document.querySelector<HTMLElement>('[data-site-nav]')!;
  const scrim = document.querySelector<HTMLElement>('[data-nav-scrim]')!;
  const menuBtn = document.getElementById('mobile-nav-btn') as HTMLButtonElement;
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-nav-trigger]')];
  const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls')!)!;
  const desktop = window.matchMedia('(min-width: 1024px)');

  // ── Sections: one open at a time on a desktop; independent accordions on a phone.
  function setSection(trigger: HTMLButtonElement, open: boolean) {
    trigger.setAttribute('aria-expanded', String(open));
    panelOf(trigger).classList.toggle('hidden', !open);
  }
  function closeSections(except?: HTMLButtonElement) {
    triggers.forEach((t) => { if (t !== except) setSection(t, false); });
    if (desktop.matches) showScrim(!!except && except.getAttribute('aria-expanded') === 'true');
  }
  function showScrim(on: boolean) {
    scrim.classList.toggle('lg:opacity-0', !on);
    scrim.classList.toggle('lg:pointer-events-none', !on);
  }
  function openSection(trigger: HTMLButtonElement) {
    if (desktop.matches) closeSections(trigger);
    setSection(trigger, true);
    if (desktop.matches) showScrim(true);
  }
  const isOpen = (t: HTMLButtonElement) => t.getAttribute('aria-expanded') === 'true';

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (isOpen(trigger)) { setSection(trigger, false); if (desktop.matches) showScrim(false); }
      else openSection(trigger);
    });
    trigger.addEventListener('keydown', (e) => {
      if (!desktop.matches) return;
      const visible = triggers.filter((t) => t.offsetParent !== null);
      const at = visible.indexOf(trigger);
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const next = visible[(at + (e.key === 'ArrowRight' ? 1 : -1) + visible.length) % visible.length];
        next.focus();
        if (triggers.some(isOpen)) openSection(next);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        openSection(trigger);
        panelOf(trigger).querySelector<HTMLElement>('a')?.focus();
      }
    });
    // Hover opens on a mouse, after a short pause so a pointer crossing the row does not
    // flash every panel; leaving the header and the panel closes, after a pause too.
    let timer = 0;
    trigger.addEventListener('pointerenter', (e) => {
      if (!desktop.matches || e.pointerType !== 'mouse') return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => openSection(trigger), triggers.some(isOpen) ? 0 : 90);
    });
    trigger.addEventListener('pointerleave', () => window.clearTimeout(timer));
  });

  let leaveTimer = 0;
  header.addEventListener('pointerleave', (e) => {
    if (!desktop.matches || e.pointerType !== 'mouse') return;
    leaveTimer = window.setTimeout(() => closeSections(), 180);
  });
  header.addEventListener('pointerenter', () => window.clearTimeout(leaveTimer));
  // The scrim sits inside the header, so the pointer reaching the page does not leave the
  // header: moving onto the scrim is what counts as leaving the menu.
  scrim.addEventListener('pointerenter', (e) => {
    if (!desktop.matches || e.pointerType !== 'mouse') return;
    leaveTimer = window.setTimeout(() => closeSections(), 180);
  });
  scrim.addEventListener('pointerleave', () => window.clearTimeout(leaveTimer));
  scrim.addEventListener('click', () => closeSections());

  // Focus leaving the menu closes it, so a Tab past the last link does not leave a panel open.
  nav.addEventListener('focusout', (e) => {
    if (!desktop.matches) return;
    const to = e.relatedTarget as Node | null;
    if (to && !nav.contains(to)) closeSections();
  });

  // ── The phone sheet: the page underneath stops scrolling while it is open. Locking the
  // page (overflow: hidden on <html>) also stops the sticky header from sticking — it went
  // back to the top of the page, off screen, whenever the menu opened after a scroll. So
  // while the sheet is open the header is fixed to the screen instead, and the body keeps
  // its height in padding so nothing underneath moves.
  function setSheet(open: boolean) {
    nav.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    hamburger?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    const height = open ? header.getBoundingClientRect().height : 0;
    Object.assign(header.style, open ? { position: 'fixed', top: '0', left: '0', right: '0' } : { position: '', top: '', left: '', right: '' });
    document.body.style.paddingTop = open ? `${height}px` : '';
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  menuBtn.addEventListener('click', () => setSheet(nav.classList.contains('hidden')));

  // The feedback link opens the widget in place (BaseLayout's listener): close the sheet so
  // it does not sit behind the widget.
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-feedback-open]') && !desktop.matches) setSheet(false);
  });

  // ── Escape closes whatever is open and gives focus back to what opened it.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!desktop.matches && !nav.classList.contains('hidden')) { setSheet(false); menuBtn.focus(); return; }
    const open = triggers.find(isOpen);
    if (desktop.matches && open) { closeSections(); open.focus(); }
  });

  // Crossing 1024px resets both layouts, so neither inherits the other's open state.
  desktop.addEventListener('change', () => {
    closeSections();
    setSheet(false);
    nav.classList.remove('hidden');
    if (!desktop.matches) nav.classList.add('hidden');
  });
  if (desktop.matches) nav.classList.remove('hidden');
</script>
