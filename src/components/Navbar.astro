      { label: 'Blues', href: '/progressions/blues/', desc: null },
      { label: '12-Bar Blues', href: '/progressions/12-bar-blues/', desc: null },
      { label: 'Sad', href: '/progressions/sad/', desc: null },
      { label: 'Happy', href: '/progressions/happy/', desc: null },
      { label: 'Neo Soul', href: '/progressions/neo-soul/', desc: null },
      { label: 'Worship', href: '/progressions/worship/', desc: null },
      { label: 'EDM', href: '/progressions/edm/', desc: null },
      { label: 'ii–V–I (Jazz)', href: '/progressions/ii-v-i/', desc: null },
    ],
  },
  {
    id: 'tools',
    label: 'Tools',
    items: [
      { label: 'Guitar Scale Chart', href: '/tools/scales/', desc: 'Visualize 277 scales on a fretboard' },
      { label: 'Circle of Fifths', href: '/tools/circle-of-fifths/', desc: 'Interactive key & chord relationships' },
      { label: 'Chord Transposer', href: '/tools/chord-transposer/', desc: 'Shift chords by key or semitone' },
      { label: 'Key Detector', href: '/tools/key-detector/', desc: 'Find the key of any progression' },
      { label: 'Guitar Tab', href: '/tools/guitar-tab/', desc: 'Play & create 6-string guitar tabs' },
      { label: 'Bass Guitar Tab', href: '/tools/bass-guitar-tab/', desc: 'Play & create 4-string bass tabs' },
      { label: 'Tuner', href: '/tuner/', desc: 'Chromatic tuner — tune any instrument' },
      { label: 'Metronome', href: '/metronome/', desc: 'BPM tool with tap tempo and accent beat' },
    ],
  },
  {
    id: 'instruments',
    label: 'Instruments',
    href: '/instruments/',
    items: [],
  },
  {
    id: 'about',
    label: 'About',
    href: '/about/',
    items: [],
  },
  {
    id: 'learn',
    label: 'Learn',
    items: [
      { label: 'Walking Bass Lines (4 Levels)', href: '/learn/walking-bass-lines/', desc: 'From root notes to expert jazz lines — play every example in the browser' },
      { label: 'How to Read Bass Tabs', href: '/learn/how-to-read-bass-tabs/', desc: 'Strings, fret numbers, symbols — with interactive examples' },
      { label: 'Guitar Chords for Beginners', href: '/learn/beginner-guitar-chords/', desc: '8 essential chords with diagrams' },
      { label: 'What is a Chord Progression?', href: '/learn/what-is-a-chord-progression/', desc: null },
