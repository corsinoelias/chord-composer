  {
    id: 'songs',
    label: 'Songs',
    items: [
      { label: 'Heart Of Worship — Matt Redman', href: '/songs/heart-of-worship-matt-redman/', desc: 'Worship · Key F#' },
      { label: 'How Great Is Our God — Chris Tomlin', href: '/songs/how-great-is-our-god-chris-tomlin/', desc: 'Worship · Key Db' },
      { label: 'This Is Amazing Grace — Phil Wickham', href: '/songs/this-is-amazing-grace-phil-wickham/', desc: 'Worship · Key A#' },
      { label: 'Alleluia — Elevation Worship', href: '/songs/alleluia-elevation-worship/', desc: 'Worship · Key B' },
      { label: 'Center — Bethel Music', href: '/songs/center-bethel-music/', desc: 'Worship · Key A' },
      { label: 'All song charts →', href: '/songs/', desc: null },
    ],
  },
  {
    id: 'progressions',
