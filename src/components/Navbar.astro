---
import { AccountSlot } from './AccountSlot';

const nav = [
  {
    id: 'songs',
    label: 'Songs',
    items: [
      { label: 'Center — Bethel Music', href: '/songs/center-bethel-music/', desc: 'Worship · Key A' },
      { label: 'Alleluia — Elevation Worship', href: '/songs/alleluia-elevation-worship/', desc: 'Worship · Key B' },
      { label: 'Washed — Elevation Rhythm', href: '/songs/washed-elevation-rhythm/', desc: 'Worship · Key B' },
      { label: 'Hay Poder | Yeshua — Averly Morillo', href: '/songs/hay-poder-yeshua-averly-morillo/', desc: 'Worship · Key F#' },
      { label: 'Holy Forever — Chris Tomlin', href: '/songs/holy-forever-chris-tomlin/', desc: 'Worship · Key C' },
      { label: 'All song charts →', href: '/songs/', desc: null },
    ],
  },
  {
    id: 'tools',
    label: 'Tools',
    items: [
      { label: 'Chord Finder', href: '/chord-lookup/', desc: 'Find any chord on guitar, piano or ukulele' },
      { label: 'Bass Guitar Tab', href: '/tools/bass-guitar-tab/', desc: 'Play & create 4-string bass tabs' },
      { label: 'Chord Transposer', href: '/tools/chord-transposer/', desc: 'Shift chords by key or semitone' },
      { label: 'Tuner', href: '/tuner/', desc: 'Chromatic tuner — tune any instrument' },
      { label: 'Circle of Fifths', href: '/tools/circle-of-fifths/', desc: 'Interactive key & chord relationships' },
      { label: 'Key Detector', href: '/tools/key-detector/', desc: 'Find the key of any progression' },
      { label: 'Metronome', href: '/metronome/', desc: 'BPM tool with tap tempo and accent beat' },
      { label: 'Guitar Tab', href: '/tools/guitar-tab/', desc: 'Play & create 6-string guitar tabs' },
      { label: 'Guitar Strumming', href: '/tools/guitar-strumming-patterns/', desc: 'Strum & arpeggio patterns over any chord' },
      { label: 'Guitar Scale Chart', href: '/tools/scales/', desc: 'Visualize 277 scales on a fretboard' },
      { label: 'Drum Machine', href: '/tools/drum-machine/', desc: '16-step beat programming with 3 kits' },
      { label: 'All tools →', href: '/tools/', desc: null },
    ],
  },
  {
    id: 'instruments',
    label: 'Instruments',
    items: [
      { label: 'Bass Guitar', href: '/bass-guitar/', desc: 'Virtual 4-string bass with real sampled tones' },
      { label: 'Guitar', href: '/guitar/', desc: '8 sampled sounds — Steel, Nylon, Jazz, and more' },
      { label: 'Drums', href: '/drums/', desc: '15-piece kit — mouse, touch, keyboard, or MIDI' },
      { label: 'Piano', href: '/piano/', desc: 'Real acoustic samples, MIDI, and a song library' },
      { label: 'All instruments →', href: '/instruments/', desc: null },
    ],
  },
  {
    id: 'about',
    label: 'About',
    href: '/about/',
    items: [],
  },
  {
    id: 'progressions',
    label: 'Progressions',
    items: [
      { label: 'Neo Soul', href: '/progressions/neo-soul/', desc: null },
      { label: 'Jazz', href: '/progressions/jazz/', desc: null },
      { label: 'Blues', href: '/progressions/blues/', desc: null },
      { label: 'Pop', href: '/progressions/pop/', desc: null },
      { label: 'Lo-fi', href: '/progressions/lo-fi/', desc: null },
      { label: 'II–V–I (Jazz)', href: '/progressions/ii-v-i/', desc: null },
      { label: '12-Bar Blues', href: '/progressions/12-bar-blues/', desc: null },
      { label: 'Happy', href: '/progressions/happy/', desc: null },
      { label: 'Sad', href: '/progressions/sad/', desc: null },
      { label: 'Rock', href: '/progressions/rock/', desc: null },
      { label: 'EDM', href: '/progressions/edm/', desc: null },
      { label: 'Worship', href: '/progressions/worship/', desc: null },
      { label: 'All progressions →', href: '/progressions/', desc: null },
    ],
  },
  {
    id: 'learn',
    label: 'Learn',
    items: [
      { label: 'C Major Chord Progressions', href: '/learn/c-major-chord-progressions/', desc: 'Every chord in the key of C, playable instantly' },
      { label: 'Chord Inversions', href: '/learn/chord-inversions/', desc: 'Slash chords, voice leading, and descending bass lines' },
      { label: 'How to Read Bass Tabs', href: '/tools/bass-guitar-tab/#what-is-a-bass-tab', desc: 'Strings, fret numbers, symbols — with interactive examples' },
      { label: 'What is a Chord Progression?', href: '/learn/what-is-a-chord-progression/', desc: null },
      { label: 'Jazz Chord Progressions', href: '/learn/jazz-chord-progressions/', desc: 'II–V–I, turnarounds, bossa nova, and modal jazz' },
      { label: 'How to Transpose Chords', href: '/learn/how-to-transpose-chords/', desc: null },
      { label: 'Common Pop Progressions', href: '/learn/chord-progressions-for-beginners/', desc: null },
      { label: 'All articles →', href: '/learn/', desc: null },
    ],
  },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group py-1.5">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center shadow-sm">
          <svg class="w-4 h-4 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <span class="font-bold text-foreground tracking-tight text-sm sm:text-base">ChordSequence</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5">
        {nav.map((section) => (
          'href' in section && section.href ? (
            <a
              href={section.href}
              class="flex items-center px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors"
            >
              {section.label}
            </a>
          ) : (
            <div class="relative" data-nav-item>
              <button
                class="flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors"
                aria-haspopup="true"
              >
                {section.label}
                <svg class="w-3 h-3 transition-transform duration-200" data-nav-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>

              <!-- Dropdown panel -->
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 transition-all duration-150 z-50" data-nav-panel>
                <div class:list={["bg-card border border-border rounded-xl shadow-2xl overflow-hidden", section.items.length > 8 ? "min-w-[440px]" : "min-w-[200px]"]}>
                  <div class:list={["p-1.5", section.items.length > 8 && "grid grid-cols-2 gap-0.5"]}>
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        class="flex flex-col px-3 py-2 rounded-lg hover:bg-accent/60 transition-colors group/item"
                      >
                        <span class="text-sm font-medium text-foreground group-hover/item:text-primary transition-colors leading-snug">{item.label}</span>
                        {item.desc && (
                          <span class="text-xs text-muted-foreground mt-0.5">{item.desc}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )
        ))}
      </nav>

      <!-- Right: CTA + mobile button -->
      <div class="flex items-center gap-2 shrink-0">
        <!--
          Signed-out visitors get the bare /chord-player/ CTA — the strongest internal
          link on the site (it renders on every page), pointing at the canonical URL
          rather than a ?chords=…&bpm=…&style=… variant, so nothing is lost for a first
          visitor. Once there's a session, AccountSlot swaps this same slot to "My
          library" instead — it's client:load, so the CTA above is what SSR/crawlers
          see and what flashes briefly before hydration confirms a session.
        -->
        <AccountSlot client:load variant="desktop" />

        <!-- Mobile hamburger -->
        <button
          id="mobile-nav-btn"
          class="lg:hidden min-h-[44px] min-w-[44px] p-[10px] rounded-md text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="hidden lg:hidden border-t border-border bg-background max-h-[80vh] overflow-y-auto">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">

      {nav.map((section) => (
        'href' in section && section.href ? (
          <a
            href={section.href}
            class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-foreground hover:bg-accent/50 transition-colors"
          >
            {section.label}
          </a>
        ) : (
          <div class="mobile-section">
            <button
              class="mobile-accordion-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold text-foreground hover:bg-accent/50 transition-colors"
              data-target={`mobile-${section.id}`}
            >
              {section.label}
              <svg class="w-4 h-4 text-muted-foreground transition-transform duration-200" data-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>
            <div id={`mobile-${section.id}`} class="hidden pl-3 pb-2 space-y-0.5">
              {section.items.map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2 rounded-lg text-sm text-muted-foreground hover:text-foreground hover:bg-accent/40 transition-colors"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        )
      ))}

      <AccountSlot client:load variant="mobile" />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-nav-btn');
  const panel = document.getElementById('mobile-nav');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    hamburger?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });

  document.querySelectorAll<HTMLButtonElement>('.mobile-accordion-btn').forEach((accBtn) => {
    accBtn.addEventListener('click', () => {
      const targetId = accBtn.dataset.target;
      if (!targetId) return;
      const content = document.getElementById(targetId);
      const chevron = accBtn.querySelector<SVGElement>('[data-chevron]');
      content?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });

  const navItems = document.querySelectorAll<HTMLElement>('[data-nav-item]');

  function closeAll() {
    navItems.forEach(item => {
      const p = item.querySelector<HTMLElement>('[data-nav-panel]');
      p?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      p?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      item.querySelector<SVGElement>('[data-nav-chevron]')?.classList.remove('rotate-180');
    });
  }

  navItems.forEach(item => {
    const dropPanel = item.querySelector<HTMLElement>('[data-nav-panel]');
    const chevron = item.querySelector<SVGElement>('[data-nav-chevron]');

    item.addEventListener('mouseenter', () => {
      closeAll();
      dropPanel?.classList.remove('opacity-0', 'invisible', 'translate-y-1');
      dropPanel?.classList.add('opacity-100', 'visible', 'translate-y-0');
      chevron?.classList.add('rotate-180');
    });

    item.addEventListener('mouseleave', () => {
      dropPanel?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      dropPanel?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      chevron?.classList.remove('rotate-180');
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-nav-item]')) closeAll();
  });
</script>
