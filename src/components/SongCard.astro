---
import type { PublicSong } from '@/lib/publicSongs';

interface Props {
  song: PublicSong;
  // Pre-normalized haystack for the client-side filter on /songs/. Set only on the search
  // grid's copies; the paginated grid renders without it. Computing it server-side keeps
  // the accent-stripping out of the hot path on every keystroke and, more importantly,
  // guarantees both sides ran the identical normalization.
  searchText?: string;
  // Whether this card belongs to the currently requested ?page= slice. Cards outside it are
  // rendered but hidden, so the client-side search can reveal any song in the catalogue
  // without a round trip, and clearing the search can restore exactly this page again.
  pageVisible?: boolean;
}

const { song, searchText, pageVisible = true } = Astro.props;
---

<a
  href={`/songs/${song.slug}/`}
  data-search-text={searchText}
  data-page-visible={pageVisible ? '' : undefined}
  style={pageVisible ? undefined : 'display:none'}
  class="group flex flex-col rounded-xl border border-border bg-card p-5 hover:border-primary/50 hover:bg-primary/5 transition-colors"
>
  <div class="flex items-start justify-between gap-2 mb-3">
    <div class="flex-1 min-w-0">
      <h2 class="text-base font-bold text-foreground group-hover:text-primary transition-colors truncate">
        {song.title}
      </h2>
      <p class="text-sm text-muted-foreground truncate">{song.artist}</p>
    </div>
    <svg class="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </div>
  <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-border/50">
    <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
      Key: {song.key}
    </span>
    {song.capo && (
      <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground border border-border">
        Capo {song.capo}
      </span>
    )}
    {song.genre.slice(0, 2).map(g => (
      <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground border border-border capitalize">
        {g}
      </span>
    ))}
  </div>
</a>
