---
import type { AUTHORS } from '../data/authors'

interface Props {
  author: (typeof AUTHORS)[keyof typeof AUTHORS]
  pubDate: Date
  updatedDate?: Date
}

const { author, pubDate, updatedDate } = Astro.props

const displayDate = updatedDate ?? pubDate
const dateLabel = updatedDate ? 'Last reviewed' : 'Published'
const formattedDate = displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<aside class="mt-14 rounded-2xl border border-border bg-card p-6 sm:p-8">
  <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-5">About the author</p>

  <div class="flex items-start gap-5">
    <a href={author.url} class="shrink-0">
      <img
        src={author.avatar}
        alt={`${author.name} — musician and software developer`}
        width="72"
        height="72"
        class="w-16 h-16 sm:w-[72px] sm:h-[72px] rounded-full object-cover ring-2 ring-primary/20 hover:ring-primary/50 transition-shadow"
        loading="lazy"
      />
    </a>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1">
        <a
          href={author.url}
          class="text-base font-bold text-foreground hover:text-primary transition-colors"
        >
          {author.name}
        </a>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
          {author.role}
        </span>
      </div>

      <p class="text-sm text-muted-foreground leading-relaxed mt-2">
        Musician and software developer from the Dominican Republic. Plays piano, bass, guitar, and drums.
        Has performed across genres — pop, R&amp;B, worship, and jazz — giving him a practical,
        instrument-grounded approach to music theory. Built Chord Sequence to make harmony accessible
        to every musician.
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-4">
        <a
          href={author.url}
          class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors"
        >
          Full bio →
        </a>
        <a
          href={author.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1"
        >
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
        <span class="text-xs text-muted-foreground ml-auto">
          {dateLabel}: <time datetime={displayDate.toISOString()}>{formattedDate}</time>
        </span>
      </div>
    </div>
  </div>
</aside>
