---
import ChordEmbed from './ChordEmbed';

interface Props {
  chords: string;
  bpm?: number;
  style?: string;
  title?: string;
  toolContext?: string;
}

const { chords, bpm, style, title, toolContext } = Astro.props;
---

<ChordEmbed client:visible chords={chords} bpm={bpm} style={style} title={title} toolContext={toolContext} />
